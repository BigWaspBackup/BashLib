(*
# API
Compatibility stubs for the retired WaspStats APIClient.
Methods keep the old names and signatures so existing scripts still compile.
They do not contact api.waspscripts.com or submit stats.
*)

{$DEFINE WL_API_INCLUDED}
{$IFNDEF WL_UTILS}
  {$I BashLib/utils.simba}
{$ENDIF}

type
  TAPIClient = record(TSRLBaseRecord)
    Payload: TJSONObject;
    Timer: TCountDown;
    TimeStamp: UInt64;
    Benchmark: TIntegerArray;
    Fails: Int32;
    Stopped, Disabled, IsSetup: Boolean;
    Config: TConfigJSON;
    UUID: String;
  end;

procedure TAPIClient.ResetPayload();
begin
end;

procedure TAPIClient.UpdatePayload({$H-}xp, {$H-}gp, {$H-}time: Int32);{$H+}
begin
end;

procedure TAPIClient.SetUsername({$H-}user: String = '');
begin
end;

procedure TAPIClient.Setup();
begin
  Self.Name := 'APIClient';
  Self.Disabled := True;
  Self.IsSetup := True;
end;

function TAPIClient.GetUUID(): String;
begin
  Result := Self.UUID;
end;

function TAPIClient.GetPassword(): String;
begin
  Result := '';
end;

function TAPIClient.GetUsername(): String;
begin
  Result := '';
end;

procedure TAPIClient.SetLocal({$H-}port: Int32 = 8080);
begin
end;

function TAPIClient.HashPassword({$H-}password: String): String;
begin
  Result := '';
end;

function TAPIClient.CheckPassword({$H-}uuid, {$H-}password: String): Boolean;
begin
  Result := False;
end;

function TAPIClient.CheckPassword({$H-}password: String): Boolean; overload;
begin
  Result := False;
end;

function TAPIClient.UpdatePassword({$H-}uuid, {$H-}old, {$H-}new: String): Boolean;
begin
  Result := False;
end;

function TAPIClient.UpdatePassword({$H-}old, {$H-}new: String): Boolean; overload;
begin
  Result := False;
end;

function TAPIClient.CheckStats({$H-}uuid: String): String;
begin
  Result := '';
end;

function TAPIClient.CheckStats(): String; overload;
begin
  Result := '';
end;

function TAPIClient.SubmitStats({$H-}uuid: String): Boolean;
begin
  Result := True;
end;

function TAPIClient.SubmitStats(): Boolean; overload;
begin
  Result := True;
end;

procedure TAPIClient.Pause();
begin
end;

procedure TAPIClient.Resume();
begin
end;

function TAPIClient.GET({$H-}route: String; {$H-}debugTime, {$H-}verbose: Boolean = False): String;
begin
  Result := '';
end;

function TAPIClient.GETEx({$H-}route, {$H-}destination: String; {$H-}debugTime, {$H-}verbose: Boolean = False): Boolean;
begin
  Result := False;
end;

function TAPIClient.POST({$H-}route: String; {$H-}debugTime, {$H-}verbose: Boolean = False): String;
begin
  Result := '';
end;

function TAPIClient.POST({$H-}route: String; {$H-}payload: String; {$H-}debugTime, {$H-}verbose: Boolean = False): String; overload;
begin
  Result := '';
end;

function TAPIClient.POST({$H-}route: String; {$H-}payload: TJSONObject; {$H-}verbose: Boolean = False): String; overload;
begin
  Result := '';
end;

function TAPIClient.GetScript({$H-}script_id: String; {$H-}verbose: Boolean = False): String;
begin
  Result := '';
end;

function TAPIClient.GetScriptRevision({$H-}script_id: String; {$H-}verbose: Boolean = False): Int32;
begin
  Result := -1;
end;

function TAPIClient.GetVersion({$H-}pkg: String; {$H-}verbose: Boolean = False): String;
begin
  Result := '';
end;

function TAPIClient.GetAllVersions({$H-}script_id: String; out revision, srltVersion, wlVersion: String; {$H-}verbose: Boolean = False): String;
begin
  revision := '';
  srltVersion := '';
  wlVersion := '';
  Result := '';
end;

procedure TAPIClient.Free();
begin
  Self.IsSetup := False;
end;

procedure CheckUpdates({$H-}caption: String = 'Updates Available');
begin
end;

var
  APIClient: TAPIClient;

procedure TSRL.Setup(); override;
begin
  inherited;
  APIClient.Setup();
end;
