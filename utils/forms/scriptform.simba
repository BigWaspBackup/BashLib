(*
## TScriptForm.ApplyJagexAccountVisibility
Greys out the Password field when Jagex Account is checked.
Password is cleared while Jagex Account is enabled.
*)
procedure TScriptForm.ApplyJagexAccountVisibility();
var
  jagex: TCheckBox;
  passEdit: TEdit;
  passPanel: TPanel;
begin
  jagex := Self.Form.GetChild('am_jagex_checkbox');
  passEdit := Self.Form.GetChild('am_pass_edit');
  passPanel := Self.Form.GetChild('am_pass_panel');

  if (jagex = nil) or (passEdit = nil) then
    Exit;

  if passPanel <> nil then
    passPanel.setVisible(True);

  if jagex.IsChecked() then
  begin
    passEdit.Clear();
    passEdit.setEnabled(False);
  end
  else
    passEdit.setEnabled(True);
end;

(*
## TScriptForm.SyncAccountManager
Writes the current Account Manager fields into the selected Login.Players slot and credentials.simba.
Only updates when the username still matches the selected account. A different username is treated
as composing a new account (Add Account), so the old entry is left alone.
Called automatically when fields change, after world selection, when the script starts,
and when the form closes (so Start saves worlds even if a script overrides StartScript
without calling inherited).
*)
procedure TScriptForm.SyncAccountManager();
var
  selector: TComboBox;
  user, pass, pin: TEdit;
  worlds: TMemo;
  jagex: TCheckBox;
  worldsArray: TIntegerArray;
  i: Int32;
  password: String;
begin
  if Self.AccountManagerLoading then
    Exit;

  if Self.Form.GetChild('am_panel') = nil then
    Exit;

  selector := Self.Form.GetChild('am_selector_combobox');
  user := Self.Form.GetChild('am_user_edit');
  pass := Self.Form.GetChild('am_pass_edit');
  pin := Self.Form.GetChild('am_pin_edit');
  worlds := Self.Form.GetChild('am_worlds_memo');
  jagex := Self.Form.GetChild('am_jagex_checkbox');

  if (selector = nil) or (user = nil) or (pass = nil) or (pin = nil) or (worlds = nil) then
    Exit;

  i := selector.getItemIndex();
  if (i < 0) or (i > High(Login.Players)) then
    Exit;

  if user.IsEmpty() then
    Exit;

  if LowerCase(user.GetText()) <> LowerCase(Login.Players[i].User) then
    Exit;

  if (jagex <> nil) and jagex.IsChecked() then
    password := ''
  else
    password := pass.GetText();

  worldsArray := worlds.GetIntegerArray(301, 700);
  Login.Players[i].User := user.GetText();
  Login.Players[i].Password := password;
  Login.Players[i].Pin := pin.GetText();
  Login.Players[i].Worlds := worldsArray;
  Login.PlayerIndex := i;

  try
    selector.getItems().Delete(i);
    selector.getItems().Insert(i, user.GetText());
    selector.setItemIndex(i);
  except
  end;

  RewriteCredentials();
end;

function TScriptForm.CreateAccountManager(owner: TControl): TPanel;
  type TScriptForm = TScriptForm;
   //This doesn't have to clutter things outside.

  procedure TScriptForm._ClearInputs({$H-}sender: TObject);{$H+}
  var
    edit: TCustomEdit;
    btn: TButton;
    jagex: TCheckBox;
  begin
    Self.AccountManagerLoading := True;
    try
      edit := Self.Form.GetChild('am_user_edit');
      edit.Clear();

      edit := Self.Form.GetChild('am_pass_edit');
      edit.Clear();

      edit := Self.Form.GetChild('am_pin_edit');
      edit.Clear();

      edit := Self.Form.GetChild('am_worlds_memo');
      edit.Clear();

      jagex := Self.Form.GetChild('am_jagex_checkbox');
      if jagex <> nil then
        jagex.SetChecked(False);

      Self.ApplyJagexAccountVisibility();

      btn := Self.Form.GetChild('am_delete_button');
      btn.setEnabled(False);
    finally
      Self.AccountManagerLoading := False;
    end;
  end;

  procedure TScriptForm._FillInputs({$H-}sender: TObject);{$H+}
  var
    idx, i: Int32;
    worldsStr: String;
    user, pass, pin: TEdit;
    worlds: TMemo;
    btn: TButton;
    jagex: TCheckBox;
  begin
    Self.AccountManagerLoading := True;
    try
      idx := Login.PlayerIndex;

      user := Self.Form.GetChild('am_user_edit');
      pass := Self.Form.GetChild('am_pass_edit');
      pin := Self.Form.GetChild('am_pin_edit');
      worlds := Self.Form.GetChild('am_worlds_memo');
      jagex := Self.Form.GetChild('am_jagex_checkbox');

      user.SetText(Login.Players[idx].User);
      pass.setText(Login.Players[idx].Password);
      pin.setText(Login.Players[idx].Pin);

      worldsStr := '';
      for i := 0 to High(Login.Players[idx].Worlds) do
      begin
        worldsStr += ToStr(Login.Players[idx].Worlds[i]);
        if i < High(Login.Players[idx].Worlds) then
          worldsStr += ', ';
      end;

      worlds.SetText(worldsStr);

      if jagex <> nil then
        jagex.SetChecked(Login.Players[idx].Password = '');

      Self.ApplyJagexAccountVisibility();

      btn := Self.Form.GetChild('am_delete_button');
      btn.setEnabled(True);
    finally
      Self.AccountManagerLoading := False;
    end;
  end;

  procedure TScriptForm._ReloadSelector({$H-}sender: TObject);{$H+}
  var
    selector: TComboBox;
    hasPlayers: Boolean;
    delete: TButton;
    player: TRSLoginPlayer;
  begin
    selector := Self.Form.GetChild('am_selector_combobox');
    selector.Clear();

    hasPlayers := Login.Players <> [];
    selector.SetEnabled(hasPlayers);
    delete := Self.Form.GetChild('am_delete_button');
    delete.SetEnabled(hasPlayers);

    for player in Login.Players do
      selector.getItems().Add(player.User);

    if hasPlayers then
    begin
      if (Login.PlayerIndex < 0) or (Login.PlayerIndex > High(Login.Players)) then
        Login.PlayerIndex := 0;
      selector.SetItemIndex(Login.PlayerIndex);
    end;
  end;

  procedure TScriptForm._SelectorOnChange(sender: TObject);
  var
    i: Int32;
    selector: TComboBox;
  begin
    selector := sender;

    i := selector.GetItemIndex();
    case i of
      -1:
      begin
        Login.PlayerIndex := 0;
        Self._ClearInputs(selector);
      end;
      0..High(Login.Players):
      begin
        Login.PlayerIndex := i;
        Self._FillInputs(selector);
      end;
      else
      begin
        Login.PlayerIndex := i;
        Self._ClearInputs(selector);
      end;
    end;

    Antiban.SetupBiometrics();
  end;

  procedure TScriptForm._OnFieldDone({$H-}sender: TObject);{$H+}
  begin
    Self.SyncAccountManager();
  end;

  procedure TScriptForm._OnJagexChange({$H-}sender: TObject);{$H+}
  begin
    if Self.AccountManagerLoading then
      Exit;

    Self.ApplyJagexAccountVisibility();
    Self.SyncAccountManager();
  end;

  procedure TScriptForm._OnAddClick(sender: TObject);
  var
    selector: TComboBox;
    user, pass, pin: TEdit;
    worlds: TMemo;
    jagex: TCheckBox;
    worldsArray: TIntegerArray;
    password, userName: String;
    i, found: Int32;
  begin
    selector := Self.Form.GetChild('am_selector_combobox');
    user := Self.Form.GetChild('am_user_edit');
    pass := Self.Form.GetChild('am_pass_edit');
    pin  := Self.Form.GetChild('am_pin_edit');
    worlds := Self.Form.GetChild('am_worlds_memo');
    jagex := Self.Form.GetChild('am_jagex_checkbox');

    if user.IsEmpty() then
    begin
      Self._ClearInputs(sender);
      Exit;
    end;

    userName := user.GetText();

    if (jagex <> nil) and jagex.IsChecked() then
      password := ''
    else
      password := pass.GetText();

    worldsArray := worlds.GetIntegerArray(301, 700);

    found := -1;
    for i := 0 to High(Login.Players) do
    begin
      if LowerCase(Login.Players[i].User) = LowerCase(userName) then
      begin
        found := i;
        Break;
      end;
    end;

    if found >= 0 then
    begin
      Login.Players[found].Password := password;
      Login.Players[found].Pin := pin.GetText();
      Login.Players[found].Worlds := worldsArray;
      Login.PlayerIndex := found;
    end
    else
    begin
      Login.AddPlayer(userName, password, pin.GetText(), worldsArray);
      Login.PlayerIndex := High(Login.Players);
    end;

    RewriteCredentials();
    Self._ReloadSelector(selector);
    Self._SelectorOnChange(selector);
  end;

  procedure TScriptForm._OnDeleteClick({$H-}sender: TObject);{$H+}
  var
    selector: TComboBox;
    i: Int32;
  begin
    selector := Self.Form.GetChild('am_selector_combobox');
    i := selector.getItemIndex();

    if (i < 0) or (i > High(Login.Players)) then
      Exit;

    Delete(Login.Players, i, 1);

    if Login.Players = [] then
      Login.PlayerIndex := 0
    else if i > High(Login.Players) then
      Login.PlayerIndex := High(Login.Players)
    else
      Login.PlayerIndex := i;

    RewriteCredentials();
    Self._ReloadSelector(selector);
    Self._SelectorOnChange(selector);
  end;

  procedure TScriptForm._OnGenerateWorldsClick({$H-}sender: TObject);{$H+}
  begin
    Self.ShowWorldFetcherDialog();
  end;

var
  selector: TLabeledCombobox;
  addButton, deleteButton, generateButton: TButton;
  user, pass, pin: TLabeledEdit;
  jagex: TLabeledCheckBox;
  worlds: TLabeledMemo;
  fullWidth, w, space, passW, pinW, y, btnW: Int32;
begin
  with Result do
  begin
    Create(owner);
    setName('am_panel');
    setCaption('');
    setBevelWidth(0);
    setHeight(Round(Self.Size.Y / 3.2) + TControl.AdjustToDPI(25));
    setWidth(Self.Size.X);
    SetTooltip('BashLib Account Manager.');
  end;

  fullWidth := Floor(Self.Size.X/2);
  space := Floor(fullWidth * 0.08);
  w := fullWidth - (space * 2);

  passW := Floor(w * 0.6);
  pinW := Floor(w * 0.3);

  y := TControl.AdjustToDPI(5);

  with selector do
  begin
    Create(Result);
    SetCaption('Current account:');
    SetName('am_selector');
    SetTooltip('Currently selected account. Scripts will use this account to log in.');
    SetLeft(space);
    SetTop(y);
    SetStyle(csDropDownList);
    SetWidth(w);
    ComboBox.setOnChange(@Self._SelectorOnChange);
  end;

  with user do
  begin
    Create(Result);
    SetCaption('Username:');
    SetName('am_user');
    SetTooltip('Username or email of the current account.');
    SetLeft(space);
    SetTop(selector.GetBottom() + TControl.AdjustToDPI(2));
    SetWidth(w);
    Edit.setOnEditingDone(@Self._OnFieldDone);
  end;

  with jagex do
  begin
    Create(Result);
    SetCaption('Jagex Account');
    SetName('am_jagex');
    SetTooltip('Jagex accounts do not need a password here. Password field is disabled when enabled.');
    SetLeft(space);
    SetTop(user.GetBottom() + TControl.AdjustToDPI(4));
    SetWidth(w);
    CheckBox.setOnChange(@Self._OnJagexChange);
  end;

  with pass do
  begin
    Create(Result);
    SetCaption('Password:');
    SetName('am_pass');
    SetTooltip('Password of the current account.');
    SetLeft(space);
    SetTop(jagex.GetBottom() + TControl.AdjustToDPI(2));
    SetWidth(passW);
    SetPasswordChar('*');
    Edit.setOnEditingDone(@Self._OnFieldDone);
  end;

  with pin do
  begin
    Create(Result);
    SetCaption('Bank pin:');
    SetName('am_pin');
    SetTooltip('Bank pin of the current account.');
    SetLeft(selector.GetRight() - pinW);
    SetTop(pass.GetTop());
    SetWidth(pinW);
    SetPasswordChar('*');
    SetMaxLength(4);
    Edit.SetOnKeyPress(@Edit.NumberField);
    Edit.setOnEditingDone(@Self._OnFieldDone);
  end;

  with worlds do
  begin
    Create(Result);
    SetCaption('Worlds (separated by commas):');
    SetName('am_worlds');
    SetTooltip('World list of the current account. Ex. 302, 305, 309, 444, 573');
    SetLeft(TControl.AdjustToDPI(375));
    SetTop(selector.GetTop());
    SetHeight(user.GetBottom());
    SetWidth(TControl.AdjustToDPI(336));
    Memo.setOnKeyPress(@Memo.NumberArrayField);
  end;

  space := TControl.AdjustToDPI(8);
  btnW := Floor((worlds.GetWidth() - space) / 2);

  with generateButton do
  begin
    Create(Result);
    SetCaption('Generate Worlds');
    SetName('am_generate_worlds_button');
    SetTooltip('Fetch and filter OSRS worlds, then replace the worlds list with your selection.');
    SetLeft(worlds.GetLeft());
    SetWidth(worlds.GetWidth());
    SetHeight(TControl.AdjustToDPI(27));
    SetTop(worlds.GetBottom() + TControl.AdjustToDPI(4));
    setOnClick(@Self._OnGenerateWorldsClick);
  end;

  with addButton do
  begin
    Create(Result);
    SetCaption('Add Account');
    SetName('am_add_button');
    SetTooltip('Creates a new account from the fields below. Does not replace the selected account.');
    SetLeft(worlds.GetLeft());
    SetWidth(btnW);
    SetHeight(TControl.AdjustToDPI(27));
    SetTop(pass.GetBottom() - GetHeight() + 1 + TControl.AdjustToDPI(2));
    setOnClick(@Self._OnAddClick);
  end;

  with deleteButton do
  begin
    Create(Result);
    SetCaption('Delete Account');
    SetName('am_delete_button');
    SetTooltip('Deletes the selected account from the credentials file.');
    SetLeft(worlds.GetLeft() + worlds.GetWidth() - btnW - TControl.AdjustToDPI(1));
    SetTop(addButton.GetTop());
    SetWidth(btnW);
    SetHeight(addButton.getHeight());
    setOnClick(@Self._OnDeleteClick);
  end;

  if Result.GetHeight() < (Max(addButton.GetTop() + addButton.GetHeight(), generateButton.GetTop() + generateButton.GetHeight()) + TControl.AdjustToDPI(8)) then
    Result.setHeight(Max(addButton.GetTop() + addButton.GetHeight(), generateButton.GetTop() + generateButton.GetHeight()) + TControl.AdjustToDPI(8));

  Self.ApplyJagexAccountVisibility();
  Self._ReloadSelector(selector.ComboBox);
  Self._SelectorOnChange(selector.ComboBox);
end;

function TScriptForm.CreateAccountManager(): TTabSheet; overload;
begin
  Self.AddTab('Account Manager');
  Result := Self.Tabs[High(Self.Tabs)];
  Self.CreateAccountManager(Result);
end;

function TScriptForm.CreateAntibanManager(owner: TControl): TPanel;
  type TScriptForm = TScriptForm;

  procedure TScriptForm._BioHashOnChange(sender: TObject);
  var
    bar: TTrackBar;
    edit: TEdit;
    value: Double;
    str: String;
  begin
    edit := sender;
    bar := Self.Form.GetChild('ab_biohash_trackbar');

    str := edit.getText();
    if not str.IsFloat() then
    begin
      BioHash := 0.000000000000001;
      edit.setText('0.000000000000001');
      bar.setPosition(0);
      Exit;
    end;

    value := StrToFloat(str);
    bar.setPosition(Trunc(value * 10));
    edit.SetText(str);
  end;

  procedure TScriptForm._BarOnChange(sender: TObject);
  var
    bar: TTrackBar;
    edit: TEdit;
    value: Double;
    str: String;
  begin
    bar := sender;
    edit := Self.Form.GetChild('ab_biohash_edit');

    value := bar.getPosition() * 0.111111111111111;
    if value = 0 then
      value += 0.000000000000001;

    if value = 1 then
      value -= 0.000000000000001;

    BioHash := value;
    str := FormatFloat('0.000000000000000', value);
    edit.SetText(str);
  end;

  procedure TScriptForm._ABOnChange(sender: TObject);
  var
    arr: TStringArray;
    i: Int32;
    child: TCheckBox;
    panel: TPanel;
    checked: Boolean;
  begin
    checked := TCheckBox(sender).IsChecked();

    arr := ['camera', 'mouse', 'chat', 'gametabs', 'bank'];

    for i := 0 to High(arr) do
    begin
      child := Self.Form.GetChild(arr[i] + '_group_checkbox');
      child.setEnabled(checked);
      panel := Self.Form.GetChild(arr[i] + '_group_panel');
      panel.setEnabled(checked);
    end;

    WLSettings.GetObject('antiban').getJSONObject('tasks').Put('enabled', checked);
    WLSettings.SaveConfig();
  end;

  procedure TScriptForm._ABGroupOnChange(sender: TObject);
  var
    checkbox: TCheckBox;
  begin
    checkbox := sender;
    WLSettings.GetObject('antiban').getJSONObject('tasks').Put(checkbox.getName().Before('_'), checkbox.IsChecked());
    WLSettings.SaveConfig();
  end;

  procedure TScriptForm._BreaksOnChange(sender: TObject);
  var
    breaks: TCheckBox;
    checked: Boolean;
  begin
    breaks := sender;
    checked := breaks.IsChecked();

    WLSettings.GetObject('antiban').Put('breaks', checked);
    WLSettings.SaveConfig();
  end;

  procedure TScriptForm._SleepsOnChange(sender: TObject);
  var
    sleepHour, sleepLength: TEdit;
    bio: TCheckbox;
    checked: Boolean;
  begin
    checked := TCheckBox(sender).IsChecked();

    sleepHour   := Self.Form.GetChild('ab_sleep_hour_edit');
    sleepLength := Self.Form.GetChild('ab_sleep_length_edit');
    bio := Self.Form.GetChild('ab_sleep_bio_checkbox');

    sleepHour.setEnabled(checked);
    sleepLength.setEnabled(checked);
    bio.getParent().setEnabled(checked);

    WLSettings.GetObject('antiban').getJSONObject('sleep').Put('enabled', checked);
    WLSettings.SaveConfig();
  end;

  procedure TScriptForm._SleepOnUseBioChange(sender: TObject);
  var
    checkbox: TCheckBox;
    edit: TEdit;
    checked: Boolean;
    h: String;
    l: Single;
  begin
    checkbox := sender;
    checked := checkbox.IsChecked();
    WLSettings.GetObject('antiban').getJSONObject('sleep').Put('biohash', checked);

    if checked then
    begin
      Antiban.SetupBiometrics();

      h := Antiban.GetSleepHour();
      WLSettings.GetObject('antiban').getJSONObject('sleep').Put('hour', h);
      l := Antiban.GetSleepLength();
      WLSettings.GetObject('antiban').getJSONObject('sleep').Put('length', l);
      WLSettings.SaveConfig();

      edit := Self.Form.GetChild('ab_sleep_hour_edit');
      if edit <> nil then edit.SetText(h);

      edit := Self.Form.GetChild('ab_sleep_length_edit');
      if edit <> nil then edit.SetText(ToStr(l));
    end;

    WLSettings.GetObject('antiban').getJSONObject('sleep').Put('biohash', checked);
    WLSettings.SaveConfig();
    checkbox.SetChecked(checked);
  end;

  procedure TScriptForm._SleepHourOnChange(sender: TObject);
  var
    edit: TEdit;
    text: String;
    bio: TCheckbox;
  begin
    edit := sender;
    text := edit.GetText();

    if not text.IsTime() then
    begin
      text := Antiban.GetSleepHour();
      edit.setText(text);
    end;

    bio := Self.Form.GetChild('ab_sleep_bio_checkbox');
    if bio <> nil then bio.SetChecked(False);

    WLSettings.GetObject('antiban').getJSONObject('sleep').Put('biohash', False);
    WLSettings.GetObject('antiban').getJSONObject('sleep').Put('hour', text);
    WLSettings.SaveConfig();
  end;

  procedure TScriptForm._SleepLengthOnChange(sender: TObject);
  var
    edit: TEdit;
    len: Single;
    bio: TCheckBox;
  begin
    edit := sender;
    len := Round(StrToFloat(edit.GetText()), 2);

    bio := Self.Form.GetChild('ab_sleep_bio_checkbox');
    if bio <> nil then bio.SetChecked(False);

    WLSettings.GetObject('antiban').getJSONObject('sleep').Put('biohash', False);
    WLSettings.GetObject('antiban').getJSONObject('sleep').Put('length', len);
    WLSettings.SaveConfig();
  end;

  procedure TScriptForm._SelectorOnChange(sender: TObject); override;
  var
    edit: TEdit;
  begin
    inherited;

    edit := Self.Form.GetChild('ab_biohash_edit');
    if edit <> nil then
      edit.setText(FormatFloat('0.000000000000000', BioHash));

    edit := Self.Form.GetChild('ab_sleep_hour_edit');
    if edit <> nil then edit.SetText(Antiban.GetSleepHour());

    edit := Self.Form.GetChild('ab_sleep_length_edit');
    if edit <> nil then edit.SetText(ToStr(Antiban.GetSleepLength()));
  end;

var
  bioPanel: TPanel;
  limitPanel: TPanel;
  fullWidth, w, space, y, i: Int32;
  bioEdit, sleepHour, sleepLength: TLabeledEdit;
  bar: TTrackBar;
  antibanGroup: TCheckCheckGroup;
  breaks, sleeps, useBio: TLabeledCheckBox;
  arr: TStringArray;
  str: String;
  combobox: TComboBox;
  checked: Boolean;
  ownerW, ownerH: Int32;
begin
  with Result do
  begin
    Create(owner);
    SetName('ab_manager_panel');
    setCaption('');
    setBevelWidth(0);
    setAlign(alClient);
  end;

  combobox := Self.Form.GetChild('am_selector_combobox');
  if combobox = nil then Antiban.SetupBiometrics();

  ownerW := owner.GetWidth();
  if ownerW <= 0 then
    ownerW := Self.Size.X;
  ownerH := owner.GetHeight();
  if ownerH <= 0 then
    ownerH := Self.Size.Y;

  fullWidth := ownerW;
  space := Floor(fullWidth * 0.1);
  w := fullWidth - (space * 2);
  y := Floor(ownerH / 6);

  with bioPanel do
  begin
    Create(Result);
    SetName('ab_biohash_panel');
    SetTop(10);
    SetLeft(space);
    SetHeight(y);
    SetWidth(w);
    setCaption('');
    setBevelWidth(0);
  end;

  with bar do
  begin
    Create(bioPanel);
    SetName('ab_biohash_trackbar');
    SetMin(0);
    SetMax(9);
    setAlign(alBottom);
    setPosition(Round(BioHash * bar.getMax()));
    SetTooltip('You can adjust your biohash with this trackbar, however, the default is recommended.');
    setOnChange(@Self._BarOnChange);
  end;

  with bioEdit do
  begin
    Create(bioPanel);
    SetLeft(Round(w/3));
    SetWidth(Round(w/4));
    SetCaption('BioHash:');
    SetName('ab_biohash');
    SetMaxLength(17);
    SetToolTip('Value that will slightly modify timings of actions in scripts to create a unique pattern. Auto-generated when account added to credentials.');
    Edit.setOnKeyPress(@Edit.NumberField);
    Edit.setOnChange(@Self._BioHashOnChange);
    SetText(FormatFloat('0.000000000000000', BioHash));
  end;

  fullWidth := Floor(ownerW / 2.8);
  space := Floor(fullWidth * 0.3);
  w := fullWidth - (space * 2);
  y := Floor(ownerH / 6);

  arr := ['Camera', 'Mouse', 'Chat', 'GameTabs', 'Bank'];
  with antibanGroup do
  begin
    Create(Result);
    SetCaption('Antiban');
    SetTooltip('Antiban settings.');
    SetTop(TControl.AdjustToDPI(120));
    SetLeft(space);
    AddItemArray(arr);

    SetChecked(WLSettings.GetObject('antiban').getJSONObject('tasks').getBoolean('enabled'));

    for i := 0 to High(arr) do
    begin
      str := LowerCase(arr[i]) + '_group';
      SetCheckedChild(WLSettings.GetObject('antiban').getJSONObject('tasks').GetBoolean(LowerCase(arr[i])), str);
      GetChildCheckBox(str).setOnChange(@Self._ABGroupOnChange);
      Self._ABGroupOnChange(GetChildCheckBox(str));
    end;

    CheckBox.setOnChange(@Self._ABOnChange);
    Self._ABOnChange(CheckBox);
  end;

  with breaks do
  begin
    Create(Result);
    SetCaption('Short breaks');
    SetLeft(fullWidth + Floor(space * 0.5));
    SetTop(antibanGroup.GetTop());
    SetToolTip('Enables/Disables short, randomized breaks.');

    SetChecked(WLSettings.GetObject('antiban').getBoolean('breaks'));

    CheckBox.setOnChange(@Self._BreaksOnChange);
    Self._BreaksOnChange(CheckBox);
  end;

  with sleeps do
  begin
    Create(Result);
    SetCaption('Sleep breaks');
    SetLeft(fullWidth * 2 + Floor(space * 0.2));
    SetTop(antibanGroup.GetTop());
    SetToolTip('Enables/Disables sleep breaks.');

    SetChecked(WLSettings.GetObject('antiban').getJSONObject('sleep').getBoolean('enabled'));
    CheckBox.setOnChange(@Self._SleepsOnChange);
  end;

  with useBio do
  begin
    Create(Result);
    SetCaption('Use BioHash for sleep');
    SetName('ab_sleep_bio');
    SetLeft(sleeps.GetLeft() + TControl.AdjustToDPI(5));
    SetTop(sleeps.GetBottom() + TControl.AdjustToDPI(5));
    SetToolTip('Enables/Disables biohash influence on sleep time and length.');

    useBio.SetChecked(WLSettings.GetObject('antiban').getJSONObject('sleep').getBoolean('biohash'));

    checked := useBio.IsChecked();
    CheckBox.setOnChange(@Self._SleepOnUseBioChange);
  end;

  with sleepHour do
  begin
    Create(Result);
    SetLeft(useBio.GetLeft());
    SetWidth(w);
    SetTop(useBio.GetBottom() + TControl.AdjustToDPI(5));
    SetCaption('Sleep hour:');
    SetName('ab_sleep_hour');
    SetToolTip('Local PC time to base randomized start of sleep on in 24hr format, HH:MM:SS.');
    SetMaxLength(8);
    Edit.setOnKeyPress(@Edit.TimeField);
    Edit.setOnEditingDone(@Self._SleepHourOnChange);

    SetText(Antiban.GetSleepHour());
  end;

  with sleepLength do
  begin
    Create(Result);
    SetLeft(sleepHour.GetLeft());
    SetWidth(w);
    SetTop(sleepHour.GetBottom() + TControl.AdjustToDPI(5));
    SetCaption('Sleep length (hours):');
    SetName('ab_sleep_length');
    SetToolTip('Sleep length in hours.');
    Edit.setOnKeyPress(@Edit.FloatField);
    Edit.setOnChange(@Self._SleepLengthOnChange);
    SetText(ToStr(Antiban.GetSleepLength()));
  end;

  Self._SleepsOnChange(sleeps.CheckBox);
  Self._SleepHourOnChange(sleepHour.Edit);
  Self._SleepLengthOnChange(sleepLength.Edit);

  if combobox <> nil then
    Self._SelectorOnChange(combobox);

  useBio.SetChecked(checked);
  Self._SleepOnUseBioChange(useBio.CheckBox);

  limitPanel := Self.CreateLimitSettings(Result);
  limitPanel.setAlign(alBottom);
end;

function TScriptForm.CreateAntibanManager(): TTabSheet; overload;
begin
  Self.AddTab('Antiban Manager');
  Result := Self.Tabs[High(Self.Tabs)];
  Self.CreateAntibanManager(Result);
end;

function TScriptForm.CreateConsumableSettings(owner: TControl; consumableType: ERSConsumable; addInfo: Boolean = True): TPanel;
var
  typeStr: String;
  itemArray: TRSItemArray;
  info: TLabel;
  minPoints, consumableAmount: TLabeledEdit;
  consumableSelector: TLabeledCombobox;
  fullWidth, w, space, y: Int32;
begin
  fullWidth := Floor(Self.Size.X/3);
  space := Floor(fullWidth * 0.1);
  w := Floor(fullWidth - space * 2);
  if addInfo then
    y := Floor(Self.Size.Y/2.5)
  else
    y := TControl.AdjustToDPI(15);

  case consumableType of
    ERSConsumable.FOOD:
      begin
        typeStr := 'Food';
        itemArray := FOOD_ARRAY;
      end;

    ERSConsumable.PRAYER:
      begin
        typeStr := 'Prayer';
        itemArray := PRAYER_ARRAY;
      end;

    ERSConsumable.ENERGY:
      begin
        typeStr := 'Energy';
        itemArray := ENERGY_ARRAY;
      end;

    ERSConsumable.BOOST:
      begin
        typeStr := 'Boost';
        itemArray := BOOST_ARRAY;
      end;
  end;

  with Result do
  begin
    Create(owner);
    setName('cm_' + LowerCase(typeStr) + '_panel');
    setCaption('');
    setBevelWidth(0);
    setHeight(y + TControl.AdjustToDPI(40));
    setWidth(Self.Size.X);
    SetTooltip('BashLib''s ' + typeStr + ' Settings.');
  end;

  if addInfo then
    with info do
    begin
      Create(Result);
      SetTop(TControl.AdjustToDPI(20));
      SetLeft(space);
      setCaption('Things to keep in mind about BashLib''s ' + typeStr +
                 ' Handler:' + LINEENDING + LINEENDING +
                 '- Auto mode will use anythig it recognizes available. It only recognizes items in the list.' +
                 LINEENDING +
                 '- Auto mode has it''s own order of preference, which might not match yours. It''s the same order as the list.' +
                 LINEENDING +
                 '- Auto mode preference order can be overriden by starting with an item from the list in your inventory.' +
                 LINEENDING +
                 '- "Drink/Eat at" and "Withdraw ' + typeStr + ' amount" are dynamic and have some variance to it.' +
                 LINEENDING +
                 '    - This variance is not a flat rate, it varies both depending on input and your BioHash.' +
                 LINEENDING +
                 '    - For "Eat/Drink" you can expect it to:' +
                 LINEENDING +
                 '        - Vary aproximately between 20% and 40% on lower values, e.g. 10.' +
                 LINEENDING +
                 '        - Vary aproximately between 5% and 20% at higher values e.g. 80.'
      );
    end;

  with consumableSelector do
  begin
    Create(Result);
    SetCaption(typeStr + ' type: (empty=auto)');
    SetName('cm_' + typeStr  + '_selector');
    SetLeft(space);
    SetTop(y);
    SetWidth(w);
    SetStyle(csDropDownList);
    AddItemArray(itemArray);
  end;

  with minPoints do
  begin
    Create(Result);
    if consumableType = ERSConsumable.BOOST then
      SetCaption('Drink/Eat every (in minutes):')
    else
      SetCaption('Drink/Eat at:');
    SetName('cm_' + typeStr + '_minimum');
    SetLeft(fullWidth + space);
    SetTop(y);
    SetWidth(w);
    if consumableType = ERSConsumable.BOOST then
      SetText('5')
    else
      SetText('50');
    Edit.setOnKeyPress(@Edit.NumberField);
  end;

  if Self.Form.GetChild('bank_settings') <> nil then
    with consumableAmount do
    begin
      Create(Result);
      SetCaption('Withdraw ' + LowerCase(typeStr) + ' amount:');
      SetName('cm_' + typeStr + '_amount');
      SetLeft(fullWidth * 2 + space);
      SetTop(y);
      SetWidth(w);
      SetText('8');
      Edit.setOnKeyPress(@Edit.NumberField);
    end;
end;

function TScriptForm.CreateConsumableSettings(consumableType: ERSConsumable): TTabSheet; overload;
var
  typeStr: String;
begin
  case consumableType of
    ERSConsumable.FOOD:   typeStr := 'Food';
    ERSConsumable.PRAYER: typeStr := 'Prayer';
    ERSConsumable.ENERGY: typeStr := 'Energy';
    ERSConsumable.BOOST:  typeStr := 'Boost';
  end;

  Self.AddTab(typeStr + ' Settings');
  Result := Self.Tabs[High(Self.Tabs)];
  Self.CreateConsumableSettings(Result, consumableType);
end;

function TScriptForm.CreateBankSettings(): TTabSheet;
  type TScriptForm = TScriptForm;
  procedure TScriptForm._BankOnChange(sender: TObject);
  var
    combobox: TComboBox;
    imgBox: TSimbaImageBox;
    b: TBox;
    p: TPoint;
  begin
    combobox := sender;
    imgBox := Self.Form.GetChild('map_selector');
    WLSettings.Put('bank_map', combobox.getItemIndex());
    WLSettings.SaveConfig();

    b := RSBankRegions[WLSettings.GetInt('bank_map')].Bounds;
    b.X1 := Round(b.X1/4);
    b.Y1 := Round(b.Y1/4);
    b.X2 := Round(b.X2/4);
    b.Y2 := Round(b.Y2/4);

    p := b.Center();
    imgBox.MoveTo(p.X, p.Y);

    imgBox.GetOverlay().Clear();
    imgBox.getOverlay().DebugTPA(b.ToRectangle().ToTPA().Connect());
    imgBox.Update();
  end;

  procedure TScriptForm.OnShow(sender: TObject); override;
  var
    imgbox: TSimbaImageBox;
    combobox: TComboBox;
  begin
    inherited;

    imgbox := TForm(sender).GetChild('map_selector');
    combobox := form.GetChild('bank_selector_combobox');

    if (imgbox <> nil) and (combobox <> nil) then
    begin
      imgbox.BackgroundChanged();
      imgbox.Update();
      Self._BankOnChange(combobox);
    end;
  end;

  procedure TScriptForm._FormOnHide(sender: TObject);
  var
    imgBox: TSimbaImageBox;
  begin
    imgBox := TForm(sender).GetChild('map_selector');
    imgBox.getBackground().FreeImage();
  end;

var
  bankSelector: TLabeledCombobox;
  path, mapPath, fileName: String;
  bmp, tmp: TMufasaBitmap;
  imgBox: TSimbaImageBox;
  fullWidth, w, space, x, y: Int32;
begin
  Self.Form.setOnHide(@Self._FormOnHide);

  Self.AddTab('Bank Settings');
  Result := Self.Tabs[High(Self.Tabs)];

  x := Floor(Self.Size.X/2);

  fullWidth := Floor(Self.Size.X/3);
  space := Floor(fullWidth * 0.1);
  w := Floor(fullWidth - space * 2);
  y := Floor(Self.Size.Y * 0.03);

  with bankSelector do
  begin
    Create(Result, 'Bank: ', 'Select your bank', [space, y], [w, 0], False);
    SetName('bank_selector');
    AddItemArray(RSBankRegions.GetStrings());
    SetItemIndex(WLSettings.GetInt('bank_map'));
    ComboBox.SetOnChange(@Self._BankOnChange);
  end;

  mapPath := INCLUDEPATH + 'BashLib' + DIRECTORYSEPARATOR + 'osr' +
              DIRECTORYSEPARATOR + 'walker' + DIRECTORYSEPARATOR + 'map.png';
  fileName := SHA1File(mapPath) + '.bmp';
  path := WL_DATAPATH + 'assets' + DIRECTORYSEPARATOR;

  bmp.Init();
  if FileExists(path + fileName) then
    bmp.LoadFromFile(path + fileName)
  else
  begin
    tmp := TRSWalkerMap.InternalLoadMap(WALKER_DIR + 'map.png');
    tmp.Downsample(4, bmp);
    tmp.Free();
    if ForceDirectories(path) then bmp.SaveToFile(path + fileName);
  end;

  with imgBox do
  begin
    Create(Result, '', 'Right Click + Drag to move', [space, y + TControl.AdjustToDPI(40)], [fullWidth * 3 - space * 2, Round(Self.Size.Y * 0.77)], False);
    imgBox.SetAlign(TAlign.alNone);
    SetName('map_selector');
    GetBackground().LoadFromMufasaBitmap(bmp);
    GetOverlay().GetCanvas().GetPen().SetColor($00FFFF);
  end;

  bmp.Free();
end;

function TScriptForm.CreateBankSettingsV2(parent: TControl; topLeft, offset: TPoint): TLabeledComboBox;
  type TScriptForm = TScriptForm;
  procedure TScriptForm._BankOnChangeV2(sender: TObject);
  var
    combobox: TComboBox;
  begin
    combobox := sender;
    WLSettings.Put('bank_map', combobox.getItemIndex());
    WLSettings.SaveConfig();
  end;

var
  loc: EBankChunk;
begin
  Result.Create(parent, 'Bank: ', 'Select your bank', topLeft, [0,0], offset, True);

  for loc := Low(EBankChunk) to High(EBankChunk) do
    Result.AddItem(loc.Name());

  if WLSettings.Has('bank_map') then
    Result.SetItemIndex(WLSettings.GetInt('bank_map'))
  else
    Result.SetItemIndex(8);
  Result.ComboBox.SetOnChange(@Self._BankOnChangeV2);
end;


function TScriptForm.CreateLimitSettings(owner: TControl): TPanel;
  type TScriptForm = TScriptForm;

  procedure TScriptForm._ActionLimitOnDone(sender: TObject);
  var
    edit: TEdit;
    str: String;
  begin
    edit := sender;
    str := edit.getText();

    if str = '' then str := '0';

    WLSettings.Put('max_actions', StrToIntDef(str, 0));
  end;

  procedure TScriptForm._TimeLimitOnDone(sender: TObject);
  var
    edit: TEdit;
    str: String;
  begin
    edit := sender;
    str := edit.getText();

    if str = '' then str := '0';

    WLSettings.Put('max_time', StrToIntDef(str, 0));
  end;

  procedure TScriptForm._StopAtLevelOnClick({$H-}sender: TObject);{$H+}
  begin
    StopAtLevel.ShowFormForCurrentAccount();
  end;

var
  actionLimit, timeLimit: TLabeledEdit;
  stopAtLevelBtn: TButton;
  fullWidth, w, space, y: Int32;
begin
  with Result do
  begin
    Create(owner);
    setName('limit_panel');
    setCaption('');
    setBevelWidth(0);
    setHeight(Round(Self.Size.Y / 5.5));
    SetTooltip('BashLib limit settings.');
  end;

  fullWidth := Floor(Self.Size.X/2);
  space := Floor(fullWidth * 0.1);
  w := Floor(fullWidth - space * 2);
  y := TControl.AdjustToDPI(20);

  with actionLimit do
  begin
    Create(Result);
    SetCaption('Stop after (number of actions):');
    SetName('wl_action_limit');
    SetTooltip('Sets the script to stop after X amount of actions are performed.'
               + LINEENDING +
               '0 = infinite.');
    SetLeft(space);
    SetTop(y);
    SetWidth(w);
    SetText(ToStr(WLSettings.GetInt('max_actions')));
    Edit.setOnKeyPress(@Edit.NumberField);
    Edit.setOnEditingDone(@Self._ActionLimitOnDone);
  end;

  with timeLimit do
  begin
    Create(Result);
    SetCaption('Stop after (time in minutes):');
    SetName('wl_time_limit');
    SetTooltip('Sets the script to stop after X amount of minutes have passed.'
               + LINEENDING +
               '0 = infinite.');
    SetLeft(fullWidth + space);
    SetTop(y);
    SetWidth(w);
    SetText(ToStr(WLSettings.GetInt('max_time')));
    Edit.setOnKeyPress(@Edit.NumberField);
    Edit.setOnEditingDone(@Self._TimeLimitOnDone);
  end;

  with stopAtLevelBtn do
  begin
    Create(Result);
    SetCaption('Stop At Level...');
    SetName('wl_stop_at_level_button');
    SetTooltip('Set skill level goals. The script stops when any enabled goal is reached.'
               + LINEENDING +
               '0 = no limit for that skill.');
    SetLeft(space);
    SetTop(actionLimit.GetBottom() + TControl.AdjustToDPI(10));
    SetWidth(w);
    SetHeight(TControl.AdjustToDPI(28));
    setOnClick(@Self._StopAtLevelOnClick);
  end;

  if Result.GetHeight() < (stopAtLevelBtn.GetTop() + stopAtLevelBtn.GetHeight() + TControl.AdjustToDPI(12)) then
    Result.setHeight(stopAtLevelBtn.GetTop() + stopAtLevelBtn.GetHeight() + TControl.AdjustToDPI(12));
end;

function TScriptForm.CreateRemoteInputSettings(owner: TControl): TPanel;
  type TScriptForm = TScriptForm;

  procedure TScriptForm._RIOnChange(sender: TObject);
  var
    arr: TStringArray;
    i: Int32;
    child: TCheckBox;
    panel: TPanel;
    checked: Boolean;
  begin
    checked := TCheckBox(sender).IsChecked();
    arr := ['block_real_input', 'hud_report', 'hud_debug', 'hud_transparent'];

    for i := 0 to High(arr) do
    begin
      child := Self.Form.GetChild(arr[i] + '_group_checkbox');
      child.setEnabled(checked);
      panel := Self.Form.GetChild(arr[i] + '_group_panel');
      panel.setEnabled(checked);
    end;

    WLSettings.GetObject('remote_input').Put('enabled', checked);

    if checked then
    begin
      child := Self.Form.GetChild(arr[1] + '_group_checkbox');
      Self._RIGroupOnChange(child);
    end
    else
      WLSettings.SaveConfig();
  end;

  procedure TScriptForm._RIGroupOnChange(sender: TObject);
  var
    checkbox, sibling: TCheckBox;
    panel: TPanel;
    name, str: String;
  begin
    checkbox := sender;
    name := checkbox.getName();
    str := name.Before('_group_checkbox');
    WLSettings.GetObject('remote_input').Put(str, checkbox.IsChecked());

    case name of
      'hud_report_group_checkbox':
        begin
          panel := checkbox.getParent().getParent();

          if not checkbox.IsChecked() then
          begin
            panel := panel.GetChild('hud_transparent_group_panel');
            panel.setEnabled(False);
            sibling := panel.GetChild('hud_transparent_group_checkbox');
            sibling.setEnabled(False);
          end
          else
          begin
            sibling := panel.GetChild('hud_debug_group_checkbox');
            sibling.SetChecked(False);
            WLSettings.GetObject('remote_input').Put('hud_debug', False);

            panel := panel.GetChild('hud_transparent_group_panel');
            panel.setEnabled(True);
            sibling := panel.GetChild('hud_transparent_group_checkbox');
            sibling.setEnabled(True);
          end;
        end;

      'hud_debug_group_checkbox':
        if checkbox.IsChecked() then
        begin
            panel := checkbox.getParent().getParent();
            sibling := panel.GetChild('hud_report_group_checkbox');
            sibling.SetChecked(False);
            WLSettings.GetObject('remote_input').Put('hud_report', False);

            panel := panel.GetChild('hud_transparent_group_panel');
            panel.setEnabled(False);
            sibling := panel.GetChild('hud_transparent_group_checkbox');
            sibling.setEnabled(False);
        end;
    end;

    WLSettings.SaveConfig();
  end;

var
  info: TLabel;
  fullWidth, space, i: Int32;
  riGroup: TCheckCheckGroup;
  arr: TStringArray;
  str: String;
  tmp: TCheckBox;
begin
  with Result do
  begin
    Create(owner);
    SetName('ri_panel');
    setCaption('');
    setBevelWidth(0);
    setHeight(Round(Self.Size.Y / 4.2));
    SetTooltip('Remote Input settings.');
  end;

  fullWidth := Floor(Self.Size.X/4);
  space := Floor(fullWidth * 0.1);

  with info do
  begin
    Create(Result);
    SetTop(TControl.AdjustToDPI(20));
    SetLeft(fullWidth + space);
    SetCaption('Remote input is the tool used to allow simba to do virtual input on osrs.' +
    LINEENDING + 'This uses reflection to achieve input.');
    SetName('ri_info');
  end;

  arr := ['Block Real Input', 'HUD Report', 'HUD Debug', 'HUD Transparent'];
  with riGroup do
  begin
    Create(Result);
    SetCaption('Remote Input');
    SetTooltip('Remote Input settings.');
    SetTop(TControl.AdjustToDPI(20));
    SetLeft(space);
    AddItemArray(arr);

    for i := 0 to High(arr) do
    begin
      str := Replace(LowerCase(arr[i]), ' ', '_', [rfReplaceAll]);
      tmp := GetChildCheckBox(str + '_group');
      tmp.setOnChange(@Self._RIGroupOnChange);
      tmp.SetChecked(WLSettings.GetObject('remote_input').getBoolean(str));
    end;

    CheckBox.setOnChange(@Self._RIOnChange);

    SetChecked(WLSettings.GetObject('remote_input').getBoolean('enabled'));

    Self._RIOnChange(CheckBox);
  end;
end;

function TScriptForm.CreateVideoPanel(owner: TControl): TPanel;
  type TScriptForm = TScriptForm;

  procedure TScriptForm._VideoOnChange(sender: TObject);
