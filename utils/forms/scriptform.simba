(*
# ScriptForm
This file is responsible for creating and managing BashLib's forms.

This might be complicated to understand if you are not familiar with pointers and type casting because it heavily relies on both.
*)
{$DEFINE WL_SCRIPTFORM_INCLUDED}
{$IFNDEF WL_UTILS}
  {$I BashLib/utils.simba}
{$ENDIF}

(*
## Compiler Directives
```pascal
{$IFHASFILE credentials.simba}{$I credentials.simba}{$ENDIF}
{$IFNDEF SCRIPT_ID}{$DEFINE SCRIPT_ID := ''}{$ENDIF}
{$IFNDEF SCRIPT_REVISION}{$DEFINE SCRIPT_REVISION := ''}{$ENDIF}
{$IFNDEF _WL_CACHE}{$DEFINE _WL_CACHE := ''}{$ENDIF}
```
The first line looks for a credentials.simba file and include it if it exists.
This is what gives BashLib scripts access to their accounts through several scripts.
It's important to know that player information is stored in Simba code to compile when the file is included, what this means is that the information is in plain text.

The next lines are unrelated to credentials but related to each other.
The way **TScriptForm** was made, it assumes a valid SCRIPT_ID and SCRIPT_REVISION have been assigned.
Because BashLib is not meant to enforce the usage of https://waspscripts..com, this was added as a way of users being able to use BashLib regardless of having a script id/revision or not.
`_WL_CACHE` is an optional opaque build tag injected into watermarked premium downloads; empty when absent.
*)
{$IFHASFILE credentials.simba}{$I credentials.simba}{$ENDIF}
{$IFNDEF SCRIPT_ID}{$DEFINE SCRIPT_ID := ''}{$ENDIF}
{$IFNDEF SCRIPT_REVISION}{$DEFINE SCRIPT_REVISION := ''}{$ENDIF}
{$IFNDEF _WL_CACHE}{$DEFINE _WL_CACHE := ''}{$ENDIF}

type
(*
## TScriptForm
```pascal
TScriptForm = record
Size: TPoint;
PageControl: TPageControl;
Tabs: array of TTabSheet;
Start: TButton;
Form: TForm;
end;
```

TScriptForm is the record responsible for handling the BashLib form.
*)
  TScriptForm = record
    Size: TPoint;
    PageControl: TPageControl;
    Tabs: array of TTabSheet;
    Start: TButton;
    LightMode, Running: Boolean;
  class var
    Form: TForm;
    WorldFetcherDialog: TForm;
    WorldFetcherAllCache: array of TWorldInfo;
    WorldFetcherFiltered: array of TWorldInfo;
    WorldFetcherSelected: array of Boolean;
    AccountManagerLoading: Boolean;
  end;

const
(*
## CREDENTIALS_FILE
..pascal:: const CREDENTIALS_FILE = AppPath + 'credentials.simba';

Global constant that points to the location of credentials.simba which is Simba's root directory.
*)
  CREDENTIALS_FILE = AppPath + 'credentials.simba';

var
  _WL_WarmedThisProcess: Boolean = False;
  _BashUpdatePromptCurrent, _BashUpdatePromptLatest: String;

(*
## RewriteCredentials
```pascal
procedure RewriteCredentials();
```

Internal method used to rewrite the credentials.simba file.
This will use whatever is stored at the moment in **Login.Players** array and replace Simba/credentials.simba with it written
in the appropiate format.

Example:
```pascal
begin
  Login.AddPlayer('USERNAME1', 'PASSWORD1', 'PIN1', []); //[] is an array of world numbers.
  Login.AddPlayer('USERNAME2', 'PASSWORD2', 'PIN2', []);
  Login.AddPlayer('USERNAME3', 'PASSWORD3', 'PIN3', []);
end;
```
*)
procedure RewriteCredentials();
  function _FilterDuplicatePlayers(players: array of TRSLoginPlayer): array of TRSLoginPlayer;
  var
    i, j: Int32;
    match: Boolean;
  begin
    Result := [];
    for i := 0 to High(players) do
    begin
      match := False;
      for j := 0 to High(Result) do
      begin
        if LowerCase(players[i].User) = LowerCase(Result[j].User) then
        begin
          match := True;
          Break;
        end;
      end;

      if not match then
        Result += players[i];
    end;
  end;

  function _BuildCredentials(): String;
  var
    player: TRSLoginPlayer;
    world: Int32;
  begin
    Result := 'begin'#13#10'';
    for player in Login.Players do
    begin
      Result += '  Login.AddPlayer(''' +
                  player.User + ''', ''' + player.Password + ''', ''' + player.Pin + ''', [';

      for world in player.Worlds do
      begin
        Result += ToStr(world);
        if world <> player.Worlds[High(player.Worlds)] then
          Result += ', ';
      end;

      Result += ']);'#13#10'';
    end;
    Result += 'end;';
  end;

begin
  Login.Players := _FilterDuplicatePlayers(Login.Players);

  if Login.Players = [] then
    Login.PlayerIndex := 0
  else if (Login.PlayerIndex < 0) or (Login.PlayerIndex > High(Login.Players)) then
    Login.PlayerIndex := High(Login.Players);

  try
    WriteFileContents(CREDENTIALS_FILE, _BuildCredentials());
  except
    WriteLn GetExceptionMessage();
    WriteLn 'It''s possible you lost your saved accounts!';
    WriteLn 'If you have issues with the Account Manager delete the following file:';
  end;
end;

(*
## TScriptForm.AddTab
```pascal
procedure TScriptForm.AddTab(caption: String);
procedure TScriptForm.AddTab(tab: TTabSheet); overload;
procedure TScriptForm.AddTabArray(captions: TStringArray);
```
Methods to add tabs to `TScriptForm`.

When you a tab by **caption** be it a single one or an array of them, the caption you use can be used
to reference the tab later.

It's **caption** get sanitized with:
```pascal
LowerCase(StringReplace(caption, ' ', '_', [rfReplaceAll]))
```

Which means that if you "HelLo WOrLD" as your **caption**, it's name internally will become "hello_world_settings".
This is only important if you need to retrieve the tab with the use of **Self.Form.GetChild()**.
If you use the other tab methods you simply have to write the **caption** name the same way you did the first time.
Your tab will also be added to **TScriptForm.Tabs** as the last element of the array and you can get it right after adding it with **MyForm.Tabs[High(MyForm.Tabs)]**.

This example as a very simple setup of a TScriptForm with one tab:

Example:
```pascal
procedure TMyScriptForm.Run(); override;
var
  tab: TTabSheet;
begin
  Self.Setup('HELLO WORLD SCRIPT');
  Self.Start.setOnClick(@Self.StartScript);

  Self.AddTab('Script Settings');
  tab := Self.Tabs[High(Self.Tabs)];

  inherited;
end;
```
*)
procedure TScriptForm.AddTab(caption: String);
var
  tab: TTabSheet;
begin
  if Self.PageControl = nil then
    Exit;

  tab.Create(Self.PageControl);

  tab.setCaption(caption);
  tab.SetTooltip(caption + ' settings.');

  caption := LowerCase(StringReplace(caption, ' ', '_', [rfReplaceAll]));

  tab.setName(caption);

  Self.Tabs += tab;
end;

procedure TScriptForm.AddTab(tab: TTabSheet); overload;
begin
  if Self.PageControl = nil then
    Exit;

  tab.setParent(Self.PageControl);
  Self.PageControl.InsertComponent(tab);

  Self.Tabs += tab;
end;

procedure TScriptForm.AddTabArray(captions: TStringArray);
var
  caption: String;
begin
  for caption in captions do
    Self.AddTab(caption);
end;


(*
## TScriptForm.InsertTab
```pascal
procedure TScriptForm.InsertTab(caption: String; index: Int32 = 0);
procedure TScriptForm.InsertTab(tab: TTabSheet; index: Int32 = 0); overload;
```
Adds a tab to TScriptForm and places it in TScriptForm.Tabs at the specified index.
This is rarely ever useful at all to be honest.
*)
procedure TScriptForm.InsertTab(caption: String; index: Int32 = 0);
var
  tab: TTabSheet;
begin
  if Self.PageControl = nil then
    Exit;

  tab.Create(Self.PageControl);
  tab.setName(caption);
  tab.setCaption(caption);

  tab.SetTooltip(caption + ' settings.');

  Insert(tab, Self.Tabs, index);
end;

procedure TScriptForm.InsertTab(tab: TTabSheet; index: Int32 = 0); overload;
begin
  if Self.PageControl = nil then
    Exit;

  tab.setParent(Self.PageControl);
  Self.PageControl.InsertComponent(tab);

  Insert(tab, Self.Tabs, index);
end;

(*
## TScriptForm.GetTab
```pascal
function TScriptForm.GetTab(index: Int32): TTabSheet;
function TScriptForm.GetTab(caption: String; ignoreCase: Boolean = False): TTabSheet; overload;
```
Returns a tab based on index or caption.

Example:
```pascal
MyForm.AddTab('Hello wolrd');
tab := MyForm.GetTab('Hello world');
```
*)
function TScriptForm.GetTab(index: Int32): TTabSheet;
begin
  Result := Self.Tabs[index];
end;

function TScriptForm.GetTab(caption: String; ignoreCase: Boolean = False): TTabSheet; overload;
var
  i: Int32;
begin
  if ignoreCase then
  begin
    caption := LowerCase(caption);

    for i := 0 to High(Self.Tabs) do
      if LowerCase(Self.Tabs[i].getCaption()) = caption then
        Exit(Self.Tabs[i]);

    Exit;
  end;

  for i := 0 to High(Self.Tabs) do
    if Self.Tabs[i].getCaption() = caption then
      Exit(Self.Tabs[i]);
end;

(*
## TScriptForm.SetTabOrder
```pascal
procedure TScriptForm.SetTabOrder(captions: TStringArray; ignoreCase: Boolean = False); overload;
```
Changes the tab order to that of the specified **captions** in the TScriptForm.Tabs array.
Keep in mind this doesnt actually move the tabs in the Form.
*)
procedure TScriptForm.SetTabOrder(captions: TStringArray; ignoreCase: Boolean = False); overload;
var
  tmp: array of TTabSheet;
  i: Int32;
begin
  for i := 0 to High(captions) do
    tmp += Self.GetTab(captions[i], ignoreCase);

  Self.Tabs := tmp;
end;


procedure TScriptForm.OnClose({$H-}sender: TObject; var closeAction: TCloseAction);{$H+}
begin
  TerminateScript();
end;

procedure TScriptForm.OnShow(sender: TObject);
begin
  Self.Running := True;
  if not Self.LightMode then
    SetWindowDarkTitleBar(TForm(sender).getHandle());
  TForm(sender).EnsureVisible(False);
end;


(*
## TScriptForm.CreateTabs
```pascal
function TScriptForm.CreateAccountManager(owner: TControl): TPanel;
function TScriptForm.CreateAccountManager(): TTabSheet; overload;
procedure TScriptForm.ShowWorldFetcherDialog();
procedure TScriptForm.SyncAccountManager();
procedure TScriptForm.ApplyJagexAccountVisibility();
function TScriptForm.CreateAntibanManager(owner: TControl): TPanel;
function TScriptForm.CreateAntibanManager(): TTabSheet; overload;
function TScriptForm.CreateConsumableSettings(owner: TControl; consumableType: ERSConsumable; addInfo: Boolean = True): TPanel;
function TScriptForm.CreateConsumableSettings(consumableType: ERSConsumable): TTabSheet; overload;
function TScriptForm.CreateBankSettings(): TTabSheet;
function TScriptForm.CreateLimitSettings(owner: TControl): TPanel;
function TScriptForm.CreateLimitSettings(owner: TControl): TPanel;
function TScriptForm.CreateRemoteInputSettings(owner: TControl): TPanel;
function TScriptForm.CreateVideoPanel(owner: TControl): TPanel;
function TScriptForm.CreateWaspLibSettings(limits: Boolean = True): TTabSheet;
function TScriptForm.CreateVersionPanel(owner: TControl; colors: TIntegerArray = [$27BA70, $00D8FF, $0000FF]; align: TAlign = alBottom): TPanel;
```
Set of methods used to create pre-configured panels and/or tabs to interact with SRL/BashLib.
The methods that return panels require you to specify a **owner** which will be the parent of that TPanel.
Some panels might also require you to position the panel correctly as you wish. You can either align it or set coordinates.

All of this are quite complex but have all their own methods self contained and it's not worth going over them since if you understand them, you might as well just refer to their source code anyway.

Very basic example of a full TScriptForm setup:

Example:
```pascal
{$I SRL-B/osr.simba}
{$I BashLib/osr.simba}

type
  TMyScriptForm = record(TScriptForm)
    Selector: TLabeledCombobox;
    Info: TLabel;
  end;

procedure TMyScriptForm.StartScript(sender: TObject); override;
begin
  //Read your form options to setup the script here.
  inherited; //This is important if you use TScript.Setup().
end;

procedure TMyScriptForm.Run(); override;
var
  tab: TTabSheet;
begin
  Self.Setup('HELLO WORLD SCRIPT');
  Self.Start.setOnClick(@Self.StartScript); //this is important, don't forget it.

  Self.AddTab('Script Settings');
  tab := Self.Tabs[High(Self.Tabs)];

  Self.CreateAccountManager(tab);

  with Self.Selector do
  begin
    Create(tab);
    SetCaption('Item type:');
    SetLeft(TControl.AdjustToDPI(40));
    SetTop(TControl.AdjustToDPI(170));
    SetStyle(csDropDownList);
    AddItemArray(['Item1', 'Item2', 'Item3', 'Item4']);
    SetItemIndex(2);
  end;

  with Self.Info do
  begin
    Create(tab);
    SetCaption('Get 99 Hello world today!');
    SetLeft(Self.Selector.GetRight() + TControl.AdjustToDPI(40));
    SetTop(TControl.AdjustToDPI(190));
  end;

  Self.CreateVersionPanel(tab);
  Self.CreateAntibanManager();
  Self.CreateBankSettings();
  Self.CreateWaspLibSettings();

  inherited;
end;

var
  MyScriptForm: TMyScriptForm;

begin
  MyScriptForm.Run();
  //RUN SCRIPT HERE!
end.
```
*)
function TScriptForm.CreateAPISettings(): TTabSheet; deprecated 'WaspStats API has been removed.';
begin
  Result := nil;
end;

(*
## TScriptForm.ShowWorldFetcherDialog
```pascal
procedure TScriptForm.ShowWorldFetcherDialog();
```
Opens a modal dialog to fetch and filter OSRS worlds, then writes the filtered
world numbers into the Account Manager worlds memo when Apply is clicked.
*)
procedure TScriptForm.ShowWorldFetcherDialog();
  type TScriptForm = TScriptForm;

  function TScriptForm._WFGetLocationString(loc: EWorldLocation): String;
  begin
    case loc of
      EWorldLocation.GERMANY: Result := 'Germany';
      EWorldLocation.UNITED_KINGDOM: Result := 'UK';
      EWorldLocation.UNITED_STATES: Result := 'USA';
      EWorldLocation.AUSTRALIA: Result := 'Australia';
      EWorldLocation.BRAZIL: Result := 'Brazil';
      EWorldLocation.SINGAPORE: Result := 'Singapore';
      EWorldLocation.JAPAN: Result := 'Japan';
      EWorldLocation.SOUTH_AFRICA: Result := 'S. Africa';
    else
      Result := 'Unknown';
    end;
  end;

  function TScriptForm._WFGetTypeString(worldType: EWorldType): String;
  begin
    case worldType of
      EWorldType.FREE_TO_PLAY: Result := 'F2P';
      EWorldType.MEMBERS: Result := 'Members';
    else
      Result := '?';
    end;
  end;

  function TScriptForm._WFPadRight(value: String; width: Int32): String;
  begin
    Result := value;
    while Length(Result) < width do
      Result += ' ';
    if Length(Result) > width then
      Result := Copy(Result, 1, width);
  end;

  function TScriptForm._WFBuildFilterSettings(): TWorldFetcherSettings;
  var
    check: TCheckBox;
    edit: TEdit;
    excludeWorlds: TIntegerArray;
    i: Int32;
  begin
    Result := WorldFetcher.Settings;
    Result.ExcludeActivities := [];
    Result.ExcludeWorlds := [];
    Result.ExcludeLocations := [];
    Result.ExcludeTypes := [];
    Result.IncludeActivities := [];
    Result.IncludeLocations := [];
    Result.IncludeTypes := [];

    edit := Self.WorldFetcherDialog.GetChild('wf_min_players_edit');
    Result.MinPlayers := StrToIntDef(edit.getText(), 0);
    edit := Self.WorldFetcherDialog.GetChild('wf_max_players_edit');
    Result.MaxPlayers := StrToIntDef(edit.getText(), 2000);

    check := Self.WorldFetcherDialog.GetChild('wf_f2p_checkbox');
    if not check.IsChecked() then
      Result.ExcludeTypes += [EWorldType.FREE_TO_PLAY];
    check := Self.WorldFetcherDialog.GetChild('wf_members_checkbox');
    if not check.IsChecked() then
      Result.ExcludeTypes += [EWorldType.MEMBERS];

    check := Self.WorldFetcherDialog.GetChild('wf_germany_checkbox');
    if not check.IsChecked() then
      Result.ExcludeLocations += [EWorldLocation.GERMANY];
    check := Self.WorldFetcherDialog.GetChild('wf_uk_checkbox');
    if not check.IsChecked() then
      Result.ExcludeLocations += [EWorldLocation.UNITED_KINGDOM];
    check := Self.WorldFetcherDialog.GetChild('wf_us_checkbox');
    if not check.IsChecked() then
      Result.ExcludeLocations += [EWorldLocation.UNITED_STATES];
    check := Self.WorldFetcherDialog.GetChild('wf_australia_checkbox');
    if not check.IsChecked() then
      Result.ExcludeLocations += [EWorldLocation.AUSTRALIA];
    check := Self.WorldFetcherDialog.GetChild('wf_brazil_checkbox');
    if not check.IsChecked() then
      Result.ExcludeLocations += [EWorldLocation.BRAZIL];
    check := Self.WorldFetcherDialog.GetChild('wf_singapore_checkbox');
    if not check.IsChecked() then
      Result.ExcludeLocations += [EWorldLocation.SINGAPORE];
    check := Self.WorldFetcherDialog.GetChild('wf_japan_checkbox');
    if not check.IsChecked() then
      Result.ExcludeLocations += [EWorldLocation.JAPAN];
    check := Self.WorldFetcherDialog.GetChild('wf_southafrica_checkbox');
    if not check.IsChecked() then
      Result.ExcludeLocations += [EWorldLocation.SOUTH_AFRICA];

    check := Self.WorldFetcherDialog.GetChild('wf_normal_checkbox');
    if not check.IsChecked() then
      Result.ExcludeActivities += [EWorldActivity.NORMAL];
    check := Self.WorldFetcherDialog.GetChild('wf_dangerous_checkbox');
    if not check.IsChecked() then
      Result.ExcludeActivities += [EWorldActivity.DANGEROUS];
    check := Self.WorldFetcherDialog.GetChild('wf_restricted_checkbox');
    if not check.IsChecked() then
      Result.ExcludeActivities += [EWorldActivity.RESTRICTED];
    check := Self.WorldFetcherDialog.GetChild('wf_skilltotal_checkbox');
    if not check.IsChecked() then
      Result.ExcludeActivities += [EWorldActivity.SKILL_TOTAL];

    edit := Self.WorldFetcherDialog.GetChild('wf_exclude_worlds_edit');
    excludeWorlds := edit.GetIntegerArray(301, 700);
    for i := 0 to High(excludeWorlds) do
      Result.ExcludeWorlds += [excludeWorlds[i]];
  end;

  function TScriptForm._WFSelectedCount(): Int32;
  var
    i: Int32;
  begin
    Result := 0;
    for i := 0 to High(Self.WorldFetcherSelected) do
      if Self.WorldFetcherSelected[i] then
        Inc(Result);
  end;

  function TScriptForm._WFPadLeft(value: String; width: Int32): String;
  begin
    Result := value;
    while Length(Result) < width do
      Result := ' ' + Result;
    if Length(Result) > width then
      Result := Copy(Result, Length(Result) - width + 1, width);
  end;

  function TScriptForm._WFFormatActivity(activityStr: String): String;
  begin
    Result := activityStr;
    if (Result = '') or (Result = '-') then
      Result := 'Normal';
    Result := Self._WFPadRight(Result, 22);
  end;

  procedure TScriptForm._WFUpdateStats();
  var
    stats: TLabel;
  begin
    stats := Self.WorldFetcherDialog.GetChild('wf_stats_label');
    stats.setCaption(
      ToStr(Self._WFSelectedCount()) + ' selected / ' +
      ToStr(Length(Self.WorldFetcherFiltered)) + ' shown'
    );
  end;

  procedure TScriptForm._WFDisplayResults();
  var
    list: TListBox;
    i: Int32;
    worldStr, mark: String;
  begin
    list := Self.WorldFetcherDialog.GetChild('wf_world_list_listbox');
    list.Clear();

    for i := 0 to High(Self.WorldFetcherFiltered) do
    begin
      if (i <= High(Self.WorldFetcherSelected)) and Self.WorldFetcherSelected[i] then
        mark := '[x] '
      else
        mark := '[ ] ';

      worldStr :=
        mark +
        Self._WFPadRight(ToStr(Self.WorldFetcherFiltered[i].WorldNumber), 5) + '  ' +
        Self._WFPadRight(Self._WFGetLocationString(Self.WorldFetcherFiltered[i].Location), 10) + '        ' +
        Self._WFPadRight(Self._WFGetTypeString(Self.WorldFetcherFiltered[i].WorldType), 8) + '        ' +
        Self._WFFormatActivity(Self.WorldFetcherFiltered[i].ActivityString) + '        ' +
        Self._WFPadLeft(ToStr(Self.WorldFetcherFiltered[i].PlayerCount), 7);

      list.getItems().Add(worldStr);
    end;

    Self._WFUpdateStats();
  end;

  procedure TScriptForm._WFOnGenerateClick({$H-}sender: TObject);{$H+}
  var
    settings: TWorldFetcherSettings;
    stats: TLabel;
    i: Int32;
  begin
    settings := Self._WFBuildFilterSettings();
    stats := Self.WorldFetcherDialog.GetChild('wf_stats_label');

    if Length(Self.WorldFetcherAllCache) = 0 then
    begin
      stats.setCaption('Fetching worlds...');
      Self.WorldFetcherDialog.Update();

      WorldFetcher.Setup();
      WorldFetcher.Settings.ExcludeActivities := [];

      if not WorldFetcher.FetchAll() then
      begin
        stats.setCaption('Fetch failed - check your connection and try Refresh.');
        Exit;
      end;

      Self.WorldFetcherAllCache := WorldFetcher.GetFilteredWorlds();
    end;

    WorldFetcher.Worlds := Self.WorldFetcherAllCache;
    Self.WorldFetcherFiltered := WorldFetcher.FilterBySettings(settings);
    Self.WorldFetcherFiltered := WorldFetcher.SortWorlds(Self.WorldFetcherFiltered, EWorldSort.WORLD_NUMBER);

    SetLength(Self.WorldFetcherSelected, Length(Self.WorldFetcherFiltered));
    for i := 0 to High(Self.WorldFetcherSelected) do
      Self.WorldFetcherSelected[i] := True;

    Self._WFDisplayResults();
  end;

  procedure TScriptForm._WFOnFilterChange({$H-}sender: TObject);{$H+}
  begin
    if Length(Self.WorldFetcherAllCache) > 0 then
      Self._WFOnGenerateClick(sender);
  end;

  procedure TScriptForm._WFOnListClick(sender: TObject);
  var
    list: TListBox;
    idx: Int32;
  begin
    list := sender;
    idx := list.getItemIndex();
    if (idx < 0) or (idx > High(Self.WorldFetcherSelected)) then
      Exit;

    Self.WorldFetcherSelected[idx] := not Self.WorldFetcherSelected[idx];
    Self._WFDisplayResults();
    list.setItemIndex(idx);
  end;

  procedure TScriptForm._WFOnSelectAllClick({$H-}sender: TObject);{$H+}
  var
    i: Int32;
  begin
    for i := 0 to High(Self.WorldFetcherSelected) do
      Self.WorldFetcherSelected[i] := True;
    Self._WFDisplayResults();
  end;

  procedure TScriptForm._WFOnSelectNoneClick({$H-}sender: TObject);{$H+}
  var
    i: Int32;
  begin
    for i := 0 to High(Self.WorldFetcherSelected) do
      Self.WorldFetcherSelected[i] := False;
    Self._WFDisplayResults();
  end;

  procedure TScriptForm._WFOnApplyClick({$H-}sender: TObject);{$H+}
  var
    worlds: TMemo;
    stats: TLabel;
    worldsStr: String;
    picked: TIntegerArray;
    i: Int32;
  begin
    picked := [];
    for i := 0 to High(Self.WorldFetcherFiltered) do
      if (i <= High(Self.WorldFetcherSelected)) and Self.WorldFetcherSelected[i] and
         (Self.WorldFetcherFiltered[i].PlayerCount >= 0) then
        picked += Self.WorldFetcherFiltered[i].WorldNumber;

    if Length(picked) = 0 then
    begin
      stats := Self.WorldFetcherDialog.GetChild('wf_stats_label');
      stats.setCaption('Select at least one world first.');
      Exit;
    end;

    worlds := Self.Form.GetChild('am_worlds_memo');
    picked := picked.Unique();
    picked := picked.Sorted();

    worldsStr := '';
    for i := 0 to High(picked) do
    begin
      if i > 0 then
        worldsStr += ', ';
      worldsStr += ToStr(picked[i]);
    end;

    worlds.SetText(worldsStr);
    Self.WorldFetcherDialog.Close();
    Self.SyncAccountManager();
  end;

var
  root, header, typePanel, locationPanel, activityPanel, optionsPanel, footerPanel: TPanel;
  caption, sectionLabel: TLabel;
  check: TCheckBox;
  generateButton, doneButton, selectAllButton, selectNoneButton: TButton;
  minEdit, maxEdit, excludeEdit: TEdit;
  list: TListBox;
  stats: TLabel;
  dash: TLabel;
  y, checkboxY, checkboxHeight, cardTop, cardH, gap: Int32;
const
  WF_GUI_BG     = $FFFFFF;
  WF_GUI_CARD   = $F7F4F1;
  WF_GUI_ACCENT = $E0C9AE;
  WF_GUI_TEXT   = $1C1C1E;
  WF_GUI_MUTED  = $6B6B70;
  WF_GUI_W      = 960;
  WF_GUI_H      = 680;
begin
  Self.WorldFetcherAllCache := [];
  Self.WorldFetcherFiltered := [];

  with Self.WorldFetcherDialog do
  begin
    Init(nil);
    setName('world_fetcher_dialog');
    setCaption('Generate Worlds');
    setWidth(TControl.AdjustToDPI(WF_GUI_W));
    setHeight(TControl.AdjustToDPI(WF_GUI_H));
    setPosition(poScreenCenter);
    setBorderStyle(bsSizeable);
    setColor(WF_GUI_BG);
    getFont().setQuality(TFontQuality.fqAntialiased);
    getFont().setColor(WF_GUI_TEXT);
  end;

  with root do
  begin
    Create(Self.WorldFetcherDialog);
    setName('wf_root_panel');
    setCaption('');
