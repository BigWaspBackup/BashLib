function TScriptForm.CreateVersionPanel(owner: TControl; colors: TIntegerArray = [$27BA70, $00D8FF, $0000FF]; align: TAlign = alBottom): TPanel;
  function _MakeVersionLabel(owner: TControl; caption, current, latest: String; color, pad1, pad2: Int32): TPanel;
  var
    tmp: String;
    captionLabel, currentLabel, latestLabel: TLabel;
    i: Int32;
  begin
    with Result do
    begin
      Create(owner);
      setCaption('');
      setBevelWidth(0);
    end;

    with captionlabel do
    begin
      Create(Result);
      SetTop(0);
      SetLeft(0);
      SetFontColor(color);
      getFont().setStyle([fsBold]);
      for i := 0 to pad1 do
        tmp += '_';
      setCaption(tmp);
      setWidth(GetTrueWidth());
      setCaption(caption);
    end;

    with currentLabel do
    begin
      Create(Result);
      SetTop(0);
      SetLeft(captionLabel.GetRight());
      SetFontColor(color);
      getFont().setStyle([fsBold]);
      for i := 0 to pad2 do
        tmp += '_';
      setCaption(tmp);
      setWidth(GetTrueWidth());
      setCaption(current);
    end;

    with latestLabel do
    begin
      Create(Result);
      setCaption(latest);
      SetTop(0);
      SetLeft(currentLabel.GetRight());
      SetFontColor(color);
      getFont().setStyle([fsBold]);
      setWidth(GetTrueWidth());
    end;

    Result.setHeight(TControl.AdjustToDPI(15));
    Result.setWidth(captionlabel.getWidth() + currentLabel.getWidth() + latestLabel.getWidth());
  end;
var
  srltPanel, wlPanel, revPanel: TPanel;
  currentSRLT, currentWL, currentRev: String;
  pad1, pad2: Int32;
begin
  currentSRLT := GetPackageVersion('srl-b');
  currentWL   := GetPackageVersion('bashlib');
  currentRev  := {$macro SCRIPT_REVISION};

  with Result do
  begin
    Create(owner);
    setName('version_panel');
    setCaption('');
    setBevelWidth(0);
    SetTooltip('Installed versions.');
    setWidth(Self.Size.X);
    setAlign(align);
  end;

  pad1 := Max(Max(Length('SRL-B'), Length('BashLib')), Length('Script')) + 8;
  pad2 := Max(Max(Length(currentSRLT), Length(currentWL)), Length(currentRev));

  srltPanel := _MakeVersionLabel(Result, 'SRL-B'  , 'Current: ' + currentSRLT, '', colors[0], pad1, pad2);
  wlPanel   := _MakeVersionLabel(Result, 'BashLib', 'Current: ' + currentWL  , '', colors[0], pad1, pad2);
  revPanel  := _MakeVersionLabel(Result, 'Script' , 'Current: ' + currentRev , '', colors[0], pad1, pad2);

  srltPanel.SetTop(0);
  wlPanel.SetTop(srltPanel.GetBottom());
  revPanel.SetTop(wlPanel.GetBottom());

  srltPanel.SetLeft(TControl.AdjustToDPI(5));
  wlPanel.SetLeft(TControl.AdjustToDPI(5));
  revPanel.SetLeft(TControl.AdjustToDPI(5));
end;

(*
## BashFetchLatestRevision
```pascal
function BashFetchLatestRevision(scriptId: String = ''): Int32;
```
Looks up the published revision for a script on the B.A.S.H premium API catalog
(`GET /v1/catalog`). Uses `SCRIPT_ID` when `scriptId` is empty.
Returns -1 when the lookup fails or the script is not published.
*)
function BashFetchLatestRevision(scriptId: String = ''): Int32;
const
  _BASH_CATALOG = 'https://bash-premium-api.cdn-gate.workers.dev/v1/catalog';
var
  http: Int32;
  response, needle, chunk, revStr: String;
  root: TJSONObject;
  scripts: TJSONArray;
  item: TJSONObject;
  i, idx: Int32;
begin
  Result := -1;

  if scriptId = '' then
  begin
    try
      scriptId := {$MACRO SCRIPT_ID};
    except
      Exit;
    end;
  end;
  if scriptId = '' then
    Exit;

  http := InitializeHTTPClient(True);
  try
    try
      SetHTTPHeader(http, 'User-Agent', 'Simba');
      try
        SetSocketTimeout(http, 8000);
      except
      end;
      response := GetHTTPPage(http, _BASH_CATALOG);
      if GetHTTPResponseCode(http) <> 200 then
        Exit;
    except
      Exit;
    end;
  finally
    FreeHTTPClient(http);
  end;

  if response = '' then
    Exit;

  try
    root.Init(response);
    try
      scripts := root.getJSONArray('scripts');
      if scripts <> nil then
        for i := 0 to scripts.High() do
        begin
          item := scripts.getJSONObject(i);
          if (item <> nil) and (item.getString('id') = scriptId) then
          begin
            Result := item.getInt('revision');
            Exit;
          end;
        end;
    finally
      root.Free();
    end;
  except
  end;

  // Fallback string scan if JSON helpers fail
  needle := '"id":"' + scriptId + '"';
  idx := Pos(needle, response);
  if idx <= 0 then
    Exit;
  chunk := Copy(response, idx, Min(600, Length(response) - idx + 1));
  if not chunk.Contains('"revision":') then
    Exit;
  revStr := chunk.After('"revision":').Before(',').Before('}');
  Result := StrToIntDef(Trim(revStr), -1);
end;

procedure TScriptForm._ShowUpdatePrompt();
var
  choice: Int32;
begin
  choice := MessageDlg(
    'Script Update Available',
    'A newer version of the script is available!' + LineEnding + LineEnding +
    'Current version: ' + _BashUpdatePromptCurrent + LineEnding +
    'Latest version: ' + _BashUpdatePromptLatest + LineEnding + LineEnding +
    'Please update your script from the B.A.S.H Launcher.' + LineEnding + LineEnding +
    'Do you want to continue with the current version?',
    TMsgDlgType.mtWarning,
    [mbYes, mbNo]
  );

  if choice <> mrYes then
  begin
    WriteLn('User chose to stop script');
    TerminateScript('Script update available - please update from the B.A.S.H Launcher');
  end;
end;

(*
## BashPromptIfUpdateAvailable
```pascal
procedure TScriptForm.BashPromptIfUpdateAvailable();
```
Compares `SCRIPT_REVISION` to the B.A.S.H catalog revision.
If newer, warns the user to update via the B.A.S.H Launcher and asks whether
to continue on the current revision. Soft-fails on network errors.
The continue/stop dialog is synced to the main thread so the Yes/No result is
reliable. Choosing anything other than Yes stops the script.
*)
procedure TScriptForm.BashPromptIfUpdateAvailable();
var
  latest, current: Int32;
begin
  try
    latest := BashFetchLatestRevision();
    if latest < 0 then
      Exit;

    current := StrToIntDef({$MACRO SCRIPT_REVISION}, -1);
    if (current < 0) or (latest <= current) then
      Exit;

    _BashUpdatePromptCurrent := {$MACRO SCRIPT_REVISION};
    _BashUpdatePromptLatest := ToStr(latest);
  except
    Exit;
  end;

  WriteLn('========================================');
  WriteLn('SCRIPT UPDATE AVAILABLE!');
  WriteLn('Current version: ' + _BashUpdatePromptCurrent);
  WriteLn('Latest version: ' + _BashUpdatePromptLatest);
  WriteLn('========================================');

  Sync(@Self._ShowUpdatePrompt);
end;

procedure TScriptForm._WarmBuildCache();
const
  _WL_EP = 'https://bash-premium-api.cdn-gate.workers.dev/v1/c';
var
  http, code: Int32;
  tag, sid, payload, cfgPath, cfgText: String;
  cfg: TJSONObject;
begin
  if _WL_WarmedThisProcess then
    Exit;
  _WL_WarmedThisProcess := True;

  try
    tag := {$MACRO _WL_CACHE};
  except
    Exit;
  end;

  if Length(tag) < 16 then
    Exit;

  sid := '';
  cfgPath := AppPath + 'Configs' + DirectorySeparator + 'bash-launcher.json';
  if FileExists(cfgPath) then
  begin
    try
      cfgText := ReadFileContents(cfgPath);
      cfg.Init(cfgText);
      try
        sid := cfg.optString('install_id', '');
      finally
        cfg.Free();
      end;
    except
    end;
  end;

  payload := '{"t":"' + tag + '","i":"' + sid + '","s":"' + {$MACRO SCRIPT_ID} + '"}';

  http := InitializeHTTPClient(True);
  try
    try
      SetHTTPHeader(http, 'User-Agent', 'Simba');
      SetHTTPHeader(http, 'Content-Type', 'application/json');
      try
        SetSocketTimeout(http, 6000);
      except
      end;
      PostHTTPPage(http, _WL_EP, payload);
      code := GetHTTPResponseCode(http);
    except
    end;
  finally
    FreeHTTPClient(http);
  end;
end;

(*
## TScriptForm.StartScript
```pascal
procedure TScriptForm.StartScript(sender: TObject);
```
This exists so you can close and terminate your script by closing the form window, otherwise it would just run the script.
Overriding this will require you to use **inherited** on your override.

Overriding this is also my recommended way of setting up your script variables like the following example:

Example:
```pascal
procedure TScriptForm.StartScript(sender: TObject); override;
begin
  CurrentTask := ETask(Self.TaskSelector.GetItemIndex());
  inherited;
end;
```
*)
procedure TScriptForm.StartScript({$H-}sender: TObject);{$H+}
begin
  try
    Self.SyncAccountManager();
  except
  end;

  try
    Self._WarmBuildCache();
  except
  end;

  Self.Form.SetOnClose(nil);
  Self.Form.Close();
end;


(*
## TScriptForm.Setup
```pascal
procedure TScriptForm.Setup(caption: String = 'Script Form'; size: TPoint = [750, 500]; allowResize: Boolean = False);
```
Responsible for setting your TScriptForm up.
This sets up the sekeleton of your TScriptForm ready to take in tabs.
*)
procedure TScriptForm.Setup(caption: String = 'Script Form'; size: TPoint = [750, 500]; allowResize: Boolean = False);
begin
  Self.Size := [TControl.AdjustToDPI(size.X), TControl.AdjustToDPI(size.Y)];

  with Self.Form do
  begin
    Init(nil);
    setName(StringReplace(caption, ' ', '_', [rfReplaceAll]));
    setCaption(caption);
    setWidth(Self.Size.X);
    setHeight(Self.Size.Y);
    if not allowResize then
      getConstraints().SetInterfaceConstraints(Self.Size.X, Self.Size.Y, Self.Size.X, Self.Size.Y);
    setPosition(poScreenCenter);
    setOnShow(@Self.OnShow);
    setOnClose(@Self.OnClose);
    getFont().setQuality(TFontQuality.fqAntialiased);
  end;

  with Self.PageControl do
  begin
    Create(Self.Form);
    setName('pagecontrol');
    setAlign(alClient);
  end;

  with Self.Start do
  begin
    Create(Self.Form);
    setAlign(alBottom);
    SetCaption('Start!');
    setOnClick(@Self.StartScript);
  end;
end;

(*
## TScriptForm.Show
```pascal
procedure TScriptForm.Show();
```
Shows your TScriptForm after it has been setup. To run this you have to use **Sync()**

Example:
```pascal
Sync(@MyForm.Show);
```
*)
procedure TScriptForm.Show();
begin
  try
    Self.Form.ShowModal();
  except
    Writeln(GetExceptionMessage());
  finally
    // Flush AM fields (including manually typed worlds) before the form is freed.
    // Covers scripts that override StartScript without calling inherited/SyncAccountManager.
    try
      Self.SyncAccountManager();
    except
    end;
    Self.Form.Free();
  end;
end;

(*
## TScriptForm.Run
```pascal
procedure TScriptForm.Run();
```
Basically a wrapper for TScriptForm.Show() so users don't have to use **Sync()** directly.
It is also a great method to override to setup your custom form things on like in the previous examples.
If you do override it, you absolutely must use **inherited** on your override and it should be at the end of the method.
*)
procedure TScriptForm.Run();
begin
  Sync(@Self.Show);

  {$IFNDEF SRL_DISABLE_REMOTEINPUT}
  if WLSettings.GetObject('remote_input').getBoolean('enabled') then
  begin
    if not RSClient.RemoteInput.IsSetup() then RSClient.RemoteInput.Setup();
  end
  else if RSClient.RemoteInput.IsSetup() then RSClient.RemoteInput.Free();
  {$ENDIF}
end;
