(*
# WorldHopper

Made by @Yolandi, modified by @Torwent.

World hopper is resposible for hopping worlds with the logged in world hopper in the logout tab.
*)
{$DEFINE YOLANDI_WORLDHOPPER_INCLUDED}
{$IFNDEF WL_OSR}
  {$I BashLib/osr.simba}
{$ENDIF}

type
(*
## type TRSWorldHopper
```pascal
type
  TRSWorldHopper = record(TRSInterface)
    SILVER, YELLOW: Int32;
    ServerMessageBox: TBox;
    Cooldown: TCountDown;
    TimedHopEnabled: Boolean;
    TimedHopInterval: Int32;
    TimedHopVariation: Int32;
    NextTimedHopTime: UInt64;
    LastTimedHopTime: UInt64;
    TimedHopsCompleted: Int32;
  end;
```
WorldHopper record. Timed hop fields are used by **SetupTimedHopping** / **DoTimedHop**.
Call **TryHopOnBreak** from `TBaseScript.DoAntiban` when both break and sleep checks are allowed.
*)
  TRSWorldHopper = record(TRSInterface)
    SILVER, YELLOW: Int32;
    ServerMessageBox: TBox;
    Cooldown: TCountDown;
    TimedHopEnabled: Boolean;
    TimedHopInterval: Int32;
    TimedHopVariation: Int32;
    NextTimedHopTime: UInt64;
    LastTimedHopTime: UInt64;
    TimedHopsCompleted: Int32;
    JustHopped: Boolean;
  end;

(*
## TRSWorldHopper.Setup
```pascal
procedure TRSWorldHopper.Setup(); override;
```
Internal method used to setup the WorldHopper.
*)
procedure TRSWorldHopper.Setup(); override;
begin
  inherited;

  Self.Name := 'WorldHopper';
  Self.SILVER := $E0E0E0;
  Self.YELLOW := $00F0F0;

  Self.Cooldown.Setup(8000);
  Self.TimedHopInterval := 45;
  Self.TimedHopVariation := 10;
end;

procedure TRSWorldHopper.SetupAlignment(); overload;
var
  alignment: TRSInterfaceAlignment;
begin
  alignment.Left := GameTab.Bounds.X1 - 3;
  alignment.Right := GameTab.Bounds.X2 + 3;
  alignment.Top := GameTab.Bounds.Y1;
  alignment.Bottom := GameTab.Bounds.Y2;

  Self.SetupAlignment(alignment);

  Self.ServerMessageBox.X1 := MainScreen.Bounds.X1 + 4;
  Self.ServerMessageBox.Y1 := MainScreen.Bounds.Y1 + 4;
  Self.ServerMessageBox.X2 := Self.ServerMessageBox.X1 + 79;
  Self.ServerMessageBox.Y2 := Self.ServerMessageBox.Y1 + 20;

  Self.ScrollArea := Self.Bounds;
  Self.ScrollArea.Y1 += 35;
  Self.ScrollArea.Y2 -= 32;
end;

(*
## TRSWorldHopper.Scroll
```pascal
procedure TRSWorldHopper.Scroll(down: Boolean);
```
Scroll one page up or down of the world hopper.

Example:
```pascal
TRSWorldHopper.Scroll(True);
```
*)
procedure TRSWorldHopper.Scroll(down: Boolean; forceMove: Boolean = True);
var
  scrollBar: TRSScrollBar;
begin
  scrollBar := Self.GetScrollBar();
  if not scrollBar.IsVisible() or not Self.CanScroll() then
    Exit;

  {$IFNDEF SRL_DISABLE_REMOTEINPUT}
  if not WLSettings.GetObject('remote_input').getBoolean('block_real_input') then
    RSClient.RemoteInput.DisableRealInput();
  {$ENDIF}

  Mouse.Scroll(Self.GetScrollArea(scrollBar), Random(1, 3), down, forceMove);

  {$IFNDEF SRL_DISABLE_REMOTEINPUT}
  if not WLSettings.GetObject('remote_input').getBoolean('block_real_input') then
    RSClient.RemoteInput.EnableRealInput();
  {$ENDIF}
end;

(*
## TRSWorldHopper.ClickWorld
```pascal
procedure TRSWorldHopper.ClickWorld(ocrBounds: TBox);
```
Click a world in the world hopper.

Example:
```pascal
TRSWorldHopper.ReadWorlds(ocrBounds);
TRSWorldHopper.ClickWorld(ocrBounds[0]);
```
*)
procedure TRSWorldHopper.ClickWorld(ocrBounds: TBox);
begin
  ocrBounds.X1 := Self.Bounds.X1;
  ocrBounds.X2 := Self.Bounds.X2 - 16;
  Mouse.Click(ocrBounds, MOUSE_LEFT);
end;

(*
## TRSWorldHopper.GetCurrentWorld
```pascal
function TRSWorldHopper.GetCurrentWorld(): Int32;
```
Returns the current world we are on.

Example:
```pascal
WriteLn TRSWorldHopper.GetCurrentWorld();
```
*)
function TRSWorldHopper.GetCurrentWorld(): Int32;
var
  b: TBox;
begin
  b := Self.Bounds;
  b.Y2 := b.Y1 + 24;
  Result := OCR.RecognizeNumber(b, TOCRColorFilter.Create([$1F98FF]), RS_FONT_BOLD_12);
end;

(*
## TRSWorldHopper.ReadWorlds
```pascal
function TRSWorldHopper.ReadWorlds(out boxes: TBoxArray): TIntegerArray;
function TRSWorldHopper.ReadWorlds(): TIntegerArray;  overload;
```
Returns currently visible worlds.

Example:
```pascal
WriteLn TRSWorldHopper.ReadWorlds();
```
*)
function TRSWorldHopper.ReadWorlds(out boxes: TBoxArray): TIntegerArray;
var
  tpa: TPointArray;
  i, value, x2: Int32;
  tmp: TBoxArray;
begin
  boxes := [];
  if SRL.FindColors(tpa, [Self.SILVER, Self.YELLOW], Self.ScrollArea) = 0 then
    Exit;

  tmp := tpa.Cluster(5, 1).ToTBA();
  tmp.SortByY();

  x2 := Self.Bounds.X2 - 17;

  for i := 0 to High(tmp) do
  begin
    value := OCR.RecognizeNumber(
      tmp[i],
      TOCRColorFilter.Create([Self.SILVER, Self.YELLOW]),
      RS_FONT_PLAIN_12
    );

    if value = 0 then
      Continue;

    Result += value;
    tmp[i].X1 := Self.Bounds.X1;
    tmp[i].Y1 -= 1;
    tmp[i].X2 := x2;
    tmp[i].Y2 += 3;
    boxes += tmp[i];
  end;
end;

function TRSWorldHopper.ReadWorlds(): TIntegerArray;  overload;
var
  boxes: TBoxArray;
begin
  Result := Self.ReadWorlds(boxes);
end;


function TRSWorldHopper.SortWorlds(): Boolean;
var
  Arrow : TPointArray;
  Attempt : Int32;
  T : TCountdown;
begin
  if not Logout.IsWorldSwitcherOpen() then
    Exit;

  for Attempt := 0 to 3 do
  begin
    T.Init(250);
    repeat
      if SRL.FindColors(Arrow, CTS1(421059, 7), Self.Bounds) = 0 then
        Continue;

      if (Arrow.Mean() - Point(Self.Bounds.X1, Self.Bounds.Y1)) = Point(29, 30) then
        Exit(True);
    until T.IsFinished();

    Mouse.Click(Box(17, 25, 40, 34).Offset(Point(Self.Bounds.X1, Self.Bounds.Y1)), MOUSE_LEFT);
  end;
end;

(*
## TRSWorldHopper.WaitForHop
```pascal
function TRSWorldHopper.WaitForHop(world: Int32; ocrBounds: TBox; coolDownOnFail: Boolean=True): Boolean;
```
Exits false if "Please wait" not found, presumably due to combat.
*)
function TRSWorldHopper.WaitForHop(world: Int32; coolDownOnFail: Boolean = True): Boolean;
var
  filter: TOCRColorFilter;
begin
  Self.DebugLn("Hopping to " + ToStr(world) + "...");

  filter := TOCRColorFilter.Create([$FFFFFF]);
  if not WaitUntil(OCR.LocateText(Self.ServerMessageBox, 'Please wait', RS_FONT_PLAIN_12, filter, 1), 100, 2000) then
  begin
    Self.DebugLn('Hop failed: ' + Chat.GetMessage(7));

    if coolDownOnFail then
    begin
      Self.Cooldown.Restart(0, 7000);
      Self.DebugLn('Hop will be ready in ' + ToStr(Self.Cooldown.Length) + 'ms.');
    end;
    Exit;
  end;

  Result := WaitUntil(Self.GetCurrentWorld() = world, 200, 10000);

  if not Result then Self.DebugLn("Timed out");
end;

(*
## TRSWorldHopper.FilterValidWorlds
```pascal
function TRSWorldHopper.FilterValidWorlds(targetWorlds: TIntegerArray): TIntegerArray;
```
Returns `targetWorlds` with any worlds that are no longer on Jagex's live
server list removed. Uses the same source as Account Manager **Generate Worlds**.
*)
function TRSWorldHopper.FilterValidWorlds(targetWorlds: TIntegerArray): TIntegerArray;
var
  skipped: TIntegerArray;
  i: Int32;
begin
  Result := WorldFetcher.FilterExistingWorlds(targetWorlds);
  if Length(Result) = Length(targetWorlds) then
    Exit;

  skipped := [];
  for i := 0 to High(targetWorlds) do
    if not Result.Contains(targetWorlds[i]) then
      skipped += targetWorlds[i];

  if Length(skipped) > 0 then
    Self.DebugLn('Skipping worlds not on the live world list: ' + ToStr(skipped));
end;

(*
## TRSWorldHopper.Hop
```pascal
function TRSWorldHopper.Hop(targetWorlds: TIntegerArray): Boolean;
```
Hops to a different world from the specified **targetWorlds**.
Worlds that are not on the live official server list are skipped, so a stale
account-manager worlds list will not try to hop to a removed world.

Example:
```pascal
WriteLn TRSWorldHopper.Hop([303, 304, 305]);
```
*)
function TRSWorldHopper.Hop(targetWorlds: TIntegerArray; doSorting: Boolean = True): Boolean;
var
  visible: TIntegerArray;
  boxes: TBoxArray;
  current, next, i: Int32;
  timeOut: TCountDown;
  moveMouse: Boolean;
begin
  if not Self.Cooldown.IsFinished() then Exit;

  targetWorlds := Self.FilterValidWorlds(targetWorlds);
  if targetWorlds.Len() = 0 then
  begin
    Self.DebugLn('No valid worlds to hop to');
    Exit;
  end;

  if Chat.HasContinue() then
  begin
    Self.DebugLn('Closing continue dialog before hopping');
    Chat.ClickContinue();
    WaitUntil(not Chat.HasContinue(), 50, 2500);
  end;

  if not Logout.Open() then
  begin
    if Chat.HasContinue() then
    begin
      Self.DebugLn('Continue dialog blocked logout, closing it');
      Chat.ClickContinue();
      if not WaitUntil(not Chat.HasContinue(), 50, 2500) then
        Exit;
      if not Logout.Open() then
        Exit;
    end
    else
      Exit;
  end;

  if not Logout.IsWorldSwitcherOpen() then
    Logout.GetButton(ERSLogoutButton.WORLD_SWITCHER).Click(MOUSE_LEFT);
  WaitUntil((current := Self.GetCurrentWorld()) <> 0, 200, 12000);

  if doSorting and not Self.SortWorlds() then Exit;
  Self.DebugLn('Current world: ' + ToStr(current));
  WriteLn('[WORLDHOP] Hopper current world: ', current);

  if (targetWorlds.Len() = 1) and (current = targetWorlds[0]) then
    Exit(True);

  i := targetWorlds.Find(current);
  if i = High(targetWorlds) then
    i := -1;

  next := targetWorlds[i+1];
  Self.DebugLn('Next world: ' + ToStr(next));
  WriteLn('[WORLDHOP] Searching hopper for world ', next);

  timeOut.Init(12000);
  moveMouse := True;

  repeat
    visible := Self.ReadWorlds(boxes);

    i := visible.Find(next);
    if i > -1 then
    begin
      WriteLn('[WORLDHOP] Clicking hopper OCR=', visible[i], ' from visible ', ToStr(visible));
      Mouse.Click(boxes[i], MOUSE_LEFT, True);
      Exit(Self.WaitForHop(next))
    end;

    Self.Scroll(visible.Min() < next, moveMouse);
    moveMouse := False;
  until timeOut.IsFinished();

  Self.DebugLn('Timed out (timeOut=' + ToStr(timeOut) + 'ms)');
  WriteLn('[WORLDHOP] Could not find world ', next, ' in hopper. Last OCR worlds: ', ToStr(visible));
  targetWorlds.Remove(next);
end;

(*
## TRSWorldHopper.SetupTimedHopping
```pascal
procedure TRSWorldHopper.SetupTimedHopping(enabled: Boolean; intervalMinutes: Int32 = 45; variationPercent: Int32 = 10);
```
Timer-based world hopping for the Antiban GUI. Call once after login, then
**TryHopOnBreak** from `TBaseScript.DoAntiban` so hops only fire at the same
safe points as breaks and sleeps.

Needs at least 2 worlds on the account. Interval is minutes. Variance is the percent each hop can land early or late.

Example:
```pascal
Self.HasWorldHopping := True; // default in TBASHPremiumGUI.InitGUI
WorldHopper.SetupTimedHopping(ENABLEWORLDHOPPING, WORLDHOPINTERVAL, WORLDHOPVARIATION);

procedure TMyScript.DoAntiban(checkBreaks, checkSleeps: Boolean); override;
begin
  WorldHopper.TryHopOnBreak(checkBreaks, checkSleeps);
  inherited;
end;
```
*)
function TRSWorldHopper.GetRandomTimedHopDelay(): UInt64;
var
  baseInterval: UInt64;
  variation: Int32;
begin
  if Self.TimedHopInterval < 1 then
    Self.TimedHopInterval := 45;

  variation := Self.TimedHopVariation;
  if variation < 0 then
    variation := 10;

  baseInterval := UInt64(Self.TimedHopInterval) * ONE_MINUTE;
  Result := baseInterval + Round(baseInterval * (Random(-variation, variation) / 100.0));
  if Result < ONE_MINUTE then
    Result := ONE_MINUTE;
end;

procedure TRSWorldHopper.ScheduleNextTimedHop();
begin
  Self.NextTimedHopTime := GetTickCount() + Self.GetRandomTimedHopDelay();
end;

procedure TRSWorldHopper.ScheduleTimedHopRetry();
begin
  Self.NextTimedHopTime := GetTickCount() + (2 * ONE_MINUTE);
end;

function TRSWorldHopper.GetTimedHopRange(): String;
var
  variation, minTime, maxTime: Int32;
begin
  variation := Self.TimedHopVariation;
  if variation <= 0 then
    variation := 10;
  minTime := Round(Self.TimedHopInterval * (100 - variation) / 100.0);
  maxTime := Round(Self.TimedHopInterval * (100 + variation) / 100.0);
  Result := IntToStr(minTime) + '-' + IntToStr(maxTime) + ' min';
end;

function TRSWorldHopper.TimeUntilTimedHop(): String;
begin
  if (not Self.TimedHopEnabled) or (Self.NextTimedHopTime = 0) then
    Exit('disabled');
  if GetTickCount() >= Self.NextTimedHopTime then
    Exit('ready');
  Result := SRL.MsToTime(Self.NextTimedHopTime - GetTickCount(), Time_Short);
end;

procedure TRSWorldHopper.SetupTimedHopping(enabled: Boolean; intervalMinutes: Int32 = 45; variationPercent: Int32 = 10);
begin
  Self.TimedHopEnabled := enabled;
  Self.TimedHopInterval := intervalMinutes;
  Self.TimedHopVariation := variationPercent;
  Self.TimedHopsCompleted := 0;
  Self.LastTimedHopTime := 0;
  Self.NextTimedHopTime := 0;

  WriteLn('[WORLDHOP] Setting up world hopping...');
  if not Self.TimedHopEnabled then
  begin
    WriteLn('[WORLDHOP] World hopping is disabled');
    Exit;
  end;

  if Length(Login.GetPlayer().Worlds) < 2 then
  begin
    WriteLn('[WORLDHOP] Need at least 2 worlds in player setup or disable world hopping');
    Logout.ClickLogout();
    TerminateScript('Configure at least 2 worlds or disable world hopping.');
  end;

  Self.ScheduleNextTimedHop();
  WriteLn('[WORLDHOP] Account: ', Login.GetPlayer().User);
  WriteLn('[WORLDHOP] Configured worlds: ', ToStr(Login.GetPlayer().Worlds));
  WriteLn('[WORLDHOP] Enabled. Next hop in: ' + Self.TimeUntilTimedHop());
end;

function TRSWorldHopper.ShouldTimedHop(): Boolean;
begin
  Result := Self.TimedHopEnabled and (Self.NextTimedHopTime > 0) and
            (GetTickCount() >= Self.NextTimedHopTime);
end;

procedure TRSWorldHopper.CloseInterfacesForHop();
begin
  if DepositBox.IsOpen() then
    DepositBox.Close();
  if Bank.IsOpen() then
    Bank.Close();
end;

function TRSWorldHopper.HopToRandomPlayerWorld(): Boolean;
var
  currentWorld, targetWorld, landedWorld, i: Int32;
  configuredWorlds, playerWorlds, availableWorlds, skippedWorlds: TIntegerArray;
begin
  Result := False;
  Self.CloseInterfacesForHop();

  configuredWorlds := Login.GetPlayer().Worlds;
  WriteLn('[WORLDHOP] Account: ', Login.GetPlayer().User);
  WriteLn('[WORLDHOP] Configured worlds: ', ToStr(configuredWorlds));

  playerWorlds := Self.FilterValidWorlds(configuredWorlds);
  if Length(playerWorlds) <> Length(configuredWorlds) then
  begin
    skippedWorlds := [];
    for i := 0 to High(configuredWorlds) do
      if not playerWorlds.Contains(configuredWorlds[i]) then
        skippedWorlds += configuredWorlds[i];
    WriteLn('[WORLDHOP] Removed worlds not on live list: ', ToStr(skippedWorlds));
  end;
  WriteLn('[WORLDHOP] Valid hop worlds: ', ToStr(playerWorlds));

  if Length(playerWorlds) = 0 then
  begin
    WriteLn('[WORLDHOP] No valid player worlds to hop to');
    Exit;
  end;

  if not Logout.Open() then
  begin
    WriteLn('[WORLDHOP] Failed to open logout menu');
    Exit;
  end;

  if not Logout.IsWorldSwitcherOpen() then
    Logout.GetButton(ERSLogoutButton.WORLD_SWITCHER).Click(MOUSE_LEFT);
  WaitUntil((currentWorld := Self.GetCurrentWorld()) <> 0, 200, 12000);
  WriteLn('[WORLDHOP] Current world: ', currentWorld);

  availableWorlds := [];
  for i := 0 to High(playerWorlds) do
    if playerWorlds[i] <> currentWorld then
      availableWorlds += playerWorlds[i];

  WriteLn('[WORLDHOP] Candidates (excluding current): ', ToStr(availableWorlds));
  if Length(availableWorlds) = 0 then
  begin
    WriteLn('[WORLDHOP] No other worlds available');
    Exit;
  end;

  targetWorld := availableWorlds[Random(Length(availableWorlds))];
  WriteLn('[WORLDHOP] Chosen world: ', targetWorld);
  if not configuredWorlds.Contains(targetWorld) then
    WriteLn('[WORLDHOP] WARNING: Chosen world ', targetWorld, ' is not in the account worlds list');

  Result := Self.Hop([targetWorld]);
  landedWorld := Self.GetCurrentWorld();
  if Result then
  begin
    WriteLn('[WORLDHOP] Hopped to world ', landedWorld, ' (requested ', targetWorld, ')');
    if (landedWorld <> 0) and (landedWorld <> targetWorld) then
      WriteLn('[WORLDHOP] WARNING: landed on ', landedWorld, ' instead of requested ', targetWorld);
  end
  else
  begin
    WriteLn('[WORLDHOP] Hop to ', targetWorld, ' failed. Current world is now ', landedWorld);
    if (landedWorld <> 0) and (not configuredWorlds.Contains(landedWorld)) then
      WriteLn('[WORLDHOP] WARNING: current world ', landedWorld, ' is not in the account worlds list');
  end;
end;

function TRSWorldHopper.DoTimedHop(): Boolean;
begin
  Result := False;
  Self.JustHopped := False;
  if not Self.TimedHopEnabled then
    Exit;

  WriteLn('[WORLDHOP] Time to hop worlds');
  Result := Self.HopToRandomPlayerWorld();
  if Result then
  begin
    Inc(Self.TimedHopsCompleted);
    Self.LastTimedHopTime := GetTickCount();
    Self.JustHopped := True;
    Self.ScheduleNextTimedHop();
    WL.Activity.Restart();
    WriteLn('[WORLDHOP] Next hop in: ' + Self.TimeUntilTimedHop());
  end
  else
  begin
    if Length(Self.FilterValidWorlds(Login.GetPlayer().Worlds)) < 2 then
    begin
      WriteLn('[WORLDHOP] No other worlds available, disabling world hopping');
      Self.TimedHopEnabled := False;
      Exit;
    end;

    Self.ScheduleTimedHopRetry();
    WriteLn('[WORLDHOP] Retry in 2 minutes');
  end;
end;

function TRSWorldHopper.TryTimedHop(): Boolean;
begin
  if not Self.ShouldTimedHop() then
    Exit(False);
  Result := Self.DoTimedHop();
end;

(*
## TRSWorldHopper.TryHopOnBreak
```pascal
function TRSWorldHopper.TryHopOnBreak(checkBreaks, checkSleeps: Boolean): Boolean;
```
Hops when the timed hop is due **and** `DoAntiban` is allowing both breaks and
sleeps (`DoAntiban(True, True)`). Call from a `DoAntiban` override before
`inherited`. Combat / mid-action `DoAntiban(True, False)` skips the hop.
*)
function TRSWorldHopper.TryHopOnBreak(checkBreaks, checkSleeps: Boolean): Boolean;
begin
  Self.JustHopped := False;
  if not (checkBreaks and checkSleeps) then
    Exit(False);
  Result := Self.TryTimedHop();
end;

var
  WorldHopper: TRSWorldHopper;

procedure TRSClient.ClientModeChanged(); override;
begin
  inherited;
  WorldHopper.SetupAlignment();
end;

procedure TSRL.Setup(); override;
begin
  inherited;
  WorldHopper.Setup();
end;

procedure TSRL.Debug(bitmap: TMufasaBitmap); override;
begin
  inherited;
  WorldHopper.Draw(bitmap);
end;
