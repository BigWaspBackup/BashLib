{$DEFINE WL_RANDOM_EVENTS_INCLUDED}
{$IFNDEF WL_OSR}
  {$I BashLib/osr.simba}
{$ENDIF}

{$SCOPEDENUMS ON}

(*
  OSRS random events are scheduled on real-world time, 1 to 2 hours after the
  last event. The countdown keeps running while logged out, so the last-event
  timestamp is persisted and scans are gated to that window.
*)
const
  GENIE_PANTS_COLOR: TCTS2Color = [9311880, 6, 0.05, 0.66];   // CTS2(9311880, 6, 0.05, 0.66)
  GENIE_BODY_COLOR: TCTS2Color = [14189363, 23, 0.08, 1.26];  // CTS2(14189363, 23, 0.08, 1.26)
  GENIE_PAIR_DIST = 20;
  GENIE_CLUSTER_DISTANCE = 8;
  RANDOM_EVENT_MIN_SEC = 60 * 60;
  RANDOM_EVENT_MAX_SEC = 120 * 60;
  RANDOM_EVENT_EARLY_SCAN_MS = 60 * 1000;
  GENIE_MAX_TRIES = 3;
  GENIE_GONE_MS = 10 * 1000;
  GENIE_OTHER_PLAYER_REASON =
    'This Genie belongs to another player. Random events have been disabled. ' +
    'Use the BASH profile, or enable Entity Hider with Hide others random events.';
  BASH_RANDOM_EVENT_MODES: TStringArray = ['Ignore', 'Interact'];
  BASH_LAMP_SKILL_KEYS: TStringArray = [
    'agility', 'attack', 'construction', 'cooking', 'crafting',
    'defence', 'farming', 'firemaking', 'fishing', 'fletching',
    'herblore', 'hitpoints', 'hunter', 'magic', 'mining',
    'prayer', 'range', 'runecrafting', 'sailing', 'slayer',
    'smithing', 'strength', 'theiving', 'woodcutting'
  ];
  BASH_LAMP_SKILL_LABELS: TStringArray = [
    'Agility', 'Attack', 'Construction', 'Cooking', 'Crafting',
    'Defence', 'Farming', 'Firemaking', 'Fishing', 'Fletching',
    'Herblore', 'Hitpoints', 'Hunter', 'Magic', 'Mining',
    'Prayer', 'Range', 'Runecrafting', 'Sailing', 'Slayer',
    'Smithing', 'Strength', 'Thieving', 'Woodcutting'
  ];

type
  ERandomEventMode = (OFF, DISMISS, INTERACT);

  TRSRandomEvents = record(TSRLBaseRecord)
    Mode: ERandomEventMode;
    SupportGenie: Boolean;
    Skill: ERSLampSkill;
    Genie: TRSNPC;
    LastEventUnix: Int64;
    NextEarlyScan: UInt64;
    GenieTries: Int32;
    IgnoreGenie: Boolean;
    LastGenieSeen: UInt64;
  end;

function ERSLampSkill.ToKey(): String; constref;
var
  key: String;
begin
  key := ToString(Self).Lower();
  if '.' in key then
    key := key.After('.');
  Result := key;
end;

function ERSLampSkill.FromKey(value: String): ERSLampSkill; static;
var
  i: Int32;
  key: String;
begin
  value := value.Lower().Replace('thieving', 'theiving');
  for i := 0 to Ord(High(ERSLampSkill)) do
  begin
    key := ERSLampSkill(i).ToKey();
    if value = key then
      Exit(ERSLampSkill(i));
  end;

  Result := ERSLampSkill.WOODCUTTING;
end;

procedure TRSRandomEvents.SetupGenie();
begin
  with Self.Genie do
  begin
    Filter.Skip := False;
    SetupUpText(['Genie']);
    Filter.Walker := False;
    Filter.MinimapDot := False;
    Filter.Finder := True;
    Filter.UpText := True;
    Finder := [];
    Finder.ColorClusters += [
      GENIE_BODY_COLOR,
      GENIE_PANTS_COLOR,
      GENIE_PAIR_DIST
    ];
    Finder.ClusterDistance := GENIE_CLUSTER_DISTANCE;
  end;
end;

procedure TRSRandomEvents.EnableGenie();
begin
  Self.SupportGenie := True;
end;

function TRSRandomEvents.GetConfig(): TJSONObject;
begin
  Result := WLSettings.GetObject('antiban').getJSONObject('random_events');
end;

function TRSRandomEvents.SkillIndexFromKey(skillKey: String): Int32;
var
  i: Int32;
begin
  skillKey := skillKey.Lower().Replace('thieving', 'theiving');
  Result := High(BASH_LAMP_SKILL_KEYS);
  for i := 0 to High(BASH_LAMP_SKILL_KEYS) do
  begin
    if BASH_LAMP_SKILL_KEYS[i] = 'woodcutting' then
      Result := i;
    if BASH_LAMP_SKILL_KEYS[i] = skillKey then
      Exit(i);
  end;
end;

procedure TRSRandomEvents.LoadSettings();
var
  json: TJSONObject;
  mode, action: String;
begin
  if not Self.SupportGenie then
  begin
    Self.Mode := ERandomEventMode.OFF;
    Exit;
  end;

  json := Self.GetConfig();
  Self.Mode := ERandomEventMode.OFF;

  if json.has('genie') then
  begin
    if json.getBoolean('genie') then
    begin
      action := 'ignore';
      if json.has('genie_action') then
        action := json.getString('genie_action').Lower();
      if action = 'interact' then
        Self.Mode := ERandomEventMode.INTERACT;
    end;
  end
  else
  begin
    mode := json.getString('mode').Lower();
    if mode = 'interact' then
      Self.Mode := ERandomEventMode.INTERACT;
  end;

  Self.Skill := ERSLampSkill.FromKey(json.getString('skill'));
  LampHandler.Skill := Self.Skill;

  Self.LastEventUnix := 0;
  if json.has('last_event_unix') then
    Self.LastEventUnix := json.getInt('last_event_unix');
end;

function TRSRandomEvents.SecondsSinceLastEvent(): Int64;
begin
  if Self.LastEventUnix <= 0 then
    Exit(RANDOM_EVENT_MAX_SEC);

  Result := UnixTime() - Self.LastEventUnix;
  if Result < 0 then
    Result := RANDOM_EVENT_MAX_SEC;
end;

function TRSRandomEvents.InSpawnWindow(): Boolean;
begin
  Result := Self.SecondsSinceLastEvent() >= RANDOM_EVENT_MIN_SEC;
end;

function TRSRandomEvents.ShouldScan(): Boolean;
begin
  if Self.InSpawnWindow() then
    Exit(True);

  if GetTickCount() < Self.NextEarlyScan then
    Exit(False);

  Self.NextEarlyScan := GetTickCount() + RANDOM_EVENT_EARLY_SCAN_MS;
  Result := True;
end;

procedure TRSRandomEvents.MarkEventHandled();
var
  json: TJSONObject;
begin
  Self.LastEventUnix := UnixTime();
  Self.NextEarlyScan := GetTickCount() + RANDOM_EVENT_EARLY_SCAN_MS;
  json := Self.GetConfig();
  json.Put('last_event_unix', Int32(Self.LastEventUnix));
  WLSettings.SaveConfig();
  Self.DebugLn('Random event handled. Next spawn window in 1-2 hours');
end;

procedure TRSRandomEvents.DebugRandom();
var
  number: Int32;
begin
  if not Antiban.DebugRandoms then
    Exit;

  CreateDirectory('randoms');
  number := Length(GetFiles('randoms/', 'png'));
  if number > 1000 then
    TerminateScript('Lots of randoms debugged');

  SaveScreenshot('randoms/' + IntToStr(number) + '.png');
end;

function TRSRandomEvents.DismissByName(): Boolean;
var
  name: String;
  foundBox: TBox;
  p: TPoint;
begin
  name := Chat.GetDisplayName();
  if name = '' then
    Exit(False);

  if OCR.LocateText(Box(MainScreen.Center, 250, 100), name, RS_FONT_BOLD_12, TOCRColorFilter.Create([$00FFFF, 0]), foundBox) < 1 then
    Exit(False);

  Self.DebugRandom();

  p := foundBox.Middle;
  p.Y := foundBox.Y2 + MainScreen.NormalizeDistance(15);
  Mouse.Move(p);
  Result := ChooseOption.Select('Dismiss');
end;

function TRSRandomEvents.DismissGenie(): Boolean;
var
  atpa: T2DPointArray;
begin
  if not Self.Genie.Find(atpa) then
    Exit(False);

  Self.DebugRandom();
  Result := Self.Genie.SelectOption(['Dismiss']);
end;

function TRSRandomEvents.IsOtherPlayersGenie(): Boolean;
var
  text: String;
begin
  text := Chat.GetChat().Lower();
  Result := 'ignoring' in text;
end;

procedure TRSRandomEvents.DisableRandomEvents(reason: String);
var
  json: TJSONObject;
begin
  Self.DebugLn(reason);
  WriteLn('[RandomEvents] ', reason);

  Self.Mode := ERandomEventMode.OFF;
  json := Self.GetConfig();
  json.Put('genie', False);
  json.Put('genie_action', 'ignore');
  json.Put('mode', 'off');
  WLSettings.SaveConfig();

  if Chat.HasContinue() then
    Chat.ClickContinue(True);
end;

function TRSRandomEvents.AdvanceGenieChat(): Boolean;
var
  timeout: TCountdown;
  lamp: TRSItem;
begin
  WaitUntil(Chat.HasContinue() or LampHandler.HasLamp(lamp), 100, 5000);

  if Self.IsOtherPlayersGenie() then
  begin
    Self.DisableRandomEvents(GENIE_OTHER_PLAYER_REASON);
    Exit(False);
  end;

  timeout.Init(12000);
  while (not timeout.IsFinished()) and Chat.HasContinue() do
  begin
    if Self.IsOtherPlayersGenie() then
    begin
      Self.DisableRandomEvents(GENIE_OTHER_PLAYER_REASON);
      Exit(False);
    end;

    Chat.ClickContinue(True);
    Wait(60, 1500, wdLeft);
  end;

  Result := WaitUntil(LampHandler.HasLamp(lamp), 100, 6000);
end;

function TRSRandomEvents.UseLamp(): Boolean;
begin
  LampHandler.Skill := Self.Skill;
  Result := LampHandler.Open() and LampHandler.SelectLampSkill();
end;

function TRSRandomEvents.HasInventorySpace(): Boolean;
begin
  Result := Inventory.Open() and Inventory.HasSpace(1);
end;

procedure TRSRandomEvents.ResetGenieInstance();
begin
  Self.GenieTries := 0;
  Self.IgnoreGenie := False;
  Self.LastGenieSeen := 0;
end;

function TRSRandomEvents.ShouldIgnoreGenie(): Boolean;
var
  atpa: T2DPointArray;
begin
  Result := False;
  if not Self.IgnoreGenie then
    Exit(False);

  if Self.Genie.Find(atpa) then
  begin
    Self.LastGenieSeen := GetTickCount();
    Exit(True);
  end;

  if (Self.LastGenieSeen > 0) and (GetTickCount() - Self.LastGenieSeen < GENIE_GONE_MS) then
    Exit(True);

  Self.ResetGenieInstance();
  Self.DebugLn('Previous Genie instance gone. Ready for the next one');
end;

procedure TRSRandomEvents.NoteGenieFail();
begin
  Inc(Self.GenieTries);
  Self.LastGenieSeen := GetTickCount();
  Self.DebugLn('Genie interact failed (' + IntToStr(Self.GenieTries) + '/' + IntToStr(GENIE_MAX_TRIES) + ')');
  if Self.GenieTries >= GENIE_MAX_TRIES then
  begin
    Self.IgnoreGenie := True;
    Self.DebugLn('Ignoring this Genie after ' + IntToStr(GENIE_MAX_TRIES) + ' failed tries');
  end;
end;

function TRSRandomEvents.InteractGenie(out attempted: Boolean): Boolean; overload;
var
  atpa: T2DPointArray;
begin
  attempted := False;
  if not Self.HasInventorySpace() then
    Exit(False);

  if not Self.Genie.Find(atpa) then
    Exit(False);

  attempted := True;
  Self.DebugRandom();

  if not Self.Genie.Click() then
  begin
    Self.DebugLn('Genie click failed');
    Exit(False);
  end;

  if not Self.AdvanceGenieChat() then
    Exit(False);

  Result := Self.UseLamp();
end;

function TRSRandomEvents.InteractGenie(): Boolean; overload;
var
  attempted: Boolean;
begin
  Result := Self.InteractGenie(attempted);
end;

function TRSRandomEvents.Handle(): Boolean;
var
  lamp: TRSItem;
  attempted: Boolean;
begin
  if not Self.SupportGenie then
    Exit(False);

  Self.LoadSettings();

  case Self.Mode of
    ERandomEventMode.OFF:
      Exit(False);
    ERandomEventMode.DISMISS:
      begin
        if not Self.ShouldScan() then
          Exit(False);

        Result := Self.DismissGenie();
        if Result then
          Self.MarkEventHandled();
      end;
    ERandomEventMode.INTERACT:
      begin
        if LampHandler.HasLamp(lamp) then
          Exit(Self.UseLamp());

        if Self.ShouldIgnoreGenie() then
          Exit(False);

        if not Self.ShouldScan() then
          Exit(False);

        if not Self.HasInventorySpace() then
          Exit(False);

        Result := Self.InteractGenie(attempted);
        if Self.Mode <> ERandomEventMode.INTERACT then
          Exit(False);
        if Result then
        begin
          Self.ResetGenieInstance();
          Self.MarkEventHandled();
        end
        else if attempted then
          Self.NoteGenieFail();
      end;
  end;
end;

procedure RandomEventsFormCloseClicked(sender: TObject);
begin
  TForm(TButton(sender).GetParent()).Close();
end;

procedure TRSRandomEvents.SetupFormCombo(
  var box: TLabeledComboBox;
  parent: TControl;
  caption: String;
  left, top, width: Int32;
  items: TStringArray;
  itemIndex: Int32;
  enabled: Boolean
);
begin
  box.Create(parent);
  box.SetLeft(TControl.AdjustToDPI(left));
  box.SetTop(TControl.AdjustToDPI(top));
  box.SetWidth(TControl.AdjustToDPI(width));
  box.SetHeight(TControl.AdjustToDPI(58));
  box.SetCaption(caption);
  box.AddItemArray(items);
  if (itemIndex >= 0) and (itemIndex <= High(items)) then
    box.SetItemIndex(itemIndex)
  else
    box.SetItemIndex(0);
  box.SetStyle(csDropDownList);
  box.SetEnabled(enabled);
end;

procedure TRSRandomEvents.ShowWarningIfNeeded();
var
  json: TJSONObject;
  warningForm: TForm;
  msg: TMemo;
  okButton: TButton;
begin
  json := Self.GetConfig();
  if json.has('warning_shown') and json.getBoolean('warning_shown') then
    Exit;

  with warningForm do
  begin
    Init(nil);
    SetCaption('Random Events');
    SetBounds(0, 0, TControl.AdjustToDPI(560), TControl.AdjustToDPI(280));
    SetPosition(poScreenCenter);
  end;

  with msg do
  begin
    Init(warningForm);
    SetParent(warningForm);
    SetBounds(TControl.AdjustToDPI(16), TControl.AdjustToDPI(16),
              TControl.AdjustToDPI(528), TControl.AdjustToDPI(180));
    GetFont().SetSize(11);
    SetReadOnly(True);
    SetCaption(
      'For this to work correctly, make sure you are on the BASH profile, or that Entity Hider is enabled with Hide others random events turned on.' +
      LineEnding + LineEnding +
      'The lamp handler relies on reading the selected skill. In rare cases the lamp may be awarded in an incorrect skill. Use at your own risk.'
    );
  end;

  with okButton do
  begin
    Init(warningForm);
    SetParent(warningForm);
    SetCaption('OK');
    SetWidth(TControl.AdjustToDPI(100));
    SetHeight(TControl.AdjustToDPI(28));
    SetLeft((warningForm.GetWidth() - TControl.AdjustToDPI(100)) div 2);
    SetTop(TControl.AdjustToDPI(210));
    SetOnClick(@RandomEventsFormCloseClicked);
  end;

  warningForm.ShowModal();
  warningForm.Free();

  json.Put('warning_shown', True);
  WLSettings.SaveConfig();
end;

procedure TRSRandomEvents.ShowSettingsForm();
var
  json: TJSONObject;
  form: TForm;
  title, subtitle: TLabel;
  genieCheck, countCheck: TCheckBox;
  genieAction, countAction, lampSkill: TLabeledComboBox;
  closeButton: TButton;
  genieEnabled: Boolean;
  genieActionIdx, skillIdx: Int32;
  mode: String;
begin
  Self.ShowWarningIfNeeded();

  json := Self.GetConfig();
  genieEnabled := False;
  genieActionIdx := 0;
  skillIdx := Self.SkillIndexFromKey(json.getString('skill'));

  if json.has('genie') then
  begin
    genieEnabled := json.getBoolean('genie');
    if json.has('genie_action') and (json.getString('genie_action').Lower() = 'interact') then
      genieActionIdx := 1;
  end
  else
  begin
    mode := json.getString('mode').Lower();
    case mode of
      'dismiss':
        genieEnabled := True;
      'interact':
        begin
          genieEnabled := True;
          genieActionIdx := 1;
        end;
    end;
  end;

  with form do
  begin
    Init(nil);
    SetCaption('Random Events');
    SetBounds(0, 0, TControl.AdjustToDPI(560), TControl.AdjustToDPI(340));
    SetPosition(poScreenCenter);
  end;

  with title do
  begin
    Init(form);
    SetParent(form);
    SetLeft(TControl.AdjustToDPI(20));
    SetTop(TControl.AdjustToDPI(14));
    SetCaption('Random Events');
    GetFont().SetSize(14);
    GetFont().SetStyle([fsBold]);
  end;

  with subtitle do
  begin
    Init(form);
    SetParent(form);
    SetLeft(TControl.AdjustToDPI(20));
    SetTop(TControl.AdjustToDPI(40));
    SetWidth(TControl.AdjustToDPI(520));
    SetCaption('Tick the events you want the script to handle.');
  end;

  genieCheck.Create(form, 'Genie', 'Leave the NPC alone or talk to them.', [20, 72], [200, 22], True);
  genieCheck.SetChecked(genieEnabled);

  Self.SetupFormCombo(genieAction, form, 'Action', 20, 98, 240, BASH_RANDOM_EVENT_MODES, genieActionIdx, True);
  genieAction.SetTooltip('Ignore does nothing to the NPC. Interact talks to them and uses the lamp.');
  Self.SetupFormCombo(lampSkill, form, 'Lamp XP skill', 280, 98, 240, BASH_LAMP_SKILL_LABELS, skillIdx, True);
  lampSkill.SetTooltip('Skill used when a Genie lamp is rubbed.');

  countCheck.Create(form, 'Count Check (coming soon)', '', [20, 172], [280, 22], True);
  countCheck.SetChecked(False);
  countCheck.SetEnabled(False);

  Self.SetupFormCombo(countAction, form, 'Action', 20, 198, 240, BASH_RANDOM_EVENT_MODES, 0, False);

  with closeButton do
  begin
    Init(form);
    SetParent(form);
    SetCaption('Save and Close');
    SetWidth(TControl.AdjustToDPI(120));
    SetHeight(TControl.AdjustToDPI(28));
    SetLeft((form.GetWidth() - TControl.AdjustToDPI(120)) div 2);
    SetTop(TControl.AdjustToDPI(280));
    SetOnClick(@RandomEventsFormCloseClicked);
  end;

  form.ShowModal();

  json.Put('genie', genieCheck.IsChecked());
  if genieAction.GetItemIndex() = 1 then
    json.Put('genie_action', 'interact')
  else
    json.Put('genie_action', 'ignore');
  json.Put('count_check', False);
  json.Put('count_check_action', 'ignore');

  if (lampSkill.GetItemIndex() >= 0) and (lampSkill.GetItemIndex() <= High(BASH_LAMP_SKILL_KEYS)) then
    json.Put('skill', BASH_LAMP_SKILL_KEYS[lampSkill.GetItemIndex()]);

  if genieCheck.IsChecked() and (genieAction.GetItemIndex() = 1) then
    json.Put('mode', 'interact')
  else
    json.Put('mode', 'off');

  form.Free();
  WLSettings.SaveConfig();
end;

procedure TRSRandomEvents.Setup();
begin
  Self.Name := 'RandomEvents';
  Self.Mode := ERandomEventMode.OFF;
  Self.SupportGenie := False;
  Self.Skill := ERSLampSkill.WOODCUTTING;
  Self.ResetGenieInstance();
  Self.SetupGenie();
end;

var
  RandomEvents: TRSRandomEvents;

function TAntiban.DismissRandom(): Boolean; override;
begin
  if not RandomEvents.SupportGenie then
    Exit(False);

  Result := RandomEvents.Handle();
end;

procedure TSRL.Setup; override;
begin
  inherited;

  RandomEvents.Setup();
end;
