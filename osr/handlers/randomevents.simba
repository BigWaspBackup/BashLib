{$DEFINE WL_RANDOM_EVENTS_INCLUDED}
{$IFNDEF WL_OSR}
  {$I BashLib/osr.simba}
{$ENDIF}

{$SCOPEDENUMS ON}

(*
  OSRS random events are scheduled on real-world time, 1 to 2 hours after the
  last event. The countdown keeps running while logged out, so the last-event
  timestamp is persisted and scans are gated to that window.
*)
const
  GENIE_PANTS_COLOR: TCTS2Color = [9311880, 6, 0.05, 0.66];   // CTS2(9311880, 6, 0.05, 0.66)
  GENIE_BODY_COLOR: TCTS2Color = [14189363, 23, 0.08, 1.26];  // CTS2(14189363, 23, 0.08, 1.26)
  GENIE_PAIR_DIST = 20;
  GENIE_CLUSTER_DISTANCE = 8;
  COUNT_CHECK_COLOR: TCTS2Color = [1776416, 1, 0.01, 0.01];     // CTS2(1776416, 1, 0.01, 0.01) black shirt + pants
  COUNT_CHECK_CAPE_COLOR: TCTS2Color = [596588, 9, 0.20, 1.92]; // CTS2(596588, 9, 0.20, 1.92) cape/collar
  COUNT_CHECK_PAIR_DIST = 20;
  COUNT_CHECK_CLUSTER_DISTANCE = 8;
  RANDOM_NPC_SHAPE: Vector3 = [1, 1, 7];
  RANDOM_NPC_DOT_MIN_DIST = 4;
  RANDOM_NPC_DOT_RADIUS = 10;
  RANDOM_NPC_MIN_PIXELS = 20;
  RANDOM_NPC_MIN_WIDTH = 8;
  RANDOM_NPC_MIN_HEIGHT = 10;
  RANDOM_NPC_SCAN_PAD = 12;
  RANDOM_EVENT_MIN_SEC = 60 * 60;
  RANDOM_EVENT_MAX_SEC = 120 * 60;
  RANDOM_EVENT_EARLY_SCAN_MS = 60 * 1000;
  RANDOM_NPC_MAX_TRIES = 3;
  RANDOM_NPC_GONE_MS = 10 * 1000;
  RANDOM_EVENT_OTHER_PLAYER_REASON =
    'This random event belongs to another player. Random events have been disabled. ' +
    'Use the BASH profile, or enable Entity Hider with Hide others random events.';
  BASH_RANDOM_EVENT_MODES: TStringArray = ['Ignore', 'Interact'];
  BASH_LAMP_SKILL_KEYS: TStringArray = [
    'agility', 'attack', 'construction', 'cooking', 'crafting',
    'defence', 'farming', 'firemaking', 'fishing', 'fletching',
    'herblore', 'hitpoints', 'hunter', 'magic', 'mining',
    'prayer', 'range', 'runecrafting', 'sailing', 'slayer',
    'smithing', 'strength', 'theiving', 'woodcutting'
  ];
  BASH_LAMP_SKILL_LABELS: TStringArray = [
    'Agility', 'Attack', 'Construction', 'Cooking', 'Crafting',
    'Defence', 'Farming', 'Firemaking', 'Fishing', 'Fletching',
    'Herblore', 'Hitpoints', 'Hunter', 'Magic', 'Mining',
    'Prayer', 'Range', 'Runecrafting', 'Sailing', 'Slayer',
    'Smithing', 'Strength', 'Thieving', 'Woodcutting'
  ];

type
  ERandomEventMode = (OFF, DISMISS, INTERACT);

  TRSRandomEvents = record(TSRLBaseRecord)
    Mode: ERandomEventMode;
    Enabled: Boolean;
    Skill: ERSLampSkill;
    Genie: TRSNPC;
    CountCheck: TRSNPC;
    GenieMode: ERandomEventMode;
    CountCheckMode: ERandomEventMode;
    LastEventUnix: Int64;
    NextEarlyScan: UInt64;
    GenieTries: Int32;
    IgnoreGenie: Boolean;
    LastGenieSeen: UInt64;
    CountCheckTries: Int32;
    IgnoreCountCheck: Boolean;
    LastCountCheckSeen: UInt64;
  end;

function ERSLampSkill.ToKey(): String; constref;
var
  key: String;
begin
  key := ToString(Self).Lower();
  if '.' in key then
    key := key.After('.');
  Result := key;
end;

function ERSLampSkill.FromKey(value: String): ERSLampSkill; static;
var
  i: Int32;
  key: String;
begin
  value := value.Lower().Replace('thieving', 'theiving');
  for i := 0 to Ord(High(ERSLampSkill)) do
  begin
    key := ERSLampSkill(i).ToKey();
    if value = key then
      Exit(ERSLampSkill(i));
  end;

  Result := ERSLampSkill.WOODCUTTING;
end;

procedure TRSRandomEvents.SetupGenie();
begin
  with Self.Genie do
  begin
    Filter.Skip := False;
    SetupUpText(['Genie']);
    Filter.Walker := False;
    Filter.MinimapDot := True;
    Filter.Finder := True;
    Filter.UpText := True;
    SetLength(ShapeArray, 1);
    ShapeArray.SetShape(RANDOM_NPC_SHAPE);
    Finder := [];
    Finder.ColorClusters += [
      GENIE_BODY_COLOR,
      GENIE_PANTS_COLOR,
      GENIE_PAIR_DIST
    ];
    Finder.ClusterDistance := GENIE_CLUSTER_DISTANCE;
  end;
end;

procedure TRSRandomEvents.SetupCountCheck();
begin
  with Self.CountCheck do
  begin
    Filter.Skip := False;
    SetupUpText(['Count Check']);
    Filter.Walker := False;
    Filter.MinimapDot := True;
    Filter.Finder := True;
    Filter.UpText := True;
    SetLength(ShapeArray, 1);
    ShapeArray.SetShape(RANDOM_NPC_SHAPE);
    Finder := [];
    Finder.ColorClusters += [
      COUNT_CHECK_COLOR,
      COUNT_CHECK_CAPE_COLOR,
      COUNT_CHECK_PAIR_DIST
    ];
    Finder.ClusterDistance := COUNT_CHECK_CLUSTER_DISTANCE;
  end;
end;

procedure TRSRandomEvents.Enable();
begin
  Self.Enabled := True;
end;

procedure TRSRandomEvents.EnableGenie();
begin
  Self.Enable();
end;

function TRSRandomEvents.NearbyNPCDots(): TPointArray;
var
  dots: TPointArray;
  origin, p: TPoint;
  dist: Double;
begin
  origin := Minimap.Center;
  dots := Minimap.GetDots(ERSMinimapDot.NPC);
  for p in dots do
  begin
    dist := p.Offset(2, 2).DistanceTo(origin);
    if (dist > RANDOM_NPC_DOT_MIN_DIST) and (dist <= RANDOM_NPC_DOT_RADIUS) then
      Result += p;
  end;
end;

function TRSRandomEvents.HasNearbyNPCDot(): Boolean;
begin
  Result := Self.NearbyNPCDots() <> [];
end;

function TRSRandomEvents.NPCName(constref npc: TRSNPC): String;
begin
  if npc.UpText <> [] then
    Result := npc.UpText[0]
  else
    Result := 'NPC';
end;

function TRSRandomEvents.KeepEventClusters(var atpa: T2DPointArray): Boolean;
var
  i: Int32;
  box: TBox;
begin
  atpa.FilterSize(RANDOM_NPC_MIN_PIXELS, EComparator.__GT__);
  for i := High(atpa) downto 0 do
  begin
    box := atpa[i].Bounds();
    if (box.Width() < RANDOM_NPC_MIN_WIDTH) or (box.Height() < RANDOM_NPC_MIN_HEIGHT) then
      Delete(atpa, i, 1);
  end;

  if atpa <> [] then
    atpa.SortByArea(False);

  Result := atpa <> [];
end;

function TRSRandomEvents.EventScanBox(): TBox;
var
  playerBox: TBox;
  expand: Int32;
begin
  MM2MS.SetupZoom();
  playerBox := MainScreen.GetPlayerBox();
  expand := Max(playerBox.Width(), playerBox.Height()) + MainScreen.NormalizeDistance(RANDOM_NPC_SCAN_PAD);
  Result := playerBox.Expand(expand, MainScreen.Bounds);
end;

function TRSRandomEvents.FindEventNPC(var npc: TRSNPC; out atpa: T2DPointArray): Boolean;
var
  dots: TPointArray;
  scan: TBox;
  p: TPoint;
  dists: String;
begin
  atpa := [];
  dots := Self.NearbyNPCDots();
  if dots = [] then
    Exit(False);

  scan := Self.EventScanBox();
  atpa := MainScreen.FindObject(npc.Finder, scan);
  if not Self.KeepEventClusters(atpa) then
    Exit(False);

  atpa := atpa.SortFrom(MainScreen.GetPlayerBox().Center());

  dists := '';
  for p in dots do
  begin
    if dists <> '' then
      dists += ', ';
    dists += ToStr(Round(p.Offset(2, 2).DistanceTo(Minimap.Center)));
  end;

  Self.DebugLn(
    Self.NPCName(npc) + ' found with ' + IntToStr(Length(dots)) +
    ' nearby NPC dot(s) at px ' + dists +
    '  scan=' + ToStr(scan) +
    '  cluster=' + ToStr(atpa[0].Bounds()) +
    ' pixels=' + IntToStr(Length(atpa[0]))
  );
  Result := True;
end;

function TRSRandomEvents.HoverEventNPC(var npc: TRSNPC; atpa: T2DPointArray): Boolean;
var
  upText: String;
begin
  if atpa = [] then
    Exit(False);

  Mouse.Move(atpa[0].Mean());
  if MainScreen.IsUpText(npc.UpText, 1200) then
    Exit(True);

  upText := MainScreen.GetUpText();
  Self.DebugLn(Self.NPCName(npc) + ' hover uptext was "' + upText + '", expected ' + Self.NPCName(npc));
  Result := False;
end;

function TRSRandomEvents.ClickEventNPC(var npc: TRSNPC; atpa: T2DPointArray): Boolean;
begin
  Result := Self.HoverEventNPC(npc, atpa);
  if Result then
    Mouse.Click(MOUSE_LEFT);
end;

function TRSRandomEvents.ActionToMode(action: String): ERandomEventMode;
begin
  if action.Lower() = 'interact' then
    Result := ERandomEventMode.INTERACT
  else
    Result := ERandomEventMode.OFF;
end;

function TRSRandomEvents.ModeToAction(mode: ERandomEventMode): String;
begin
  if mode = ERandomEventMode.INTERACT then
    Result := 'interact'
  else
    Result := 'ignore';
end;

function TRSRandomEvents.ActionIndex(mode: ERandomEventMode): Int32;
begin
  if mode = ERandomEventMode.INTERACT then
    Result := 1
  else
    Result := 0;
end;

function TRSRandomEvents.GetConfig(): TJSONObject;
begin
  Result := WLSettings.GetObject('antiban').getJSONObject('random_events');
end;

function TRSRandomEvents.SkillIndexFromKey(skillKey: String): Int32;
var
  i: Int32;
begin
  skillKey := skillKey.Lower().Replace('thieving', 'theiving');
  Result := High(BASH_LAMP_SKILL_KEYS);
  for i := 0 to High(BASH_LAMP_SKILL_KEYS) do
  begin
    if BASH_LAMP_SKILL_KEYS[i] = 'woodcutting' then
      Result := i;
    if BASH_LAMP_SKILL_KEYS[i] = skillKey then
      Exit(i);
  end;
end;

procedure TRSRandomEvents.LoadSettings();
var
  json: TJSONObject;
  mode: String;
begin
  if not Self.Enabled then
  begin
    Self.Mode := ERandomEventMode.OFF;
    Self.GenieMode := ERandomEventMode.OFF;
    Self.CountCheckMode := ERandomEventMode.OFF;
    Exit;
  end;

  json := Self.GetConfig();
  mode := '';
  if json.has('mode') then
    mode := json.getString('mode').Lower();

  if json.has('genie_action') then
    Self.GenieMode := Self.ActionToMode(json.getString('genie_action'))
  else if mode = 'interact' then
    Self.GenieMode := ERandomEventMode.INTERACT
  else
    Self.GenieMode := ERandomEventMode.OFF;

  if json.has('count_check_action') then
    Self.CountCheckMode := Self.ActionToMode(json.getString('count_check_action'))
  else
    Self.CountCheckMode := ERandomEventMode.OFF;

  if (Self.GenieMode = ERandomEventMode.INTERACT) or (Self.CountCheckMode = ERandomEventMode.INTERACT) then
    Self.Mode := ERandomEventMode.INTERACT
  else
    Self.Mode := ERandomEventMode.OFF;

  Self.Skill := ERSLampSkill.FromKey(json.getString('skill'));
  LampHandler.Skill := Self.Skill;

  Self.LastEventUnix := 0;
  if json.has('last_event_unix') then
    Self.LastEventUnix := json.getInt('last_event_unix');
end;

function TRSRandomEvents.SecondsSinceLastEvent(): Int64;
begin
  if Self.LastEventUnix <= 0 then
    Exit(RANDOM_EVENT_MAX_SEC);

  Result := UnixTime() - Self.LastEventUnix;
  if Result < 0 then
    Result := RANDOM_EVENT_MAX_SEC;
end;

function TRSRandomEvents.InSpawnWindow(): Boolean;
begin
  Result := Self.SecondsSinceLastEvent() >= RANDOM_EVENT_MIN_SEC;
end;

function TRSRandomEvents.ShouldScan(): Boolean;
begin
  if Self.InSpawnWindow() then
    Exit(True);

  if GetTickCount() < Self.NextEarlyScan then
    Exit(False);

  Self.NextEarlyScan := GetTickCount() + RANDOM_EVENT_EARLY_SCAN_MS;
  Result := True;
end;

procedure TRSRandomEvents.MarkEventHandled();
var
  json: TJSONObject;
begin
  Self.LastEventUnix := UnixTime();
  Self.NextEarlyScan := GetTickCount() + RANDOM_EVENT_EARLY_SCAN_MS;
  json := Self.GetConfig();
  json.Put('last_event_unix', Int32(Self.LastEventUnix));
  WLSettings.SaveConfig();
  Self.DebugLn('Random event handled. Next spawn window in 1-2 hours');
end;

procedure TRSRandomEvents.DebugRandom();
var
  number: Int32;
begin
  if not Antiban.DebugRandoms then
    Exit;

  CreateDirectory('randoms');
  number := Length(GetFiles('randoms/', 'png'));
  if number > 1000 then
    TerminateScript('Lots of randoms debugged');

  SaveScreenshot('randoms/' + IntToStr(number) + '.png');
end;

function TRSRandomEvents.DismissByName(): Boolean;
var
  name: String;
  foundBox: TBox;
  p: TPoint;
begin
  name := Chat.GetDisplayName();
  if name = '' then
    Exit(False);

  if OCR.LocateText(Box(MainScreen.Center, 250, 100), name, RS_FONT_BOLD_12, TOCRColorFilter.Create([$00FFFF, 0]), foundBox) < 1 then
    Exit(False);

  Self.DebugRandom();

  p := foundBox.Middle;
  p.Y := foundBox.Y2 + MainScreen.NormalizeDistance(15);
  Mouse.Move(p);
  Result := ChooseOption.Select('Dismiss');
end;

function TRSRandomEvents.DismissGenie(): Boolean;
var
  atpa: T2DPointArray;
begin
  if not Self.FindEventNPC(Self.Genie, atpa) then
    Exit(False);

  Self.DebugRandom();
  Result := Self.HoverEventNPC(Self.Genie, atpa) and ChooseOption.Select('Dismiss');
end;

function TRSRandomEvents.IsOtherPlayersEvent(): Boolean;
var
  text: String;
begin
  text := Chat.GetChat().Lower();
  Result := ('ignoring' in text) or ('not you' in text);
end;

function TRSRandomEvents.ChatHasCountCheckFail(): Boolean;
var
  text: String;
begin
  text := Chat.GetChat().Lower();
  Result := ('fail my checks' in text) or
            ('do not have a bank pin' in text) or
            ('do not have a jagex account' in text);
end;

procedure TRSRandomEvents.DisableRandomEvents(reason: String);
var
  json: TJSONObject;
begin
  Self.DebugLn(reason);
  WriteLn('[RandomEvents] ', reason);

  Self.Mode := ERandomEventMode.OFF;
  Self.GenieMode := ERandomEventMode.OFF;
  Self.CountCheckMode := ERandomEventMode.OFF;
  json := Self.GetConfig();
  json.Put('genie', False);
  json.Put('genie_action', 'ignore');
  json.Put('count_check', False);
  json.Put('count_check_action', 'ignore');
  json.Put('mode', 'off');
  WLSettings.SaveConfig();

  if Chat.HasContinue() then
    Chat.ClickContinue(True);
end;

function TRSRandomEvents.AdvanceGenieChat(): Boolean;
var
  timeout: TCountdown;
  lamp: TRSItem;
begin
  WaitUntil(Chat.HasContinue() or LampHandler.HasLamp(lamp), 100, 5000);

  if Self.IsOtherPlayersEvent() then
  begin
    Self.DisableRandomEvents(RANDOM_EVENT_OTHER_PLAYER_REASON);
    Exit(False);
  end;

  timeout.Init(12000);
  while (not timeout.IsFinished()) and Chat.HasContinue() do
  begin
    if Self.IsOtherPlayersEvent() then
    begin
      Self.DisableRandomEvents(RANDOM_EVENT_OTHER_PLAYER_REASON);
      Exit(False);
    end;

    Chat.ClickContinue(True);
    Wait(60, 1500, wdLeft);
  end;

  Result := WaitUntil(LampHandler.HasLamp(lamp), 100, 6000);
end;

function TRSRandomEvents.UseLamp(): Boolean;
begin
  LampHandler.Skill := Self.Skill;
  Result := LampHandler.Open() and LampHandler.SelectLampSkill();
end;

function TRSRandomEvents.HasInventorySpace(): Boolean;
begin
  Result := Inventory.Open() and Inventory.HasSpace(1);
end;

procedure TRSRandomEvents.ResetGenieInstance();
begin
  Self.GenieTries := 0;
  Self.IgnoreGenie := False;
  Self.LastGenieSeen := 0;
end;

function TRSRandomEvents.ShouldIgnoreGenie(): Boolean;
var
  atpa: T2DPointArray;
begin
  Result := False;
  if not Self.IgnoreGenie then
    Exit(False);

  if Self.FindEventNPC(Self.Genie, atpa) then
  begin
    Self.LastGenieSeen := GetTickCount();
    Exit(True);
  end;

  if (Self.LastGenieSeen > 0) and (GetTickCount() - Self.LastGenieSeen < RANDOM_NPC_GONE_MS) then
    Exit(True);

  Self.ResetGenieInstance();
  Self.DebugLn('Previous Genie instance gone. Ready for the next one');
end;

procedure TRSRandomEvents.NoteGenieFail();
begin
  Inc(Self.GenieTries);
  Self.LastGenieSeen := GetTickCount();
  Self.DebugLn('Genie interact failed (' + IntToStr(Self.GenieTries) + '/' + IntToStr(RANDOM_NPC_MAX_TRIES) + ')');
  if Self.GenieTries >= RANDOM_NPC_MAX_TRIES then
  begin
    Self.IgnoreGenie := True;
    Self.DebugLn('Ignoring this Genie after ' + IntToStr(RANDOM_NPC_MAX_TRIES) + ' failed tries');
  end;
end;

function TRSRandomEvents.InteractGenie(out attempted: Boolean): Boolean; overload;
var
  atpa: T2DPointArray;
begin
  attempted := False;
  if not Self.HasInventorySpace() then
    Exit(False);

  if not Self.FindEventNPC(Self.Genie, atpa) then
    Exit(False);

  Self.DebugRandom();

  if not Self.ClickEventNPC(Self.Genie, atpa) then
    Exit(False);

  attempted := True;

  if not Self.AdvanceGenieChat() then
    Exit(False);

  Result := Self.UseLamp();
end;

function TRSRandomEvents.InteractGenie(): Boolean; overload;
var
  attempted: Boolean;
begin
  Result := Self.InteractGenie(attempted);
end;

function TRSRandomEvents.DismissCountCheck(): Boolean;
var
  atpa: T2DPointArray;
begin
  if not Self.FindEventNPC(Self.CountCheck, atpa) then
    Exit(False);

  Self.DebugRandom();
  Result := Self.HoverEventNPC(Self.CountCheck, atpa) and ChooseOption.Select('Dismiss');
end;

procedure TRSRandomEvents.ResetCountCheckInstance();
begin
  Self.CountCheckTries := 0;
  Self.IgnoreCountCheck := False;
  Self.LastCountCheckSeen := 0;
end;

function TRSRandomEvents.ShouldIgnoreCountCheck(): Boolean;
var
  atpa: T2DPointArray;
begin
  Result := False;
  if not Self.IgnoreCountCheck then
    Exit(False);

  if Self.FindEventNPC(Self.CountCheck, atpa) then
  begin
    Self.LastCountCheckSeen := GetTickCount();
    Exit(True);
  end;

  if (Self.LastCountCheckSeen > 0) and (GetTickCount() - Self.LastCountCheckSeen < RANDOM_NPC_GONE_MS) then
    Exit(True);

  Self.ResetCountCheckInstance();
  Self.DebugLn('Previous Count Check instance gone. Ready for the next one');
end;

procedure TRSRandomEvents.NoteCountCheckFail();
begin
  Inc(Self.CountCheckTries);
  Self.LastCountCheckSeen := GetTickCount();
  Self.DebugLn('Count Check interact failed (' + IntToStr(Self.CountCheckTries) + '/' + IntToStr(RANDOM_NPC_MAX_TRIES) + ')');
  if Self.CountCheckTries >= RANDOM_NPC_MAX_TRIES then
  begin
    Self.IgnoreCountCheck := True;
    Self.DebugLn('Ignoring this Count Check after ' + IntToStr(RANDOM_NPC_MAX_TRIES) + ' failed tries');
  end;
end;

function TRSRandomEvents.AdvanceCountCheckChat(out gotLamp: Boolean): Boolean;
var
  timeout: TCountdown;
  lamp: TRSItem;
  failed: Boolean;
begin
  gotLamp := False;
  failed := False;

  WaitUntil(Chat.HasContinue() or LampHandler.HasLamp(lamp), 100, 5000);

  if Self.IsOtherPlayersEvent() then
  begin
    Self.DisableRandomEvents(RANDOM_EVENT_OTHER_PLAYER_REASON);
    Exit(False);
  end;

  timeout.Init(12000);
  while (not timeout.IsFinished()) and Chat.HasContinue() do
  begin
    if Self.IsOtherPlayersEvent() then
    begin
      Self.DisableRandomEvents(RANDOM_EVENT_OTHER_PLAYER_REASON);
      Exit(False);
    end;

    if Self.ChatHasCountCheckFail() then
      failed := True;

    Chat.ClickContinue(True);
    Wait(60, 1500, wdLeft);
  end;

  gotLamp := WaitUntil(LampHandler.HasLamp(lamp), 100, 4000);
  if failed and (not gotLamp) then
    Self.DebugLn('Count Check: account failed security checks, no lamp');

  Result := gotLamp or failed;
end;

function TRSRandomEvents.InteractCountCheck(out attempted: Boolean): Boolean; overload;
var
  atpa: T2DPointArray;
  gotLamp: Boolean;
begin
  attempted := False;
  if not Self.HasInventorySpace() then
    Exit(False);

  if not Self.FindEventNPC(Self.CountCheck, atpa) then
    Exit(False);

  Self.DebugRandom();

  if not Self.ClickEventNPC(Self.CountCheck, atpa) then
    Exit(False);

  attempted := True;

  if not Self.AdvanceCountCheckChat(gotLamp) then
    Exit(False);

  if gotLamp then
    Result := Self.UseLamp()
  else
    Result := True;
end;

function TRSRandomEvents.InteractCountCheck(): Boolean; overload;
var
  attempted: Boolean;
begin
  Result := Self.InteractCountCheck(attempted);
end;

function TRSRandomEvents.Handle(): Boolean;
var
  lamp: TRSItem;
  attempted: Boolean;
begin
  if not Self.Enabled then
    Exit(False);

  Self.LoadSettings();

  if LampHandler.HasLamp(lamp) then
    Exit(Self.UseLamp());

  if Self.Mode = ERandomEventMode.OFF then
    Exit(False);

  if not Self.ShouldScan() then
    Exit(False);

  if Self.Mode = ERandomEventMode.DISMISS then
  begin
    Result := Self.DismissGenie() or Self.DismissCountCheck();
    if Result then
      Self.MarkEventHandled();
    Exit;
  end;

  if (Self.GenieMode = ERandomEventMode.INTERACT) and (not Self.ShouldIgnoreGenie()) then
  begin
    if Self.HasInventorySpace() then
    begin
      Result := Self.InteractGenie(attempted);
      if Self.GenieMode <> ERandomEventMode.INTERACT then
        Exit(False);
      if Result then
      begin
        Self.ResetGenieInstance();
        Self.MarkEventHandled();
        Exit;
      end
      else if attempted then
        Self.NoteGenieFail();
    end;
  end;

  if (Self.CountCheckMode = ERandomEventMode.INTERACT) and (not Self.ShouldIgnoreCountCheck()) then
  begin
    if not Self.HasInventorySpace() then
      Exit(False);

    Result := Self.InteractCountCheck(attempted);
    if Self.CountCheckMode <> ERandomEventMode.INTERACT then
      Exit(False);
    if Result then
    begin
      Self.ResetCountCheckInstance();
      Self.MarkEventHandled();
    end
    else if attempted then
      Self.NoteCountCheckFail();
  end;
end;

procedure RandomEventsFormCloseClicked(sender: TObject);
begin
  TForm(TButton(sender).GetParent()).Close();
end;

procedure TRSRandomEvents.SetupFormCombo(
  var box: TLabeledComboBox;
  parent: TControl;
  caption: String;
  left, top, width: Int32;
  items: TStringArray;
  itemIndex: Int32;
  enabled: Boolean
);
begin
  box.Create(parent);
  box.SetLeft(TControl.AdjustToDPI(left));
  box.SetTop(TControl.AdjustToDPI(top));
  box.SetWidth(TControl.AdjustToDPI(width));
  box.SetHeight(TControl.AdjustToDPI(58));
  box.SetCaption(caption);
  box.AddItemArray(items);
  if (itemIndex >= 0) and (itemIndex <= High(items)) then
    box.SetItemIndex(itemIndex)
  else
    box.SetItemIndex(0);
  box.SetStyle(csDropDownList);
  box.SetEnabled(enabled);
end;

procedure TRSRandomEvents.ShowWarningIfNeeded();
var
  json: TJSONObject;
  warningForm: TForm;
  msg: TMemo;
  okButton: TButton;
begin
  json := Self.GetConfig();
  if json.has('warning_shown') and json.getBoolean('warning_shown') then
    Exit;

  with warningForm do
  begin
    Init(nil);
    SetCaption('Random Events');
    SetBounds(0, 0, TControl.AdjustToDPI(560), TControl.AdjustToDPI(280));
    SetPosition(poScreenCenter);
  end;

  with msg do
  begin
    Init(warningForm);
    SetParent(warningForm);
    SetBounds(TControl.AdjustToDPI(16), TControl.AdjustToDPI(16),
              TControl.AdjustToDPI(528), TControl.AdjustToDPI(180));
    GetFont().SetSize(11);
    SetReadOnly(True);
    SetCaption(
      'For this to work correctly, make sure you are on the BASH profile, or that Entity Hider is enabled with Hide others random events turned on.' +
      LineEnding + LineEnding +
      'The lamp handler relies on reading the selected skill. In rare cases the lamp may be awarded in an incorrect skill. Use at your own risk.'
    );
  end;

  with okButton do
  begin
    Init(warningForm);
    SetParent(warningForm);
    SetCaption('OK');
    SetWidth(TControl.AdjustToDPI(100));
    SetHeight(TControl.AdjustToDPI(28));
    SetLeft((warningForm.GetWidth() - TControl.AdjustToDPI(100)) div 2);
    SetTop(TControl.AdjustToDPI(210));
    SetOnClick(@RandomEventsFormCloseClicked);
  end;

  warningForm.ShowModal();
  warningForm.Free();

  json.Put('warning_shown', True);
  WLSettings.SaveConfig();
end;

procedure TRSRandomEvents.ShowSettingsForm();
var
  json: TJSONObject;
  form: TForm;
  title, subtitle: TLabel;
  genieAction, countAction, lampSkill: TLabeledComboBox;
  closeButton: TButton;
  genieMode, countMode: ERandomEventMode;
  skillIdx: Int32;
begin
  Self.ShowWarningIfNeeded();

  json := Self.GetConfig();
  genieMode := ERandomEventMode.OFF;
  countMode := ERandomEventMode.OFF;
  skillIdx := Self.SkillIndexFromKey(json.getString('skill'));

  if json.has('genie_action') then
    genieMode := Self.ActionToMode(json.getString('genie_action'))
  else if json.has('mode') and (json.getString('mode').Lower() = 'interact') then
    genieMode := ERandomEventMode.INTERACT;

  if json.has('count_check_action') then
    countMode := Self.ActionToMode(json.getString('count_check_action'));

  with form do
  begin
    Init(nil);
    SetCaption('Random Events');
    SetBounds(0, 0, TControl.AdjustToDPI(560), TControl.AdjustToDPI(280));
    SetPosition(poScreenCenter);
  end;

  with title do
  begin
    Init(form);
    SetParent(form);
    SetLeft(TControl.AdjustToDPI(20));
    SetTop(TControl.AdjustToDPI(14));
    SetCaption('Random Events');
    GetFont().SetSize(14);
    GetFont().SetStyle([fsBold]);
  end;

  with subtitle do
  begin
    Init(form);
    SetParent(form);
    SetLeft(TControl.AdjustToDPI(20));
    SetTop(TControl.AdjustToDPI(40));
    SetWidth(TControl.AdjustToDPI(520));
    SetCaption('Ignore leaves the NPC alone. Interact talks to them and uses any lamp they give.');
  end;

  Self.SetupFormCombo(genieAction, form, 'Genie', 20, 72, 240, BASH_RANDOM_EVENT_MODES, Self.ActionIndex(genieMode), True);
  genieAction.SetTooltip('Ignore does nothing. Interact talks to the Genie and rubs the lamp.');
  Self.SetupFormCombo(lampSkill, form, 'Lamp XP skill', 280, 72, 240, BASH_LAMP_SKILL_LABELS, skillIdx, True);
  lampSkill.SetTooltip('Skill used when a Genie or Count Check lamp is rubbed.');

  Self.SetupFormCombo(countAction, form, 'Count Check', 20, 146, 240, BASH_RANDOM_EVENT_MODES, Self.ActionIndex(countMode), True);
  countAction.SetTooltip('Ignore does nothing. Interact talks to Count Check. A lamp is only given if the account has a Jagex Account and Bank PIN.');

  with closeButton do
  begin
    Init(form);
    SetParent(form);
    SetCaption('Save and Close');
    SetWidth(TControl.AdjustToDPI(120));
    SetHeight(TControl.AdjustToDPI(28));
    SetLeft((form.GetWidth() - TControl.AdjustToDPI(120)) div 2);
    SetTop(TControl.AdjustToDPI(220));
    SetOnClick(@RandomEventsFormCloseClicked);
  end;

  form.ShowModal();

  if genieAction.GetItemIndex() = 1 then
    json.Put('genie_action', 'interact')
  else
    json.Put('genie_action', 'ignore');
  json.Put('genie', genieAction.GetItemIndex() = 1);

  if countAction.GetItemIndex() = 1 then
    json.Put('count_check_action', 'interact')
  else
    json.Put('count_check_action', 'ignore');
  json.Put('count_check', countAction.GetItemIndex() = 1);

  if (lampSkill.GetItemIndex() >= 0) and (lampSkill.GetItemIndex() <= High(BASH_LAMP_SKILL_KEYS)) then
    json.Put('skill', BASH_LAMP_SKILL_KEYS[lampSkill.GetItemIndex()]);

  if (genieAction.GetItemIndex() = 1) or (countAction.GetItemIndex() = 1) then
    json.Put('mode', 'interact')
  else
    json.Put('mode', 'off');

  form.Free();
  WLSettings.SaveConfig();
end;

procedure TRSRandomEvents.Setup();
begin
  Self.Name := 'RandomEvents';
  Self.Mode := ERandomEventMode.OFF;
  Self.Enabled := False;
  Self.GenieMode := ERandomEventMode.OFF;
  Self.CountCheckMode := ERandomEventMode.OFF;
  Self.Skill := ERSLampSkill.WOODCUTTING;
  Self.ResetGenieInstance();
  Self.ResetCountCheckInstance();
  Self.SetupGenie();
  Self.SetupCountCheck();
end;

var
  RandomEvents: TRSRandomEvents;

function TAntiban.DismissRandom(): Boolean; override;
begin
  if not RandomEvents.Enabled then
    Exit(False);

  Result := RandomEvents.Handle();
end;

procedure TSRL.Setup; override;
begin
  inherited;

  RandomEvents.Setup();
end;
