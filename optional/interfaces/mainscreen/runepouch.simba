{$DEFINE XJ_RUNEPOUCH_INCLUDED}
{$IFNDEF WL_OSR}
  {$I BashLib/osr.simba}
{$ENDIF}

const
  RUNE_POUCH_WINDOW: TBox = [85, 8, 435, 333];
  { Post Interface Uplift brown. Keep the older brown as a fallback. }
  RUNE_POUCH_BROWN = 3424329;
  RUNE_POUCH_BROWN_OLD = 2586039;

  RUNES : TRSItemArray := [
    'Air rune', 'Water rune', 'Earth rune', 'Fire rune',
    'Mind rune', 'Chaos rune', 'Death rune', 'Blood rune',
    'Law rune', 'Cosmic rune', 'Body rune', 'Astral rune',
    'Wrath rune', 'Soul rune', 'Nature rune', 'Aether rune',
    'Mist rune', 'Dust rune', 'Mud rune', 'Smoke rune',
    'Steam rune', 'Lava rune'
];

type
  TRSRunePouch = record(TRSTitledInterface)
    Items: TRSItemInterface;
  end;

var
  RunePouch : TRSRunePouch;

function TRSRunePouch.IsOpen(): Boolean;
var
  cNew, cOld: Int32;
  title: String;
begin
  cNew := SRL.CountColor(RUNE_POUCH_BROWN, Self.Bounds);
  cOld := SRL.CountColor(RUNE_POUCH_BROWN_OLD, Self.Bounds);
  Result := (cNew > 600) or (cOld > 600);
  if Result then
    Exit;
  { Colour can miss after UI tweaks. Only try title OCR when some
    brown is already in the pouch window so we do not false-open. }
  if (cNew < 80) and (cOld < 80) then
    Exit(False);
  title := LowerCase(Self.GetTitle());
  Result := (Pos('pouch', title) > 0) and ((Pos('rune', title) > 0) or (Pos('divine', title) > 0));
end;

function TRSRunePouch.IsOpen(waitTime: Int32; interval: Int32 = -1): Boolean; overload; begin
  if (interval = -1) then
    interval := SRL.TruncatedGauss(50, 1500);

  Result := WaitUntil(Self.IsOpen, interval, waitTime);
end;

function TRSRunePouch.Open: Boolean;
var
  Match : TRSItemFinderMatch;
  up: String;
begin
  if Self.IsOpen then
    Exit(True);

  if not Inventory.Open then
    Exit;

  if not ItemFinder.Find(['Rune pouch', 'Divine rune pouch'], Inventory.GetSlotBoxes, Match) then
    Exit;

  { Prefer left-click. Open is the default action and avoids ChooseOption OCR
    missing the short word "Open". }
  Mouse.Move(Match.Box);
  Wait(40, 80);
  up := Trim(MainScreen.GetUpText());
  if (up = '') or up.ContainsAny(['Open', 'Rune pouch', 'Divine']) then
  begin
    Mouse.Click(MOUSE_LEFT);
    if Self.IsOpen(4000) then
      Exit(True);
  end;

  Mouse.Move(Match.Box);
  if ChooseOption.Select(['Open'], MOUSE_LEFT, False) then
    Result := Self.IsOpen(5000)
  else
    Result := False;
end;

function TRSRunePouch.GetTitle(): String; override;
var
  titleBox: TBox;
begin
  titleBox := Self.Bounds;
  titleBox.X1 += 40;
  titleBox.Y1 += 8;
  titleBox.X2 -= 40;
  titleBox.Y2 := titleBox.Y1 + 18;
  Result := OCR.Recognize(titleBox, TOCRThresholdFilter.Create(13), RS_FONT_BOLD_12);
end;

function TRSRunePouch.IsDivine(): Boolean;
begin
  Result := Pos('divine', LowerCase(Self.GetTitle())) > 0;
end;

function TRSRunePouch.GetPouchBoxes(): TBoxArray;
begin
  if Self.IsDivine() then
    Result := Grid(4, 1, 34, 34, [10, 0], [Self.Bounds.X1 + 93, Self.Bounds.Y1 + 63])
  else
    Result := Grid(3, 1, 34, 34, [27, 0], [Self.Bounds.X1 + 97, Self.Bounds.Y1 + 62]);
end;

function TRSRunePouch.GetInventoryBoxes(): TBoxArray; begin
  Result := Grid(7, 4, 34, 32, [13, 1], [Self.Bounds.X1 + 14, Self.Bounds.Y1 + 136]);
end;

function TRSRunePouch.DiscoverPouch(): TRSItemArray;
var
  SlotBoxes : TBoxArray := Self.GetPouchBoxes;
  Matches : TRSItemFinderMatchArray;
  I : Int32;
begin
  if not Self.IsOpen then
    Exit;

  Matches := ItemFinder.FindAll(RUNES, SlotBoxes, SlotBoxes.Len);

  if Length(Matches) = 0 then
    Exit;

  for I := 0 to High(Matches) do
    Result += Matches[I].Item;
end;

function TRSRunePouch.DiscoverInventory(): TRSItemArray;
var
  SlotBoxes : TBoxArray := Self.GetInventoryBoxes;
  Matches : TRSItemFinderMatchArray;
  I : Int32;
begin
  if not Self.IsOpen then
    Exit;

  Matches := ItemFinder.FindAll(RUNES, SlotBoxes, SlotBoxes.Len);

  if Length(Matches) = 0 then
    Exit;

  for I := 0 to High(Matches) do
    Result += Matches[I].Item;
end;

function TRSRunePouch.FindInPouch(Rune : TRSItem; out Slot : Int32): Boolean;
var
  SlotBoxes : TBoxArray := Self.GetPouchBoxes;
  Match : TRSItemFinderMatch;
begin
  if not Self.IsOpen then
    Exit;

  Result := ItemFinder.Find([Rune], SlotBoxes, Match);
  Slot := Match.Index;
end;

function TRSRunePouch.FindInPouch(Rune : TRSItem; out Box : TBox): Boolean; overload;
var
  SlotBoxes : TBoxArray := Self.GetPouchBoxes;
  Match : TRSItemFinderMatch;
begin
  if not Self.IsOpen then
    Exit;

  Result := ItemFinder.Find([Rune], SlotBoxes, Match);
  Box := Match.Box;
end;

function TRSRunePouch.FindInInventory(Rune : TRSItem; out Slot : Int32): Boolean;
var
  SlotBoxes : TBoxArray := Self.GetInventoryBoxes;
  Match : TRSItemFinderMatch;
begin
  if not Self.IsOpen then
    Exit;

  Result := ItemFinder.Find([Rune], SlotBoxes, Match);
  Slot := Match.Index;
end;

function TRSRunePouch.FindInInventory(Rune : TRSItem; out Box : TBox): Boolean; overload;
var
  SlotBoxes : TBoxArray := Self.GetInventoryBoxes;
  Match : TRSItemFinderMatch;
begin
  if not Self.IsOpen then
    Exit;

  Result := ItemFinder.Find([Rune], SlotBoxes, Match);
  Box := Match.Box;
end;

function TRSRunePouch.Withdraw(Rune : TRSItem; Amount : Int32 = -1): Boolean;
var
  slot, have: Int32;
  slots: TBoxArray;
begin
  if not Self.IsOpen then
    Exit;
  slots := Self.GetPouchBoxes();
  if not Self.FindInPouch(Rune, slot) then
    Exit;
  if not InRange(slot, 0, High(slots)) then
    Exit;

  have := Self.StackCount(slots[slot], slot = 0, slot = High(slots));
  Mouse.Move(slots[slot].Expand(-3));

  if (Amount = -1) or (Amount >= have) then
    ChooseOption.Select('Withdraw-All')
  else if not ChooseOption.Select('Withdraw-' + ToString(Amount) + ' ', MOUSE_LEFT, True, False) then
    if ChooseOption.Select('Withdraw-X') then
      Chat.AnswerQuery('Enter amount', ToString(Amount), Random(2000, 2500));

  Result := WaitUntil((SRL.CountColor(10461097, slots[slot]) = 0), 17, 3000);
end;

function TRSRunePouch.WithdrawAll(): Boolean;
var
  SlotBoxes : TBoxArray := Self.GetPouchBoxes;
  I : Int32;
begin
  if not Self.IsOpen then
    Exit;

  for I := 0 to High(SlotBoxes) do begin
    if SRL.CountColor(10461097, SlotBoxes[I]) = 0 then
      Continue;

    Mouse.Move(SlotBoxes[I].Expand(-3));
    ChooseOption.Select('Withdraw-All');
  end;

  Result := WaitUntil((SRL.CountColor(10461097, SlotBoxes[0].Combine(SlotBoxes[High(SlotBoxes)])) = 0), 17, 3000);
end;

function TRSRunePouch.Store(Rune : TRSItem; Amount : Int32 = -1): Boolean;
var
  Box : TBox;
  Slot : Int32;
begin
  if not (Self.IsOpen and Self.FindInInventory(Rune, Box)) then
    Exit;

  Mouse.Move(Box.Expand(-3));

  if (Amount = -1) or (Amount >= SRL.GetItemAmount(Box)) then
    ChooseOption.Select('Store-All')
  else if not ChooseOption.Select('Store-' + ToString(Amount) + ' ', MOUSE_LEFT, True, False) then
    if ChooseOption.Select('Store-X') then
      Chat.AnswerQuery('Enter amount', ToString(Amount), Random(2000, 2500));

  Result := WaitUntil(Self.FindInPouch(Rune, Slot), 17, 3000);
end;

function TRSRunePouch.StackCount(slot: TBox; isFirst, isLast: Boolean): Int32;
var
  amount: TBox;
  leftPad, rightPad, yellowQty, whiteQty, greenQty: Int32;
  divine: Boolean;
begin
  divine := Self.IsDivine();
  if divine then
  begin
    if isFirst then
      leftPad := 20
    else
      leftPad := 6;
    if isLast then
      rightPad := 10
    else
      rightPad := 0;
  end
  else
  begin
    if isFirst then
    begin
      leftPad := 28;
      rightPad := 8;
    end
    else
    begin
      leftPad := 18;
      rightPad := 0;
    end;
  end;

  amount := slot;
  amount.X1 -= leftPad;
  amount.X2 := slot.X2 + rightPad;
  amount.Y2 := slot.Y1 + 8;
  yellowQty := 0;
  whiteQty := 0;
  greenQty := 0;
  if SRL.CountColor(RS_ITEM_YELLOW_STACK, amount) > 0 then
    yellowQty := OCR.RecognizeNumber(amount, TOCRColorFilter.Create([RS_ITEM_YELLOW_STACK]), RS_FONT_PLAIN_11);
  if SRL.CountColor(RS_ITEM_WHITE_STACK, amount) > 0 then
    whiteQty := OCR.RecognizeNumber(amount, TOCRColorFilter.Create([RS_ITEM_WHITE_STACK]), RS_FONT_PLAIN_11) * 1000;
  if SRL.CountColor(RS_ITEM_GREEN_STACK, amount) > 0 then
    greenQty := OCR.RecognizeNumber(amount, TOCRColorFilter.Create([RS_ITEM_GREEN_STACK]), RS_FONT_PLAIN_11) * 1000000;
  Result := yellowQty;
  if whiteQty > Result then
    Result := whiteQty;
  if greenQty > Result then
    Result := greenQty;
end;

function TRSRunePouch.GetRuneCount(Rune : TRSItem): Int32;
var
  slot: Int32;
  slots: TBoxArray;
begin
  if not Self.IsOpen then
    Exit;
  slots := Self.GetPouchBoxes();
  if not Self.FindInPouch(Rune, slot) then
    Exit;
  if not InRange(slot, 0, High(slots)) then
    Exit;
  Result := Self.StackCount(slots[slot], slot = 0, slot = High(slots));
end;

procedure TRSRunePouch.Setup(); override;
begin
  inherited;

  Self.Name := 'Rune Pouch';
  Self.Items.Name := Self.Name + '.Items';
  Self.Items.SlotBoxesFunction := @Self.GetPouchBoxes;
end;

procedure TRSRunePouch.SetupAlignment(); overload;
begin
  Self.Bounds := RUNE_POUCH_WINDOW;
end;

procedure TRSClient.ClientModeChanged(); override;
begin
  inherited;

  RunePouch.SetupAlignment();
end;

procedure TSRL.Setup(); override;
begin
  inherited;

  RunePouch.Setup();
end;
