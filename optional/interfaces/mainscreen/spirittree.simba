(*
Spirit tree location menu.

  SpiritTree.Scan();
  SpiritTree.Travel('Feldip Hills');
*)

{$DEFINE BASH_SPIRIT_TREE_INCLUDED}
{$IFNDEF SRL_OSR}
  {$I SRL-B/osr.simba}
{$ENDIF}

type
  TSpiritRow = record
    Stop, Dark, Grey: Int32;
    Unlocked: Boolean;
    Text: String;
    Bounds: TBox;
  end;
  TSpiritRowArray = array of TSpiritRow;

  TRSSpiritTree = record
    Ready, Scanned: Boolean;
    LastLocked: Boolean;
    Names, Keys, OpenNames: TStringArray;
    X, Y, Plane: TIntegerArray;
  end;

var
  SpiritTree: TRSSpiritTree;

function SpiritFold(const text: String): String;
var
  i: Int32;
  s: String;
begin
  s := LowerCase(text);
  Result := '';
  for i := 1 to Length(s) do
    if ((s[i] >= 'a') and (s[i] <= 'z')) or (s[i] = ' ') then
      Result := Result + s[i];
end;

procedure TRSSpiritTree.AddStop(const name, key: String; x, y, plane: Int32);
begin
  Self.Names += name;
  Self.Keys += key;
  Self.X += x;
  Self.Y += y;
  Self.Plane += plane;
end;

function TRSSpiritTree.CacheFile(): String;
begin
  Result := SIMBA_DATA_DIR + 'bashnav' + DirectorySeparator + 'spirittree.json';
end;

procedure TRSSpiritTree.LoadCache();
var
  text: String;
  json, item: TJSONObject;
  items: TJSONArray;
  i: Int32;
begin
  if not FileExists(Self.CacheFile()) then
    Exit;
  text := ReadFileContents(Self.CacheFile());
  if text = '' then
    Exit;
  try
    json.Init(text);
    items := json.getJSONArray('names');
    for i := 0 to items.High() do
    begin
      item := items.getJSONObject(i);
      if item.getString('name') <> '' then
        Self.OpenNames += item.getString('name');
    end;
  except
    SetLength(Self.OpenNames, 0);
  end;
end;

procedure TRSSpiritTree.SaveCache();
var
  i: Int32;
  text: String;
begin
  ForceDirectories(ExtractFilePath(Self.CacheFile()));
  text := '{"names":[';
  for i := 0 to High(Self.OpenNames) do
  begin
    if i > 0 then
      text := text + ',';
    text := text + '{"name":"' + Self.OpenNames[i] + '"}';
  end;
  text := text + ']}';
  WriteFileContents(Self.CacheFile(), text, False);
end;

procedure TRSSpiritTree.Ensure();
begin
  if Self.Ready then
    Exit;
  Self.AddStop('Tree Gnome Village', 'tree gnome village', 2539, 3166, 0);
  Self.AddStop('Gnome Stronghold', 'gnome stronghold', 2460, 3446, 0);
  Self.AddStop('Battlefield of Khazard', 'khazard', 2555, 3259, 0);
  Self.AddStop('Grand Exchange', 'grand exchange', 3185, 3510, 0);
  Self.AddStop('Feldip Hills', 'feldip', 2486, 2850, 0);
  Self.AddStop('Prifddinas', 'prifddinas', 3275, 6124, 0);
  Self.AddStop('Port Sarim', 'port sarim', 3060, 3258, 0);
  Self.AddStop('Etceteria', 'etceteria', 2613, 3858, 0);
  Self.AddStop('Brimhaven', 'brimhaven', 2802, 3203, 0);
  Self.AddStop('Hosidius', 'hosidius', 1693, 3542, 0);
  Self.AddStop('Farming Guild', 'farming guild', 1253, 3750, 0);
  Self.AddStop('Poison Waste', 'poison waste', 2339, 3111, 0);
  Self.AddStop('Laguna Aurorae', 'laguna', 1202, 2786, 0);
  Self.Ready := True;
  Self.LoadCache();
end;

function TRSSpiritTree.Count(): Int32;
begin
  Self.Ensure();
  Result := Length(Self.Names);
end;

function TRSSpiritTree.StopName(index: Int32): String;
begin
  Self.Ensure();
  Result := Self.Names[index];
end;

function TRSSpiritTree.StopX(index: Int32): Int32;
begin
  Self.Ensure();
  Result := Self.X[index];
end;

function TRSSpiritTree.StopY(index: Int32): Int32;
begin
  Self.Ensure();
  Result := Self.Y[index];
end;

function TRSSpiritTree.StopPlane(index: Int32): Int32;
begin
  Self.Ensure();
  Result := Self.Plane[index];
end;

function TRSSpiritTree.HasUnlocks(): Boolean;
begin
  Self.Ensure();
  Result := Length(Self.OpenNames) > 0;
end;

function TRSSpiritTree.MatchStop(const line: String): Int32;
var
  folded: String;
  i: Int32;
begin
  Self.Ensure();
  folded := SpiritFold(line);
  Result := -1;
  if folded = '' then
    Exit;
  if Pos('cancel', folded) > 0 then
    Exit(-2);
  if Pos('your house', folded) > 0 then
    Exit(-3);
  for i := 0 to High(Self.Keys) do
    if Pos(Self.Keys[i], folded) > 0 then
      Exit(i);
end;

function TRSSpiritTree.IndexOf(const name: String): Int32;
begin
  Result := Self.MatchStop(name);
  if Result < 0 then
    Result := -1;
end;

function TRSSpiritTree.Unlocked(index: Int32): Boolean;
var
  i: Int32;
begin
  Self.Ensure();
  Result := False;
  if (index < 0) or (index > High(Self.Names)) then
    Exit;
  for i := 0 to High(Self.OpenNames) do
    if Self.MatchStop(Self.OpenNames[i]) = index then
      Exit(True);
end;

procedure TRSSpiritTree.Forget(const name: String);
var
  i, idx: Int32;
  kept: TStringArray;
begin
  idx := Self.IndexOf(name);
  if idx < 0 then
    Exit;
  for i := 0 to High(Self.OpenNames) do
    if Self.MatchStop(Self.OpenNames[i]) <> idx then
      kept += Self.OpenNames[i];
  Self.OpenNames := kept;
  Self.SaveCache();
  WriteLn('[SpiritTree] Removed locked stop ', Self.Names[idx]);
end;

function TRSSpiritTree.ListArea(): TBox;
begin
  if RSClient.Mode = ERSClientMode.FIXED then
    Result := [8, 64, 450, 460]
  else
  begin
    Result := MainScreen.Bounds;
    Result.Y1 := Result.Y1 + 36;
    if (Result.X2 - Result.X1) > 520 then
      Result.X2 := Result.X1 + 520;
  end;
end;

function TRSSpiritTree.ReadRows(out rows: TSpiritRowArray): Boolean;
var
  lines: TStringArray;
  boxes: TBoxArray;
  i, dark, grey, stop, matched: Int32;
  row: TSpiritRow;
begin
  Result := False;
  SetLength(rows, 0);
  Self.Ensure();
  try
    lines := OCR.RecognizeLines(Self.ListArea(), TOCRColorFilter.Create([$192633, $254852], [45, 22]), RS_FONT_PLAIN_12, boxes);
  except
    Exit;
  end;
  matched := 0;
  for i := 0 to High(lines) do
  begin
    if (boxes[i].Y2 - boxes[i].Y1) < 6 then
      Continue;
    stop := Self.MatchStop(lines[i]);
    if stop = -1 then
      Continue;
    dark := SRL.CountColor(CTS0($192633, 22), boxes[i]) + SRL.CountColor(CTS0($254852, 18), boxes[i]);
    grey := SRL.CountColor(CTS0($5F5F5F, 16), boxes[i]);
    Inc(matched);
    row.Stop := stop;
    row.Dark := dark;
    row.Grey := grey;
    row.Unlocked := (dark > 30) and (grey * 3 < dark);
    row.Text := lines[i];
    row.Bounds := boxes[i];
    if (row.Bounds.X2 - row.Bounds.X1) > 240 then
      row.Bounds.X2 := row.Bounds.X1 + 240;
    rows += row;
  end;
  Result := matched >= 3;
  if not Result then
    SetLength(rows, 0);
end;

function TRSSpiritTree.Scan(): Boolean;
var
  rows: TSpiritRowArray;
  i: Int32;
  names: TStringArray;
  labelText: String;
begin
  Result := False;
  Self.Ensure();
  if Self.Scanned then
    Exit(Length(Self.OpenNames) > 0);
  Self.Scanned := True;
  if not Self.ReadRows(rows) then
    Exit(Length(Self.OpenNames) > 0);
  names := Copy(Self.OpenNames);
  for i := 0 to High(rows) do
  begin
    if rows[i].Stop >= 0 then
      labelText := Self.Names[rows[i].Stop]
    else if rows[i].Stop = -3 then
      labelText := 'Your house'
    else
      labelText := 'Cancel';
    WriteLn('[SpiritTree] ', rows[i].Dark, '/', rows[i].Grey, ' ', labelText, ' unlocked=', rows[i].Unlocked);
    if rows[i].Stop < 0 then
      Continue;
    if rows[i].Unlocked then
    begin
      if names.Find(labelText) < 0 then
        names += labelText;
    end
    else
      names.Remove(labelText);
  end;
  if Length(names) = 0 then
  begin
    WriteLn('[SpiritTree] Menu is open but every stop is locked.');
    Exit(False);
  end;
  Self.OpenNames := names;
  Self.SaveCache();
  WriteLn('[SpiritTree] Unlocked: ', Self.OpenNames);
  Result := True;
end;

function TRSSpiritTree.Travel(const name: String): Boolean;
var
  rows: TSpiritRowArray;
  i, want, waited: Int32;
  labelText, seen: String;
begin
  Result := False;
  Self.LastLocked := False;
  Self.Ensure();
  want := Self.MatchStop(name);
  if want = -2 then
    Exit;
  if want = -3 then
    labelText := 'Your house'
  else if want >= 0 then
    labelText := Self.Names[want]
  else
    Exit;
  waited := 0;
  while waited < 2500 do
  begin
    if Self.ReadRows(rows) then
    begin
      seen := '';
      for i := 0 to High(rows) do
      begin
        if seen <> '' then
          seen := seen + ', ';
        seen := seen + rows[i].Text;
        if rows[i].Stop = want then
        begin
          if not rows[i].Unlocked then
          begin
            Self.LastLocked := True;
            WriteLn('[SpiritTree] ', labelText, ' is locked.');
            Exit;
          end;
          Mouse.Click(rows[i].Bounds, MOUSE_LEFT);
          Exit(True);
        end;
      end;
      WriteLn('[SpiritTree] ', labelText, ' not in [', seen, '] after ', waited, 'ms.');
    end;
    Wait(200);
    waited := waited + 200;
  end;
  if want = -3 then
    Exit;
  WriteLn('[SpiritTree] ', labelText, ' is not on the open menu.');
end;

function TRSSpiritTree.IsOpen(): Boolean;
var
  rows: TSpiritRowArray;
begin
  Result := Self.ReadRows(rows);
end;

function TRSSpiritTree.Close(): Boolean;
begin
  if not Self.IsOpen() then
    Exit(True);
  Keyboard.PressKey(VK_ESCAPE);
  Result := WaitUntil(not Self.IsOpen(), 250, 2000);
end;
