procedure TAIChatbot.GUI_AddCombo(
  parent: TWinControl;
  var box: TLabeledCombobox;
  ctrlName, labelText: String;
  left, top: Int32;
  items: TStringArray;
  itemIndex: Int32
);
begin
  box.Create(parent);
  box.SetLeft(TControl.AdjustToDPI(left));
  box.SetTop(TControl.AdjustToDPI(top));
  box.SetWidth(TControl.AdjustToDPI(AIC_GUI_COMBO_W));
  box.SetHeight(TControl.AdjustToDPI(AIC_GUI_COMBO_H));
  box.SetName(ctrlName);
  box.SetCaption(labelText);
  box.AddItemArray(items);
  if (itemIndex >= 0) and (itemIndex <= High(items)) then
    box.SetItemIndex(itemIndex)
  else
    box.SetItemIndex(0);
  box.SetFontColor(AIC_GUI_TEXT);
  box.SetStyle(csDropDownList);
  box.SetFontSize(10);
  box.ComboBox.SetFontColor(AIC_GUI_TEXT);
  box.ComboBox.GetFont().SetSize(10);
end;

procedure TAIChatbot.BuildSettings(parent: TWinControl; formWidth: Int32 = 0);
var
  widthHint, serviceIndex, styleIndex, optionsH: Int32;
  options: TWinControl;
begin
  Self.ApplyScriptDefaults();

  if formWidth <= 0 then
    widthHint := parent.GetWidth()
  else
    widthHint := formWidth;
  if widthHint < TControl.AdjustToDPI(400) then
    widthHint := TControl.AdjustToDPI(700);

  Self.GUI_AddHeader(parent, 'AI Chat', 'Replies to public chat using an AI service. Leave disabled if you do not want the bot to talk.', widthHint);

  Self.GUI_AddCheck(parent, Self.GUIEnabledCB, 'aichat_enabled_checkbox', 'Enable AI Chatbot', 24, 100, Self.Enabled);
  Self.GUIEnabledCB.SetTooltip('When on, the script watches public chat and can type short replies.');

  optionsH := TControl.AdjustToDPI(470);
  Self.GUIOptionsPanel.Create(parent);
  Self.GUIOptionsPanel.SetLeft(0);
  Self.GUIOptionsPanel.SetTop(TControl.AdjustToDPI(128));
  Self.GUIOptionsPanel.SetWidth(widthHint);
  Self.GUIOptionsPanel.SetHeight(optionsH);
  Self.GUIOptionsPanel.SetBevelOuter(bvNone);
  Self.GUIOptionsPanel.SetColor(AIC_GUI_BG);
  options := Self.GUIOptionsPanel;

  Self.GUI_AddLabel(options, 'API', 24, 0, 11, AIC_GUI_TEXT, True);

  case LowerCase(Self.ApiService) of
    'groq': serviceIndex := 1;
    'deepseek': serviceIndex := 2;
    'chatgpt', 'openai': serviceIndex := 3;
    'local', 'ollama': serviceIndex := 4;
  else
    serviceIndex := 0;
  end;

  Self.GUI_AddCombo(options, Self.GUIServiceCombo, 'aichat_service', 'AI Service', 24, 18, ['Gemini', 'Groq', 'DeepSeek', 'ChatGPT', 'Local'], serviceIndex);
  Self.GUIServiceCombo.SetTooltip('Which AI provider to use. Gemini and Groq both offer free API keys.');
  Self.GUIServiceCombo.ComboBox.SetOnChange(@Self.OnServiceChanged);

  Self.GUI_AddEdit(options, Self.GUIApiKeyEdit, 'aichat_api_key', 'API Key', Self.ApiKey, AIC_GUI_COL2, 18, AIC_GUI_EDIT_W);
  Self.GUIApiKeyEdit.SetPasswordChar('*');
  Self.GUIApiKeyEdit.SetTooltip('Your key from the AI provider. Not needed for Local/Ollama.');
  Self.GUIApiKeyEdit.Edit.SetOnChange(@Self.OnApiKeyChanged);

  Self.GUITestBtn.Create(options);
  Self.GUITestBtn.SetLeft(TControl.AdjustToDPI(AIC_GUI_COL3));
  Self.GUITestBtn.SetTop(TControl.AdjustToDPI(31));
  Self.GUITestBtn.SetWidth(TControl.AdjustToDPI(80));
  Self.GUITestBtn.SetHeight(TControl.AdjustToDPI(AIC_GUI_BTN_H));
  Self.GUITestBtn.SetCaption('Test API');
  Self.GUITestBtn.SetTooltip('Checks that the selected service and API key work.');
  Self.GUITestBtn.SetOnClick(@Self.OnTestClicked);

  Self.GUIApiHelpInfo.Create(options);
  Self.GUIApiHelpInfo.SetLeft(TControl.AdjustToDPI(24));
  Self.GUIApiHelpInfo.SetTop(TControl.AdjustToDPI(72));
  Self.GUIApiHelpInfo.GetFont().SetSize(10);
  Self.GUIApiHelpInfo.GetFont().SetColor(AIC_GUI_LINK);
  Self.GUIApiHelpInfo.SetOnClick(@Self.OnApiHelpClicked);

  styleIndex := Integer(Self.ResponseStyle);
  if (styleIndex < 0) or (styleIndex > 3) then
    styleIndex := 0;

  Self.GUI_AddLabel(options, 'Chat Settings', 24, 100, 11, AIC_GUI_TEXT, True);

  Self.GUI_AddEdit(options, Self.GUIActivityEdit, 'aichat_activity', 'Current activity', Self.Activity, 24, 118, AIC_GUI_EDIT_W + AIC_GUI_EDIT_W + 48);
  Self.GUIActivityEdit.SetTooltip('What this character is doing right now. Example: prif agility / mining iron at mining guild');

  Self.GUI_AddMemo(options, Self.GUIExtraInstructionsMemo, 'aichat_extra', 'Extra instructions (optional)', Self.ExtraInstructions, 24, 168, AIC_GUI_EDIT_W + AIC_GUI_EDIT_W + 48, 78);
  Self.GUIExtraInstructionsMemo.SetTooltip('Optional add-ons to the AI personality. Example: keep answers vague about exact location');

  Self.GUI_AddCombo(options, Self.GUIResponseStyleCombo, 'aichat_style', 'Reply style', 24, 258, ['Normal', 'Friendly', 'Casual', 'Minimal'], styleIndex);
  Self.GUIResponseStyleCombo.SetTooltip('Normal = balanced. Friendly = warmer. Casual = slangy. Minimal = very short.');
  Self.GUIResponseStyleCombo.ComboBox.SetOnChange(@Self.OnStyleChanged);

  Self.GUI_AddCheck(options, Self.GUIMemoryCB, 'aichat_memory_checkbox', 'Remember recent chat with each player', AIC_GUI_COL2, 276, Self.UseConversationMemory);
  Self.GUIMemoryCB.SetTooltip('Keeps short context so replies make more sense in an ongoing conversation.');

  Self.GUIDefaultBtn.Create(options);
  Self.GUIDefaultBtn.SetLeft(TControl.AdjustToDPI(AIC_GUI_COL3));
  Self.GUIDefaultBtn.SetTop(TControl.AdjustToDPI(271));
  Self.GUIDefaultBtn.SetWidth(TControl.AdjustToDPI(80));
  Self.GUIDefaultBtn.SetHeight(TControl.AdjustToDPI(AIC_GUI_BTN_H));
  Self.GUIDefaultBtn.SetCaption('Default');
  Self.GUIDefaultBtn.SetTooltip('Reset reply limits, style, and extra instructions. Leaves activity as-is.');
  Self.GUIDefaultBtn.SetOnClick(@Self.OnDefaultClicked);

  Self.GUI_AddEdit(options, Self.GUIMaxNearbyEdit, 'aichat_nearby', 'Pause if this many players nearby', IntToStr(Self.MaxNearbyPlayers), 24, 316, AIC_GUI_EDIT_W);
  Self.GUIMaxNearbyEdit.Edit.SetOnKeyPress(@Self.GUIMaxNearbyEdit.Edit.NumberField);
  Self.GUIMaxNearbyEdit.Edit.SetOnChange(@Self.OnMaxNearbyChanged);
  Self.GUIMaxNearbyEdit.SetTooltip('If more players than this are nearby, the bot stops replying until it is quieter.');

  Self.GUI_AddEdit(options, Self.GUIMaxInteractionEdit, 'aichat_interactions', 'Max interactions per player', IntToStr(Self.MaxInteractionCount), AIC_GUI_COL2, 316, AIC_GUI_EDIT_W);
  Self.GUIMaxInteractionEdit.Edit.SetOnKeyPress(@Self.GUIMaxInteractionEdit.Edit.NumberField);
  Self.GUIMaxInteractionEdit.Edit.SetOnChange(@Self.OnMaxInteractionChanged);
  Self.GUIMaxInteractionEdit.SetTooltip('How many replies one player can get before the cooldown starts.');

  Self.GUI_AddEdit(options, Self.GUICooldownEdit, 'aichat_cooldown', 'Cooldown after max (minutes)', IntToStr(Max(1, Self.InteractionCooldown div 60000)), AIC_GUI_COL3, 316, AIC_GUI_EDIT_W);
  Self.GUICooldownEdit.Edit.SetOnKeyPress(@Self.GUICooldownEdit.Edit.NumberField);
  Self.GUICooldownEdit.Edit.SetOnChange(@Self.OnCooldownChanged);
  Self.GUICooldownEdit.SetTooltip('How long to wait before chatting with that player again after hitting the max.');

  Self.GUI_AddEdit(options, Self.GUIIgnoreListEdit, 'aichat_ignore', 'Ignore messages containing (comma separated)', Self.IgnoreListAsString(), 24, 376, AIC_GUI_EDIT_W + AIC_GUI_EDIT_W + 48);
  Self.GUIIgnoreListEdit.Edit.SetOnChange(@Self.OnIgnoreListChanged);
  Self.GUIIgnoreListEdit.SetTooltip('Skip chat that looks like spam trading ads. Example: Buying,Selling,Discord');

  Self.GUI_AddCheck(options, Self.GUILogConvCB, 'aichat_logconv_checkbox', 'Save conversations to a log file', 24, 431, Self.LogConversations);
  Self.GUILogConvCB.SetTooltip('Writes chats to files you can review later with Review Logs.');

  Self.GUIReviewLogsBtn.Create(options);
  Self.GUIReviewLogsBtn.SetLeft(TControl.AdjustToDPI(AIC_GUI_COL2));
  Self.GUIReviewLogsBtn.SetTop(TControl.AdjustToDPI(431));
  Self.GUIReviewLogsBtn.SetWidth(TControl.AdjustToDPI(110));
  Self.GUIReviewLogsBtn.SetHeight(TControl.AdjustToDPI(AIC_GUI_BTN_H));
  Self.GUIReviewLogsBtn.SetCaption('Review Logs');
  Self.GUIReviewLogsBtn.SetTooltip('Open the folder of saved conversation logs so you can read them.');
  Self.GUIReviewLogsBtn.SetOnClick(@Self.OnReviewLogsClicked);

  Self.GUIDeleteLogsBtn.Create(options);
  Self.GUIDeleteLogsBtn.SetLeft(TControl.AdjustToDPI(AIC_GUI_COL2 + 120));
  Self.GUIDeleteLogsBtn.SetTop(TControl.AdjustToDPI(431));
  Self.GUIDeleteLogsBtn.SetWidth(TControl.AdjustToDPI(110));
  Self.GUIDeleteLogsBtn.SetHeight(TControl.AdjustToDPI(AIC_GUI_BTN_H));
  Self.GUIDeleteLogsBtn.SetCaption('Delete Logs');
  Self.GUIDeleteLogsBtn.SetTooltip('Delete all saved AI Chat conversation log files.');
  Self.GUIDeleteLogsBtn.SetOnClick(@Self.OnDeleteLogsClicked);

  Self.HasGUI := True;
  Self.UpdateApiHelpLink();
  Self.UpdateOptionsVisibility();
end;

function TScriptForm.CreateAIChatSettings(): TTabSheet;
var
  tab: TTabSheet;
begin
  Self.AddTab('AI Chatbot');
  tab := Self.Tabs[High(Self.Tabs)];
  Result := tab;

  AIChatbot.Enabled := AIChatGUIEnabled;
  AIChatbot.ApiService := AIChatGUIApiService;
  AIChatbot.ApiKey := AIChatGUIApiKey;
  AIChatbot.ResponseStyle := TAIChatResponseStyle(AIChatGUIResponseStyle);
  AIChatbot.LoadSettings();
  AIChatbot.BuildSettings(tab, Self.Form.GetWidth());
end;

function TAntiban.DoAntiban(checkBreaks: Boolean = True; checkSleeps: Boolean = True): Boolean; override;
begin
  Result := inherited;

  if not AIChatbot.Enabled then
    Exit;

  if not (checkBreaks or checkSleeps) then
    Exit;

  if not AIChatbot.IsInitialized then
    AIChatbot.Init();

  AIChatbot.ProcessMessages();
end;

// When AI Chatbot is enabled, suppress chat antibans
procedure TAntiban.ChatScrolling(); override;
begin
  if AIChatbot.Enabled then
    Exit;

  inherited;
end;

