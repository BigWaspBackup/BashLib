var
  WEBHOOKURL: String = '';
  ENABLEWEBHOOKS: Boolean = False;
  OVERRIDEBREAKS: Boolean = False;
  CUSTOMBREAKINTERVAL: Integer = 60;
  CUSTOMBREAKDURATION: Integer = 5;
  ENABLEWORLDHOPPING: Boolean = False;
  WORLDHOPINTERVAL: Integer = 45;
  ENABLEFARMRUNS: Boolean = False;
  BIRDHOUSEENABLED: Boolean = False;
  Discord: TDiscordClient;

type
  TBASHGUIProc = procedure of object;
  TBASHGUISenderProc = procedure(sender: TObject) of object;
  TBASHGUIExtrasProc = procedure(var nextY: Int32) of object;

  TBASHPremiumGUI = record(TBASHGUIBase)
    BrandTitle, WindowTitle, Username: String;
    LegacyAntibanSection, WebhookTestPrefix: String;
    HasFarm, HasAIChat, HasWorldHopping, HasMaxActions, HasStopAtLevel, HasRandomEvents: Boolean;
    LockCameraTask, LockChatTask, LockMouseTask, LockGameTabsTask, LockBankTask: Boolean;
    StopAtLevelSkills: array of ERSSkill;

    ActionNav, AccountsNav, AntibanNav, AIChatNav: TImage;
    PatchesNav, TravelNav, BirdhouseNav: TImage;
    ActionSection, AccountsSection, AntibanSection, AIChatSection: TPanel;
    PatchesSection, TravelSection, BirdhouseSection: TPanel;
    ExtraNavs: array of TImage;
    ExtraSections: array of TPanel;

    EnableFarmRunsCheckBox, EnableBirdhouseRunsCheckBox: TLabeledCheckBox;
    SideRunReturnCombo: TLabeledComboBox;

    EnableWebhooksCheckBox: TLabeledCheckBox;
    WebHookInput: TLabeledEdit;
    TestButton: TButton;
    WebhookInfo: TLabel;

    MaxActionsInput, MaxTimeInput: TLabeledEdit;
    ShortBreaksCheckBox, SleepBreaksCheckBox: TLabeledCheckBox;
    SleepHourInput, SleepLengthInput: TLabeledEdit;
    TasksEnabledCheckBox: TLabeledCheckBox;
    TaskCameraCheckBox, TaskMouseCheckBox, TaskChatCheckBox: TLabeledCheckBox;
    TaskGameTabsCheckBox, TaskBankCheckBox: TLabeledCheckBox;
    OverrideBreaksCheckBox: TLabeledCheckBox;
    CustomBreakIntervalInput, CustomBreakDurationInput: TLabeledEdit;
    EnableWorldHoppingCheckBox: TLabeledCheckBox;
    WorldHopIntervalInput: TLabeledEdit;
    StopAtLevelChip: TImage;
    RandomEventsButton: TButton;

    FnInitGUI, FnLoadActionSettings, FnBuildActionSection, FnBuildExtraSections: TBASHGUIProc;
    FnBuildAccountsExtras, FnApplyActionSettings, FnAfterBuildShell: TBASHGUIProc;
    FnConfigureAntibanTasks, FnSetupAIChat, FnRefreshNavLayout: TBASHGUIProc;
    FnBuildAntibanExtras: TBASHGUIExtrasProc;
    FnStartScript, FnOnFarmEnableChanged, FnOnBirdhouseEnableChanged, FnWebhooksCheckboxChanged: TBASHGUISenderProc;

    {$IFDEF BASH_FARM_RUNNER}
    FarmGUI: TBASHFarmGUI;
    {$ENDIF}
  end;

function BASHPremiumCurrentUser(): String;
begin
  if (Login.PlayerIndex < 0) or (Login.PlayerIndex > High(Login.Players)) then
    Result := 'NoUserNameSelected'
  else
    Result := Login.Players[Login.PlayerIndex].User;
end;

function TBASHPremiumGUI.ReadINIKey(section, key, defaultVal: String): String;
begin
  Result := ReadINI(section, key, BASH_GUI_SETTINGS_FILE);
  if Result = '' then
    Result := defaultVal;
end;

function TBASHPremiumGUI.ReadAntibanINI(key, defaultVal: String): String;
var
  v: String;
begin
  v := ReadINI(Self.Username + BASH_GUI_ANTIBAN_SECTION, key, BASH_GUI_SETTINGS_FILE);
  if v <> '' then
    Exit(v);
  if Self.LegacyAntibanSection <> '' then
  begin
    v := ReadINI(Self.Username + Self.LegacyAntibanSection, key, BASH_GUI_SETTINGS_FILE);
    if v <> '' then
      Exit(v);
  end;
  Result := defaultVal;
end;

procedure TBASHPremiumGUI.WriteAntibanINI(key, value: String);
begin
  WriteINI(Self.Username + BASH_GUI_ANTIBAN_SECTION, key, value, BASH_GUI_SETTINGS_FILE);
end;

procedure TBASHPremiumGUI.InitGUI();
begin
  Self.BrandTitle := 'BASH';
  Self.WindowTitle := 'BASH Script';
  Self.WebhookTestPrefix := 'Test message from BASH';
  Self.HasFarm := False;
  Self.HasAIChat := False;
  Self.HasWorldHopping := True;
  Self.HasMaxActions := True;
  Self.HasStopAtLevel := False;
  Self.HasRandomEvents := False;
end;

