{$IFNDEF BASH_GUI_KIT}
  {$I BashLib/optional/handlers/bashgui.simba}
{$ENDIF}

const
  BASH_BH_GUI_W = 900;
  BASH_BH_GUI_H = 560;

type
  TBASHBirdHouseGUI = record(TBASHGUIBase)
    SettingsNav: TImage;
    SettingsSection: TPanel;
  end;

procedure TBASHBirdHouseGUI.RefreshLogEnabled();
var
  combo: TComboBox;
  caption: TLabel;
  enabled: Boolean;
begin
  enabled := not Self.ReadCheck('cb_bash_bh_bestlog');

  combo := Self.Form.GetChild('lcb_bash_bh_log_combobox');
  if combo <> nil then
    combo.SetEnabled(enabled);

  caption := Self.Form.GetChild('lcb_bash_bh_log_caption');
  if caption <> nil then
    caption.SetEnabled(enabled);
end;

procedure TBASHBirdHouseGUI.OnBestLogCheckChange({$H-}sender: TObject); {$H+}
begin
  Self.RefreshLogEnabled();
end;

procedure TBASHBirdHouseGUI.StyleNav({$H-}selected: TImage); {$H+}
begin
  Self.ActiveNav := Self.SettingsNav;
  Self.PaintRoundChip(Self.SettingsNav, Self.SettingsNav.GetHint(), BASH_GUI_ACCENT, BASH_GUI_NAV, True);
end;

procedure TBASHBirdHouseGUI.ShowSettings({$H-}sender: TObject); {$H+}
begin
  Self.SettingsSection.SetVisible(True);
  Self.StyleNav(Self.SettingsNav);
end;

procedure TBASHBirdHouseGUI.BuildSettingsSection();
var
  lcb: TLabeledComboBox;
  cb: TLabeledCheckBox;
begin
  Self.AddHeader(
    Self.SettingsSection,
    'Settings',
    'Birdhouse type, seeds, and when to run.'
  );

  Self.AddCombo(
    Self.SettingsSection, lcb, 'lcb_bash_bh_log', 'Birdhouse / log type',
    24, 110, BASH_BH_LOG_TYPES, BASHBirdHouseConfig.LogTypeIdx
  );
  lcb.SetTooltip('Log / birdhouse tier to craft and place.');

  Self.AddCombo(
    Self.SettingsSection, lcb, 'lcb_bash_bh_seed', 'Seed',
    BASH_GUI_COMBO_COL2, 110, BASH_BH_SEEDS, BASHBirdHouseConfig.SeedIdx
  );
  lcb.SetTooltip('Seed type used to fill birdhouses..');

  Self.AddCheck(
    Self.SettingsSection, cb, 'cb_bash_bh_bestlog', 'Always use best log',
    24, 200, BASHBirdHouseConfig.UseBestLog
  );
  cb.SetTooltip('Auto-pick the highest birdhouse your Hunter level unlocks..');
  cb.CheckBox.SetOnChange(@Self.OnBestLogCheckChange);

  Self.AddCheck(
    Self.SettingsSection, cb, 'cb_bash_bh_runnow', 'Run birdhouse now',
    24, 250, BASHBirdHouseConfig.RunNow
  );
  cb.SetTooltip('Ignore the birdhouse timer and run a birdhouse lap immediately when the script starts.');

  Self.RefreshLogEnabled();
end;

procedure TBASHBirdHouseGUI.BuildShell(tab: TTabSheet);
begin
  Self.BuildChrome(tab);

  Self.BrandLabel := Self.MakeLabel(Self.NavPanel, 'BASH Birdhouse', 16, 28, 15, BASH_GUI_TEXT, True);

  Self.SettingsNav := Self.MakeNavItem(Self.NavPanel, 'Settings', 12, 100, True);

  Self.SettingsSection := Self.MakePanel(Self.ContentPanel, 0, 0, 100, 100, BASH_GUI_BG);
  Self.SettingsSection.SetWidth(Self.MainWidth());
  Self.SettingsSection.SetHeight(Self.ContentHeight());

  Self.BuildSettingsSection();

  Self.SettingsNav.SetOnClick(@Self.ShowSettings);
  Self.StartChip.SetOnClick(@Self.StartScript);

  Self.ShowSettings(Self.SettingsNav);
end;

procedure TBASHBirdHouseGUI.ApplySettings();
begin
  BASHBirdHouseConfig.LogTypeIdx := Self.ReadComboIdx('lcb_bash_bh_log');
  BASHBirdHouseConfig.SeedIdx := Self.ReadComboIdx('lcb_bash_bh_seed');
  BASHBirdHouseConfig.UseBestLog := Self.ReadCheck('cb_bash_bh_bestlog');
  BASHBirdHouseConfig.RunNow := Self.ReadCheck('cb_bash_bh_runnow');

  BASHBirdHouseConfig.Write();
  BASHBirdHouseRunner.ApplyConfig(BASHBirdHouseConfig);
end;

procedure TBASHBirdHouseGUI.StartScript({$H-}sender: TObject); override; {$H+}
begin
  Self.ApplySettings();
  BASHBirdHouseRunner.Init();
  WriteLn('[BASHBirdHouse] Ready - log=', ToStr(BASHBirdHouseRunner.LogType),
    ' seed=', ToStr(BASHBirdHouseRunner.Seed));

  try
    Self._WarmBuildCache();
  except
  end;
  Self.Form.SetOnClose(nil);
  Self.Form.Close();
end;

procedure TBASHBirdHouseGUI.Run(); override;
var
  tab: TTabSheet;
begin
  BASHBirdHouseConfig.Read();
  Self.Setup('BASH Birdhouse', [BASH_BH_GUI_W, BASH_BH_GUI_H], False);
  Self.AddTab('BASH Birdhouse');
  tab := Self.Tabs[High(Self.Tabs)];
  Self.BuildShell(tab);
  inherited;
end;
