{$DEFINE BASH_FARM_RUNNER}

{$IFNDEF WL_OSR}
  {$I BashLib/osr.simba}
{$ENDIF}
{$IFNDEF SKUNK_UNIVERSAL_TRANSPORTV2}
  {$I BashLib/optional/handlers/teleports/transportv2.simba}
{$ENDIF}
{$IFNDEF WL_QUETZAL_INCLUDED}
  {$I BashLib/optional/interfaces/mainscreen/quetzal.simba}
{$ENDIF}

{$I BashLib/optional/handlers/bashfarm/types.simba}
{$I BashLib/optional/handlers/bashfarm/patchdata.simba}
{$I BashLib/optional/handlers/bashfarm/journal.simba}
{$I BashLib/optional/handlers/bashfarm/contracts.simba}
{$I BashLib/optional/handlers/bashfarm/patch.simba}
{$I BashLib/optional/handlers/bashfarm/config.simba}
{$I BashLib/optional/handlers/bashfarm/travel.simba}

type
  TBASHFarmRunner = record
    Patches: array of TBASHFarmPatch;
    Transport: TUniversalTransportV2;
    ReadyTimer: TCountDown;
    Journal: TBASHFarmJournal;
    Contract: TBASHFarmContract;
    CompostMethod: EBASHCompostMethod;
    BarbDibber: Boolean;
    MagicSecateurs: Boolean;
    LumbyElite: Boolean;
    Initialized: Boolean;
    PatchesCompleted, PatchesSkipped, RunsComplete: Int32;

    ExtraRuneNames: TRSItemArray;
    ExtraRuneQtys: TIntegerArray;

    EquippedScanDone: Boolean;
    EquippedTravelKeys: TStringArray;
    ArdyCloakEquipped: Boolean;
    FairyStaffEquipped: Boolean;
    FairyStaffName: TRSItem;
  end;

var
  BASHFarmRunner: TBASHFarmRunner;

function TBASHFarmRunner.CompostItemName(): TRSItem;
begin
  case Self.CompostMethod of
    EBASHCompostMethod.BOTTOMLESS: Exit('Bottomless compost bucket');
    EBASHCompostMethod.ULTRA: Exit('Ultracompost');
    EBASHCompostMethod.SUPER: Exit('Supercompost');
    EBASHCompostMethod.FERTILE_SOIL: Exit('Ultracompost');
    EBASHCompostMethod.REGULAR: Exit('Compost');
  end;
  Result := 'Ultracompost';
end;

procedure TBASHFarmRunner.SetupUpTexts(var patch: TBASHFarmPatch);
begin
  patch.EmptyUpText := BASH_PATCH_TYPE_NAMES[Ord(patch.Data.PatchType)];
  patch.PlantedUpText := patch.EmptyUpText;

  case patch.Data.PatchType of
    EBASHPatchType.ALLOTMENT:
      patch.HarvestUpText := 'arves';
    EBASHPatchType.TREE, EBASHPatchType.CRYSTAL:
      patch.HarvestUpText := 'heck';
  else
    patch.HarvestUpText := 'ick';
  end;
end;

procedure TBASHFarmRunner.AddPatch(patchId: EBASHFarmPatch; travel: TTeleportLocation; seed: TRSItem);
var
  patch: TBASHFarmPatch;
begin
  EnsureBASHFarmPatchData();

  patch.Reset();
  patch.Id := patchId;
  patch.Data := BASHFarmPatchData[patchId];
  patch.Travel := travel;
  patch.Seed := seed;
  patch.CompostItem := Self.CompostItemName();
  patch.UseFertileSoil := Self.CompostMethod = EBASHCompostMethod.FERTILE_SOIL;
  patch.MagicSecateurs := Self.MagicSecateurs;
  patch.BarbDibber := Self.BarbDibber;
  Self.SetupUpTexts(patch);

  patch.Seed := Self.Contract.ApplyContractOverride(patchId, seed);

  Self.Patches += patch;
end;

procedure TBASHFarmRunner.ClearPatches();
begin
  SetLength(Self.Patches, 0);
  Self.Initialized := False;
  Self.EquippedScanDone := False;
  SetLength(Self.EquippedTravelKeys, 0);
  Self.ArdyCloakEquipped := False;
  Self.FairyStaffEquipped := False;
  Self.FairyStaffName := '';
end;

procedure TBASHFarmRunner.BuildFromConfig(cfg: TBASHFarmConfig);
var
  p: EBASHFarmPatch;
  seed: TRSItem;
begin
  Self.ClearPatches();

  Self.CompostMethod := cfg.GetCompostMethod();
  Self.BarbDibber := cfg.BarbDibber;
  Self.MagicSecateurs := cfg.MagicSecateurs;
  Self.LumbyElite := cfg.LumbyElite;

  for p := Low(EBASHFarmPatch) to High(EBASHFarmPatch) do
  begin
    if p = EBASHFarmPatch.HARMONY_ISLAND_HERB then
      Continue;
    if not cfg.Enabled[p] then
      Continue;

    seed := cfg.SeedForPatch(p);
    if seed = '' then
    begin
      WriteLn('[BASHFarm] Skip ', ToStr(p), ': no seed/sapling');
      Continue;
    end;

    Self.AddPatch(p, BASHFarmTravelForPatch(p, cfg), seed);
  end;

  if cfg.RunNow then
    Self.ReadyTimer.Init(0);

end;

function BASHFarmIsGuildFairyCIR(constref travel: TTeleportLocation): Boolean;
begin
  Result := 'bash guild fairy cir' in travel.destination.Lower();
end;

function TBASHFarmRunner.CollectChunks(): array of TRSMapChunk;
var
  i, j, k: Int32;
  chunk: TRSMapChunk;
  exists, needArdyCloak: Boolean;
begin
  SetLength(Result, 0);
  needArdyCloak := False;

  for i := 0 to High(Self.Patches) do
  begin
    if BASHFarmIsGuildFairyCIR(Self.Patches[i].Travel) then
      needArdyCloak := True;

    for j := 0 to High(Self.Patches[i].Data.Chunks) do
    begin
      chunk := Self.Patches[i].Data.Chunks[j];
      exists := False;
      for k := 0 to High(Result) do
        if (Result[k].Chunk = chunk.Chunk) then
        begin
          exists := True;
          Break;
        end;
      if not exists then
        Result += chunk;
    end;
  end;

  if needArdyCloak then
  begin
    chunk.Chunk := Box(38, 51, 42, 48);
    chunk.Planes := [0];
    exists := False;
    for k := 0 to High(Result) do
      if (Result[k].Chunk = chunk.Chunk) then
      begin
        exists := True;
        Break;
      end;
    if not exists then
      Result += chunk;
  end;
end;

procedure TBASHFarmRunner.BindMapObjects();
begin
  Map.Walker.AdaptiveWalk := True;
  Map.Walker._DoorHandler.Enabled := True;

  Objects.Data := nil;
  NPCs.Data := nil;
  Banks.MapObjects := [];
  Banks.ObjectsCache := [];
  Banks.NPCsCache := [];
  Objects.Setup(Map.Objects(), @Map.Walker);
  NPCs.Setup(Map.NPCs(), @Map.Walker);
end;

procedure TBASHFarmRunner.EnsureChunks();
begin
  if not Map.IsSetup then
  begin
    WriteLn('[BASHFarm] EnsureChunks: map not loaded');
    Exit;
  end;

  Self.BindMapObjects();
end;

procedure TBASHFarmRunner.Init();
begin
  if Self.Initialized then
    Exit;

  EnsureBASHFarmPatchData();

  if Length(Self.Patches) = 0 then
    WriteLn('[BASHFarm] Init with no patches');

  Self.Journal.Load();
  Self.Contract.Clear();
  Self.ReadyTimer.Init(0);
  Self.Initialized := True;
end;

function TBASHFarmRunner.EnsureBankOpen(): Boolean;
begin
  if Bank.IsOpen(False) then
    Exit(True);

  WriteLn('[BASHFarm] Bank not open - opening');

  if Banks.WalkOpen() then
  begin
    if Bank.IsOpen() or BankPin.IsOpen() then
      Exit(True);
  end;

  if Banks.Open() then
  begin
    if Bank.IsOpen() or BankPin.IsOpen() then
      Exit(True);
  end;

  WriteLn('[BASHFarm] Could not open bank');
  Result := False;
end;

function TBASHFarmRunner.FarmWithdrawHelper(item: TRSItem; quant: Int32): Boolean;
var
  attempt, have, need: Int32;
begin
  if item = '' then
    Exit(True);

  if quant < 0 then
    quant := Bank.QUANTITY_ALL;

  if Inventory.ContainsItem(item) then
  begin
    if quant = Bank.QUANTITY_ALL then
      Exit(True);
    if (Inventory.CountItem(item) >= quant) or (Inventory.CountItemStack(item) >= quant) then
      Exit(True);
  end;

  if not Self.EnsureBankOpen() then
  begin
    WriteLn('[BASHFarm] FarmWithdrawHelper: bank not open for ', ToStr(item));
    Exit(False);
  end;

  WriteLn('[BASHFarm] Withdrawing ', quant, 'x ', ToStr(item));

  for attempt := 1 to 5 do
  begin
    have := Max(Inventory.CountItem(item), Inventory.CountItemStack(item));
    if Inventory.ContainsItem(item) then
    begin
      if (quant = Bank.QUANTITY_ALL) or (have >= quant) then
        Exit(True);
    end;

    if not Bank.IsOpen(False) then
    begin
      WriteLn('[BASHFarm] FarmWithdrawHelper: bank closed mid-withdraw (', ToStr(item), ')');
      if not Self.EnsureBankOpen() then
        Exit(False);
    end;

    if quant = Bank.QUANTITY_ALL then
      need := quant
    else
      need := quant - Max(0, have);

    if not Bank.WithdrawItem([item, need, False], True) then
      WriteLn('[BASHFarm] WithdrawItem returned False for ', ToStr(item));

    Result := WaitUntil(
      Inventory.ContainsItem(item) and
      ((quant = Bank.QUANTITY_ALL) or
       (Inventory.CountItem(item) >= quant) or
       (Inventory.CountItemStack(item) >= quant)),
      35, 4000);

    if Result then
    begin
      Exit(True);
    end;

  end;

  WriteLn('[BASHFarm] Failed to withdraw ', ToStr(item));
  Result := False;
end;

function BASHFarmIsMagicTeleport(tp: ETeleportType): Boolean;
begin
  Result := tp in [
    ETeleportType.NORMAL_MAGIC,
    ETeleportType.LUNAR_MAGIC,
    ETeleportType.ARCEUUS_MAGIC,
    ETeleportType.ANCIENT_MAGICKS
  ];
end;

procedure BASHFarmAddRuneNeed(var names: TRSItemArray; var qtys: TIntegerArray; rune: TRSItem; amount: Int32);
var
  i: Int32;
begin
  if (rune = '') or (amount <= 0) then
    Exit;

  for i := 0 to High(names) do
    if names[i] = rune then
    begin
      Inc(qtys[i], amount);
      Exit;
    end;

  names += rune;
  qtys += amount;
end;

procedure BASHFarmAddMagicRuneCost(var names: TRSItemArray; var qtys: TIntegerArray; travel: TTeleportLocation);
var
  dest: String;
begin
  dest := travel.destination.Lower();

  case dest of
    'ardougne':
      begin
        BASHFarmAddRuneNeed(names, qtys, 'Water rune', 2);
        BASHFarmAddRuneNeed(names, qtys, 'Law rune', 2);
      end;
    'falador':
      begin
        BASHFarmAddRuneNeed(names, qtys, 'Air rune', 3);
        BASHFarmAddRuneNeed(names, qtys, 'Water rune', 1);
        BASHFarmAddRuneNeed(names, qtys, 'Law rune', 1);
      end;
    'lumbridge':
      begin
        BASHFarmAddRuneNeed(names, qtys, 'Earth rune', 3);
        BASHFarmAddRuneNeed(names, qtys, 'Air rune', 1);
        BASHFarmAddRuneNeed(names, qtys, 'Law rune', 1);
      end;
    'varrock':
      begin
        BASHFarmAddRuneNeed(names, qtys, 'Air rune', 3);
        BASHFarmAddRuneNeed(names, qtys, 'Fire rune', 1);
        BASHFarmAddRuneNeed(names, qtys, 'Law rune', 1);
      end;
    'catherby':
      begin
        BASHFarmAddRuneNeed(names, qtys, 'Water rune', 3);
        BASHFarmAddRuneNeed(names, qtys, 'Law rune', 3);
        BASHFarmAddRuneNeed(names, qtys, 'Astral rune', 1);
      end;
    'camelot':
      begin
        BASHFarmAddRuneNeed(names, qtys, 'Air rune', 5);
        BASHFarmAddRuneNeed(names, qtys, 'Law rune', 1);
      end;
    'house':
      begin
        BASHFarmAddRuneNeed(names, qtys, 'Air rune', 1);
        BASHFarmAddRuneNeed(names, qtys, 'Earth rune', 1);
        BASHFarmAddRuneNeed(names, qtys, 'Law rune', 1);
      end;
    'ortus civitas spell':
      begin
        BASHFarmAddRuneNeed(names, qtys, 'Fire rune', 1);
        BASHFarmAddRuneNeed(names, qtys, 'Earth rune', 1);
        BASHFarmAddRuneNeed(names, qtys, 'Law rune', 2);
      end;
  else
    WriteLn('[BASHFarm] No rune cost table for magic teleport: ', travel.destination);
  end;
end;

function BASHFarmExpandItemVariants(variants: TRSItemArray): TRSItemArray;
var
  j: Int32;
  variant: TRSItem;
  concrete: TRSItemArray;
begin
  SetLength(Result, 0);
  for j := 0 to High(variants) do
  begin
    variant := variants[j];
    concrete := variant.GetArray();
    Result += concrete;
  end;
end;

function BASHFarmHasTeleportItem(constref travel: TTeleportLocation; checkEquipment: Boolean = True): Boolean;
var
  j: Int32;
  tpItem: TRSItem;
  concrete: TRSItemArray;
begin
  for j := 0 to High(travel.items) do
  begin
    tpItem := travel.items[j];
    if tpItem = '' then
      Continue;
    concrete := tpItem.GetArray();
    if Inventory.ContainsAny(concrete) then
      Exit(True);
    if checkEquipment and Equipment.ContainsAny(concrete) then
      Exit(True);
  end;

  if (travel.teleportType = ETeleportType.DIARY_ITEM) and (travel.item <> '') then
  begin
    concrete := BASHFarmExpandItemVariants(getNumberedDiaryItems(travel.item));
    if Inventory.ContainsAny(concrete) then
      Exit(True);
    if checkEquipment and Equipment.ContainsAny(concrete) then
      Exit(True);
    Exit(False);
  end;

  if (travel.teleportType = ETeleportType.JEWELLERY) and (travel.item <> '') then
  begin
    concrete := BASHFarmExpandItemVariants(getChargedJewelleryNames(travel.item));
    if Inventory.ContainsAny(concrete) then
      Exit(True);
    if checkEquipment and Equipment.ContainsAny(concrete) then
      Exit(True);
    Exit(False);
  end;

  if travel.item <> '' then
  begin
    tpItem := travel.item;
    concrete := tpItem.GetArray();
    if Inventory.ContainsAny(concrete) then
      Exit(True);
    if checkEquipment and Equipment.ContainsAny(concrete) then
      Exit(True);
  end;

  Result := False;
end;

function BASHFarmTeleportEquipped(constref travel: TTeleportLocation): Boolean;
var
  j: Int32;
  tpItem: TRSItem;
  concrete: TRSItemArray;
begin
  for j := 0 to High(travel.items) do
  begin
    tpItem := travel.items[j];
    if tpItem = '' then
      Continue;
    concrete := tpItem.GetArray();
    if Equipment.ContainsAny(concrete) then
      Exit(True);
  end;

  if (travel.teleportType = ETeleportType.DIARY_ITEM) and (travel.item <> '') then
  begin
    concrete := BASHFarmExpandItemVariants(getNumberedDiaryItems(travel.item));
    Exit(Equipment.ContainsAny(concrete));
  end;

  if (travel.teleportType = ETeleportType.JEWELLERY) and (travel.item <> '') then
  begin
    concrete := BASHFarmExpandItemVariants(getChargedJewelleryNames(travel.item));
    Exit(Equipment.ContainsAny(concrete));
  end;

  if travel.item <> '' then
  begin
    tpItem := travel.item;
    concrete := tpItem.GetArray();
    Exit(Equipment.ContainsAny(concrete));
  end;

  Result := False;
end;

function BASHFarmTravelItemKey(constref travel: TTeleportLocation): String;
var
  j: Int32;
begin
  Result := ToStr(travel.teleportType) + ':';
  for j := 0 to High(travel.items) do
    if travel.items[j] <> '' then
      Result += ToStr(travel.items[j]).Lower() + '|';
  if travel.item <> '' then
    Result += ToStr(travel.item).Lower();
  if Result.EndsWith(':') then
    Result += travel.destination.Lower();
end;

function TBASHFarmRunner.TravelKeyEquipped(constref key: String): Boolean;
var
  k: Int32;
begin
  for k := 0 to High(Self.EquippedTravelKeys) do
    if Self.EquippedTravelKeys[k] = key then
      Exit(True);
  Result := False;
end;

procedure TBASHFarmRunner.EnsureEquippedTeleportCache();
var
  i: Int32;
  travel: TTeleportLocation;
  itemKey: String;
  needGuildFairy: Boolean;
begin
  if Self.EquippedScanDone then
    Exit;

  if Length(Self.Patches) = 0 then
    Exit;

  WriteLn('[BASHFarm] Scanning equipment for teleports / fairy staff');

  if Bank.IsOpen() then
  begin
    Bank.Close();
    WaitUntil(not Bank.IsOpen(), 50, 2500);
  end;

  SetLength(Self.EquippedTravelKeys, 0);
  Self.ArdyCloakEquipped := False;
  Self.FairyStaffEquipped := Self.LumbyElite;
  Self.FairyStaffName := '';
  needGuildFairy := False;

  for i := 0 to High(Self.Patches) do
  begin
    travel := Self.Patches[i].Travel;

    if BASHFarmIsGuildFairyCIR(travel) then
    begin
      needGuildFairy := True;
      Continue;
    end;

    if BASHFarmIsMagicTeleport(travel.teleportType) then
      Continue;

    itemKey := BASHFarmTravelItemKey(travel);
    if Self.TravelKeyEquipped(itemKey) then
      Continue;

    if BASHFarmTeleportEquipped(travel) then
    begin
      WriteLn('[BASHFarm] Equipped teleport: ', Self.Patches[i].Data.Name,
              ' (', travel.destination, ')');
      Self.EquippedTravelKeys += itemKey;
    end;
  end;

  if needGuildFairy or Self.TravelKeyEquipped(BASHFarmTravelItemKey(RSTeleportsV2.MONASTERY)) then
  begin
    Self.ArdyCloakEquipped := BASHFarmTeleportEquipped(RSTeleportsV2.MONASTERY);
    if Self.ArdyCloakEquipped then
      WriteLn('[BASHFarm] Ardougne cloak equipped - will cast from equipment');
  end;

  if not Self.ArdyCloakEquipped then
    for i := 0 to High(Self.Patches) do
    begin
      travel := Self.Patches[i].Travel;
      if (travel.teleportType = ETeleportType.DIARY_ITEM) and
         ('ardougne cloak' in ToStr(travel.item).Lower()) then
      begin
        if BASHFarmTeleportEquipped(travel) then
        begin
          Self.ArdyCloakEquipped := True;
          WriteLn('[BASHFarm] Ardougne cloak equipped - will cast from equipment');
        end;
        Break;
      end;
    end;

  if needGuildFairy and (not Self.LumbyElite) then
  begin
    if Equipment.ContainsItem('Lunar staff') then
    begin
      Self.FairyStaffEquipped := True;
      Self.FairyStaffName := 'Lunar staff';
    end
    else if Equipment.ContainsItem('Dramen staff') then
    begin
      Self.FairyStaffEquipped := True;
      Self.FairyStaffName := 'Dramen staff';
    end;

    if Self.FairyStaffEquipped then
      WriteLn('[BASHFarm] ', Self.FairyStaffName, ' equipped - skip withdraw / re-equip');
  end;

  Self.EquippedScanDone := True;
  Inventory.Open();
end;

function TBASHFarmRunner.OnStart(): Boolean;
var
  i, j, seedsNeeded: Int32;
  seed, tpItem: TRSItem;
  counted, magicSeen, itemSeen, withdrew: Boolean;
  travel: TTeleportLocation;
  runeNames: TRSItemArray;
  runeQtys: TIntegerArray;
  seenMagic, seenItems: TStringArray;
  magicKey, itemKey: String;
  needGuildFairy: Boolean;
begin
  Self.EnsureEquippedTeleportCache();

  { Cache may close an already-open bank; reopen if the host opened it for us }
  if not Bank.IsOpen() then
  begin
    if not Self.EnsureBankOpen() then
    begin
      WriteLn('[BASHFarm] OnStart: bank is not open');
      Exit(False);
    end;
  end;

  WriteLn('[BASHFarm] OnStart: depositing inventory');
  Bank.DepositAll();

  needGuildFairy := False;
  for i := 0 to High(Self.Patches) do
    if BASHFarmIsGuildFairyCIR(Self.Patches[i].Travel) then
    begin
      needGuildFairy := True;
      Break;
    end;

  for i := 0 to High(Self.Patches) do
  begin
    seed := Self.Patches[i].Seed;
    if seed = '' then
      Continue;

    counted := False;
    for j := 0 to i - 1 do
      if Self.Patches[j].Seed = seed then
      begin
        counted := True;
        Break;
      end;
    if counted then
      Continue;

    seedsNeeded := 0;
    for j := 0 to High(Self.Patches) do
      if Self.Patches[j].Seed = seed then
      begin
        if Self.Patches[j].Data.PatchType = EBASHPatchType.ALLOTMENT then
          Inc(seedsNeeded, 3)
        else
          Inc(seedsNeeded);
      end;

    Self.FarmWithdrawHelper(seed, seedsNeeded);
  end;

  SetLength(runeNames, 0);
  SetLength(runeQtys, 0);
  SetLength(seenMagic, 0);
  SetLength(seenItems, 0);

  for i := 0 to High(Self.Patches) do
  begin
    travel := Self.Patches[i].Travel;

    if BASHFarmIsMagicTeleport(travel.teleportType) then
    begin
      magicKey := ToStr(travel.teleportType) + ':' + travel.destination.Lower();
      magicSeen := False;
      for j := 0 to High(seenMagic) do
        if seenMagic[j] = magicKey then
        begin
          magicSeen := True;
          Break;
        end;

      if not magicSeen then
      begin
        seenMagic += magicKey;
        BASHFarmAddMagicRuneCost(runeNames, runeQtys, travel);
      end;
      Continue;
    end;

    itemKey := BASHFarmTravelItemKey(travel);
    itemSeen := False;
    for j := 0 to High(seenItems) do
      if seenItems[j] = itemKey then
      begin
        itemSeen := True;
        Break;
      end;
    if itemSeen then
      Continue;
    seenItems += itemKey;

    if BASHFarmIsGuildFairyCIR(travel) then
      Continue;

    if Self.TravelKeyEquipped(itemKey) then
      Continue;

    { Invent-only: equipment already cached }
    if BASHFarmHasTeleportItem(travel, False) then
      Continue;

    WriteLn('[BASHFarm] Withdrawing teleport for ', Self.Patches[i].Data.Name,
            ' -> ', travel.destination);

    if travel.teleportType in [ETeleportType.JEWELLERY, ETeleportType.DIARY_ITEM] then
    begin
      if not Self.EnsureBankOpen() then
        WriteLn('[BASHFarm] Warning: bank closed before teleport withdraw')
      else if not Self.Transport.withdrawTeleportItem(travel) then
        WriteLn('[BASHFarm] Warning: could not withdraw teleport for ', Self.Patches[i].Data.Name);
      Continue;
    end;

    withdrew := False;
    for j := 0 to High(travel.items) do
    begin
      tpItem := travel.items[j];
      if tpItem = '' then
        Continue;
      if Inventory.ContainsItem(tpItem) then
      begin
        withdrew := True;
        Break;
      end;
      if Self.FarmWithdrawHelper(tpItem, 1) then
      begin
        withdrew := True;
        Break;
      end;
    end;

    if (not withdrew) and (travel.item <> '') then
    begin
      if Inventory.ContainsItem(travel.item) then
        withdrew := True
      else if Self.FarmWithdrawHelper(travel.item, 1) then
        withdrew := True;
    end;

    if (not BASHFarmHasTeleportItem(travel, False)) and
       (travel.teleportType in [ETeleportType.OTHER, ETeleportType.SCROLL]) then
    begin
      if not Self.EnsureBankOpen() then
        WriteLn('[BASHFarm] Warning: bank closed before teleport withdraw')
      else if not Self.Transport.withdrawTeleportItem(travel) then
        WriteLn('[BASHFarm] Warning: could not withdraw teleport for ', Self.Patches[i].Data.Name);
    end
    else if not BASHFarmHasTeleportItem(travel, False) then
      WriteLn('[BASHFarm] Warning: failed to withdraw teleport for ', Self.Patches[i].Data.Name);
  end;

  if needGuildFairy then
  begin
    if not Self.EnsureBankOpen() then
      WriteLn('[BASHFarm] Warning: bank closed before guild fairy withdraw')
    else
    begin
      if Self.ArdyCloakEquipped then
        WriteLn('[BASHFarm] Skipping Ardougne cloak withdraw (equipped)')
      else if not Self.Transport.withdrawTeleportItem(RSTeleportsV2.MONASTERY) then
        WriteLn('[BASHFarm] Warning: could not withdraw Ardougne cloak for guild fairy');

      if not Self.LumbyElite then
      begin
        if Self.FairyStaffEquipped or
           Inventory.ContainsItem('Dramen staff') or
           Inventory.ContainsItem('Lunar staff') then
          WriteLn('[BASHFarm] Skipping Dramen/Lunar staff withdraw (already have)')
        else if not Self.FarmWithdrawHelper('Dramen staff', 1) then
        begin
          if not Self.FarmWithdrawHelper('Lunar staff', 1) then
            WriteLn('[BASHFarm] Warning: could not withdraw Dramen or Lunar staff');
        end;
      end;
    end;
  end;

  for i := 0 to High(Self.ExtraRuneNames) do
  begin
    if (i > High(Self.ExtraRuneQtys)) or (Self.ExtraRuneQtys[i] <= 0) then
      Continue;
    BASHFarmAddRuneNeed(runeNames, runeQtys, Self.ExtraRuneNames[i], Self.ExtraRuneQtys[i]);
  end;

  if Length(runeNames) > 0 then
  begin
    if not Self.EnsureBankOpen() then
    begin
      WriteLn('[BASHFarm] OnStart: could not reopen bank for runes');
      Exit(False);
    end;

    for i := 0 to High(runeNames) do
    begin
      if not Self.FarmWithdrawHelper(runeNames[i], runeQtys[i]) then
      begin
        WriteLn('[BASHFarm] OnStart: failed to withdraw ', runeQtys[i], 'x ', ToStr(runeNames[i]));
        Exit(False);
      end;
    end;
  end;

  for i := 0 to High(Self.Patches) do
    if Self.Patches[i].Data.PatchType in [EBASHPatchType.TREE, EBASHPatchType.FRUIT] then
    begin
      Self.FarmWithdrawHelper('Coins', 2000);
      Break;
    end;

  if Bank.IsOpen() then
    Bank.Close();
  Result := True;
end;

procedure TBASHFarmRunner.OnComplete();
begin
  Bank.CachedQuantity := 0;
end;

function TBASHFarmRunner.UseDJPFairyRingCIR(): Boolean;
var
  savedFairyWalker, savedRSWalker: Boolean;
begin
  if Self.LumbyElite then
    FairyRing.Item := 'null'
  else if Self.FairyStaffEquipped and (Self.FairyStaffName <> '') then
    FairyRing.Item := Self.FairyStaffName
  else if Inventory.ContainsItem('Lunar staff') then
    FairyRing.Item := 'Lunar staff'
  else
    FairyRing.Item := 'Dramen staff';

  FairyRing.SetupFairyRings();
  savedFairyWalker := FairyRing.FairyRings.Filter.Walker;
  savedRSWalker := RSObjects.FairyRing.Filter.Walker;
  FairyRing.FairyRings.Filter.Walker := False;
  RSObjects.FairyRing.Filter.Walker := False;

  Result := FairyRing.Teleport('CIR');

  FairyRing.FairyRings.Filter.Walker := savedFairyWalker;
  RSObjects.FairyRing.Filter.Walker := savedRSWalker;
end;

function TBASHFarmRunner.TeleportGuildFairyCIR(): Boolean;
var
  cirLand, djpTile, me: TPoint;
  savedScreenWalk, savedAdaptiveWalk: Boolean;
  i: Int32;
begin
  Result := False;
  cirLand := RSTeleportsV2.CIR_NORTHEAST_OF_THE_FARMING_GUILD.worldPoint;
  djpTile := [6528, 37510];

  Map.Walker._DoorHandler.Enabled := True;

  if Map.Position().InBox(BASH_GUILD_MAP) then
    Exit(True);

  if Map.Walker.InRange(cirLand, 40) or Map.Walker.AnyInRange(BASH_GUILD_DOOR_FRONT_TILES, 20) then
    Exit(True);

  if not Map.Walker.AnyInRange(BASH_DJP_FAIRY_RING_TILES, 12) then
  begin
    if not Map.Position().InBox(BASH_ARDY_MONASTERY_LANDING) then
    begin
      if not Self.Transport.Run(RSTeleportsV2.MONASTERY) then
      begin
        WriteLn('[BASHFarm] Guild Fairy CIR: Monastery teleport failed');
        Exit(False);
      end;

      if not WaitUntil(Map.Position().InBox(BASH_ARDY_MONASTERY_LANDING), 35, 6000) then
      begin
        WriteLn('[BASHFarm] Guild Fairy CIR: not in monastery landing box after cloak');
        Exit(False);
      end;
    end;

    if not Map.Walker.WebWalk(djpTile, 5, 0.15) then
    begin
      WriteLn('[BASHFarm] Guild Fairy CIR: WebWalk to DJP ring failed');
      Exit(False);
    end;
  end;

  savedScreenWalk := Map.Walker.ScreenWalk;
  savedAdaptiveWalk := Map.Walker.AdaptiveWalk;
  Map.Walker.ScreenWalk := False;
  Map.Walker.AdaptiveWalk := False;

  if not Self.UseDJPFairyRingCIR() then
  begin
    Map.Walker.ScreenWalk := savedScreenWalk;
    Map.Walker.AdaptiveWalk := savedAdaptiveWalk;
    WriteLn('[BASHFarm] Guild Fairy CIR: fairy ring use failed');
    Exit(False);
  end;

  Map.Walker.ScreenWalk := savedScreenWalk;
  Map.Walker.AdaptiveWalk := savedAdaptiveWalk;

  Minimap.WaitMoving();
  for i := 0 to 200 do
  begin
    me := Map.Position();
    if me.InBox(BASH_GUILD_MAP) or me.InRange(BASH_GUILD_DOOR_FRONT, 400) or me.InRange(cirLand, 150) then
      Break;
    Wait(50);
  end;

  Map.Walker._DoorHandler.Enabled := True;
  Result := True;
end;

function TBASHFarmRunner.TeleportTo(travel: TTeleportLocation): Boolean;
var
  startPos: TPoint;
  item: TRSItem;
  i, attempt: Int32;
  dest, itemName: String;
  isKharedst: Boolean;
begin
  Result := False;
  startPos := Map.Position();
  dest := travel.destination.Lower();

  if BASHFarmIsGuildFairyCIR(travel) then
  begin
    Result := Self.TeleportGuildFairyCIR();
    Exit;
  end;

  if BASHFarmIsMagicTeleport(travel.teleportType) and (dest = 'house') then
  begin
    Result := Magic.CastSpell(ERSSpell.TELEPORT_TO_HOUSE, 'Outside');
    if Result then
    begin
      Result := WaitUntil(not Map.Position().InRange(startPos, 10), 35, 10000);
    end;
    if not Result then
      WriteLn('[BASHFarm] House spell (Outside) failed');
    Exit;
  end;

  if (dest = 'outside') and (Length(travel.items) > 0) then
  begin
    for i := 0 to High(travel.items) do
    begin
      item := travel.items[i];
      if (item = '') or (not Inventory.ContainsItem(item)) then
        Continue;
      Result := Inventory.ClickItem(item, 'Outside');
      if Result then
        Break;
    end;
    if not Result then
      for i := 0 to High(travel.items) do
      begin
        item := travel.items[i];
        if (item = '') or (not Equipment.ContainsItem(item)) then
          Continue;
        Result := Equipment.ClickItem(item, 'Outside');
        if Result then
          Break;
      end;
    if Result then
    begin
      Result := WaitUntil(not Map.Position().InRange(startPos, 10), 35, 10000);
    end;
    if not Result then
      WriteLn('[BASHFarm] House tablet (Outside) failed');
    Exit;
  end;

  isKharedst := False;
  for i := 0 to High(travel.items) do
  begin
    itemName := ToStr(travel.items[i]).Lower();
    if ('book of the dead' in itemName) or ('kharedst' in itemName) then
    begin
      isKharedst := True;
      Break;
    end;
  end;

  if isKharedst and ('lancallium' in dest) then
  begin
    for i := 0 to High(travel.items) do
    begin
      item := travel.items[i];
      if (item = '') or (not Inventory.ContainsItem(item)) then
        Continue;

      if Inventory.ClickItem(item, 'Reminisce') then
      begin
        WaitUntil(Chat.IsOpen(), 35, 350);
        Keyboard.Send('1');
        Result := True;
        Break;
      end;
    end;

    if not Result then
      for i := 0 to High(travel.items) do
      begin
        item := travel.items[i];
        if (item = '') or (not Equipment.ContainsItem(item)) then
          Continue;

        if Equipment.ClickItem(item, 'Reminisce') then
        begin
          WaitUntil(Chat.IsOpen(), 35, 350);
          Keyboard.Send('1');
          Result := True;
          Break;
        end;
      end;

    if Result then
    begin
      Result := WaitUntil(not Map.Position().InRange(startPos, 10), 35, 12000);
    end;
    if not Result then
      WriteLn('[BASHFarm] Book of the dead Reminisce -> 1 (Lunch) failed');
    Exit;
  end;

  if 'ortus hunter cape' in dest then
  begin
    Result := Self.TeleportOrtusHunterCape();
    Exit;
  end;

  if 'ortus quetzal whistle' in dest then
  begin
    Result := Self.TeleportOrtusQuetzalWhistle();
    Exit;
  end;

  if 'ortus civitas tablet' in dest then
  begin
    Result := Self.TeleportOrtusCivitasTablet();
    Exit;
  end;

  if 'ortus civitas spell' in dest then
  begin
    Result := Self.TeleportOrtusCivitasSpell();
    Exit;
  end;

  for attempt := 1 to 3 do
  begin
    if BASHFarmIsMagicTeleport(travel.teleportType) then
      Result := Self.Transport.run(travel, True, False, Map)
    else
      Result := Self.Transport.run(travel, False, False, Map);

    if Result then
      Exit;

    WriteLn('[BASHFarm] Teleport attempt ', attempt, '/3 failed: ',
            travel.destination, ' (', ToStr(travel.teleportType), ')');
  end;
end;

function TBASHFarmRunner.OrtusWalkNorthToFarm(): Boolean;
var
  me, lep, dest: TPoint;
  dist, scale: Double;
begin
  WriteLn('[BASHFarm] Ortus: walking north from Hunter Guild to farm');
  lep := BASH_ORTUS_LEP;
  me := Map.Position();
  dist := me.DistanceTo(lep);

  if dist <= 14 then
    Exit(True);

  scale := 10 / dist;
  dest.X := Round(lep.X + (me.X - lep.X) * scale);
  dest.Y := Round(lep.Y + (me.Y - lep.Y) * scale);

  Result := Map.Walker.WebWalk(dest, 3, 0.15);
  if not Result then
    Result := Map.Position().InBox(BASH_ORTUS_MAP);
end;

function TBASHFarmRunner.OrtusUseQuetzalWhistle(): Boolean;
begin
  Result := Quetzal.TravelFromWhistle(EQuetzalLanding.HUNTER_GUILD, True);
end;

function TBASHFarmRunner.OrtusUseHunterCape(): Boolean;
var
  item: TRSItem;
  capes: TRSItemArray;
begin
  Result := False;
  capes := ['Hunter cape(t)', 'Hunter cape'];

  for item in capes do
  begin
    if Inventory.ContainsItem(item) then
    begin
      if Inventory.ClickItem(item, 'Teleport') then
      begin
        if WaitUntil(Chat.FindOption('Hunter Guild'), 35, 4000) then
          Chat.ClickOption('Hunter Guild');
        Result := WaitUntil(Minimap.PercentBlack() < 25, 35, 5000);
        if Result then
          Exit;
      end;
    end;

    if Equipment.ContainsItem(item) then
    begin
      if Equipment.ClickItem(item, 'Hunter Guild') then
      begin
        Result := WaitUntil(Minimap.PercentBlack() < 25, 35, 5000);
        if Result then
          Exit;
      end;
    end;
  end;
end;

function TBASHFarmRunner.TeleportOrtusHunterCape(): Boolean;
begin
  Result := False;
  WriteLn('[BASHFarm] Ortus travel: Hunter Guild (Hunters Cape)');

  if Self.OrtusUseHunterCape() then
  begin
    Result := Self.OrtusWalkNorthToFarm();
    Exit;
  end;

  WriteLn('[BASHFarm] Ortus: no Hunter cape available');
end;

function TBASHFarmRunner.TeleportOrtusQuetzalWhistle(): Boolean;
begin
  Result := False;
  WriteLn('[BASHFarm] Ortus travel: Quetzal Whistle');

  if Self.OrtusUseQuetzalWhistle() then
  begin
    Result := Self.OrtusWalkNorthToFarm();
    Exit;
  end;

  WriteLn('[BASHFarm] Ortus: no quetzal whistle available');
end;

function TBASHFarmRunner.OrtusUseRenuToHunterGuild(): Boolean;
begin
  WriteLn('[BASHFarm] Ortus: using Quetzal Transport (Renu) to Hunter Guild');
  Result := Quetzal.TravelFromRenu(EQuetzalLanding.HUNTER_GUILD);
end;

function TBASHFarmRunner.TeleportOrtusCivitasAfterArrive(): Boolean;
begin
  WaitUntil((Minimap.PercentBlack() < 25), 35, 1200);

  if not Self.OrtusUseRenuToHunterGuild() then
    Exit(False);

  Result := Self.OrtusWalkNorthToFarm();
end;

function TBASHFarmRunner.TeleportOrtusCivitasTablet(): Boolean;
var
  startPos: TPoint;
begin
  Result := False;
  startPos := Map.Position();
  WriteLn('[BASHFarm] Ortus travel: Civitas tablet -> Quetzal -> Hunter Guild');

  if not Inventory.ContainsItem('Civitas illa fortis teleport') then
  begin
    WriteLn('[BASHFarm] Ortus: no Civitas tablet in inventory');
    Exit(False);
  end;

  if not Inventory.ClickItem('Civitas illa fortis teleport', 'Break') then
    Exit(False);

  if not WaitUntil(not Map.Position().InRange(startPos, 10), 35, 12000) then
    Exit(False);

  Result := Self.TeleportOrtusCivitasAfterArrive();
end;

function TBASHFarmRunner.TeleportOrtusCivitasSpell(): Boolean;
var
  startPos: TPoint;
begin
  Result := False;
  startPos := Map.Position();
  WriteLn('[BASHFarm] Ortus travel: Civitas spell -> Quetzal -> Hunter Guild');

  if not Magic.CastSpell(ERSSpell.CIVITAS_ILLA_FORTIS_TELEPORT, 'Cast') then
  begin
    WriteLn('[BASHFarm] Ortus: Civitas spell cast failed');
    Exit(False);
  end;

  if not WaitUntil(not Map.Position().InRange(startPos, 10), 35, 12000) then
    Exit(False);

  Result := Self.TeleportOrtusCivitasAfterArrive();
end;

function BASHFarmIsGuildPatch(id: EBASHFarmPatch): Boolean;
begin
  Result := id in [
    EBASHFarmPatch.GUILD_HERB,
    EBASHFarmPatch.GUILD_FLOWER,
    EBASHFarmPatch.GUILD_ALLOT_N,
    EBASHFarmPatch.GUILD_ALLOT_S,
    EBASHFarmPatch.GUILD_BUSH,
    EBASHFarmPatch.GUILD_CACTUS,
    EBASHFarmPatch.GUILD_ANIMA,
    EBASHFarmPatch.GUILD_TREE,
    EBASHFarmPatch.GUILD_REDWOOD,
    EBASHFarmPatch.GUILD_FRUIT,
    EBASHFarmPatch.GUILD_CELASTRUS
  ];
end;

function BASHFarmSameLocation(constref a, b: TBASHFarmPatch): Boolean;
begin
  if BASHFarmIsGuildPatch(a.Id) and BASHFarmIsGuildPatch(b.Id) then
    Exit(True);

  Result := (a.Data.LeprechaunCoords.X = b.Data.LeprechaunCoords.X) and
            (a.Data.LeprechaunCoords.Y = b.Data.LeprechaunCoords.Y);
end;

function BASHFarmIsPhasmatys(id: EBASHFarmPatch): Boolean;
begin
  Result := id in [
    EBASHFarmPatch.PHASMATYS_HERB,
    EBASHFarmPatch.PHASMATYS_FLOWER,
    EBASHFarmPatch.PHASMATYS_ALLOT_N,
    EBASHFarmPatch.PHASMATYS_ALLOT_S
  ];
end;

function BASHFarmIsAllotStyle(patchType: EBASHPatchType): Boolean;
begin
  Result := patchType in [EBASHPatchType.HERB, EBASHPatchType.FLOWER, EBASHPatchType.ALLOTMENT];
end;

procedure TBASHFarmRunner.ShufflePatchesByLocation();
var
  i, j, k, locCount, startIdx, pick, tmpIdx: Int32;
  locFirst: TIntegerArray;
  locOrder: TIntegerArray;
  groups: array of array of TBASHFarmPatch;
  flat: array of TBASHFarmPatch;
  tmp: TBASHFarmPatch;
begin
  if Length(Self.Patches) <= 1 then
    Exit;

  SetLength(locFirst, 0);
  for i := 0 to High(Self.Patches) do
  begin
    startIdx := -1;
    for j := 0 to High(locFirst) do
      if BASHFarmSameLocation(Self.Patches[i], Self.Patches[locFirst[j]]) then
      begin
        startIdx := j;
        Break;
      end;
    if startIdx < 0 then
      locFirst += i;
  end;

  locCount := Length(locFirst);
  SetLength(groups, locCount);

  for j := 0 to locCount - 1 do
  begin
    SetLength(groups[j], 0);
    for i := 0 to High(Self.Patches) do
      if BASHFarmSameLocation(Self.Patches[i], Self.Patches[locFirst[j]]) then
        groups[j] += Self.Patches[i];

    for i := High(groups[j]) downto 1 do
    begin
      pick := Random(i + 1);
      tmp := groups[j][i];
      groups[j][i] := groups[j][pick];
      groups[j][pick] := tmp;
    end;
  end;

  SetLength(locOrder, locCount);
  for j := 0 to locCount - 1 do
    locOrder[j] := j;

  for j := locCount - 1 downto 1 do
  begin
    pick := Random(j + 1);
    tmpIdx := locOrder[j];
    locOrder[j] := locOrder[pick];
    locOrder[pick] := tmpIdx;
  end;

  if (locCount > 1) and BASHFarmIsPhasmatys(groups[locOrder[locCount - 1]][0].Id) then
  begin
    pick := Random(locCount - 1);
    tmpIdx := locOrder[locCount - 1];
    locOrder[locCount - 1] := locOrder[pick];
    locOrder[pick] := tmpIdx;
  end;

  SetLength(flat, 0);
  for j := 0 to locCount - 1 do
  begin
    k := locOrder[j];
    for i := 0 to High(groups[k]) do
      flat += groups[k][i];
  end;

  Self.Patches := flat;
end;

procedure TBASHFarmRunner.PreparePatch(var patch: TBASHFarmPatch);
begin
  patch.Reset();
  patch.Seed := Self.Contract.ApplyContractOverride(patch.Id, patch.Seed);
  patch.CompostItem := Self.CompostItemName();
  patch.UseFertileSoil := Self.CompostMethod = EBASHCompostMethod.FERTILE_SOIL;
  patch.MagicSecateurs := Self.MagicSecateurs;

  if Self.Journal.IsLikelyGrowing(patch.Id) and (patch.Data.PatchType in [EBASHPatchType.TREE, EBASHPatchType.FRUIT]) then
    WriteLn('[BASHFarm] Journal: ', patch.Data.Name, ' likely still growing (', Self.Journal.GetPlantedItem(patch.Id), ')');
end;

procedure TBASHFarmRunner.RecordPatchResult(constref patch: TBASHFarmPatch);
begin
  if patch.Skip then
    Inc(Self.PatchesSkipped)
  else if patch.Complete or patch.Harvested or patch.Planted then
    Inc(Self.PatchesCompleted);
end;

procedure TBASHFarmRunner.SkipRemainingAtLocation(fromIdx, toIdx: Int32; reason: String);
var
  k: Int32;
  patch: TBASHFarmPatch;
begin
  for k := fromIdx to toIdx do
  begin
    patch := Self.Patches[k];
    if patch.Skip then
      Continue;

    // Patches already completed (e.g. during the harvest phase) count as
    // completed rather than being re-recorded as skipped.
    if not patch.Complete then
      patch.SkipPatch(reason);
    Self.RecordPatchResult(patch);
    Self.Patches[k] := patch;
  end;
end;

function TBASHFarmRunner.TeleportAwayFromPhasmatys(nextPatchIdx: Int32): Boolean;
begin
  Result := False;

  if nextPatchIdx > High(Self.Patches) then
  begin
    WriteLn('[BASHFarm] Phasmatys HP drop - no next location to teleport to');
    Exit;
  end;

  WriteLn('[BASHFarm] Phasmatys HP drop - teleporting toward ',
          Self.Patches[nextPatchIdx].Data.Name);
  Result := Self.TeleportTo(Self.Patches[nextPatchIdx].Travel);
  if not Result then
    WriteLn('[BASHFarm] Phasmatys escape teleport failed');
end;

function TBASHFarmRunner.ArriveAtLocation(var patch: TBASHFarmPatch): Boolean;
begin
  Result := False;

  if not patch.AtFarm() then
  begin
    if not Self.TeleportTo(patch.Travel) then
    begin
      patch.SkipPatch('Teleport failed');
      Exit(False);
    end;
  end;

  if not patch.HandleStrongholdShortcut() then
  begin
    patch.SkipPatch('Stronghold shortcut failed (need 73 Agility if below rocks)');
    Exit(False);
  end;

  if not patch.AtFarm() then
  begin
    if not patch.WalkNearLeprechaun(10) then
      WriteLn('[BASHFarm] Warning: could not walk to farm near leprechaun at ', patch.Data.Name);
  end;

  Result := patch.AtFarm();
end;

procedure TBASHFarmRunner.Run();
var
  i, j, k, m, allotCount, needCompost, compostQty, phasStartHp: Int32;
  patch: TBASHFarmPatch;
  usePhased, phasWatch, phasBailed: Boolean;
begin
  if not Self.Initialized then
    Self.Init();

  BASHEnsureRunZoom(5, 25);

  { Before host OnStart opens the bank }
  Self.EnsureEquippedTeleportCache();

  if not Self.OnStart() then
  begin
    WriteLn('[BASHFarm] OnStart returned False, aborting');
    Exit;
  end;

  Self.EnsureChunks();

  Self.ShufflePatchesByLocation();

  i := 0;
  while i <= High(Self.Patches) do
  begin
    j := i;
    while (j < High(Self.Patches)) and BASHFarmSameLocation(Self.Patches[i], Self.Patches[j + 1]) do
      Inc(j);

    for k := i to j do
    begin
      patch := Self.Patches[k];
      Self.PreparePatch(patch);
      Self.Patches[k] := patch;
    end;

    patch := Self.Patches[i];
    if not Self.ArriveAtLocation(patch) then
    begin
      Self.Patches[i] := patch;
      Self.RecordPatchResult(patch);
      for k := i + 1 to j do
      begin
        patch := Self.Patches[k];
        patch.SkipPatch('Location arrive failed');
        Self.Patches[k] := patch;
        Self.RecordPatchResult(patch);
      end;
      i := j + 1;
      Continue;
    end;
    Self.Patches[i] := patch;

    phasWatch := BASHFarmIsPhasmatys(Self.Patches[i].Id);
    phasStartHp := 0;
    phasBailed := False;
    if phasWatch then
    begin
      phasStartHp := Minimap.GetHPLevel();
      for k := i to j do
      begin
        Self.Patches[k].CombatHpWatch := True;
        Self.Patches[k].CombatStartHp := phasStartHp;
      end;
    end;

    allotCount := 0;
    for k := i to j do
      if BASHFarmIsAllotStyle(Self.Patches[k].Data.PatchType) then
        Inc(allotCount);

    usePhased := (allotCount >= 2) and (Random(100) < Random(20, 30));

    if usePhased then
      WriteLn('[BASHFarm] Phased pick-all then seed-all at ', Self.Patches[i].Data.Name, ' group (', (j - i + 1), ' patches)')
    else
      WriteLn('[BASHFarm] Sequential patch flow at ', Self.Patches[i].Data.Name, ' group (', (j - i + 1), ' patches)');

    if not Self.Patches[i].EnsureLepTools(not usePhased) then
      WriteLn('[BASHFarm] Warning: could not withdraw tools/compost from leprechaun at ', Self.Patches[i].Data.Name);

    if phasWatch and (Minimap.GetHPLevel() < phasStartHp) then
    begin
      WriteLn('[BASHFarm] Phasmatys HP dropped before patch work (', Minimap.GetHPLevel(), ' < ', phasStartHp, ')');
      Self.SkipRemainingAtLocation(i, j, 'Phasmatys combat bail');
      Self.TeleportAwayFromPhasmatys(j + 1);
      i := j + 1;
      Continue;
    end;

    if usePhased then
    begin
      for k := i to j do
      begin
        patch := Self.Patches[k];
        if patch.Skip then
          Continue;

        if phasWatch and (Minimap.GetHPLevel() < phasStartHp) then
        begin
          for m := i to k - 1 do
            Self.RecordPatchResult(Self.Patches[m]);
          Self.SkipRemainingAtLocation(k, j, 'Phasmatys combat bail');
          phasBailed := True;
          Break;
        end;

        if k > i then
        begin
          if not patch.HandleStrongholdShortcut() then
          begin
            patch.SkipPatch('Stronghold shortcut failed (need 73 Agility if below rocks)');
            Self.Patches[k] := patch;
            Continue;
          end;
          if not patch.AtFarm() then
            patch.WalkNearLeprechaun(10);
        end;

        patch.RunHarvestPhase(Self.Journal);
        Self.Patches[k] := patch;

        if phasWatch and ((Minimap.GetHPLevel() < phasStartHp) or patch.CombatHpDropped()) then
        begin
          if not patch.Skip then
          begin
            patch.SkipPatch('Phasmatys combat bail');
            Self.Patches[k] := patch;
          end;
          for m := i to k do
            Self.RecordPatchResult(Self.Patches[m]);
          Self.SkipRemainingAtLocation(k + 1, j, 'Phasmatys combat bail');
          phasBailed := True;
          Break;
        end;
      end;

      if phasBailed then
      begin
        Self.TeleportAwayFromPhasmatys(j + 1);
        i := j + 1;
        Continue;
      end;

      needCompost := 0;
      for k := i to j do
      begin
        patch := Self.Patches[k];
        if patch.Skip or patch.Complete then
          Continue;
        if patch.UseFertileSoil or (patch.CompostItem = '') then
          Continue;
        Inc(needCompost);
      end;

      if needCompost > 0 then
      begin
        patch := Self.Patches[i];
        patch.NoteItems();
        if patch.CompostItem = 'Bottomless compost bucket' then
          compostQty := 1
        else
          compostQty := needCompost;

        WriteLn('[BASHFarm] Bulk withdrawing ', compostQty, 'x ', patch.CompostItem, ' for ', needCompost, ' patches');
        if not patch.WithdrawLepCompost(compostQty) then
          WriteLn('[BASHFarm] Warning: bulk compost withdraw failed at ', patch.Data.Name);
        Self.Patches[i] := patch;
      end;

      if phasWatch and (Minimap.GetHPLevel() < phasStartHp) then
      begin
        Self.SkipRemainingAtLocation(i, j, 'Phasmatys combat bail');
        Self.TeleportAwayFromPhasmatys(j + 1);
        i := j + 1;
        Continue;
      end;

      for k := i to j do
      begin
        patch := Self.Patches[k];
        if patch.Skip or patch.Complete then
        begin
          Self.RecordPatchResult(patch);
          Self.Patches[k] := patch;
          Continue;
        end;

        if phasWatch and (Minimap.GetHPLevel() < phasStartHp) then
        begin
          Self.SkipRemainingAtLocation(k, j, 'Phasmatys combat bail');
          phasBailed := True;
          Break;
        end;

        if not patch.AtFarm() then
          patch.WalkNearLeprechaun(10);

        patch.RunPlantCompostPhase(Self.Journal);
        Self.RecordPatchResult(patch);
        Self.Patches[k] := patch;

        if phasWatch and ((Minimap.GetHPLevel() < phasStartHp) or patch.CombatHpDropped()) then
        begin
          Self.SkipRemainingAtLocation(k + 1, j, 'Phasmatys combat bail');
          phasBailed := True;
          Break;
        end;
      end;

      if phasBailed then
      begin
        Self.TeleportAwayFromPhasmatys(j + 1);
        i := j + 1;
        Continue;
      end;
    end
    else
    begin
      for k := i to j do
      begin
        patch := Self.Patches[k];
        if patch.Skip then
        begin
          Self.RecordPatchResult(patch);
          Continue;
        end;

        if phasWatch and (Minimap.GetHPLevel() < phasStartHp) then
        begin
          Self.SkipRemainingAtLocation(k, j, 'Phasmatys combat bail');
          phasBailed := True;
          Break;
        end;

        if k > i then
        begin
          if not patch.HandleStrongholdShortcut() then
          begin
            patch.SkipPatch('Stronghold shortcut failed (need 73 Agility if below rocks)');
            Self.Patches[k] := patch;
            Self.RecordPatchResult(patch);
            Continue;
          end;

          if not patch.AtFarm() then
          begin
            if not patch.WalkNearLeprechaun(10) then
              WriteLn('[BASHFarm] Warning: could not walk to farm near leprechaun at ', patch.Data.Name);
          end;

          if not patch.EnsureLepTools() then
            WriteLn('[BASHFarm] Warning: could not withdraw tools/compost from leprechaun at ', patch.Data.Name);
        end;

        patch.Run(Self.Journal);
        Self.RecordPatchResult(patch);
        Self.Patches[k] := patch;

        if phasWatch and ((Minimap.GetHPLevel() < phasStartHp) or patch.CombatHpDropped()) then
        begin
          Self.SkipRemainingAtLocation(k + 1, j, 'Phasmatys combat bail');
          phasBailed := True;
          Break;
        end;
      end;

      if phasBailed then
      begin
        Self.TeleportAwayFromPhasmatys(j + 1);
        i := j + 1;
        Continue;
      end;
    end;

    i := j + 1;
  end;

  if Length(Self.Patches) > 0 then
  begin
    Self.Patches[High(Self.Patches)].NoteItems();
    Self.Patches[High(Self.Patches)].DepositLepTools();
  end;

  Inc(Self.RunsComplete);
  Self.Journal.Save();

  Self.OnComplete();
end;

procedure TBASHFarmRunner.DoFarmRun();
begin
  if not Self.ReadyTimer.IsFinished() then
    Exit;

  Self.Run();
  Self.ReadyTimer.Init(Random(86 * ONE_MINUTE, 97 * ONE_MINUTE));
  WriteLn('[BASHFarm] Next run in ', SRL.MsToTime(Self.ReadyTimer.TimeRemaining(), TTimeFormat.Time_Short));
end;

function TBASHFarmRunner.CanDoFarmRun(): Boolean;
begin
  Result := Self.ReadyTimer.IsFinished();
end;

