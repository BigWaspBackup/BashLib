function BASHFarmMenuHas(needle: String; caseSensitive: Boolean = False): Boolean;
var
  hay, n: String;
  option: TRSChooseOption_Option;
begin
  Result := False;
  if not ChooseOption.IsOpen() then
    if not ChooseOption.Open() then
      Exit(False);

  n := needle;
  if not caseSensitive then
    n := LowerCase(n);

  for option in ChooseOption.GetOptions() do
  begin
    hay := option.Text;
    if not caseSensitive then
      hay := LowerCase(hay);
    if n in hay then
      Exit(True);
  end;
end;

function BASHFarmUpTextUseTarget(upText: String): String;
var
  arrowAt: Int32;
begin
  Result := '';
  arrowAt := Pos('->', upText);
  if arrowAt <= 0 then
    arrowAt := Pos(',>', upText);
  if arrowAt <= 0 then
    arrowAt := Pos('>', upText);
  if arrowAt <= 0 then
    Exit;
  Result := Trim(Copy(upText, arrowAt + 1, Length(upText)));
  if (Length(Result) > 0) and (Copy(Result, 1, 1) = '>') then
    Result := Trim(Copy(Result, 2, Length(Result)));
end;

function BASHFarmEmptyUpTextNeedle(emptyUpText: String): String;
begin
  Result := emptyUpText;
  if Result = '' then
    Exit;
  case LowerCase(Result) of
    'allotment': Exit('Allot');
    'flower': Exit('Flow');
  end;
  if Length(Result) > 5 then
    Result := Copy(Result, 1, 5);
end;

function BASHFarmSeedCropNeedle(seed: TRSItem): String;
var
  s, low: String;
  at: Int32;
begin
  s := Trim(ToStr(seed));
  Result := s;
  if s = '' then
    Exit;

  low := LowerCase(s);
  at := Pos(' seed', low);
  if at > 0 then
    Result := Trim(Copy(s, 1, at - 1));
end;

function BASHFarmProduceCropNeedle(itemName: String): String;
var
  low: String;
  at, i: Int32;
  suffixes: TStringArray;
begin
  Result := Trim(itemName);
  if Result = '' then
    Exit;

  low := LowerCase(Result);
  suffixes := [' root', ' leaf', ' weed', ' berries', ' berry'];
  for i := 0 to High(suffixes) do
  begin
    at := Pos(suffixes[i], low);
    if at > 1 then
    begin
      Result := Trim(Copy(Result, 1, at - 1));
      Exit;
    end;
  end;
end;

function BASHFarmUpTextHasFarmProduce(upText: String): Boolean;
var
  target, itemName, crop: String;
  i: Int32;
begin
  Result := False;
  target := BASHFarmUpTextUseTarget(upText);
  if target = '' then
    target := upText;

  for i := 0 to High(BASH_FARM_LEPRECHAUN_ITEMS) do
  begin
    itemName := ToStr(BASH_FARM_LEPRECHAUN_ITEMS[i]);
    if (itemName = '') or (itemName = 'Weeds') then
      Continue;
    if itemName in target then
      Exit(True);

    crop := BASHFarmProduceCropNeedle(itemName);
    if (crop <> '') and (crop <> itemName) and (Length(crop) >= 4) and (crop in target) then
      Exit(True);
  end;
end;

function BASHFarmCompostConfirmed(const chatBefore: String): Boolean;
var
  line: String;
begin
  if XPBar.EarnedXP() then
    Exit(True);

  line := Chat.GetMessage(7);
  if (line = '') or (line = chatBefore) then
    Exit(False);

  if 'already been treated' in line then
  begin
    WriteLn('[BASHFarm] Chat: already been treated');
    Exit(True);
  end;

  Result := ('You treat' in line) or
            ('ompost' in line) or
            ('You apply' in line);
end;

function BASHFarmNeedsWeedingChat(const chatBefore: String): Boolean;
var
  i: Int32;
  line: String;
begin
  Result := False;
  for i := 6 to 7 do
  begin
    line := Chat.GetMessage(i);
    if ('needs weeding' in line) and (line <> chatBefore) then
      Exit(True);
  end;
end;

function BASHFarmCountSeed(seed: TRSItem): Int32;
begin
  Result := Inventory.CountItemStack(seed);
  if Result >= 0 then
    Exit;
  if Inventory.ContainsItem(seed) then
    Result := Max(1, Inventory.CountItem(seed))
  else
    Result := 0;
end;

function BASHFarmMenuSelect(needles: TStringArray; caseSensitive: Boolean = False): Boolean; overload;
var
  hay, n: String;
  option: TRSChooseOption_Option;
  i: Int32;
begin
  Result := False;
  if not ChooseOption.IsOpen() then
    if not ChooseOption.Open() then
      Exit(False);

  for option in ChooseOption.GetOptions() do
  begin
    hay := option.Text;
    if not caseSensitive then
      hay := LowerCase(hay);

    for i := 0 to High(needles) do
    begin
      n := needles[i];
      if not caseSensitive then
        n := LowerCase(n);
      if n in hay then
      begin
        ChooseOption.Select(option, MOUSE_LEFT);
        Exit(True);
      end;
    end;
  end;

  ChooseOption.Close();
end;

function BASHFarmMenuSelect(needle: String; caseSensitive: Boolean = False): Boolean; overload;
begin
  Result := BASHFarmMenuSelect([needle], caseSensitive);
end;

procedure BASHFarmCloseLepInterface();
begin
  if not RSInterface.IsOpen() then
    Exit;

  if not RSInterface.ClickClose(True) then
    RSInterface.ClickClose(False);
  if not WaitUntil(not RSInterface.IsOpen(), 40, 700) then
  begin
    RSInterface.Close(False);
    WaitUntil(not RSInterface.IsOpen(), 40, 700);
  end;
end;

procedure BASHFarmEnsureFarmChat();
var
  onAllOrGame: Boolean;
begin
  if ChatButtons.GetState(ERSChatButton.GAME_CHAT) <> ERSChatButtonState.ENABLED then
  begin
    WriteLn('[BASHFarm] Game chat off - enabling');
    ChatButtons.ChangeState(ERSChatButton.GAME_CHAT, ERSChatButtonState.ENABLED);
  end;

  onAllOrGame := ChatButtons.IsActive(ERSChatButton.ALL_CHAT) or
                 ChatButtons.IsActive(ERSChatButton.GAME_CHAT);
  if onAllOrGame then
    Exit;

  WriteLn('[BASHFarm] Chat tab not All/Game - switching to All');
  ChatButtons.Open(ERSChatButton.ALL_CHAT);
end;

procedure TBASHFarmPatch.Reset();
begin
  Self.Harvested := False;
  Self.Planted := False;
  Self.Composted := False;
  Self.Skip := False;
  Self.Complete := False;
  Self.OutOfSeeds := False;
  Self.FailCount := 0;
  Self.TPA := [];
  Self.SearchBox := [0, 0, 0, 0];
  Self.AimTile := [0, 0];
  Self.LastPickedTile := [0, 0];
  Self.HasAimTile := False;
  Self.CombatHpWatch := False;
  Self.CombatStartHp := 0;
end;

procedure TBASHFarmPatch.SkipPatch(reason: String);
begin
  WriteLn('[BASHFarm] Skipping ' + Self.Data.Name + ': ' + reason);
  Inventory.SetSelectedSlot(-1);
  Self.Skip := True;
end;

function TBASHFarmPatch.CombatHpDropped(): Boolean;
begin
  Result := Self.CombatHpWatch and (Self.CombatStartHp > 0) and
            (Minimap.GetHPLevel() < Self.CombatStartHp);
end;

function TBASHFarmPatch.WalkWaitMs(base: Int32): Int32;
var
  extra: Int32;
begin
  extra := Round(Map.Position().DistanceTo(Self.Data.Coords) * 15);
  if extra > 8000 then
    extra := 8000;
  Result := base + extra;
end;

function TBASHFarmPatch.BailIfCombatHpDropped(): Boolean;
begin
  Result := False;
  if not Self.CombatHpDropped() then
    Exit;
  Self.SkipPatch('HP dropped at Phasmatys (lure risk) - bailing');
  Result := True;
end;

function TBASHFarmPatch.HandleStrongholdShortcut(): Boolean;
var
  attempt: Int32;
  rocksMS: TPoint;
begin
  Result := True;
  if Self.Id <> EBASHFarmPatch.STRONGHOLD_HERB then
    Exit;

  if Map.Walker.InRange(Self.Data.Coords, 45) then
    Exit;
  if Map.Walker.InRange(BASH_STRONGHOLD_SHORTCUT_TOP, 6) then
    Exit;

  if not Map.Walker.InRange(BASH_STRONGHOLD_SHORTCUT_BOTTOM, 40) and
     not Map.Walker.InRange(BASH_STRONGHOLD_ROCKS, 40) then
    Exit;

  if Stats.GetLevel(ERSSkill.AGILITY, True) < 73 then
  begin
    WriteLn('[BASHFarm] Stronghold rocks need 73 Agility (landed below shortcut)');
    Exit(False);
  end;

  WriteLn('[BASHFarm] Climbing Stronghold rocks shortcut');
  for attempt := 1 to 3 do
  begin
    if not Map.Walker.InRange(BASH_STRONGHOLD_ROCKS, 12) then
      Map.Walker.WebWalk(BASH_STRONGHOLD_SHORTCUT_BOTTOM, 6, 0.15);

    rocksMS := Map.GetTileMS(BASH_STRONGHOLD_ROCKS).Mean;
    if not (rocksMS in MainScreen.Bounds) then
    begin
      Map.Walker.MakePointVisible(BASH_STRONGHOLD_ROCKS);
      rocksMS := Map.GetTileMS(BASH_STRONGHOLD_ROCKS).Mean;
    end;

    Mouse.Move(SRL.RandomPoint(rocksMS, MainScreen.NormalizeDistance(8)));
    if not (MainScreen.IsUpText('Climb') or MainScreen.IsUpText('Rocks')) then
    begin
      Mouse.Click(MOUSE_RIGHT);
      if not ChooseOption.Select(['Climb']) then
      begin
        ChooseOption.Close();
        Continue;
      end;
    end
    else
      Mouse.Click(MOUSE_LEFT);

    if not MainScreen.DidRedClick() then
      Continue;

    if WaitUntil(
         Map.Walker.InRange(BASH_STRONGHOLD_SHORTCUT_TOP, 4),
         35,
         8000
       ) then
    begin
      Exit(True);
    end;

  end;

  Result := Map.Walker.InRange(BASH_STRONGHOLD_SHORTCUT_TOP, 4) or
            Map.Walker.InRange(Self.Data.Coords, 45);
  if not Result then
    WriteLn('[BASHFarm] Failed to climb Stronghold rocks');
end;

function BASHFarmIsGuildPatch(id: EBASHFarmPatch): Boolean;
begin
  Result := id in [
    EBASHFarmPatch.GUILD_HERB,
    EBASHFarmPatch.GUILD_FLOWER,
    EBASHFarmPatch.GUILD_ALLOT_N,
    EBASHFarmPatch.GUILD_ALLOT_S,
    EBASHFarmPatch.GUILD_BUSH,
    EBASHFarmPatch.GUILD_CACTUS,
    EBASHFarmPatch.GUILD_ANIMA,
    EBASHFarmPatch.GUILD_TREE,
    EBASHFarmPatch.GUILD_REDWOOD,
    EBASHFarmPatch.GUILD_FRUIT,
    EBASHFarmPatch.GUILD_CELASTRUS
  ];
end;

function TBASHFarmPatch.IsGuild(): Boolean;
begin
  Result := BASHFarmIsGuildPatch(Self.Id);
end;

procedure TBASHFarmPatch.ApplyWalkDoorSolver();
begin
  Map.Walker._DoorHandler.Enabled := Self.IsGuild();
end;

function TBASHFarmPatch.IsPhasmatys(): Boolean;
begin
  Result := Self.Id in [
    EBASHFarmPatch.PHASMATYS_HERB,
    EBASHFarmPatch.PHASMATYS_FLOWER,
    EBASHFarmPatch.PHASMATYS_ALLOT_N,
    EBASHFarmPatch.PHASMATYS_ALLOT_S
  ];
end;

function TBASHFarmPatch.TryWalkToward(dest: TPoint; untilDist: Int32; blindStep: Int32 = 42; maxAttempts: Int32 = 8): Boolean;
var
  me, mid: TPoint;
  dist, step: Double;
  attempt: Int32;

  function TryWeb(target: TPoint; stopDist: Int32): Boolean;
  begin
    Result := False;
    try
      Result := Map.Walker.WebWalk(target, stopDist, 0.15);
    except
      WriteLn('[BASHFarm] WebWalk connect failed to ', target, ' from ', Map.Position());
      Result := False;
    end;
  end;

  function TryBlind(target: TPoint; stopDist: Int32): Boolean;
  begin
    Result := False;
    try
      Result := Map.Walker.WalkBlind(target, stopDist);
    except
      WriteLn('[BASHFarm] WalkBlind failed to ', target, ' from ', Map.Position());
      Result := False;
    end;
  end;
begin
  if maxAttempts < 1 then
    maxAttempts := 1;

  for attempt := 1 to maxAttempts do
  begin
    if Map.Walker.InRange(dest, untilDist) then
      Exit(True);

    if TryWeb(dest, untilDist) then
      Exit(True);

    me := Map.Position();
    dist := me.DistanceTo(dest);
    if dist <= untilDist then
      Exit(True);
    if dist < 1 then
      dist := 1;

    step := Min(Double(blindStep), dist);
    if step < 12 then
      step := Min(12, dist);

    mid.X := Round(me.X + (dest.X - me.X) * (step / dist));
    mid.Y := Round(me.Y + (dest.Y - me.Y) * (step / dist));

    WriteLn('[BASHFarm] Phasmatys WalkBlind ', attempt, '/', maxAttempts, ' -> ', mid,
            ' (dest=', dest, ', dist=', Round(dist), ')');
    TryBlind(mid, 6);
  end;

  Result := Map.Walker.InRange(dest, untilDist + 10);
end;

function TBASHFarmPatch.HandlePhasmatysApproach(): Boolean;
var
  walked: Boolean;
begin
  Result := True;
  if not Self.IsPhasmatys() then
    Exit;

  if Self.AtFarm() then
    Exit;

  if not Map.Walker.InRange(BASH_PHASMATYS_ECTOFUNTUS, 55) then
    Exit;

  WriteLn('[BASHFarm] Leaving Ectofuntus toward Port Phasmatys farm');

  walked := Self.TryWalkToward(BASH_PHASMATYS_FARM_APPROACH, 14);
  if not walked then
    walked := Self.TryWalkToward(Self.Data.Coords, 16);
  if not walked then
    walked := Self.TryWalkToward(Self.Data.LeprechaunCoords, 14);

  if not walked then
    WriteLn('[BASHFarm] Phasmatys approach walk failed - will retry via farm walk');
end;


function TBASHFarmPatch.UsesTileList(): Boolean;
begin
  if Self.Data.PatchType = EBASHPatchType.ALLOTMENT then
    Exit(Length(Self.Data.Outline) >= 3);
  if Length(Self.Data.Outline) > 8 then
    Exit(True);
  Result := (Length(Self.Data.Outline) = 4) and
            (Self.Data.PatchType in [
              EBASHPatchType.HERB, EBASHPatchType.FLOWER,
              EBASHPatchType.BUSH, EBASHPatchType.CACTUS,
              EBASHPatchType.FRUIT
            ]);
end;

function TBASHFarmPatch.GetOutlineMapTiles(): TPointArray;
var
  b: TBox;
  x, y: Int32;
begin
  SetLength(Result, 0);
  if Length(Self.Data.Outline) < 3 then
    Exit;

  if Self.UsesTileList() then
  begin
    Result := Self.Data.Outline;
    Exit;
  end;

  b := Self.Data.Outline.Bounds();
  for y := b.Y1 to b.Y2 do
    for x := b.X1 to b.X2 do
      if SRL.PointInPoly([x, y], Self.Data.Outline) then
        Result += [x, y];
end;

function TBASHFarmPatch.GetInteractTile(me: TPoint; preferRank: Int32 = 0): TPoint; overload;
var
  tiles: TPointArray;
  scores: array of Double;
  used: array of Boolean;
  i, j, rank, bestI: Int32;
  best, distMe, distCenter, score: Double;
  close: Boolean;
  center, nearest, ms: TPoint;
begin
  if Length(Self.Data.Outline) < 3 then
    Exit(Self.Data.Coords);

  tiles := Self.GetOutlineMapTiles();
  if Length(tiles) = 0 then
    Exit(Self.Data.Coords);

  center := Self.Data.Coords;
  if (center.X = 0) and (center.Y = 0) then
    center := tiles.Mean;

  nearest := tiles.NearestPoint(me);
  close := me.DistanceTo(nearest) <= 10;

  SetLength(scores, Length(tiles));
  for i := 0 to High(tiles) do
  begin
    distMe := me.DistanceTo(tiles[i]);
    distCenter := tiles[i].DistanceTo(center);
    ms := Map.GetTileMS(me, tiles[i]).Mean;
    score := 0;
    if not (ms in MainScreen.Bounds) then
      score := score + 10000;

    if close then
    begin
      score := score + distCenter * 4;
      if distMe < 3 then
        score := score + 8;
      if distMe < 10 then
        score := score - distMe * 0.4
      else
        score := score - 4;
    end
    else
      score := score + distMe + distCenter * 0.25;

    scores[i] := score;
  end;

  rank := preferRank;
  if rank < 0 then
    rank := 0;
  if rank > High(tiles) then
    rank := High(tiles);

  SetLength(used, Length(tiles));
  Result := tiles[0];
  for j := 0 to rank do
  begin
    bestI := -1;
    best := 1000000000;
    for i := 0 to High(tiles) do
    begin
      if used[i] then
        Continue;
      if scores[i] < best then
      begin
        best := scores[i];
        bestI := i;
      end;
    end;
    if bestI < 0 then
      Break;
    used[bestI] := True;
    Result := tiles[bestI];
  end;
end;

function TBASHFarmPatch.GetInteractTile(): TPoint; overload;
begin
  Result := Self.GetInteractTile(Map.Position());
end;

procedure TBASHFarmPatch.CommitAimTile();
begin
  if (Self.LastPickedTile.X <> 0) or (Self.LastPickedTile.Y <> 0) then
    Self.AimTile := Self.LastPickedTile;
  Self.HasAimTile := (Self.AimTile.X <> 0) or (Self.AimTile.Y <> 0);
end;

function TBASHFarmPatch.GetInteractMS(tileRank: Int32 = 0): TPoint;
var
  me, tile: TPoint;
begin
  me := Map.Position();
  tile := Self.GetInteractTile(me, tileRank);
  Result := Map.GetTileMS(me, tile).Mean;
  if not (Result in MainScreen.Bounds) then
  begin
    if Self.SearchBox.Area > 0 then
      Result := Self.SearchBox.Center()
    else if Length(Self.TPA) > 0 then
      Result := Self.TPA.Mean;
  end;
end;

function TBASHFarmPatch.GetAimClick(aimAttempt: Int32): TPoint;
var
  me, tile, base: TPoint;
  rank, jitter: Int32;
begin
  if aimAttempt < 1 then
    aimAttempt := 1;

  me := Map.Position();
  tile := [0, 0];

  if (aimAttempt = 1) and Self.HasAimTile then
  begin
    base := Map.GetTileMS(me, Self.AimTile).Mean;
    if base in MainScreen.Bounds then
      tile := Self.AimTile;
  end;

  if (tile.X = 0) and (tile.Y = 0) then
  begin
    rank := aimAttempt - 1;
    tile := Self.GetInteractTile(me, rank);
  end;

  Self.LastPickedTile := tile;
  base := Map.GetTileMS(me, tile).Mean;
  Self.TPA := [base];
  Self.SearchBox.X1 := base.X - MainScreen.NormalizeDistance(10);
  Self.SearchBox.Y1 := base.Y - MainScreen.NormalizeDistance(10);
  Self.SearchBox.X2 := base.X + MainScreen.NormalizeDistance(10);
  Self.SearchBox.Y2 := base.Y + MainScreen.NormalizeDistance(10);
  Self.SearchBox.LimitTo(MainScreen.Bounds);

  jitter := MainScreen.NormalizeDistance(3);
  Result := SRL.RandomPoint(base, jitter);
end;

function TBASHFarmPatch.GetAllotmentAimClick(aimAttempt: Int32): TPoint;
begin
  Result := Self.GetAimClick(aimAttempt);
end;

function TBASHFarmPatch.Find(): Boolean;
var
  borderTPA: TPointArray;
  borderATPA: T2DPointArray;
  i, searchMod, bestIdx: Int32;
  filterPt, centerSearch, interact, me: TPoint;
  bestDist, dist, nearTol: Double;
  hull: TPointArray;
begin
  Self.SearchBox := [0, 0, 0, 0];
  Self.TPA := [];

  me := Map.Position();
  interact := [0, 0];
  if Self.HasAimTile then
  begin
    filterPt := Map.GetTileMS(me, Self.AimTile).Mean;
    if filterPt in MainScreen.Bounds then
      interact := Self.AimTile;
  end;
  if (interact.X = 0) and (interact.Y = 0) then
    interact := Self.GetInteractTile(me);
  filterPt := Map.GetTileMS(me, interact).Mean;
  if not (filterPt in MainScreen.Bounds) then
    Exit(False);

  if Length(Self.Data.Outline) >= 3 then
  begin
    Self.TPA := [filterPt];
    searchMod := MainScreen.NormalizeDistance(14);
    if Self.Data.PatchType = EBASHPatchType.ALLOTMENT then
      searchMod := MainScreen.NormalizeDistance(18);
    centerSearch := filterPt;
    Self.SearchBox.X1 := centerSearch.X - searchMod;
    Self.SearchBox.Y1 := centerSearch.Y - searchMod;
    Self.SearchBox.X2 := centerSearch.X + searchMod;
    Self.SearchBox.Y2 := centerSearch.Y + searchMod;
    Self.SearchBox.LimitTo(MainScreen.Bounds);
    Exit(True);
  end;

  if SRL.FindColors(borderTPA, Self.Data.BorderColor, MainScreen.Bounds) = 0 then
    Exit(False);

  borderATPA := borderTPA.Cluster(MainScreen.NormalizeDistance(20));
  borderATPA.SortFrom(filterPt);

  bestIdx := -1;
  bestDist := 1000000;
  nearTol := MainScreen.NormalizeDistance(90);

  for i := 0 to High(borderATPA) do
  begin
    hull := borderATPA[i].ConvexHull.Connect;
    if Length(hull) < 8 then
      Continue;

    if SRL.PointInPoly(filterPt, hull) then
    begin
      Self.TPA := hull;
      bestIdx := i;
      bestDist := 0;
      Break;
    end;

    dist := filterPt.DistanceTo(hull.Mean);
    if dist < bestDist then
    begin
      bestDist := dist;
      bestIdx := i;
      Self.TPA := hull;
    end;
  end;

  if (bestIdx < 0) or (bestDist > nearTol) then
  begin
    Self.TPA := [];
    Exit(False);
  end;

  searchMod := MainScreen.NormalizeDistance(12);
  if Self.Data.PatchType = EBASHPatchType.FRUIT then
    searchMod := MainScreen.NormalizeDistance(16);

  centerSearch := Self.TPA.Mean;
  Self.SearchBox.X1 := centerSearch.X - searchMod;
  Self.SearchBox.Y1 := centerSearch.Y - searchMod;
  Self.SearchBox.X2 := centerSearch.X + searchMod;
  Self.SearchBox.Y2 := centerSearch.Y + searchMod;
  Self.SearchBox.LimitTo(MainScreen.Bounds);
  Result := True;
end;

function TBASHFarmPatch.WalkFind(): Boolean;
var
  interact: TPoint;
  attempt: Int32;
begin
  Self.SearchBox := [0, 0, 0, 0];
  Self.TPA := [];
  interact := Self.GetInteractTile();

  for attempt := 0 to 5 do
  begin
    if Self.Find() then
      Exit(True);

    Map.Walker.MakePointVisible(interact);
    if Self.Find() then
      Exit(True);

    Minimap.SetCompassAngle(Minimap.GetCompassAngle() + Random(35, 70) * (1 - 2 * (attempt mod 2)), 10);
  end;

  Result := False;
end;

function TBASHFarmPatch.IsEmpty(): Boolean;
var
  upText: String;
begin
  if not Self.Hover() then
    Exit(False);

  upText := MainScreen.GetUpText();

  if Self.Data.PatchType = EBASHPatchType.TREE then
  begin
    Result := Self.EmptyUpText in upText;
    if not ('Rake' in upText) then
      Exit;
  end;

  if Self.Data.PatchType in [EBASHPatchType.HERB, EBASHPatchType.FLOWER, EBASHPatchType.ALLOTMENT] then
  begin
    Result := ('spect' in upText) and (Self.EmptyUpText in upText) and
              (not ('lear' in upText)) and (not ('Rake' in upText));
    Exit;
  end;

  Result := Self.EmptyUpText in upText;
end;

function TBASHFarmPatch.IsDiseased(): Boolean;
begin
  Result := Self.Find() and (SRL.CountColor(CTS2(1272942, 14, 0.03, 2.31), Self.SearchBox) > MainScreen.NormalizeDistance(3));
end;

procedure TBASHFarmPatch._UpdateTarget(sender: PMouse; var x, y: Double; var done: Boolean);
var
  p, destination: TPoint;
begin
  destination := [Round(x), Round(y)];
  p := sender^.Position();
  if p.DistanceTo(destination) > 5 then
    Exit;

  sender^.OnMovingEx := nil;

  if Self.SearchBox.Area = 0 then
  begin
    done := False;
    Exit;
  end;

  done := True;
  if PointInBox(destination, Self.SearchBox) then
    Exit;

  p := SRL.RandomPoint(Self.SearchBox.Center(), MainScreen.NormalizeDistance(8));
  x := p.X;
  y := p.Y;
end;

function TBASHFarmPatch.HasPatchUpText(const upText: String): Boolean;
var
  target, crop, lowTarget: String;
begin
  Result := False;
  if upText = '' then
    Exit;

  if 'Rake' in upText then
    Exit(True);
  if 'ead' in upText then
    Exit(True);
  if 'seas' in upText then
    Exit(True);
  if 'eck-hea' in upText then
    Exit(True);
  if 'spect' in upText then
    Exit(True);
  if ('Chop' in upText) or ('lear' in upText) then
    Exit(True);
  if (Self.HarvestUpText <> '') and (Self.HarvestUpText in upText) then
    Exit(True);
  if (Self.EmptyUpText <> '') and (Self.EmptyUpText in upText) then
    Exit(True);
  if (Self.PlantedUpText <> '') and (Self.PlantedUpText in upText) then
    Exit(True);
  if BASHFarmUpTextHasFarmProduce(upText) then
    Exit(True);

  crop := BASHFarmSeedCropNeedle(Self.Seed);
  if (crop <> '') and (Length(crop) >= 3) and (crop in upText) then
    Exit(True);

  target := BASHFarmUpTextUseTarget(upText);
  if target <> '' then
  begin
    lowTarget := LowerCase(target);
    if ('plant' in lowTarget) or ('herb' in lowTarget) or ('allot' in lowTarget) then
      Exit(True);
  end;
end;

function TBASHFarmPatch.Hover(aimAttempt: Int32 = 1): Boolean;
var
  rotateTry, spotTry, spotIdx: Int32;
  interact: TPoint;
begin
  Mouse.OnMovingEx := nil;
  Result := False;

  if aimAttempt < 1 then
    aimAttempt := 1;

  for rotateTry := 1 to 3 do
  begin
    if not Self.Find() then
    begin
      interact := Self.GetInteractTile(Map.Position(), Max(0, aimAttempt - 1));
      Map.Walker.MakePointVisible(interact);
      if rotateTry < 3 then
        Minimap.SetCompassAngle(Minimap.GetCompassAngle() + Random(35, 70) * (1 - 2 * (rotateTry mod 2)), 10);
      Continue;
    end;

    for spotTry := 1 to 3 do
    begin
      spotIdx := aimAttempt + spotTry - 1;

      if Length(Self.Data.Outline) < 3 then
        Mouse.OnMovingEx := @Self._UpdateTarget;

      Mouse.Move(Self.GetAimClick(Max(1, spotIdx)));
      Mouse.OnMovingEx := nil;

      if WaitUntil(Self.HasPatchUpText(MainScreen.GetUpText()), 40, 2000) then
      begin
        Self.CommitAimTile();
        Exit(True);
      end;

      if spotTry < 3 then
        WriteLn('[BASHFarm] Hover miss at ', Self.Data.Name, ' ("', MainScreen.GetUpText(),
                '") - trying another patch spot (', spotTry, '/3)');
    end;

    if rotateTry < 3 then
    begin
      WriteLn('[BASHFarm] Hover still missing ', Self.Data.Name, ' - rotating camera (', rotateTry, '/3)');
      Minimap.SetCompassAngle(Minimap.GetCompassAngle() + Random(40, 85) * (1 - 2 * (rotateTry mod 2)), 10);
      Wait(180, 320);
    end;
  end;

  WriteLn('[BASHFarm] Hover failed at ', Self.Data.Name, ' after re-aims/rotates ("',
          MainScreen.GetUpText(), '")');
  Result := False;
end;

function TBASHFarmPatch.ClickUpText(text: String): Boolean;
var
  up: String;
  attempt, maxAttempts: Int32;
begin
  Result := False;

  up := MainScreen.GetUpText();
  if text in up then
  begin
    Mouse.Click(MOUSE_LEFT);
    Exit(True);
  end;

  if Self.Data.PatchType = EBASHPatchType.ALLOTMENT then
    maxAttempts := 8
  else
    maxAttempts := 4;

  for attempt := 1 to maxAttempts do
  begin
    if not Self.Hover(attempt) then
      Exit;

    if WaitUntil((text in MainScreen.GetUpText()) or MainScreen.IsUpText(text), 40, 2000) then
    begin
      Mouse.Click(MOUSE_LEFT);
      Exit(True);
    end;

    up := MainScreen.GetUpText();

    if attempt < maxAttempts then
    begin
      if Self.Data.PatchType = EBASHPatchType.ALLOTMENT then
      begin
        if attempt = 2 then
          WriteLn('[BASHFarm] ClickUpText: "', text, '" retry closer at ', Self.Data.Name,
                  ' (got="', up, '")')
        else if attempt = 5 then
          WriteLn('[BASHFarm] ClickUpText: "', text, '" retry new front spot at ', Self.Data.Name,
                  ' (got="', up, '")')
        else if attempt = 1 then
          WriteLn('[BASHFarm] ClickUpText: "', text, '" not ready at ', Self.Data.Name,
                  ' (got="', up, '") - try again');
      end
      else
        WriteLn('[BASHFarm] ClickUpText: "', text, '" not ready at ', Self.Data.Name,
                ' (got="', up, '") - try again');
    end;
  end;

  WriteLn('[BASHFarm] ClickUpText: "', text, '" missing after hover at ',
          Self.Data.Name, ' (got="', MainScreen.GetUpText(), '")');
end;

function TBASHFarmPatch.Inspect(): EBASHPatchState;
label
  doInspect;
var
  upText: String;
begin
  if Self.Complete then
    Exit(EBASHPatchState.COMPLETE);
  if Self.Skip then
    Exit(EBASHPatchState.SKIP);

  if Self.Planted and (not Self.Composted) then
  begin
    if Inventory.IsFull() then
      Exit(EBASHPatchState.NOTE_ITEMS);
    Exit(EBASHPatchState.UNCOMPOSTED);
  end;
  if Self.Planted then
    Exit(EBASHPatchState.GROWING);

  if Inventory.GetSelectedSlot() > -1 then
    Inventory.SetSelectedSlot(-1);

  if Minimap.InPOH() then
    Exit(EBASHPatchState.TELEPORT_TO);

  if not Map.Position().InBox(Self.Data.MapCoords) then
    Exit(EBASHPatchState.TELEPORT_TO);

  if Inventory.IsFull() then
    Exit(EBASHPatchState.NOTE_ITEMS);

  if Self.Harvested and (not Self.Planted) then
    Exit(EBASHPatchState.EMPTY);

  if not Self.WalkFind() then
    Exit(EBASHPatchState.NOT_FOUND);

  if Self.Data.PatchType = EBASHPatchType.HERB then
  begin
    if SRL.CountColor(CTS2(6050153, 7, 2.73, 0.61), Self.SearchBox) > MainScreen.NormalizeDistance(14) then
      Exit(EBASHPatchState.DEAD);
    if SRL.CountColor(CTS2(1272942, 14, 0.03, 2.31), Self.SearchBox) > MainScreen.NormalizeDistance(14) then
      Exit(EBASHPatchState.DISEASED);
  end;

  if not Self.Hover() then
    Exit(EBASHPatchState.NOT_FOUND);

  upText := MainScreen.GetUpText();

  if 'Rake' in upText then
    Exit(EBASHPatchState.OVERGROWN);
  if 'ead' in upText then
    Exit(EBASHPatchState.DEAD);
  if 'seas' in upText then
    Exit(EBASHPatchState.DISEASED);
  if ('Chop' in upText) or ('lear' in upText) then
  begin
    if Self.DontClear then
      Exit(EBASHPatchState.GROWING);
    if Self.Data.PatchType in [EBASHPatchType.HERB, EBASHPatchType.FLOWER, EBASHPatchType.ALLOTMENT] then
      Exit(EBASHPatchState.DEAD);
    Exit(EBASHPatchState.NEED_CLEAR);
  end;
  if 'eck-hea' in upText then
    Exit(EBASHPatchState.FRESH);
  if Self.HarvestUpText in upText then
    Exit(EBASHPatchState.GROWN);

  if 'spect' in upText then
  begin
    if Self.Data.PatchType in [EBASHPatchType.HERB, EBASHPatchType.FLOWER, EBASHPatchType.ALLOTMENT] then
    begin
      if Self.EmptyUpText in upText then
        Exit(EBASHPatchState.EMPTY);
      Exit(EBASHPatchState.GROWING);
    end;

    if Self.EmptyUpText in upText then
      Exit(EBASHPatchState.EMPTY);
    Exit(EBASHPatchState.GROWING);
  end
  else if (Self.EmptyUpText in upText) or (Self.PlantedUpText in upText) then
  begin
    if Self.EmptyUpText in upText then
      Exit(EBASHPatchState.EMPTY);
    Exit(EBASHPatchState.GROWING);
  end;

  WriteLn('[BASHFarm] Inspect ambiguous uptext at ', Self.Data.Name, ' ("', upText, '") - menu probe');
  if Self.Hover() then
  begin
    ChooseOption.Open();
    if BASHFarmMenuHas(Self.HarvestUpText, False) then
    begin
      ChooseOption.Close();
      Exit(EBASHPatchState.GROWN);
    end;
    if BASHFarmMenuHas('Rake', False) then
    begin
      ChooseOption.Close();
      Exit(EBASHPatchState.OVERGROWN);
    end;
    if BASHFarmMenuHas('ead', False) then
    begin
      ChooseOption.Close();
      Exit(EBASHPatchState.DEAD);
    end;
    if BASHFarmMenuHas('seas', False) then
    begin
      ChooseOption.Close();
      Exit(EBASHPatchState.DISEASED);
    end;
    if BASHFarmMenuHas('eck-hea', False) then
    begin
      ChooseOption.Close();
      Exit(EBASHPatchState.FRESH);
    end;
    if (not Self.DontClear) and
       (BASHFarmMenuHas('lear', False) or BASHFarmMenuHas('Chop', False)) then
    begin
      ChooseOption.Close();
      if Self.Data.PatchType in [EBASHPatchType.HERB, EBASHPatchType.FLOWER, EBASHPatchType.ALLOTMENT] then
        Exit(EBASHPatchState.DEAD);
      Exit(EBASHPatchState.NEED_CLEAR);
    end;
    if BASHFarmMenuHas('spect', False) then
    begin
      ChooseOption.Close();
      if Self.Data.PatchType in [EBASHPatchType.HERB, EBASHPatchType.FLOWER, EBASHPatchType.ALLOTMENT] then
      begin
        if Self.Hover() then
        begin
          upText := MainScreen.GetUpText();
          if Self.EmptyUpText in upText then
            Exit(EBASHPatchState.EMPTY);
          if 'spect' in upText then
            Exit(EBASHPatchState.GROWING);
        end;
        Exit(EBASHPatchState.EMPTY);
      end;
    end;
    ChooseOption.Close();
  end;

  if Self.FailCount >= 3 then
  begin
    WriteLn('[BASHFarm] Inspect last resort at ', Self.Data.Name);
    if Self.Hover() then
    begin
      upText := MainScreen.GetUpText();
      if 'spect' in upText then
        goto doInspect;
      ChooseOption.Open();
      if BASHFarmMenuHas('spect', False) then
        goto doInspect;
      ChooseOption.Close();
    end;
  end;

  Exit(EBASHPatchState.NOT_FOUND);

doInspect:
  if ChooseOption.IsOpen() then
  begin
    if not BASHFarmMenuSelect('spect', False) then
      Exit(EBASHPatchState.NOT_FOUND);
  end
  else
    Mouse.Click(MOUSE_LEFT);

  WaitUntil(Chat.FindMessage('This is a'), 35, 4000);

  if Chat.FindMessage('is empty') then
    Exit(EBASHPatchState.EMPTY);
  if Chat.FindMessage('not bee') then
    Exit(EBASHPatchState.UNCOMPOSTED);
  if Chat.FindMessage('lly gr') then
    Exit(EBASHPatchState.GROWN);
  if Chat.FindMessage('has been') then
    Exit(EBASHPatchState.GROWING);
  if Chat.FindMessage('ead') then
    Exit(EBASHPatchState.DEAD);
  if Chat.FindMessage('seas') then
    Exit(EBASHPatchState.DISEASED);

  Result := EBASHPatchState.NOT_FOUND;
end;

function TBASHFarmPatch.EnsureHarvestSpace(): Boolean;
begin
  Result := not Inventory.IsFull();
  if Result then
    Exit;

  WriteLn('[BASHFarm] Harvest: inventory full - noting before pick at ', Self.Data.Name);
  Self.DropEmptyBuckets();
  if Inventory.IsFull() then
    Self.NoteItems();

  Result := not Inventory.IsFull();
  if not Result then
    WriteLn('[BASHFarm] Harvest: still full after noting at ', Self.Data.Name);
end;

function TBASHFarmPatch.Harvest(): Boolean;
var
  timeout, stall, reaim: TCountdown;
  lastCount, curCount, lastEmpty, curEmpty: Int32;
  gotActivity, started, herbFirstXpLogged: Boolean;
  waitMs: Int32;
  upText: String;
  aimAttempt: Int32;

  function PatchStillHarvestable(const hoverUp: String): Boolean;
  begin
    Result := (Self.HarvestUpText in hoverUp) or BASHFarmUpTextHasFarmProduce(hoverUp);
  end;

  function PatchLooksEmpty(const hoverUp: String): Boolean;
  begin
    Result := ('spect' in hoverUp) and (Self.EmptyUpText in hoverUp) and
              (not ('lear' in hoverUp)) and (not ('Rake' in hoverUp));
  end;

  procedure LogHerbSoil({$H-}const stage: String); {$H+}
  begin
    if Self.Data.PatchType <> EBASHPatchType.HERB then
      Exit;
  end;

  function CheckHarvestXp(): Boolean;
  begin
    Result := XPBar.EarnedXP();
    if Result and (not herbFirstXpLogged) then
    begin
      herbFirstXpLogged := True;
      LogHerbSoil('first XP');
    end;
  end;

  function ClickHarvestAim(attempt: Int32): Boolean;
  begin
    Result := False;
    if not Self.EnsureHarvestSpace() then
      Exit;
    if not Self.Hover(attempt) then
      Exit;

    if WaitUntil(
      (Self.HarvestUpText in MainScreen.GetUpText()) or MainScreen.IsUpText(Self.HarvestUpText),
      40,
      2000
    ) then
    begin
      Mouse.Click(MOUSE_LEFT);
      Exit(MainScreen.DidRedClick());
    end;
  end;

  function ResumePick(): Boolean;
  begin
    Result := False;
    if not Self.EnsureHarvestSpace() then
      Exit;
    if Self.Data.PatchType = EBASHPatchType.ALLOTMENT then
    begin
      Inc(aimAttempt);
      if aimAttempt < 1 then
        aimAttempt := 1;
      if not ClickHarvestAim(aimAttempt) then
        Exit;
    end
    else
    begin
      if not Self.ClickUpText(Self.HarvestUpText) then
        Exit;
      if not MainScreen.DidRedClick() then
        Exit;
    end;

    lastCount := Inventory.Count();
    lastEmpty := Inventory.CountEmptySlots();
    Result := True;
  end;

  procedure FreeInventForPick();
  begin
    Self.DropEmptyBuckets();
    if Inventory.IsFull() or (Inventory.CountEmptySlots() < 3) then
    begin
      Self.NoteItems();
    end;
    lastCount := Inventory.Count();
    lastEmpty := Inventory.CountEmptySlots();
  end;

  function PostNotePatchCheck(): Boolean;
  var
    upText: String;
  begin
    Minimap.WaitPlayerMoving(250, 1200);

    if not Self.Hover() then
    begin
      WriteLn('[BASHFarm] Harvest: post-note hover missed - will recheck');
      Self.Harvested := False;
      Exit(True);
    end;

    upText := MainScreen.GetUpText();
    if Self.HarvestUpText in upText then
    begin
      Self.Harvested := False;
      Exit(True);
    end;
    if BASHFarmUpTextHasFarmProduce(upText) then
    begin
      WriteLn('[BASHFarm] Harvest: post-note produce still on patch ("', upText, '")');
      Self.Harvested := False;
      Exit(True);
    end;
    if PatchLooksEmpty(upText) then
    begin
      Self.Harvested := True;
      Exit(True);
    end;

    WriteLn('[BASHFarm] Harvest: post-note uptext ambiguous ("', upText, '") - will recheck');
    Self.Harvested := False;
    Result := True;
  end;
begin
  Result := False;
  Self.Harvested := False;
  herbFirstXpLogged := False;
  aimAttempt := 0;
  gotActivity := False;

  WriteLn('[BASHFarm] Harvesting ', Self.Data.Name);

  if not Self.EnsureHarvestSpace() then
  begin
    WriteLn('[BASHFarm] Harvest: cannot pick, inventory still full at ', Self.Data.Name);
    Exit(PostNotePatchCheck());
  end;

  if Self.Data.PatchType = EBASHPatchType.FLOWER then
    Self.NoteItems();

  if Self.Data.PatchType = EBASHPatchType.ALLOTMENT then
  begin
    gotActivity := False;
    lastCount := Inventory.Count();
    lastEmpty := Inventory.CountEmptySlots();

    if Inventory.IsFull() or (Inventory.CountEmptySlots() < 3) then
      FreeInventForPick();
    if Inventory.IsFull() then
    begin
      WriteLn('[BASHFarm] Harvest: invent full before allotment pick at ', Self.Data.Name);
      Exit(PostNotePatchCheck());
    end;

    for aimAttempt := 1 to 8 do
    begin
      if Inventory.IsFull() then
      begin
        WriteLn('[BASHFarm] Harvest: invent full before aim - noting at ', Self.Data.Name);
        FreeInventForPick();
        if Inventory.IsFull() then
        begin
          WriteLn('[BASHFarm] Harvest: invent still full - cannot pick ', Self.Data.Name);
          Exit(PostNotePatchCheck());
        end;
      end;

      if not ClickHarvestAim(aimAttempt) then
      begin
        if aimAttempt < 8 then
        begin
          if aimAttempt = 2 then
            WriteLn('[BASHFarm] Harvest: retry closer to player at ', Self.Data.Name)
          else if aimAttempt = 5 then
            WriteLn('[BASHFarm] Harvest: retry new front-edge spot at ', Self.Data.Name);
        end;
        Continue;
      end;

      XPBar.Read();
      XPBar.EarnedXP();
      lastCount := Inventory.Count();
      lastEmpty := Inventory.CountEmptySlots();
      waitMs := Self.WalkWaitMs(4500);
      if WaitUntil(
        XPBar.EarnedXP() or
        (Inventory.Count() <> lastCount) or
        (Inventory.CountEmptySlots() <> lastEmpty) or
        Self.CombatHpDropped(),
        35,
        waitMs
      ) then
      begin
        if Self.BailIfCombatHpDropped() then
          Exit(False);
        gotActivity := True;
        Break;
      end;

      // Full invent looks like a missed click — note and only re-aim if we have space.
      if Inventory.IsFull() then
      begin
        WriteLn('[BASHFarm] Harvest: no start - invent full after click, noting at ', Self.Data.Name);
        FreeInventForPick();
        if Inventory.IsFull() then
        begin
          WriteLn('[BASHFarm] Harvest: invent still full - cannot pick ', Self.Data.Name);
          Exit(PostNotePatchCheck());
        end;
        Continue;
      end;

      Minimap.WaitPlayerMoving(200, 900);
      if aimAttempt < 8 then
      begin
        if aimAttempt = 2 then
          WriteLn('[BASHFarm] Harvest: no start after click - retry closer at ', Self.Data.Name)
        else if aimAttempt = 5 then
          WriteLn('[BASHFarm] Harvest: no start after click - retry new front spot at ', Self.Data.Name)
        else
          WriteLn('[BASHFarm] Harvest: no start after click - re-aim at ', Self.Data.Name,
                  ' (attempt ', aimAttempt, ')');
      end;
    end;

    if not gotActivity then
    begin
      WriteLn('[BASHFarm] Harvest: could not start allotment pick at ', Self.Data.Name);
      Exit(False);
    end;
  end
  else
  begin
    if not Self.EnsureHarvestSpace() then
    begin
      WriteLn('[BASHFarm] Harvest: invent full before pick at ', Self.Data.Name);
      Exit(PostNotePatchCheck());
    end;

    if not Self.ClickUpText(Self.HarvestUpText) then
      Exit(False);

    if not MainScreen.DidRedClick() then
      Exit(False);
  end;

  XPBar.Read();
  XPBar.EarnedXP();

  if Self.Data.PatchType = EBASHPatchType.FLOWER then
  begin
    waitMs := Self.WalkWaitMs(5000);
    Result := WaitUntil(
      XPBar.EarnedXP() or Self.CombatHpDropped(),
      35,
      waitMs
    );
    if Self.BailIfCombatHpDropped() then
      Exit(False);
    if Result then
    begin
      Self.DropEmptyBuckets();
      Self.Harvested := True;
    end
    else
      WriteLn('[BASHFarm] Harvest: flower timed out waiting for XP');
    Exit;
  end;

  lastCount := Inventory.Count();
  lastEmpty := Inventory.CountEmptySlots();
  timeout.Init((Inventory.CountEmptySlots() + 3) * 3 * 600);
  started := False;
  reaim.Init(2800);

  if (Self.Data.PatchType = EBASHPatchType.ALLOTMENT) and gotActivity then
  begin
    started := True;
    stall.Init(2000);
    Result := True;
  end
  else if CheckHarvestXp() or
          (Inventory.Count() <> lastCount) or
          (Inventory.CountEmptySlots() <> lastEmpty) then
  begin
    started := True;
    stall.Init(2000);
    Result := True;
    lastCount := Inventory.Count();
    lastEmpty := Inventory.CountEmptySlots();
  end;

  while not timeout.IsFinished() do
  begin
    if Self.BailIfCombatHpDropped() then
      Exit(False);

    gotActivity := False;

    if CheckHarvestXp() then
      gotActivity := True;

    curCount := Inventory.Count();
    curEmpty := Inventory.CountEmptySlots();
    if (curCount <> lastCount) or (curEmpty <> lastEmpty) then
    begin
      lastCount := curCount;
      lastEmpty := curEmpty;
      gotActivity := True;
    end;

    if gotActivity then
    begin
      Result := True;
      if not started then
      begin
        started := True;
        stall.Init(2000);
      end
      else
        stall.Restart();
      reaim.Restart();
    end;

    if (not started) and
       (Self.Data.PatchType = EBASHPatchType.ALLOTMENT) and
       reaim.IsFinished() then
    begin
      if Inventory.IsFull() then
      begin
        WriteLn('[BASHFarm] Harvest: invent full before re-aim - noting at ', Self.Data.Name);
        FreeInventForPick();
        if Inventory.IsFull() then
          Exit(PostNotePatchCheck());
      end
      else
      begin
        Inc(aimAttempt);
        WriteLn('[BASHFarm] Harvest: still no XP - re-aim attempt ', aimAttempt, ' at ', Self.Data.Name);
        if ClickHarvestAim(aimAttempt) then
        begin
          lastCount := Inventory.Count();
          lastEmpty := Inventory.CountEmptySlots();
        end;
      end;
      reaim.Restart();
    end;

    if started and
       (Self.Data.PatchType = EBASHPatchType.ALLOTMENT) and
       Inventory.IsFull() then
    begin
      WriteLn('[BASHFarm] Harvest: allotment invent full - noting');
      Self.DropEmptyBuckets();
      Self.NoteItems();
      Exit(PostNotePatchCheck());
    end;

    if started and (not gotActivity) and stall.IsFinished() then
    begin
      if Self.Hover(Max(1, aimAttempt)) then
      begin
        upText := MainScreen.GetUpText();
        if PatchStillHarvestable(upText) then
        begin
          if not Self.EnsureHarvestSpace() then
          begin
            Self.Harvested := False;
            Exit(PostNotePatchCheck());
          end;
          if ResumePick() then
          begin
            stall.Restart();
            Continue;
          end;
          WriteLn('[BASHFarm] Harvest: crop still present at ', Self.Data.Name,
                  ' ("', upText, '")');
          Self.Harvested := False;
          Exit(True);
        end;

        if PatchLooksEmpty(upText) then
        begin
          Self.DropEmptyBuckets();
          if Inventory.IsFull() then
            Self.NoteItems();
          LogHerbSoil('finished');
          Self.Harvested := True;
          Exit(True);
        end;

        Self.DropEmptyBuckets();
        if Inventory.IsFull() then
          Self.NoteItems();
        LogHerbSoil('finished');
        Self.Harvested := True;
        Exit(True);
      end;

      if Inventory.IsFull() or (Inventory.CountEmptySlots() < 2) then
      begin
        FreeInventForPick();
        if ResumePick() then
        begin
          stall.Restart();
          timeout.Init(25000);
          Continue;
        end;

        if Self.Hover(Max(1, aimAttempt)) then
        begin
          upText := MainScreen.GetUpText();
          if PatchStillHarvestable(upText) then
          begin
            WriteLn('[BASHFarm] Harvest: resume failed, still grown');
            Self.Harvested := False;
            Exit(True);
          end;
          if PatchLooksEmpty(upText) then
          begin
            LogHerbSoil('finished');
            Self.Harvested := True;
            Exit(True);
          end;
        end;

        LogHerbSoil('finished');
        Self.Harvested := True;
        Exit(True);
      end;

      if ResumePick() then
      begin
        stall.Restart();
        Continue;
      end;

      if Self.Hover(Max(1, aimAttempt)) then
      begin
        upText := MainScreen.GetUpText();
        if PatchStillHarvestable(upText) then
        begin
          WriteLn('[BASHFarm] Harvest: resume failed, still grown');
          Self.Harvested := False;
          Exit(True);
        end;
      end;

      Self.DropEmptyBuckets();
      LogHerbSoil('finished');
      Self.Harvested := True;
      Exit(True);
    end;

    WaitUntil(
      CheckHarvestXp() or
      (Inventory.Count() <> lastCount) or
      (Inventory.CountEmptySlots() <> lastEmpty) or
      Self.CombatHpDropped(),
      35,
      250
    );
  end;

  WriteLn('[BASHFarm] Harvest timed out at ', Self.Data.Name);

  if not started then
  begin
    WriteLn('[BASHFarm] Harvest: timed out before first XP/invent');
    Exit(False);
  end;

  if Inventory.IsFull() then
    FreeInventForPick();

  if Self.Hover() then
  begin
    upText := MainScreen.GetUpText();
    if PatchStillHarvestable(upText) then
    begin
      WriteLn('[BASHFarm] Harvest timeout: still harvestable');
      Self.Harvested := False;
      Result := True;
    end
    else if PatchLooksEmpty(upText) then
    begin
      LogHerbSoil('finished');
      Self.Harvested := True;
      Result := True;
    end
    else
    begin
      WriteLn('[BASHFarm] Harvest timeout: patch state unclear ("', upText, '")');
      Self.Harvested := False;
      Result := True;
    end;
  end
  else
  begin
    WriteLn('[BASHFarm] Harvest timeout: could not hover patch');
    Self.Harvested := False;
    Result := True;
  end;
end;

function TBASHFarmPatch.Plant(): Boolean;
var
  attempt, seedBefore, seedsNeeded: Int32;
  clickAt: TPoint;
  justRaked: Boolean;
  tClick, deadline: UInt64;
  up: String;
  compostPrepped, compostHovered: Boolean;

  function WillCompostAfterPlant(): Boolean;
  begin
    Result := (not Self.Composted) and
              (Self.UseFertileSoil or (Self.CompostItem <> ''));
  end;

  function PlantFinished(): Boolean;
  var
    nowCount: Int32;
  begin
    nowCount := BASHFarmCountSeed(Self.Seed);
    Result :=
      ((seedBefore > 0) and (nowCount >= 0) and (nowCount <= seedBefore - seedsNeeded)) or
      ((seedBefore > 0) and (nowCount >= 0) and (nowCount < seedBefore)) or
      ((seedBefore <= seedsNeeded) and (not Inventory.ContainsItem(Self.Seed))) or
      XPBar.EarnedXP();
  end;

  function PrepBucketCompost(): Boolean;
  begin
    Result := False;
    compostHovered := False;
    if Self.UseFertileSoil or (Self.CompostItem = '') then
      Exit;
    if not Inventory.ContainsItem(Self.CompostItem) then
      Exit;
    Result := Inventory.SetSelectedItem(Self.CompostItem);
    if Result and (Random(100) < 78) then
    begin
      compostHovered := True;
      Self.Hover();
    end;
  end;

  function FinishWithCompost(): Boolean;
  begin
    Result := False;
    if not WillCompostAfterPlant() then
      Exit(True);

    WaitUntil(Chat.FindMessage('You plant'), 35, 5000);
    Wait(1000, 1400);
    if compostHovered then
      Wait(1500, 2000);

    if Self.UseFertileSoil then
    begin
      Result := Self.FertileSoil();
      Exit;
    end;

    Result := Self.Compost();
  end;

  function TryPlantSeed(): Boolean;
  var
    seedUp, useTarget, lowUp, emptyNeedle, chatBefore: String;
    aimAttempt, slashAt: Int32;
    ready, grown, needsWeeding: Boolean;

    function PlantUpTextReady(): Boolean;
    begin
      seedUp := MainScreen.GetUpText();
      useTarget := BASHFarmUpTextUseTarget(seedUp);
      slashAt := Pos(' / ', useTarget);
      if slashAt > 0 then
        useTarget := Trim(Copy(useTarget, 1, slashAt - 1));

      if ('->' in seedUp) or ('>' in seedUp) then
        if Length(Trim(useTarget)) < 3 then
          Exit(False);

      ready := (emptyNeedle <> '') and (
        (emptyNeedle in useTarget) or
        (emptyNeedle in seedUp)
      );
      grown := (useTarget <> '') and
               (not ready) and
               (
                 BASHFarmUpTextHasFarmProduce(useTarget) or
                 (Self.HarvestUpText in useTarget) or
                 ('arves' in useTarget) or
                 (('ick' in useTarget) and ('pick' in LowerCase(useTarget)))
               );
      Result := ready or grown;
    end;
  begin
    Result := False;
    compostPrepped := False;
    compostHovered := False;
    emptyNeedle := BASHFarmEmptyUpTextNeedle(Self.EmptyUpText);

    seedBefore := BASHFarmCountSeed(Self.Seed);
    if seedBefore < seedsNeeded then
    begin
      WriteLn('[BASHFarm] Not enough seeds to plant (have ', seedBefore, ', need ', seedsNeeded, ')');
      Self.OutOfSeeds := True;
      Exit(False);
    end;

    if Inventory.GetSelectedSlot() = -1 then
      if not Inventory.SetSelectedItem(Self.Seed) then
        Exit(False);

    if not Self.Find() then
    begin
      Self.WalkFind();
      if not Self.Find() then
        Exit(False);
    end;

    for aimAttempt := 1 to 10 do
    begin
      if Inventory.GetSelectedSlot() = -1 then
        if not Inventory.SetSelectedItem(Self.Seed) then
          Exit(False);

      clickAt := Self.GetAimClick(aimAttempt);

      Mouse.Move(clickAt);
      seedUp := '';
      useTarget := '';
      ready := False;
      grown := False;
      WaitUntil(PlantUpTextReady(), 40, 2000);

      if ready then
      begin
        Self.CommitAimTile();
        chatBefore := Chat.GetMessage(7);
        Mouse.Click(MOUSE_LEFT);

        if not MainScreen.DidRedClick() then
          Continue;

        if Chat.HasContinue() then
          Chat.ClickContinue(True);

        needsWeeding := False;
        tClick := GetTickCount();
        deadline := tClick + 8000;
        while GetTickCount() < deadline do
        begin
          if PlantFinished() then
          begin
            Result := True;
            Exit;
          end;

          if BASHFarmNeedsWeedingChat(chatBefore) then
          begin
            needsWeeding := True;
            Break;
          end;

          if (not compostPrepped) and
             WillCompostAfterPlant() and
             (not Self.UseFertileSoil) and
             (GetTickCount() >= tClick + 350) then
            compostPrepped := PrepBucketCompost();

          Wait(35);
        end;

        if needsWeeding then
          WriteLn('[BASHFarm] Plant: "', Self.EmptyUpText, '" needs weeding first at ',
                  Self.Data.Name, ' - raking then retry')
        else
          WriteLn('[BASHFarm] Plant: click on "', Self.EmptyUpText,
                  '" did not plant at ', Self.Data.Name, ' - checking for weeds');

        Inventory.SetSelectedSlot(-1);
        if Self.Hover() then
          lowUp := MainScreen.GetUpText()
        else
          lowUp := '';

        if needsWeeding or ('Rake' in lowUp) then
        begin
          if not needsWeeding then
            WriteLn('[BASHFarm] Plant: weeds present at ', Self.Data.Name, ' - raking then retry');
          if Self.ClearWeeds(False, needsWeeding) then
          begin
            if not Inventory.SetSelectedItem(Self.Seed) then
              Exit(False);
            Continue;
          end;
        end;

        if not Inventory.SetSelectedItem(Self.Seed) then
          Exit(False);
        Continue;
      end;

      if grown then
      begin
        WriteLn('[BASHFarm] Plant: seed aimed at crop at ', Self.Data.Name,
                ' (Use -> "', useTarget, '") - needs harvest');
        Inventory.SetSelectedSlot(-1);
        Self.Harvested := False;
        Exit(False);
      end;

      if Self.Data.PatchType = EBASHPatchType.ALLOTMENT then
      begin
        if aimAttempt = 3 then
          WriteLn('[BASHFarm] Plant: retry closer to player at ', Self.Data.Name,
                  ' (got="', seedUp, '", want Use -> "', Self.EmptyUpText, '")')
        else if aimAttempt = 6 then
          WriteLn('[BASHFarm] Plant: retry new front-edge spot at ', Self.Data.Name,
                  ' (got="', seedUp, '", want Use -> "', Self.EmptyUpText, '")')
        else if aimAttempt = 1 then
          WriteLn('[BASHFarm] Plant: try again at ', Self.Data.Name,
                  ' (got="', seedUp, '", want Use -> "', Self.EmptyUpText, '")');
      end
      else if aimAttempt = 1 then
        WriteLn('[BASHFarm] Plant: try again at ', Self.Data.Name,
                ' (got="', seedUp, '", want Use -> "', Self.EmptyUpText, '")');
    end;

    WriteLn('[BASHFarm] Plant: could not get Use -> "', Self.EmptyUpText, '" at ',
            Self.Data.Name, ' (last="', seedUp, '")');
  end;

  function MarkPlantedAndCompost(): Boolean;
  begin
    Self.Planted := True;
    Self.Harvested := False;
    FinishWithCompost();
    Self.DropWeeds();
    Result := True;
  end;

  function RakeThenPlant(): Boolean;
  begin
    Result := False;
    if not Self.ClearWeeds(False, True) then
      Exit(False);

    WriteLn('[BASHFarm] Weeds cleared - planting seed immediately');
    XPBar.Read();
    XPBar.EarnedXP();
    Result := TryPlantSeed();
    if Result then
      Result := MarkPlantedAndCompost();
  end;
begin
  Result := False;
  justRaked := False;
  compostPrepped := False;
  compostHovered := False;

  if Inventory.IsFull() then
  begin
    WriteLn('[BASHFarm] Inventory full before planting - noting at leprechaun');
    Self.NoteItems();
    if Inventory.IsFull() then
    begin
      WriteLn('[BASHFarm] Inventory still full after note, cannot plant');
      Exit(False);
    end;
  end;

  if Self.Data.PatchType = EBASHPatchType.ALLOTMENT then
    seedsNeeded := 3
  else
    seedsNeeded := 1;

  seedBefore := BASHFarmCountSeed(Self.Seed);

  if seedBefore < seedsNeeded then
  begin
    WriteLn('[BASHFarm] Not enough seeds to plant (have ', seedBefore, ', need ', seedsNeeded, ')');
    Self.OutOfSeeds := True;
    Exit(False);
  end;

  WriteLn('[BASHFarm] Planting ', ToStr(Self.Seed), ' at ', Self.Data.Name);

  XPBar.Read();
  XPBar.EarnedXP();

  Inventory.SetSelectedSlot(-1);
  up := MainScreen.GetUpText();
  if ('Rake' in up) or (Self.Hover() and ('Rake' in MainScreen.GetUpText())) then
  begin
    if RakeThenPlant() then
    begin
      Exit(True);
    end;
  end;

  for attempt := 1 to 5 do
  begin
    if TryPlantSeed() then
    begin
      Result := MarkPlantedAndCompost();
      Exit;
    end;

    if not Self.Harvested then
    begin
      Inventory.SetSelectedSlot(-1);
      WriteLn('[BASHFarm] Plant aborted at ', Self.Data.Name, ' - patch still needs harvest');
      Exit(False);
    end;

    WriteLn('[BASHFarm] Plant attempt ', attempt, ' failed at ', Self.Data.Name,
            ' - checking Rake/harvest then rotating camera');

    Inventory.SetSelectedSlot(-1);

    if not Self.Hover() then
    begin
      if not Self.Find() then
        Self.WalkFind();
      if not Self.Hover() then
      begin
        if attempt < 5 then
        begin
          Wait(900, 1100);
          Minimap.SetCompassAngle(
            Minimap.GetCompassAngle() + Random(35, 70) * (1 - 2 * (attempt mod 2)), 10);
        end;
        Continue;
      end;
    end;

    up := MainScreen.GetUpText();
    if (Self.HarvestUpText in up) or BASHFarmUpTextHasFarmProduce(up) then
    begin
      WriteLn('[BASHFarm] Plant: harvest uptext after fail at ', Self.Data.Name,
              ' ("', up, '")');
      Self.Harvested := False;
      Exit(False);
    end;

    if ('Rake' in up) or Chat.FindMessage('needs weeding') then
    begin
      if RakeThenPlant() then
      begin
        Exit(True);
      end;
      justRaked := True;
    end;

    if attempt < 5 then
    begin
      WriteLn('[BASHFarm] Plant: rotating camera before retry at ', Self.Data.Name);
      Minimap.SetCompassAngle(
        Minimap.GetCompassAngle() + Random(35, 70) * (1 - 2 * (attempt mod 2)), 10);
      if not Self.Find() then
        Self.WalkFind();
    end;
  end;

  Inventory.SetSelectedSlot(-1);
  if justRaked then
    Self.DropWeeds();
  Result := False;
end;

function TBASHFarmPatch.CompostItemInUseUpText(const up: String): Boolean;
var
  source: String;
  arrowAt: Int32;
  item: String;
begin
  Result := False;
  if up = '' then
    Exit;

  arrowAt := Pos('->', up);
  if arrowAt <= 0 then
    arrowAt := Pos('>', up);
  if arrowAt > 0 then
    source := Copy(up, 1, arrowAt - 1)
  else
    source := up;

  if ('Bucket' in source) and (not ('ompost' in source)) then
    Exit(False);

  item := ToStr(Self.CompostItem);
  if item = '' then
    Exit(False);
  if item in source then
    Exit(True);

  case item of
    'Bottomless compost bucket':
      Result := 'ottomless' in source;
    'Ultracompost':
      Result := 'Ultra' in source;
    'Supercompost':
      Result := 'Super' in source;
    'Compost':
      Result := ('Compost' in source) and (not ('Ultra' in source)) and (not ('Super' in source));
  end;
end;

function TBASHFarmPatch.CompostTargetReady(const up: String): Boolean;
var
  target, crop, lowTarget, patchNeedle: String;
  cutAt: Int32;
begin
  Result := False;
  if up = '' then
    Exit;
  if not (('->' in up) or ('>' in up) or ('Use' in up)) then
    Exit;
  if not Self.CompostItemInUseUpText(up) then
    Exit;

  target := BASHFarmUpTextUseTarget(up);
  cutAt := Pos(' / ', target);
  if cutAt > 0 then
    target := Trim(Copy(target, 1, cutAt - 1));
  if Length(Trim(target)) < 3 then
    Exit;

  patchNeedle := BASHFarmEmptyUpTextNeedle(Self.EmptyUpText);
  if patchNeedle = '' then
    patchNeedle := BASHFarmEmptyUpTextNeedle(Self.PlantedUpText);

  if patchNeedle <> '' then
  begin
    if patchNeedle in target then
      Exit(True);
    if patchNeedle in up then
      Exit(True);
  end;

  crop := BASHFarmSeedCropNeedle(Self.Seed);
  if (crop <> '') and ((crop in target) or (crop in up)) then
    Exit(True);

  lowTarget := LowerCase(target);
  if ('plant' in lowTarget) or ('herb' in lowTarget) or ('allot' in lowTarget) then
    Exit(True);

  if Self.HasPatchUpText(target) or Self.HasPatchUpText(up) then
    Exit(True);
  if BASHFarmUpTextHasFarmProduce(target) or BASHFarmUpTextHasFarmProduce(up) then
    Exit(True);
  if (Self.HarvestUpText <> '') and (Self.HarvestUpText in target) then
    Exit(True);
end;

function TBASHFarmPatch.EnsureCompostSelected(): Boolean;
begin
  Result := False;
  if not Inventory.ContainsItem(Self.CompostItem) then
    if not Self.WithdrawLepCompost() then
      Exit(False);

  Result := Inventory.SetSelectedItem(Self.CompostItem);
end;

function TBASHFarmPatch.Compost(): Boolean;
var
  i, aimAttempt, maxAims: Int32;
  isBottomless, treatedBefore, ready: Boolean;
  waitMs: Int32;
  clickAt: TPoint;
  compostUp, useTarget, chatBefore: String;
  correctItems: TRSItemArray := ['Bottomless compost bucket', 'Ultracompost', 'Supercompost', 'Compost'];

  function CompostUpTextReady(): Boolean;
  var
    slashAt: Int32;
    target: String;
  begin
    compostUp := MainScreen.GetUpText();
    target := BASHFarmUpTextUseTarget(compostUp);
    slashAt := Pos(' / ', target);
    if slashAt > 0 then
      target := Trim(Copy(target, 1, slashAt - 1));
    useTarget := target;

    if ('->' in compostUp) or ('>' in compostUp) then
      if Length(Trim(target)) < 3 then
        Exit(False);

    Result := Self.CompostTargetReady(compostUp);
  end;
begin
  Result := False;

  if Self.Composted then
    Exit(True);

  for i := 0 to High(correctItems) do
    if Self.CompostItem = correctItems[i] then
    begin
      Result := True;
      Break;
    end;

  if not Result then
    Exit(False);

  Result := False;
  isBottomless := Self.CompostItem = 'Bottomless compost bucket';

  if not Self.EnsureCompostSelected() then
    Exit(False);

  WriteLn('[BASHFarm] Composting ', Self.Data.Name);

  if Self.Data.PatchType = EBASHPatchType.ALLOTMENT then
    maxAims := 10
  else
    maxAims := 8;

  XPBar.Read();
  XPBar.EarnedXP();
  chatBefore := Chat.GetMessage(7);
  treatedBefore := Chat.FindMessage('already been treated');

  if not Self.Find() then
  begin
    Self.WalkFind();
    if not Self.Find() then
      Exit(False);
  end;

  for aimAttempt := 1 to maxAims do
  begin
    if not Self.EnsureCompostSelected() then
      Break;

    compostUp := MainScreen.GetUpText();
    ready := Self.CompostTargetReady(compostUp);

    if not ready then
    begin
      clickAt := Self.GetAimClick(aimAttempt);
      Mouse.Move(clickAt);
      compostUp := '';
      useTarget := '';
      ready := WaitUntil(CompostUpTextReady(), 40, 2000);
    end;

    if not ready then
    begin
      if Self.Data.PatchType = EBASHPatchType.ALLOTMENT then
      begin
        if aimAttempt = 3 then
          WriteLn('[BASHFarm] Compost: retry closer to player at ', Self.Data.Name,
                  ' (got="', compostUp, '")')
        else if aimAttempt = 6 then
          WriteLn('[BASHFarm] Compost: retry new front-edge spot at ', Self.Data.Name,
                  ' (got="', compostUp, '")')
        else if aimAttempt = 1 then
          WriteLn('[BASHFarm] Compost: try again at ', Self.Data.Name,
                  ' (got="', compostUp, '")');
      end
      else if aimAttempt = 1 then
        WriteLn('[BASHFarm] Compost: try again at ', Self.Data.Name,
                ' (got="', compostUp, '")');
      Continue;
    end;

    Self.CommitAimTile();
    XPBar.Read();
    XPBar.EarnedXP();
    Mouse.Click(MOUSE_LEFT);

    if not MainScreen.DidRedClick() then
      Continue;

    waitMs := Self.WalkWaitMs(5000);
    Result := WaitUntil(BASHFarmCompostConfirmed(chatBefore), 35, waitMs);

    if (not Result) and (not treatedBefore) and Chat.FindMessage('already been treated') then
    begin
      WriteLn('[BASHFarm] ', Self.Data.Name, ' already been treated - not composting again');
      Result := True;
    end;

    if Result then
      Break;

    WriteLn('[BASHFarm] Compost not applied on ', Self.Data.Name,
            ' - no XP/chat, retrying (', aimAttempt, '/', maxAims, ')');
  end;

  Self.Composted := Result;
  Inventory.SetSelectedSlot(-1);
  if not Result then
    WriteLn('[BASHFarm] Compost unconfirmed on ', Self.Data.Name);

  if Result and (not isBottomless) then
    Self.DropEmptyBuckets();
end;

function TBASHFarmPatch.FertileSoil(): Boolean;
var
  attempt: Int32;
  waitMs: Int32;
begin
  if Magic.GetSpellBook() <> ERSSpellBook.LUNAR then
    Exit(False);

  if not Self.Find() then
    Exit(False);

  for 1 to 2 do
    if Magic.CastSpell(ERSSpell.FERTILE_SOIL) then
      Break;

  XPBar.EarnedXP();

  for attempt := 1 to 4 do
  begin
    if not Magic.IsSelected(ERSSpell.FERTILE_SOIL) then
      Exit(False);

    if not Self.Find() then
    begin
      Self.WalkFind();
      Continue;
    end;

    Mouse.Move(Self.GetAimClick(attempt));
    Self.CommitAimTile();
    Mouse.Click(MOUSE_LEFT);
    Break;
  end;

  if not MainScreen.DidRedClick() then
    Exit(False);

  waitMs := Self.WalkWaitMs(3000);
  Result := WaitUntil(XPBar.EarnedXP(), 35, waitMs);
  Self.Composted := Result;
end;

function TBASHFarmPatch.CheckHealth(): Boolean;
var
  waitMs: Int32;
begin
  if not Self.ClickUpText('eck-hea') then
    Exit(False);

  if not MainScreen.DidRedClick() then
    Exit(False);

  waitMs := Self.WalkWaitMs(4000);
  Result := WaitUntil(XPBar.EarnedXP(), 35, waitMs);
end;

function TBASHFarmPatch.DropWeeds(): Boolean;
var
  slots: TIntegerArray;
begin
  if not Inventory.FindItems(['Weeds'], slots) then
    Exit(True);

  Wait(Random(700, 900));

  WriteLn('[BASHFarm] Dropping ', Length(slots), ' weed slot(s)');
  Result := Inventory.ShiftDrop(slots);
end;

function TBASHFarmPatch.DropEmptyBuckets(): Boolean;
var
  slots: TIntegerArray;
begin
  Result := True;

  if Self.UseFertileSoil or (Self.CompostItem = 'Bottomless compost bucket') then
    Exit;

  if not Inventory.FindItems(['Bucket'], slots) then
    Exit;

  if not Inventory.IsFull() then
  begin
    if Random(100) >= 40 then
      Exit;
    WriteLn('[BASHFarm] Dropping ', Length(slots), ' empty bucket(s) (random)');
  end
  else
    WriteLn('[BASHFarm] Dropping ', Length(slots), ' empty bucket(s) (invent full)');

  Result := Inventory.ShiftDrop(slots);
end;

function TBASHFarmPatch.ClearWeeds(dropWeedsAfter: Boolean = False; requireRake: Boolean = False): Boolean;
var
  xpWaitMs: Int32;
  gotXp: Boolean;
  overall: TCountdown;
  up: String;
begin
  Result := False;
  Inventory.SetSelectedSlot(-1);

  if not Inventory.ContainsItem('Rake') then
  begin
    if not Self.WithdrawLepRake() then
    begin
      WriteLn('[BASHFarm] Could not withdraw rake from leprechaun');
      Exit(False);
    end;
  end;

  if not Self.Hover() then
  begin
    Self.WalkFind();
    if not Self.Hover() then
      Exit(False);
  end;

  up := MainScreen.GetUpText();
  if not ('Rake' in up) then
  begin
    if not requireRake then
    begin
      if dropWeedsAfter then
        Self.DropWeeds();
      Exit(True);
    end;
    WriteLn('[BASHFarm] Patch needs weeding - finding Rake at ', Self.Data.Name);
  end;

  WriteLn('[BASHFarm] Raking weeds at ', Self.Data.Name);

  if not Self.ClickUpText('Rake') then
    Exit(False);
  if not MainScreen.DidRedClick() then
    Exit(False);

  XPBar.Read();
  XPBar.EarnedXP();
  xpWaitMs := Self.WalkWaitMs(8000);
  overall.Init(Self.WalkWaitMs(30000));

  while not overall.IsFinished() do
  begin
    gotXp := WaitUntil(XPBar.EarnedXP(), 35, xpWaitMs);
    if not gotXp then
    begin
      Inventory.SetSelectedSlot(-1);
      if not Self.Hover() then
        Exit(False);
      up := MainScreen.GetUpText();
      if not ('Rake' in up) then
        Break;
      WriteLn('[BASHFarm] No rake XP - re-clicking Rake');
      if not Self.ClickUpText('Rake') then
        Exit(False);
      if not MainScreen.DidRedClick() then
        Exit(False);
      XPBar.Read();
      XPBar.EarnedXP();
      Continue;
    end;

    Inventory.SetSelectedSlot(-1);
    if not Self.Hover() then
    begin
      Self.WalkFind();
      if not Self.Hover() then
        Exit(False);
    end;

    up := MainScreen.GetUpText();
    if 'spect' in up then
    begin
      WriteLn('[BASHFarm] Patch shows Inspect - weeds cleared');
      Break;
    end;

    if 'Rake' in up then
    begin
      WriteLn('[BASHFarm] Still Rake after XP - waiting for next weed XP');
      Continue;
    end;

    WriteLn('[BASHFarm] After rake XP uptext=', up);
    Break;
  end;

  if dropWeedsAfter then
    Self.DropWeeds();

  Inventory.SetSelectedSlot(-1);
  if not Self.Hover() then
    Result := False
  else
    Result := not ('Rake' in MainScreen.GetUpText());
  if not Result then
    WriteLn('[BASHFarm] Failed to clear weeds at ', Self.Data.Name);
end;

function TBASHFarmPatch.ClearDead(): Boolean;
var
  waitMs: Int32;
  gotXp: Boolean;
  deadline: UInt64;
  up: String;
begin
  if not Self.ClickUpText('lear') then
    Exit(False);

  if not MainScreen.DidRedClick() then
    Exit(False);

  waitMs := Self.WalkWaitMs(5000);
  XPBar.Read();
  XPBar.EarnedXP();

  if Self.Data.PatchType in [EBASHPatchType.HERB, EBASHPatchType.FLOWER, EBASHPatchType.ALLOTMENT] then
  begin
    gotXp := WaitUntil(XPBar.EarnedXP(), 35, waitMs);
    if gotXp then
      waitMs := 2500
    else
      waitMs := Min(waitMs, 4000);

    Result := False;
    if not Self.Hover() then
      Exit(False);

    deadline := GetTickCount() + UInt64(waitMs);
    while GetTickCount() < deadline do
    begin
      up := MainScreen.GetUpText();
      if ('spect' in up) and (not ('lear' in up)) then
      begin
        Result := True;
        Break;
      end;
      if (Length(up) < 3) or (Random(100) < 12) then
        Self.Hover();
      Wait(40);
    end;

    if Result then
      WriteLn('[BASHFarm] ClearDead done at ', Self.Data.Name, ' uptext=', MainScreen.GetUpText())
    else
      WriteLn('[BASHFarm] ClearDead: timed out waiting for Inspect at ', Self.Data.Name);
    Exit;
  end;

  Result := WaitUntil(Self.IsEmpty(), 35, waitMs);
end;

function TBASHFarmPatch.Clear(): Boolean;
begin
  case Self.Data.PatchType of
    EBASHPatchType.TREE:
      begin
        if not Self.ClickUpText('lear') then
          Exit(False);

        if Chat.FindMessage('Pay') or WaitUntil(Chat.GetChatTitle() = 'Pay 200', 35, 1500) then
        begin
          Chat.ClickOption('Yes');
          WaitUntil(not Chat.IsOpen(), 35, 3000);
        end;

        Result := WaitUntil(Self.IsEmpty(), 35, 8000);
      end;
    EBASHPatchType.FRUIT:
      begin
        if not Self.ClickUpText('Chop') then
          Exit(False);

        WaitUntil(MainScreen.IsUpText('lear'), 35, 5000);
        if not Self.ClickUpText('lear') then
          Exit(False);

        Result := WaitUntil(Self.IsEmpty(), 35, 5000);
      end;
  else
    Result := Self.ClearDead();
  end;
end;

function TBASHFarmPatch.Cure(): Boolean;
var
  slot: Int32;
  waitMs: Int32;
begin
  if not Self.Find() then
    Exit(False);

  if not Inventory.FindItem('Plant cure', slot) then
    Exit(False);

  if not Inventory.SetSelectedSlot(slot) then
    Exit(False);

  if not Self.ClickUpText('seas') then
    Exit(False);

  if not MainScreen.DidRedClick() then
    Exit(False);

  waitMs := Self.WalkWaitMs(3000);
  Result := WaitUntil(not Self.IsDiseased(), 35, waitMs);
end;

const
  BASH_ATFARM_LEP_DIST = 40;
  BASH_ATFARM_PATCH_DIST = 48;
  BASH_SKIP_WALK_PATCH_DIST = 24;

function TBASHFarmPatch.AtFarm(): Boolean;
begin
  if (Length(Self.Data.StandTiles) > 0) and
     Map.Walker.AnyInRange(Self.Data.StandTiles, 6) then
    Exit(True);

  Result := Map.Walker.InRange(Self.Data.LeprechaunCoords, BASH_ATFARM_LEP_DIST) or
            Map.Walker.InRange(Self.Data.Coords, BASH_ATFARM_PATCH_DIST);
end;

function TBASHFarmPatch.UsesReusableCompost(): Boolean;
begin
  Result := Self.UseFertileSoil or (Self.CompostItem = 'Bottomless compost bucket');
end;

function TBASHFarmPatch.HasFarmToolsReady(includeCompost: Boolean = True): Boolean;
var
  needCompost: Boolean;
begin
  if Self.MagicSecateurs and
     (not Inventory.ContainsItem('Magic secateurs')) and
     (not Equipment.ContainsItem('Magic secateurs')) then
    Exit(False);
  if not Inventory.ContainsItem('Spade') then
    Exit(False);
  if (not Self.BarbDibber) and (not Inventory.ContainsItem('Seed dibber')) then
    Exit(False);

  needCompost := includeCompost and (not Self.UseFertileSoil) and (Self.CompostItem <> '');
  if needCompost and (not Inventory.ContainsItem(Self.CompostItem)) then
    Exit(False);

  Result := True;
end;

function TBASHFarmPatch.WalkNearPatch(untilDist: Int32 = 8): Boolean;
var
  me, dest: TPoint;
  attempt, maxAttempts, i, bestIdx, farAttempt: Int32;
  targets: TPointArray;
  stopDist: Int32;
  bestDist, dist: Double;

  function TryWebWalk(target: TPoint; stopAt: Int32): Boolean;
  begin
    Result := False;
    try
      Result := Map.Walker.WebWalk(target, stopAt, 0.15);
    except
      WriteLn('[BASHFarm] WebWalk connect failed to ', target, ' from ', Map.Position());
      Result := False;
    end;
  end;
begin
  Self.ApplyWalkDoorSolver();
  me := Map.Position();

  if Length(Self.Data.StandTiles) > 0 then
  begin
    if Map.Walker.AnyInRange(Self.Data.StandTiles, 4) then
      Exit(True);

    bestIdx := 0;
    bestDist := me.DistanceTo(Self.Data.StandTiles[0]);
    for i := 1 to High(Self.Data.StandTiles) do
    begin
      dist := me.DistanceTo(Self.Data.StandTiles[i]);
      if dist < bestDist then
      begin
        bestDist := dist;
        bestIdx := i;
      end;
    end;
    dest := Self.Data.StandTiles[bestIdx];

    WriteLn('[BASHFarm] Walking to stand pad at ', Self.Data.Name, ' -> ', dest);
    if not TryWebWalk(dest, 3) then
    begin
      WriteLn('[BASHFarm] Stand pad WebWalk failed at ', Self.Data.Name,
              ' (pos=', Map.Position(), ')');
      Exit(Map.Walker.AnyInRange(Self.Data.StandTiles, 6));
    end;

    Result := Map.Walker.AnyInRange(Self.Data.StandTiles, 4);
    if not Result then
      WriteLn('[BASHFarm] Not on stand pad after walk at ', Self.Data.Name,
              ' (pos=', Map.Position(), ')');
    Exit;
  end;

  if Map.Walker.InRange(Self.Data.Coords, Max(untilDist + 6, BASH_SKIP_WALK_PATCH_DIST)) then
    Exit(True);

  if me.DistanceTo(Self.Data.Coords) > 600 then
  begin
    for farAttempt := 1 to 4 do
    begin
      WriteLn('[BASHFarm] Too far from patch at ', Self.Data.Name,
              ' (dist=', Round(me.DistanceTo(Self.Data.Coords)),
              ') - waiting for teleport settle (', farAttempt, '/4)');
      Wait(900, 1100);

      if farAttempt = 2 then
        Minimap.SetCompassAngle(
          Minimap.GetCompassAngle() + Random(35, 70) * (1 - 2 * Random(2)), 10);

      me := Map.Position();
      if Map.Walker.InRange(Self.Data.Coords, Max(untilDist + 6, BASH_SKIP_WALK_PATCH_DIST)) then
        Exit(True);
      if me.DistanceTo(Self.Data.Coords) <= 600 then
        Break;

      if farAttempt = 4 then
      begin
        WriteLn('[BASHFarm] Too far from patch at ', Self.Data.Name,
                ' (dist=', Round(me.DistanceTo(Self.Data.Coords)), ') - aborting walk');
        Exit(False);
      end;
    end;
  end;

  WriteLn('[BASHFarm] Walking to patch at ', Self.Data.Name);

  targets := [
    Self.Data.Coords,
    Self.GetInteractTile(),
    Self.Data.MapCoords.Center()
  ];
  stopDist := Max(untilDist, 6);
  maxAttempts := Min(3, Length(targets));

  for attempt := 0 to maxAttempts - 1 do
  begin
    dest := targets[attempt];
    if attempt > 0 then
      WriteLn('[BASHFarm] Patch walk fallback ', attempt + 1, '/', maxAttempts, ' -> ', dest);

    if Self.IsPhasmatys() then
    begin
      if Self.TryWalkToward(dest, stopDist, 42, 5) then
        Exit(True);
    end
    else if TryWebWalk(dest, stopDist) then
      Exit(True);

    if Map.Walker.InRange(Self.Data.Coords, untilDist + 6) then
      Exit(True);
  end;

  Result := Map.Walker.InRange(Self.Data.Coords, untilDist + 10);
  if not Result then
    WriteLn('[BASHFarm] Failed to walk near patch at ', Self.Data.Name,
            ' (dist=', Round(Map.Position().DistanceTo(Self.Data.Coords)), ')');
end;

function TBASHFarmPatch.WalkToFarmWork(keepOut: Int32 = 10): Boolean;
var
  needCompost: Boolean;
begin
  needCompost := (not Self.UseFertileSoil) and (Self.CompostItem <> '');
  if not Self.HasFarmToolsReady(needCompost) then
  begin
    WriteLn('[BASHFarm] Tools/compost needed - walking to lep first at ', Self.Data.Name);
    Exit(Self.WalkNearLeprechaun(keepOut));
  end;
  Result := Self.WalkNearPatch(Max(keepOut - 2, 6));
end;

function TBASHFarmPatch.WalkNearLeprechaun(keepOut: Int32 = 10): Boolean;
var
  me, lep, dest: TPoint;
  dist: Double;
  attempt, maxAttempts: Int32;
  targets: TPointArray;
  untilDist: Int32;

  function TryWebWalk(target: TPoint; stopDist: Int32): Boolean;
  begin
    Result := False;
    try
      Result := Map.Walker.WebWalk(target, stopDist, 0.15);
    except
      WriteLn('[BASHFarm] WebWalk connect failed to ', target, ' from ', Map.Position());
      Result := False;
    end;
  end;

  function NearLep(): Boolean;
  begin
    me := Map.Position();
    dist := me.DistanceTo(lep);
    Result := (dist > 1) and (dist <= (keepOut + 18));
  end;
begin
  Self.ApplyWalkDoorSolver();
  lep := Self.Data.LeprechaunCoords;
  me := Map.Position();
  dist := me.DistanceTo(lep);

  if NearLep() then
  begin
    Map.Walker.MakePointVisible(lep);
    Exit(True);
  end;

 { if dist > 500 then // Remove for now we add back if we web walk fuck still
  begin
    WriteLn('[BASHFarm] Too far from leprechaun at ', Self.Data.Name,
            ' (dist=', Round(dist), ') - aborting walk');
    Exit(False);
  end;}

  WriteLn('[BASHFarm] Walking to farm near leprechaun at ', Self.Data.Name);

  targets := [
    [lep.X + 3, lep.Y + 3],
    [lep.X - 3, lep.Y + 3],
    [lep.X + 3, lep.Y - 3],
    [lep.X - 3, lep.Y - 3],
    [lep.X + 4, lep.Y],
    [lep.X - 4, lep.Y],
    [lep.X, lep.Y + 4],
    [lep.X, lep.Y - 4],
    Self.Data.MapCoords.Center(),
    Self.Data.Coords
  ];

  untilDist := Max(keepOut + 8, 14);
  maxAttempts := Min(3, Length(targets));

  for attempt := 0 to maxAttempts - 1 do
  begin
    dest := targets[attempt];
    if dest.DistanceTo(lep) <= 1 then
      Continue;

    if attempt > 0 then
      WriteLn('[BASHFarm] Lep walk fallback ', attempt + 1, '/', maxAttempts, ' -> ', dest);

    if Self.IsPhasmatys() then
    begin
      if Self.TryWalkToward(dest, untilDist, 42, 5) and NearLep() then
      begin
        Map.Walker.MakePointVisible(lep);
        Exit(True);
      end;
    end
    else if TryWebWalk(dest, untilDist) then
    begin
      if NearLep() then
      begin
        Map.Walker.MakePointVisible(lep);
        Exit(True);
      end;
    end;

    if NearLep() then
    begin
      Map.Walker.MakePointVisible(lep);
      Exit(True);
    end;
  end;

  Result := NearLep();
  if Result then
    Map.Walker.MakePointVisible(lep)
  else
    WriteLn('[BASHFarm] Failed to walk near leprechaun at ', Self.Data.Name,
            ' (dist=', Round(Map.Position().DistanceTo(lep)), ')');
end;

function TBASHFarmPatch.FindLeprechaun(out lepPoints: TPointArray): Boolean;
var
  filterPt, me, lep: TPoint;
  tpa: TPointArray;
  atpa: T2DPointArray;
  attempt: Int32;
  dist: Double;
  playerBox: TBox;

  function UnderClickPoint(): TPoint;
  begin
    playerBox := MainScreen.GetPlayerBox();
    playerBox.Y1 := playerBox.Y1 - Floor(playerBox.Height / 2);
    Result := playerBox.Middle;
  end;

  function TryColor(): Boolean;
  begin
    Result := False;
    SetLength(lepPoints, 0);
    filterPt := Map.GetTileMS(Self.Data.LeprechaunCoords).Mean;

    if SRL.FindColors(tpa, Self.Data.LeprechaunColor, MainScreen.Bounds) < 5 then
      Exit;

    atpa := tpa.Cluster(1);
    if Length(atpa) = 0 then
      Exit;

    if filterPt in MainScreen.Bounds then
      atpa.SortFrom(filterPt)
    else
      atpa.SortBySize();

    SetLength(lepPoints, 1);
    lepPoints[0] := atpa[0].Mean;
    Result := True;
  end;

  function TryUnderPlayer(): Boolean;
  begin
    Result := False;
    // Only trust minimap-dot-under when we are actually near the lep tile.
    if dist > 18 then
      Exit;
    if not Minimap.HasDotUnder() then
      Exit;

    SetLength(lepPoints, 1);
    lepPoints[0] := UnderClickPoint();
    WriteLn('[BASHFarm] Lep under player at ', Self.Data.Name, ' (minimap dot)');
    Result := True;
  end;

begin
  SetLength(lepPoints, 0);
  me := Map.Position();
  lep := Self.Data.LeprechaunCoords;
  dist := me.DistanceTo(lep);

  if not Self.AtFarm() then
  begin
    WriteLn('[BASHFarm] Walking to nearby lep for ', Self.Data.Name,
            ' (dist=', Round(dist), ')');
    if not Self.WalkNearLeprechaun(10) then
    begin
      WriteLn('[BASHFarm] Could not reach leprechaun at ', Self.Data.Name, ' - giving up');
      Exit(False);
    end;
    me := Map.Position();
    dist := me.DistanceTo(lep);
    if not Self.AtFarm() then
    begin
      WriteLn('[BASHFarm] Still too far from leprechaun at ', Self.Data.Name,
              ' (dist=', Round(dist), ')');
      Exit(False);
    end;
  end
  else
    Map.Walker.MakePointVisible(Self.Data.LeprechaunCoords);

  if TryColor() then
    Exit(True);
  if TryUnderPlayer() then
    Exit(True);

  for attempt := 0 to 2 do
  begin
    if dist > 3 then
      Map.Walker.MakePointVisible(Self.Data.LeprechaunCoords);

    me := Map.Position();
    dist := me.DistanceTo(lep);

    if TryColor() then
      Exit(True);
    if TryUnderPlayer() then
      Exit(True);

    Minimap.SetCompassAngle(Minimap.GetCompassAngle() + Random(35, 70) * (1 - 2 * (attempt mod 2)), 10);
  end;

  WriteLn('[BASHFarm] Could not find leprechaun at ', Self.Data.Name);
  Result := False;
end;

function TBASHFarmPatch.HoverLeprechaun(): Boolean;
var
  tpa: TPointArray;
  i: Int32;
  playerBox: TBox;
  under, me: TPoint;
begin
  if not Self.FindLeprechaun(tpa) then
    Exit(False);

  for i := 0 to High(tpa) do
  begin
    Mouse.Move(SRL.RandomPoint(tpa[i], MainScreen.NormalizeDistance(6)));
    if MainScreen.IsUpText('Lepr') then
      Exit(True);
  end;

  if Minimap.HasDotUnder() then
  begin
    me := Map.Position();
    if me.DistanceTo(Self.Data.LeprechaunCoords) <= 18 then
    begin
      playerBox := MainScreen.GetPlayerBox();
      playerBox.Y1 := playerBox.Y1 - Floor(playerBox.Height / 2);
      under := playerBox.Middle;
      Mouse.Move(SRL.RandomPoint(under, MainScreen.NormalizeDistance(6)));
      if MainScreen.IsUpText('Lepr') then
      begin
        WriteLn('[BASHFarm] Lep under player at ', Self.Data.Name, ' (minimap dot)');
        Exit(True);
      end;
    end;
  end;

  Result := MainScreen.IsUpText('Lepr');
end;

function TBASHFarmPatch.ClickLeprechaun(): Boolean;
var
  tpa: TPointArray;
  i: Int32;
  playerBox: TBox;
  under, me: TPoint;
begin
  if not Self.FindLeprechaun(tpa) then
    Exit(False);

  for i := 0 to High(tpa) do
  begin
    Mouse.Move(tpa[i]);
    if MainScreen.IsUpText('Lepr') then
      Break;
  end;

  if (not MainScreen.IsUpText('Lepr')) and Minimap.HasDotUnder() then
  begin
    me := Map.Position();
    if me.DistanceTo(Self.Data.LeprechaunCoords) <= 18 then
    begin
      playerBox := MainScreen.GetPlayerBox();
      playerBox.Y1 := playerBox.Y1 - Floor(playerBox.Height / 2);
      under := playerBox.Middle;
      Mouse.Move(under);
      if MainScreen.IsUpText('Lepr') then
        WriteLn('[BASHFarm] Lep under player at ', Self.Data.Name, ' (minimap dot)');
    end;
  end;

  if MainScreen.IsUpText('Lepr') then
    Mouse.Click(MOUSE_LEFT)
  else
    Exit(ChooseOption.Select('Lepr'));

  Result := True;
end;

{$I BashLib/optional/handlers/bashfarm/lep_slots.simba}

const
  BASH_LEP_STORE_COLS = 4;
  BASH_LEP_STORE_ROWS = 3;
  BASH_LEP_INV_COLS = 2;
  BASH_LEP_INV_ROWS = 6;

  BASH_LEP_SLOT_RAKE = 0;
  BASH_LEP_SLOT_DIBBER = 1;
  BASH_LEP_SLOT_SPADE = 2;
  BASH_LEP_SLOT_SECATEURS = 3;
  BASH_LEP_SLOT_WATERING_CAN = 4;
  BASH_LEP_SLOT_TROWEL = 5;
  BASH_LEP_SLOT_PLANT_CURE = 6;
  BASH_LEP_SLOT_BOTTOMLESS = 7;
  BASH_LEP_SLOT_BUCKETS = 8;
  BASH_LEP_SLOT_COMPOST = 9;
  BASH_LEP_SLOT_SUPERCOMPOST = 10;
  BASH_LEP_SLOT_ULTRACOMPOST = 11;

var
  BASHLepStoreSlots: TBoxArray;
  BASHLepInvSlots: TBoxArray;

function _BASHLepBox(x1, y1, x2, y2: Int32): TBox;
begin
  Result.X1 := x1;
  Result.Y1 := y1;
  Result.X2 := x2;
  Result.Y2 := y2;
end;

function _BASHLepOwnedGreen(): TCTS2Color;
begin
  Result := CTS2(2154272, 1, 0.01, 0.01);
end;

procedure _BASHLepClearSlots();
begin
  SetLength(BASHLepStoreSlots, 0);
  SetLength(BASHLepInvSlots, 0);
end;

function _BASHLepRefreshSlots(): Boolean;
begin
  Result := False;
  _BASHLepClearSlots();

  BASHLepStoreSlots := BASHLepFitGrid(
    BASHLepSteelCorners(MainScreen.Bounds),
    BASH_LEP_STORE_COLS,
    BASH_LEP_STORE_ROWS
  );
  BASHLepInvSlots := BASHLepFitGrid(
    BASHLepSteelCorners(GameTab.Bounds),
    BASH_LEP_INV_COLS,
    BASH_LEP_INV_ROWS
  );

  Result := (Length(BASHLepStoreSlots) = BASH_LEP_STORE_COLS * BASH_LEP_STORE_ROWS) and
            (Length(BASHLepInvSlots) = BASH_LEP_INV_COLS * BASH_LEP_INV_ROWS);

  if not Result then
    WriteLn('[BASHFarm] Lep slot scan incomplete: store ', Length(BASHLepStoreSlots),
            ' invent ', Length(BASHLepInvSlots));
end;

function _BASHLepEnsureSlots(): Boolean;
begin
  if (Length(BASHLepStoreSlots) >= 8) and (Length(BASHLepInvSlots) >= 8) then
    Exit(True);
  Result := _BASHLepRefreshSlots();
end;

function _BASHLepInvSlot(idx: Int32): TBox;
begin
  if (idx < 0) or (idx > High(BASHLepInvSlots)) then
    Exit(_BASHLepBox(0, 0, 0, 0));
  Result := BASHLepInvSlots[idx];
end;

function _BASHLepStoreSlot(idx: Int32): TBox;
begin
  if (idx < 0) or (idx > High(BASHLepStoreSlots)) then
    Exit(_BASHLepBox(0, 0, 0, 0));
  Result := BASHLepStoreSlots[idx];
end;

function TBASHFarmPatch.CompostSlotIdx(): Int32;
begin
  case Self.CompostItem of
    'Compost': Exit(BASH_LEP_SLOT_COMPOST);
    'Supercompost': Exit(BASH_LEP_SLOT_SUPERCOMPOST);
    'Ultracompost': Exit(BASH_LEP_SLOT_ULTRACOMPOST);
    'Bottomless compost bucket': Exit(BASH_LEP_SLOT_BOTTOMLESS);
  end;
  Result := -1;
end;

function TBASHFarmPatch.LepInvSlotIsGreen(slotIdx: Int32; minPixels: Int32 = 8): Boolean;
var
  box: TBox;
begin
  box := _BASHLepInvSlot(slotIdx);
  if (box.X2 <= box.X1) or (box.Y2 <= box.Y1) then
    Exit(False);

  Result := SRL.CountColor(_BASHLepOwnedGreen(), box) >= minPixels;
  if not Result then
    Result := SRL.CountColor(RS_ITEM_GREEN_STACK, box) >= minPixels;
end;

function TBASHFarmPatch.WaitLepInvSlotGreen(slotIdx: Int32; timeout: Int32 = 5000): Boolean;
begin
  Result := WaitUntil(Self.LepInvSlotIsGreen(slotIdx), 35, timeout);
end;

function TBASHFarmPatch.WaitLepInvSlotNotGreen(slotIdx: Int32; timeout: Int32 = 5000): Boolean;
begin
  Result := WaitUntil(not Self.LepInvSlotIsGreen(slotIdx), 35, timeout);
end;

function TBASHFarmPatch.OpenLepExchange(): Boolean;
var
  attempt: Int32;
begin
  if RSInterface.IsOpen() then
  begin
    _BASHLepEnsureSlots();
    Exit(True);
  end;

  if not Self.AtFarm() then
  begin
    if not Self.WalkNearLeprechaun(10) then
    begin
      WriteLn('[BASHFarm] OpenLepExchange: not at farm / cannot reach lep at ', Self.Data.Name);
      Exit(False);
    end;
  end;

  // Only note produce when we are actually at the farm lep.
  Self.NoteItems();

  Inventory.SetSelectedSlot(-1);
  RSInterface.Close();
  _BASHLepClearSlots();

  for attempt := 1 to 3 do
  begin
    if RSInterface.IsOpen() then
    begin
      _BASHLepRefreshSlots();
      Exit(True);
    end;

    if not Self.AtFarm() then
    begin
      WriteLn('[BASHFarm] OpenLepExchange: left farm area - aborting at ', Self.Data.Name);
      Exit(False);
    end;

    if not Self.HoverLeprechaun() then
    begin
      Map.Walker.MakePointVisible(Self.Data.LeprechaunCoords);
      Minimap.SetCompassAngle(Minimap.GetCompassAngle() + Random(40, 80) * (1 - 2 * (attempt mod 2)), 10);
      Continue;
    end;

    Mouse.Click(MOUSE_RIGHT);
    if not BASHFarmMenuSelect('Exchange', False) then
      Continue;

    if WaitUntil(RSInterface.IsOpen(), 35, 7500) then
    begin
      if BankPin.IsOpen() then
        BankPin.Enter(Login.GetPlayer.Pin);
      WaitUntil(not BankPin.IsOpen(), 35, 3000);
      _BASHLepRefreshSlots();
      Exit(True);
    end;
  end;

  Result := False;
end;

function TBASHFarmPatch.WithdrawLepCompost(qty: Int32 = 1; closeAfter: Boolean = True): Boolean;
var
  slot, i, attempt, maxTries: Int32;
  isBottomless: Boolean;
begin
  Result := False;

  if Self.UseFertileSoil then
    Exit(True);

  if qty < 1 then
    qty := 1;

  isBottomless := Self.CompostItem = 'Bottomless compost bucket';
  if isBottomless then
    qty := 1;

  slot := Self.CompostSlotIdx();
  if slot < 0 then
    Exit(False);

  if closeAfter then
    maxTries := 3
  else
    maxTries := 1;

  for attempt := 1 to maxTries do
  begin
    if BASHFarmAbortRun then
      Exit(False);

    if not RSInterface.IsOpen() then
    begin
      if isBottomless then
      begin
        if Inventory.ContainsItem(Self.CompostItem) then
          Exit(True);
      end
      else if Inventory.CountItem(Self.CompostItem) >= qty then
        Exit(True);

      if not Self.OpenLepExchange() then
      begin
        WriteLn('[BASHFarm] Could not open leprechaun store for compost (', attempt, '/', maxTries, ')');
        Continue;
      end;
    end
    else if not _BASHLepEnsureSlots() then
      Continue;

    Result := True;
    if isBottomless then
    begin
      if not Self.LepInvSlotIsGreen(slot) then
      begin
        Mouse.Move(_BASHLepStoreSlot(slot));
        if not BASHFarmMenuSelect('Remove', False) then
          Result := False
        else
          Result := Self.WaitLepInvSlotGreen(slot, 5000);
      end;
    end
    else
    begin
      for i := 1 to qty do
      begin
        Mouse.Move(_BASHLepStoreSlot(slot));
        if not BASHFarmMenuSelect('Remove-1', False) then
        begin
          Result := False;
          Break;
        end;

        if not Self.WaitLepInvSlotGreen(slot, 5000) then
        begin
          Result := False;
          Break;
        end;

        if i < qty then
          Wait(Random(60, 160));
      end;
    end;

    if not closeAfter then
      Exit(Result);

    BASHFarmCloseLepInterface();
    _BASHLepClearSlots();
    if RSInterface.IsOpen() then
      Continue;

    if isBottomless then
      Result := WaitUntil(Inventory.ContainsItem(Self.CompostItem), 35, 1500)
    else
      Result := WaitUntil(Inventory.CountItem(Self.CompostItem) >= qty, 35, 1500);

    if Result then
      Exit(True);

    WriteLn('[BASHFarm] ', Self.CompostItem, ' not in inventory after lep withdraw (', attempt, '/', maxTries, ')');
  end;

  if closeAfter then
    BASHFarmFailTools('Could not withdraw ' + Self.CompostItem + ' from leprechaun at ' + Self.Data.Name);
  Result := False;
end;

function TBASHFarmPatch.DepositLepCompost(): Boolean;
var
  slot: Int32;
  invBox: TBox;
begin
  Result := False;

  if Self.UseFertileSoil then
    Exit(True);

  if RSInterface.IsOpen() then
    Exit(False);
  if not Inventory.ContainsItem(Self.CompostItem) then
    Exit(True);

  slot := Self.CompostSlotIdx();
  if slot < 0 then
    Exit(False);

  if not Self.OpenLepExchange() then
    Exit(False);

  invBox := _BASHLepInvSlot(slot);
  WaitUntil(Self.LepInvSlotIsGreen(slot), 35, 1500);
  Mouse.Move(invBox);

  if Self.CompostItem = 'Bottomless compost bucket' then
  begin
    if not BASHFarmMenuSelect('Store', False) then
    begin
      BASHFarmCloseLepInterface();
      _BASHLepClearSlots();
      Exit(False);
    end;
  end
  else if not BASHFarmMenuSelect('Store-All', False) then
  begin
    BASHFarmCloseLepInterface();
    _BASHLepClearSlots();
    Exit(False);
  end;

  Result := Self.WaitLepInvSlotNotGreen(slot, 5000);
  BASHFarmCloseLepInterface();
  _BASHLepClearSlots();
end;

function TBASHFarmPatch.WithdrawLepSecateurs(closeAfter: Boolean = True): Boolean;
begin
  Result := Self.WithdrawLepTool(
    ['Magic secateurs'],
    BASH_LEP_SLOT_SECATEURS,
    'Magic secateurs',
    closeAfter
  );
end;

function TBASHFarmPatch.WithdrawLepSpade(closeAfter: Boolean = True): Boolean;
begin
  Result := Self.WithdrawLepTool(
    ['Spade'],
    BASH_LEP_SLOT_SPADE,
    'spade',
    closeAfter
  );
end;

function TBASHFarmPatch.WithdrawLepDibber(closeAfter: Boolean = True): Boolean;
begin
  Result := Self.WithdrawLepTool(
    ['Seed dibber'],
    BASH_LEP_SLOT_DIBBER,
    'Seed dibber',
    closeAfter
  );
end;

function TBASHFarmPatch.WithdrawLepRake(closeAfter: Boolean = True): Boolean;
begin
  Result := Self.WithdrawLepTool(
    ['Rake'],
    BASH_LEP_SLOT_RAKE,
    'rake',
    closeAfter
  );
end;

function TBASHFarmPatch.WithdrawLepTool(
  haveItems: TRSItemArray;
  slot: Int32;
  labelName: String;
  closeAfter: Boolean = True
): Boolean;
var
  attempt, maxTries: Int32;
begin
  Result := False;

  if closeAfter then
    maxTries := 3
  else
    maxTries := 1;

  for attempt := 1 to maxTries do
  begin
    if BASHFarmAbortRun then
      Exit(False);

    if not RSInterface.IsOpen() then
    begin
      if Inventory.ContainsAny(haveItems) then
        Exit(True);

      if not Self.OpenLepExchange() then
      begin
        WriteLn('[BASHFarm] Could not open leprechaun store for ', labelName, ' (', attempt, '/', maxTries, ')');
        Continue;
      end;
    end
    else if not _BASHLepEnsureSlots() then
      Continue;

    if not Self.LepInvSlotIsGreen(slot) then
    begin
      Mouse.Move(_BASHLepStoreSlot(slot));
      if not BASHFarmMenuSelect(['Remove-1', 'Remove'], False) then
      begin
        WriteLn('[BASHFarm] Lep store Remove failed for ', labelName, ' (', attempt, '/', maxTries, ')');
        if closeAfter then
        begin
          BASHFarmCloseLepInterface();
          _BASHLepClearSlots();
        end;
        Continue;
      end;
      Self.WaitLepInvSlotGreen(slot, 5000);
    end;

    if not closeAfter then
      Exit(True);

    BASHFarmCloseLepInterface();
    _BASHLepClearSlots();
    if RSInterface.IsOpen() then
      Continue;

    if WaitUntil(Inventory.ContainsAny(haveItems), 35, 1500) then
      Exit(True);

    WriteLn('[BASHFarm] ', labelName, ' not in inventory after lep withdraw (', attempt, '/', maxTries, ')');
  end;

  if closeAfter then
    BASHFarmFailTools('Could not withdraw ' + labelName + ' from leprechaun at ' + Self.Data.Name);
  Result := False;
end;

function TBASHFarmPatch.HasStorableLepTools(): Boolean;
begin
  Result := Inventory.ContainsAny([
    'Magic secateurs',
    'Secateurs',
    'Compost',
    'Supercompost',
    'Ultracompost',
    'Bottomless compost bucket',
    'Bucket',
    'Seed dibber',
    'Spade',
    'Rake',
    'Plant cure',
    'Gardening trowel',
    'Watering can'
  ]);
end;

function TBASHFarmPatch.DepositLepTools(): Boolean;
var
  round, attempt: Int32;
  foundLep: Boolean;
  me, dest: TPoint;
  dx, dy: Int32;
begin
  Result := True;
  foundLep := False;

  if not Self.AtFarm() then
  begin
    WriteLn('[BASHFarm] DepositLepTools: not at farm - skipping');
    Exit(False);
  end;

  Self.NoteItems();

  if not Self.HasStorableLepTools() then
    Exit(True);

  Inventory.SetSelectedSlot(-1);
  RSInterface.Close();

  for round := 1 to 2 do
  begin
    if round = 2 then
    begin
      if not Self.HasStorableLepTools() then
        Exit(True);
      if not Self.AtFarm() then
      begin
        WriteLn('[BASHFarm] DepositLepTools: left farm area - aborting');
        Exit(False);
      end;

      me := Map.Position();
      dx := Random(10, 22) * (1 - 2 * Random(2));
      dy := Random(10, 22) * (1 - 2 * Random(2));
      dest := Point(me.X + dx, me.Y + dy);
      WriteLn('[BASHFarm] DepositLepTools: walking nearby to retry -> ', dest);
      Self.TryWalkToward(dest, 6, 24, 4);
      Inventory.SetSelectedSlot(-1);
      RSInterface.Close();
    end;

    for attempt := 1 to 3 do
    begin
      if not Self.HasStorableLepTools() then
        Exit(True);

      if not Self.AtFarm() then
      begin
        WriteLn('[BASHFarm] DepositLepTools: left farm area - aborting');
        Exit(False);
      end;

      if not Self.HoverLeprechaun() then
      begin
        Map.Walker.MakePointVisible(Self.Data.LeprechaunCoords);
        Minimap.SetCompassAngle(Minimap.GetCompassAngle() + Random(40, 80) * (1 - 2 * (attempt mod 2)), 10);
        Continue;
      end;

      foundLep := True;
      Mouse.Click(MOUSE_RIGHT);
      if not BASHFarmMenuSelect(['Deposit-all', 'Deposit-All', 'Deposit all'], False) then
      begin
        WriteLn('[BASHFarm] Deposit-all option not found');
        ChooseOption.Close();
        WaitUntil(not ChooseOption.IsOpen(), 35, 300);
        Continue;
      end;

      Result := WaitUntil(not Self.HasStorableLepTools(), 35, 6000);
      if Result then
      begin
        WriteLn('[BASHFarm] Deposited farm tools to leprechaun');
        Exit(True);
      end;

      WriteLn('[BASHFarm] Tools still in inventory after deposit-all (round ', round, ' try ', attempt, '/3)');
    end;
  end;

  if not foundLep then
  begin
    WriteLn('[BASHFarm] DepositLepTools: could not find leprechaun at ', Self.Data.Name);
    Exit(False);
  end;

  WriteLn('[BASHFarm] DepositLepTools failed, falling back to Store-All');
  Result := Self.DepositLepCompost();
end;

function TBASHFarmPatch.EnsureLepTools(includeCompost: Boolean = True): Boolean;
var
  attempt: Int32;
  needSecs, needSpade, needDibber, needCompost: Boolean;
  okSecs, okSpade, okDibber, okCompost: Boolean;
begin
  Mouse.OnMovingEx := nil;
  Result := False;

  if Self.Skip or BASHFarmAbortRun then
    Exit(False);

  for attempt := 1 to 3 do
  begin
    if RSInterface.IsOpen() then
    begin
      BASHFarmCloseLepInterface();
      _BASHLepClearSlots();
    end;

    needSecs := Self.MagicSecateurs and
                (not Inventory.ContainsItem('Magic secateurs')) and
                (not Equipment.ContainsItem('Magic secateurs'));
    needSpade := not Inventory.ContainsItem('Spade');
    needDibber := (not Self.BarbDibber) and (not Inventory.ContainsItem('Seed dibber'));
    needCompost := includeCompost and (not Self.UseFertileSoil) and (Self.CompostItem <> '') and
                   (not Inventory.ContainsItem(Self.CompostItem));

    if (not needSecs) and (not needSpade) and (not needDibber) and (not needCompost) then
      Exit(True);

    if not Self.AtFarm() then
    begin
      WriteLn('[BASHFarm] EnsureLepTools: not at farm for ', Self.Data.Name, ' - aborting');
      Exit(False);
    end;

    WriteLn('[BASHFarm] Withdrawing lep tools at ', Self.Data.Name, ' (', attempt, '/3)');
    Self.NoteItems();

    if not Self.OpenLepExchange() then
    begin
      WriteLn('[BASHFarm] Could not open leprechaun store (', attempt, '/3)');
      Continue;
    end;

    if needSecs then
      Self.WithdrawLepSecateurs(False);

    if needSpade then
      Self.WithdrawLepSpade(False);

    if needDibber then
      Self.WithdrawLepDibber(False);

    if needCompost then
      Self.WithdrawLepCompost(1, False);

    BASHFarmCloseLepInterface();
    _BASHLepClearSlots();
    if RSInterface.IsOpen() then
      Continue;

    WaitUntil(
      ((not needSecs) or Inventory.ContainsItem('Magic secateurs')
        or Equipment.ContainsItem('Magic secateurs')) and
      ((not needSpade) or Inventory.ContainsItem('Spade')) and
      ((not needDibber) or Inventory.ContainsItem('Seed dibber')) and
      ((not needCompost) or Inventory.ContainsItem(Self.CompostItem)),
      35,
      1500
    );

    okSecs := (not needSecs) or Inventory.ContainsItem('Magic secateurs')
      or Equipment.ContainsItem('Magic secateurs');
    okSpade := (not needSpade) or Inventory.ContainsItem('Spade');
    okDibber := (not needDibber) or Inventory.ContainsItem('Seed dibber');
    okCompost := (not needCompost) or Inventory.ContainsItem(Self.CompostItem);

    if okSecs and okSpade and okDibber and okCompost then
      Exit(True);

    if needSecs and not okSecs then
      WriteLn('[BASHFarm] Failed to withdraw Magic secateurs from leprechaun (', attempt, '/3)');
    if needSpade and not okSpade then
      WriteLn('[BASHFarm] Failed to withdraw spade from leprechaun (', attempt, '/3)');
    if needDibber and not okDibber then
      WriteLn('[BASHFarm] Failed to withdraw Seed dibber from leprechaun (', attempt, '/3)');
    if needCompost and not okCompost then
      WriteLn('[BASHFarm] Failed to withdraw ', Self.CompostItem, ' from leprechaun (', attempt, '/3)');
  end;

  BASHFarmFailTools('Could not withdraw tools from leprechaun at ' + Self.Data.Name);
  Result := False;
end;

procedure TBASHFarmPatch.NoteItems();
var
  slot, i, attempt: Int32;
  item: TRSItem;
  items: TRSItemArray;
  tpa: TPointArray;
  noted: Boolean;
begin
  Self.DropWeeds();

  for i := 0 to High(BASH_FARM_LEPRECHAUN_ITEMS) do
  begin
    item := BASH_FARM_LEPRECHAUN_ITEMS[i];
    if ToStr(item) = 'Weeds' then
      Continue;
    if Inventory.FindItem(item, slot) then
      items += item;
  end;

  if Length(items) < 1 then
    Exit;

  if not Self.AtFarm() then
  begin
    WriteLn('[BASHFarm] NoteItems: not at farm for ', Self.Data.Name, ' - skipping');
    Exit;
  end;

  if not Self.FindLeprechaun(tpa) then
  begin
    WriteLn('[BASHFarm] NoteItems: could not find leprechaun');
    Exit;
  end;

  for i := 0 to High(items) do
  begin
    noted := False;

    for attempt := 1 to 3 do
    begin
      if not Inventory.FindItem(items[i], slot) then
      begin
        noted := True;
        Break;
      end;

      RSInterface.Close();
      Inventory.SetSelectedSlot(slot);

      if not Self.ClickLeprechaun() then
      begin
        Inventory.SetSelectedSlot(-1);
        WriteLn('[BASHFarm] NoteItems: lep click failed for ', items[i],
                ' attempt ', attempt, '/3 at ', Self.Data.Name);
        Wait(Random(120, 280));
        Continue;
      end;

      if not MainScreen.DidRedClick() then
      begin
        Inventory.SetSelectedSlot(-1);
        WriteLn('[BASHFarm] NoteItems: missed note click for ', items[i],
                ' attempt ', attempt, '/3 at ', Self.Data.Name);
        Wait(Random(120, 280));
        Continue;
      end;

      if WaitUntil(Inventory.CountItem(items[i]) = 0, 35, 10000) then
      begin
        noted := True;
        Break;
      end;

      Inventory.SetSelectedSlot(-1);
      WriteLn('[BASHFarm] NoteItems: still holding ', items[i],
              ' after note attempt ', attempt, '/3 at ', Self.Data.Name);
      Wait(Random(150, 350));
    end;

    if not noted then
      WriteLn('[BASHFarm] NoteItems: failed to note ', items[i],
              ' after 3 attempts at ', Self.Data.Name);
  end;

  Inventory.SetSelectedSlot(-1);
  Minimap.WaitPlayerMoving(250, 5000);
  Wait(Random(150, 350));
end;

procedure TBASHFarmPatch.RunPhase(var journal: TBASHFarmJournal; plantPhase: Boolean);
var
  timeout: TCountdown;
  state: EBASHPatchState;
begin
  if not RSClient.IsLoggedIn() then
    Exit;
  if Self.Skip or Self.Complete or BASHFarmAbortRun then
    Exit;

  timeout.Init(6 * ONE_MINUTE);

  while not timeout.IsFinished() do
  begin
    if BASHFarmAbortRun then
      Exit;

    if Self.BailIfCombatHpDropped() then
      Exit;

    if not RSClient.IsLoggedIn() then
      Login.LoginPlayer();

    Self.DropEmptyBuckets();

    state := Self.Inspect();

    case state of
      EBASHPatchState.TELEPORT_TO, EBASHPatchState.SKIP:
        Exit;
      EBASHPatchState.NOTE_ITEMS:
        Self.NoteItems();
      EBASHPatchState.NEED_CLEAR:
        begin
          if Self.Clear() then
            Self.Harvested := True;
          journal.RecordState(Self.Id, Self.Data.PatchType, EBASHJournalState.EMPTY);
        end;
      EBASHPatchState.GROWN:
        begin
          if Self.Harvest() and Self.Harvested then
            journal.RecordState(Self.Id, Self.Data.PatchType, EBASHJournalState.EMPTY);
        end;
      EBASHPatchState.FRESH:
        Self.CheckHealth();
      EBASHPatchState.OVERGROWN:
        begin
          if plantPhase then
          begin
            Self.Harvested := True;
            if Self.Plant() then
            begin
              Self.DropWeeds();
              journal.RecordPlant(Self.Id, Self.Data.PatchType, ToStr(Self.Seed));
              if Self.Composted then
              begin
                Self.Complete := True;
                Exit;
              end;
            end
            else if not Self.Harvested then
            begin
              WriteLn('[BASHFarm] Plant deferred at ', Self.Data.Name, ' - rechecking patch');
              Continue;
            end
            else
              Self.SkipPatch('Failed to plant after rake');
          end
          else if Self.Data.PatchType in [
            EBASHPatchType.HERB, EBASHPatchType.FLOWER, EBASHPatchType.ALLOTMENT
          ] then
            Self.Harvested := True
          else if Self.ClearWeeds(False) then
            Self.Harvested := True
          else
            Self.SkipPatch('Failed to rake weeds');
        end;
      EBASHPatchState.DEAD:
        begin
          if Self.ClearDead() then
            Self.Harvested := True;
          journal.RecordState(Self.Id, Self.Data.PatchType, EBASHJournalState.DEAD);
        end;
      EBASHPatchState.DISEASED:
        begin
          if not Self.Cure() then
            Self.SkipPatch('Diseased and no plant cure');
          journal.RecordState(Self.Id, Self.Data.PatchType, EBASHJournalState.DISEASED);
        end;
      EBASHPatchState.EMPTY:
        begin
          Self.Harvested := True;
          if not plantPhase then
            Exit;

          if Self.Plant() then
          begin
            Self.DropWeeds();
            journal.RecordPlant(Self.Id, Self.Data.PatchType, ToStr(Self.Seed));
            if Self.Composted then
            begin
              Self.Complete := True;
              Exit;
            end;
          end
          else if not Self.Harvested then
          begin
            WriteLn('[BASHFarm] Plant deferred at ', Self.Data.Name, ' - rechecking patch');
            Continue;
          end
          else
            Self.SkipPatch('Failed to plant');
        end;
      EBASHPatchState.UNCOMPOSTED:
        begin
          if not plantPhase then
            Exit;

          if Self.UseFertileSoil then
          begin
            if Self.FertileSoil() then
            begin
              Self.Complete := True;
              Exit;
            end;
          end
          else if Self.Compost() then
          begin
            journal.RecordState(Self.Id, Self.Data.PatchType, EBASHJournalState.GROWING);
            Self.Complete := True;
            Exit;
          end
          else
            Self.SkipPatch('Failed to compost');
        end;
      EBASHPatchState.GROWING, EBASHPatchState.COMPLETE:
        begin
          journal.RecordState(Self.Id, Self.Data.PatchType, EBASHJournalState.GROWING);
          Self.Complete := True;
          Exit;
        end;
      EBASHPatchState.NOT_FOUND:
        begin
          Inc(Self.FailCount);
          if Self.FailCount >= 8 then
            Self.SkipPatch('Too many find failures');
        end;
    end;

    if Self.Skip then
      Exit;
  end;
end;

procedure TBASHFarmPatch.RunHarvestPhase(var journal: TBASHFarmJournal);
begin
  Self.RunPhase(journal, False);
end;

procedure TBASHFarmPatch.RunPlantCompostPhase(var journal: TBASHFarmJournal);
begin
  Self.RunPhase(journal, True);
end;

procedure TBASHFarmPatch.Run(var journal: TBASHFarmJournal);
begin
  Self.RunHarvestPhase(journal);
  if Self.Skip or Self.Complete then
    Exit;
  Self.RunPlantCompostPhase(journal);
end;
