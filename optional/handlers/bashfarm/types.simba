  EBASHPatchType = (
    HERB,
    FLOWER,
    ALLOTMENT,
    TREE,
    FRUIT,
    BUSH,
    CACTUS,
    ANIMA,
    HOPS,
    SEAWEED,
    CORAL,
    GRAPE,
    MUSHROOM,
    BELLADONNA,
    CALQUAT,
    CRYSTAL,
    CELASTRUS
  );

  EBASHPatchState = (
    TELEPORT_TO,
    DEAD,
    DISEASED,
    EMPTY,
    UNCOMPOSTED,
    GROWING,
    GROWN,
    FRESH,
    OVERGROWN,
    NEED_CLEAR,
    NOT_FOUND,
    NOTE_ITEMS,
    COMPLETE,
    SKIP
  );

  EBASHCompostMethod = (
    REGULAR,
    SUPER,
    ULTRA,
    BOTTOMLESS,
    FERTILE_SOIL
  );

  EBASHJournalState = (
    UNKNOWN,
    EMPTY,
    GROWING,
    DISEASED,
    DEAD,
    GROWN
  );

  EBASHFairyWeaponRestore = (
    IMMEDIATE,
    ON_WALK,
    AT_LEP
  );

  TBASHPatchData = record
    PatchType: EBASHPatchType;
    BorderColor, SoilColor: TCTS2Color;
    Coords: TPoint;
    LeprechaunCoords: TPoint;
    LeprechaunColor: TCTS2Color;
    Name: String;
    MapCoords: TBox;
    FarmerName: String;
    FarmerColor: TCTS2Color;
    Chunks: array of TRSMapChunk;
    Outline: TPointArray;
    CompostBinCoords: TPoint;
    StandTiles: TPointArray;
  end;

  TBASHFarmPatch = record
    Id: EBASHFarmPatch;
    Data: TBASHPatchData;
    Travel: TTeleportLocation;
    Seed: TRSItem;
    CompostItem: TRSItem;
    EmptyUpText, PlantedUpText, HarvestUpText: String;
    TPA: TPointArray;
    SearchBox: TBox;
    AimTile: TPoint;
    LastPickedTile: TPoint;
    HasAimTile: Boolean;
    Harvested, Planted, Composted, Skip, Complete, DontClear, OutOfSeeds: Boolean;
    UseFertileSoil: Boolean;
    MagicSecateurs: Boolean;
    BarbDibber: Boolean;
    FailCount: Int32;

    CombatHpWatch: Boolean;
    CombatStartHp: Int32;
  end;

  TBASHJournalEntry = record
    PatchId: EBASHFarmPatch;
    PatchType: EBASHPatchType;
    PlantedItem: String;
    PlantedAt: Int32;
    ExpectedReadyAt: Int32;
    LastObservedState: EBASHJournalState;
    ContractTag: String;
  end;

  TBASHFarmJournal = record
    Path: String;
    Entries: array of TBASHJournalEntry;
  end;

  TBASHFarmContract = record
    Active: Boolean;
    RawText: String;
    RequiredSeed: TRSItem;
    RequiredPatchType: EBASHPatchType;
    AssignedPatch: EBASHFarmPatch;
    Satisfied: Boolean;
  end;

