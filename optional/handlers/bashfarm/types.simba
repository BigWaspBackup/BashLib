var
  BASHFarmAbortRun: Boolean;
  BASHFarmAbortReason: String;

{$I BashLib/optional/handlers/bashcommon.simba}

procedure BASHFarmFailTools(reason: String);
begin
  if BASHFarmAbortRun then
    Exit;
  BASHFarmAbortRun := True;
  BASHFarmAbortReason := reason;
  WriteLn('[BASHFarm] ', reason, ' - finishing farm run and disabling farm runs');
end;
