{$IFDEF BASH_FARM_WITH_BIRDHOUSE}
procedure TBASHFarmGUI.BuildActivitiesSection();
var
  cb: TLabeledCheckBox;
  lcb: TLabeledComboBox;
begin
  Self.AddHeader(
    Self.ActivitiesSection,
    'Activities',
    'Choose which runs this script will do. Uncheck anything you want to skip.'
  );

  Self.AddCheck(Self.ActivitiesSection, cb, 'cb_bash_enable_patches',
    'Herb / flower / allotment / bush / cactus runs',
    24, 110, BASHFarmConfig.EnablePatches);
  cb.SetTooltip('Enable farming patch runs. Shows the Patches and Travel tabs when checked.');
  cb.CheckBox.SetOnChange(@Self.OnActivityCheckChange);

  Self.AddCheck(Self.ActivitiesSection, cb, 'cb_bash_enable_trees',
    'Tree / fruit tree runs (WIP)',
    24, 160, False);
  cb.SetTooltip('Tree and fruit tree runs are not finished yet and stay disabled.');
  cb.CheckBox.SetChecked(False);
  cb.CheckBox.SetEnabled(False);
  cb.SetEnabled(False);

  Self.AddCheck(Self.ActivitiesSection, cb, 'cb_bash_enable_birdhouse',
    'Birdhouse runs',
    24, 210, BASHFarmConfig.EnableBirdhouse);
  cb.SetTooltip('Enable birdhouse runs on Fossil Island. Shows the Birdhouse tab when checked.');
  cb.CheckBox.SetOnChange(@Self.OnActivityCheckChange);

  Self.AddCombo(Self.ActivitiesSection, lcb, 'lcb_bash_start_loc', 'Starting location (return to bank)',
    24, 270, BASH_HOST_START_LOCATIONS, BASHFarmConfig.StartingLocationIdx);
  lcb.SetTooltip('Bank / start location to return to between activities.');
end;

procedure TBASHFarmGUI.BuildBirdhouseSection();
var
  lcb: TLabeledComboBox;
  cb: TLabeledCheckBox;
begin
  Self.AddHeader(
    Self.BirdhouseSection,
    'Birdhouse',
    'Birdhouse type, seeds, and when to run.'
  );

  Self.AddCombo(Self.BirdhouseSection, lcb, 'lcb_bash_bh_log', 'Birdhouse / log type',
    24, 110, BASH_BH_LOG_TYPES, BASHBirdHouseConfig.LogTypeIdx);
  lcb.SetTooltip('Log / birdhouse tier to craft and place. Disabled when Always use best log is on.');

  Self.AddCombo(Self.BirdhouseSection, lcb, 'lcb_bash_bh_seed', 'Seed',
    BASH_GUI_COMBO_COL2, 110, BASH_BH_SEEDS, BASHBirdHouseConfig.SeedIdx);
  lcb.SetTooltip('Seed type used to fill birdhouses. Keep enough in the bank.');

  Self.AddCheck(Self.BirdhouseSection, cb, 'cb_bash_bh_bestlog', 'Always use best log',
    24, 200, BASHBirdHouseConfig.UseBestLog);
  cb.SetTooltip('Auto-pick the highest birdhouse your Hunter level unlocks. Disables the log dropdown.');
  cb.CheckBox.SetOnChange(@Self.OnBestLogCheckChange);

  Self.AddCheck(Self.BirdhouseSection, cb, 'cb_bash_bh_runnow', 'Run birdhouse now',
    24, 250, BASHBirdHouseConfig.RunNow);
  cb.SetTooltip('Ignore the birdhouse timer and run a birdhouse lap immediately when the script starts.');

  Self.RefreshBirdhouseLogEnabled();
end;

procedure TBASHFarmGUI.BuildAccountsSection();
var
  am: TPanel;
  selectorPanel, userPanel, passPanel, pinPanel, worldsPanel, jagexPanel: TPanel;
  addBtn, deleteBtn, generateBtn: TButton;
  leftColW, passW, pinW, worldsLeft, btnW, btnGap: Int32;
begin
  Self.AddHeader(Self.AccountsSection, 'Accounts', 'Login account used when the script starts.');

  am := Self.CreateAccountManager(Self.AccountsSection);
  am.SetLeft(TControl.AdjustToDPI(16));
  am.SetTop(TControl.AdjustToDPI(100));
  am.SetColor(BASH_GUI_BG);

  leftColW := TControl.AdjustToDPI(280);
  passW := Floor(leftColW * 0.6);
  pinW := Floor(leftColW * 0.3);

  selectorPanel := Self.Form.GetChild('am_selector_panel');
  userPanel := Self.Form.GetChild('am_user_panel');
  passPanel := Self.Form.GetChild('am_pass_panel');
  pinPanel := Self.Form.GetChild('am_pin_panel');
  worldsPanel := Self.Form.GetChild('am_worlds_panel');
  jagexPanel := Self.Form.GetChild('am_jagex_panel');

  if selectorPanel <> nil then
    selectorPanel.SetWidth(leftColW);
  if userPanel <> nil then
    userPanel.SetWidth(leftColW);
  if jagexPanel <> nil then
    jagexPanel.SetWidth(leftColW);
  if passPanel <> nil then
    passPanel.SetWidth(passW);
  if (pinPanel <> nil) and (selectorPanel <> nil) then
  begin
    pinPanel.SetWidth(pinW);
    pinPanel.SetLeft(selectorPanel.GetLeft() + leftColW - pinW);
  end;

  if (worldsPanel <> nil) and (selectorPanel <> nil) and (userPanel <> nil) then
  begin
    worldsLeft := selectorPanel.GetLeft() + leftColW + TControl.AdjustToDPI(48);
    worldsPanel.SetLeft(worldsLeft);
    worldsPanel.SetHeight(userPanel.GetBottom());

    addBtn := Self.Form.GetChild('am_add_button');
    deleteBtn := Self.Form.GetChild('am_delete_button');
    generateBtn := Self.Form.GetChild('am_generate_worlds_button');
    btnGap := TControl.AdjustToDPI(8);
    btnW := Floor((worldsPanel.GetWidth() - btnGap) / 2);

    if generateBtn <> nil then
    begin
      generateBtn.SetLeft(worldsLeft);
      generateBtn.SetWidth(worldsPanel.GetWidth());
    end;
    if addBtn <> nil then
    begin
      addBtn.SetLeft(worldsLeft);
      addBtn.SetWidth(btnW);
    end;
    if deleteBtn <> nil then
    begin
      deleteBtn.SetLeft(worldsLeft + worldsPanel.GetWidth() - btnW - TControl.AdjustToDPI(1));
      deleteBtn.SetWidth(btnW);
    end;

    if (addBtn <> nil) and (am.GetHeight() < addBtn.GetTop() + addBtn.GetHeight() + TControl.AdjustToDPI(8)) then
      am.SetHeight(addBtn.GetTop() + addBtn.GetHeight() + TControl.AdjustToDPI(8));
  end;

  Self.ApplyJagexAccountVisibility();
end;

procedure TBASHFarmGUI.BuildAntibanSection();
var
  ab: TPanel;
begin
  Self.AddHeader(Self.AntibanSection, 'Antiban', 'BioHash, breaks, sleeps, and action limits.');

  ab := Self.CreateAntibanManager(Self.AntibanSection);
  ab.SetAlign(alNone);
  ab.SetLeft(0);
  ab.SetTop(TControl.AdjustToDPI(88));
  ab.SetWidth(Self.AntibanSection.GetWidth());
  ab.SetHeight(Self.AntibanSection.GetHeight() - TControl.AdjustToDPI(88));
  ab.SetColor(BASH_GUI_BG);
end;

procedure TBASHFarmGUI.ClearPatchEnables();
var
  p: EBASHFarmPatch;
begin
  for p := Low(EBASHFarmPatch) to High(EBASHFarmPatch) do
    if not BASHFarmPatchIsTreeRun(p) then
      BASHFarmConfig.Enabled[p] := False;
end;

procedure TBASHFarmGUI.ClearTreeEnables();
var
  p: EBASHFarmPatch;
begin
  for p := Low(EBASHFarmPatch) to High(EBASHFarmPatch) do
    if BASHFarmPatchIsTreeRun(p) then
      BASHFarmConfig.Enabled[p] := False;
end;
{$ENDIF}

procedure TBASHFarmGUI.BuildShell(tab: TTabSheet);
var
  contentH, mainW: Int32;
begin
  Self.BuildChrome(tab);
  mainW := Self.MainWidth();
  contentH := Self.ContentHeight();

  {$IFDEF BASH_FARM_WITH_BIRDHOUSE}
  Self.BrandLabel := Self.MakeLabel(Self.NavPanel, 'BASH Farm + BH', 16, 28, 14, BASH_GUI_TEXT, True);
  {$ELSE}
  Self.BrandLabel := Self.MakeLabel(Self.NavPanel, 'BASH Farm', 16, 28, 16, BASH_GUI_TEXT, True);
  {$ENDIF}

  {$IFDEF BASH_FARM_WITH_BIRDHOUSE}
  Self.ActivitiesNav := Self.MakeNavItem(Self.NavPanel, 'Activities', 12, 100, True);
  Self.PatchesNav := Self.MakeNavItem(Self.NavPanel, 'Patches', 12, 152);
  Self.TreesNav := Self.MakeNavItem(Self.NavPanel, 'Trees', 12, 204);
  Self.TravelNav := Self.MakeNavItem(Self.NavPanel, 'Travel', 12, 256);
  Self.BirdhouseNav := Self.MakeNavItem(Self.NavPanel, 'Birdhouse', 12, 308);
  Self.AccountsNav := Self.MakeNavItem(Self.NavPanel, 'Accounts', 12, 360);
  Self.AntibanNav := Self.MakeNavItem(Self.NavPanel, 'Antiban', 12, 412);

  Self.ActivitiesSection := Self.MakePanel(Self.ContentPanel, 0, 0, 100, 100, BASH_GUI_BG);
  Self.PatchesSection := Self.MakePanel(Self.ContentPanel, 0, 0, 100, 100, BASH_GUI_BG);
  Self.TreesSection := Self.MakePanel(Self.ContentPanel, 0, 0, 100, 100, BASH_GUI_BG);
  Self.TravelSection := Self.MakePanel(Self.ContentPanel, 0, 0, 100, 100, BASH_GUI_BG);
  Self.BirdhouseSection := Self.MakePanel(Self.ContentPanel, 0, 0, 100, 100, BASH_GUI_BG);
  Self.AccountsSection := Self.MakePanel(Self.ContentPanel, 0, 0, 100, 100, BASH_GUI_BG);
  Self.AntibanSection := Self.MakePanel(Self.ContentPanel, 0, 0, 100, 100, BASH_GUI_BG);

  Self.ActivitiesSection.SetWidth(mainW);
  Self.ActivitiesSection.SetHeight(contentH);
  Self.PatchesSection.SetWidth(mainW);
  Self.PatchesSection.SetHeight(contentH);
  Self.TreesSection.SetWidth(mainW);
  Self.TreesSection.SetHeight(contentH);
  Self.TravelSection.SetWidth(mainW);
  Self.TravelSection.SetHeight(contentH);
  Self.BirdhouseSection.SetWidth(mainW);
  Self.BirdhouseSection.SetHeight(contentH);
  Self.AccountsSection.SetWidth(mainW);
  Self.AccountsSection.SetHeight(contentH);
  Self.AntibanSection.SetWidth(mainW);
  Self.AntibanSection.SetHeight(contentH);

  Self.BuildActivitiesSection();
  Self.BuildPatchesSection();
  Self.BuildTreesSection();
  Self.BuildTravelSection();
  Self.BuildBirdhouseSection();
  Self.BuildAccountsSection();
  Self.BuildAntibanSection();

  Self.ActivitiesNav.SetOnClick(@Self.ShowActivities);
  Self.PatchesNav.SetOnClick(@Self.ShowPatches);
  Self.TreesNav.SetOnClick(@Self.ShowTrees);
  Self.TravelNav.SetOnClick(@Self.ShowTravel);
  Self.BirdhouseNav.SetOnClick(@Self.ShowBirdhouse);
  Self.AccountsNav.SetOnClick(@Self.ShowAccounts);
  Self.AntibanNav.SetOnClick(@Self.ShowAntiban);
  {$ELSE}
  Self.PatchesNav := Self.MakeNavItem(Self.NavPanel, 'Patches', 12, 100, True);
  Self.TreesNav := Self.MakeNavItem(Self.NavPanel, 'Trees', 12, 152);
  Self.TravelNav := Self.MakeNavItem(Self.NavPanel, 'Travel', 12, 204);

  Self.PatchesSection := Self.MakePanel(Self.ContentPanel, 0, 0, 100, 100, BASH_GUI_BG);
  Self.TreesSection := Self.MakePanel(Self.ContentPanel, 0, 0, 100, 100, BASH_GUI_BG);
  Self.TravelSection := Self.MakePanel(Self.ContentPanel, 0, 0, 100, 100, BASH_GUI_BG);

  Self.PatchesSection.SetWidth(mainW);
  Self.PatchesSection.SetHeight(contentH);
  Self.TreesSection.SetWidth(mainW);
  Self.TreesSection.SetHeight(contentH);
  Self.TravelSection.SetWidth(mainW);
  Self.TravelSection.SetHeight(contentH);

  Self.BuildPatchesSection();
  Self.BuildTreesSection();
  Self.BuildTravelSection();

  Self.PatchesNav.SetOnClick(@Self.ShowPatches);
  Self.TreesNav.SetOnClick(@Self.ShowTrees);
  Self.TravelNav.SetOnClick(@Self.ShowTravel);
  {$ENDIF}

  Self.StartChip.SetOnClick(@Self.StartScript);

  {$IFDEF BASH_FARM_WITH_BIRDHOUSE}
  Self.ShowActivities(Self.ActivitiesNav);
  Self.RefreshActivityNav();
  {$ELSE}
  Self.ShowPatches(Self.PatchesNav);
  {$ENDIF}
end;

procedure TBASHFarmGUI.ApplySettings();
begin
  BASHFarmConfig.HerbSeedIdx := Self.ReadComboIdx('lcb_bash_herbseed');
  BASHFarmConfig.FlowerSeedIdx := Self.ReadComboIdx('lcb_bash_flowerseed');
  BASHFarmConfig.AllotmentSeedIdx := Self.ReadComboIdx('lcb_bash_allotseed');
  BASHFarmConfig.BushSeedIdx := Self.ReadComboIdx('lcb_bash_bushseed');
  BASHFarmConfig.CactusSeedIdx := Self.ReadComboIdx('lcb_bash_cactusseed');
  BASHFarmConfig.CompostIdx := Self.ReadComboIdx('lcb_bash_compost');

  BASHFarmConfig.WeissTP := Self.ReadComboIdx('lcb_bash_weiss_tp');
  BASHFarmConfig.StrongholdTP := Self.ReadComboIdx('lcb_bash_stronghold_tp');
  BASHFarmConfig.ArdougneTP := Self.ReadComboIdx('lcb_bash_ardougne_tp');
  BASHFarmConfig.FaladorTP := Self.ReadComboIdx('lcb_bash_falador_tp');
  BASHFarmConfig.CatherbyTP := Self.ReadComboIdx('lcb_bash_catherby_tp');
  BASHFarmConfig.PhasmatysTP := 0;
  BASHFarmConfig.HosidiusTP := Self.ReadComboIdx('lcb_bash_hosidius_tp');
  BASHFarmConfig.OrtusTP := Self.ReadComboIdx('lcb_bash_ortus_tp');
  BASHFarmConfig.GuildTP := Self.ReadComboIdx('lcb_bash_guild_tp');

  BASHFarmConfig.TreeSaplingIdx := Self.ReadComboIdx('lcb_bash_treesapling');
  BASHFarmConfig.FruitSaplingIdx := Self.ReadComboIdx('lcb_bash_fruitsapling');
  BASHFarmConfig.LumbridgeTreeTP := Self.ReadComboIdx('lcb_bash_lum_tree_tp');
  BASHFarmConfig.VarrockTreeTP := Self.ReadComboIdx('lcb_bash_var_tree_tp');
  BASHFarmConfig.FaladorTreeTP := Self.ReadComboIdx('lcb_bash_fally_tree_tp');
  BASHFarmConfig.TaverleyTreeTP := Self.ReadComboIdx('lcb_bash_tav_tree_tp');
  BASHFarmConfig.GnomeTreeTP := Self.ReadComboIdx('lcb_bash_gnome_tree_tp');
  BASHFarmConfig.GnomeFruitTP := Self.ReadComboIdx('lcb_bash_gnome_fruit_tp');
  BASHFarmConfig.GnomeVillageFruitTP := Self.ReadComboIdx('lcb_bash_gnome_village_tp');
  BASHFarmConfig.CatherbyFruitTP := Self.ReadComboIdx('lcb_bash_cath_fruit_tp');
  BASHFarmConfig.BrimhavenFruitTP := Self.ReadComboIdx('lcb_bash_brim_fruit_tp');
  BASHFarmConfig.LletyaFruitTP := Self.ReadComboIdx('lcb_bash_lletya_fruit_tp');

  BASHFarmConfig.BarbDibber := Self.ReadCheck('cb_bash_barbdibber');
  BASHFarmConfig.LumbyElite := Self.ReadCheck('cb_bash_lumby_elite');
  BASHFarmConfig.RunNow := Self.ReadCheck('cb_bash_runnow');

  BASHFarmConfig.Enabled[EBASHFarmPatch.WEISS_HERB] := Self.ReadCheck('cb_bash_weiss_herb');
  BASHFarmConfig.Enabled[EBASHFarmPatch.STRONGHOLD_HERB] := Self.ReadCheck('cb_bash_stronghold_herb');
  BASHFarmConfig.Enabled[EBASHFarmPatch.ARDOUGNE_HERB] := Self.ReadCheck('cb_bash_ardy_herb');
  BASHFarmConfig.Enabled[EBASHFarmPatch.ARDOUGNE_FLOWER] := Self.ReadCheck('cb_bash_ardy_flower');
  BASHFarmConfig.Enabled[EBASHFarmPatch.ARDOUGNE_ALLOT_N] := Self.ReadCheck('cb_bash_ardy_allot');
  BASHFarmConfig.Enabled[EBASHFarmPatch.ARDOUGNE_ALLOT_S] := Self.ReadCheck('cb_bash_ardy_allot');
  BASHFarmConfig.Enabled[EBASHFarmPatch.FALADOR_HERB] := Self.ReadCheck('cb_bash_fally_herb');
  BASHFarmConfig.Enabled[EBASHFarmPatch.FALADOR_FLOWER] := Self.ReadCheck('cb_bash_fally_flower');
  BASHFarmConfig.Enabled[EBASHFarmPatch.FALADOR_ALLOT_N] := Self.ReadCheck('cb_bash_fally_allot');
  BASHFarmConfig.Enabled[EBASHFarmPatch.FALADOR_ALLOT_S] := Self.ReadCheck('cb_bash_fally_allot');
  BASHFarmConfig.Enabled[EBASHFarmPatch.CATHERBY_HERB] := Self.ReadCheck('cb_bash_cath_herb');
  BASHFarmConfig.Enabled[EBASHFarmPatch.CATHERBY_FLOWER] := Self.ReadCheck('cb_bash_cath_flower');
  BASHFarmConfig.Enabled[EBASHFarmPatch.CATHERBY_ALLOT_N] := Self.ReadCheck('cb_bash_cath_allot');
  BASHFarmConfig.Enabled[EBASHFarmPatch.CATHERBY_ALLOT_S] := Self.ReadCheck('cb_bash_cath_allot');
  BASHFarmConfig.Enabled[EBASHFarmPatch.PHASMATYS_HERB] := Self.ReadCheck('cb_bash_phas_herb');
  BASHFarmConfig.Enabled[EBASHFarmPatch.PHASMATYS_FLOWER] := Self.ReadCheck('cb_bash_phas_flower');
  BASHFarmConfig.Enabled[EBASHFarmPatch.PHASMATYS_ALLOT_N] := Self.ReadCheck('cb_bash_phas_allot');
  BASHFarmConfig.Enabled[EBASHFarmPatch.PHASMATYS_ALLOT_S] := Self.ReadCheck('cb_bash_phas_allot');
  BASHFarmConfig.Enabled[EBASHFarmPatch.HOSIDIUS_HERB] := Self.ReadCheck('cb_bash_hosi_herb');
  BASHFarmConfig.Enabled[EBASHFarmPatch.HOSIDIUS_FLOWER] := Self.ReadCheck('cb_bash_hosi_flower');
  BASHFarmConfig.Enabled[EBASHFarmPatch.HOSIDIUS_ALLOT_N] := Self.ReadCheck('cb_bash_hosi_allot');
  BASHFarmConfig.Enabled[EBASHFarmPatch.HOSIDIUS_ALLOT_S] := Self.ReadCheck('cb_bash_hosi_allot');
  BASHFarmConfig.Enabled[EBASHFarmPatch.ORTUS_HERB] := Self.ReadCheck('cb_bash_ortus_herb');
  BASHFarmConfig.Enabled[EBASHFarmPatch.ORTUS_FLOWER] := Self.ReadCheck('cb_bash_ortus_flower');
  BASHFarmConfig.Enabled[EBASHFarmPatch.ORTUS_ALLOT_N] := Self.ReadCheck('cb_bash_ortus_allot');
  BASHFarmConfig.Enabled[EBASHFarmPatch.ORTUS_ALLOT_S] := Self.ReadCheck('cb_bash_ortus_allot');
  BASHFarmConfig.Enabled[EBASHFarmPatch.GUILD_HERB] := Self.ReadCheck('cb_bash_guild_herb');
  BASHFarmConfig.Enabled[EBASHFarmPatch.GUILD_FLOWER] := Self.ReadCheck('cb_bash_guild_flower');
  BASHFarmConfig.Enabled[EBASHFarmPatch.GUILD_ALLOT_N] := Self.ReadCheck('cb_bash_guild_allot');
  BASHFarmConfig.Enabled[EBASHFarmPatch.GUILD_ALLOT_S] := Self.ReadCheck('cb_bash_guild_allot');
  BASHFarmConfig.Enabled[EBASHFarmPatch.GUILD_BUSH] := Self.ReadCheck('cb_bash_guild_bush');
  BASHFarmConfig.Enabled[EBASHFarmPatch.GUILD_CACTUS] := Self.ReadCheck('cb_bash_guild_cactus');
  BASHFarmConfig.Enabled[EBASHFarmPatch.GUILD_ANIMA] := False;

  BASHFarmConfig.Enabled[EBASHFarmPatch.LUMBRIDGE_TREE] := Self.ReadCheck('cb_bash_lum_tree');
  BASHFarmConfig.Enabled[EBASHFarmPatch.VARROCK_TREE] := Self.ReadCheck('cb_bash_var_tree');
  BASHFarmConfig.Enabled[EBASHFarmPatch.FALADOR_TREE] := Self.ReadCheck('cb_bash_fally_tree');
  BASHFarmConfig.Enabled[EBASHFarmPatch.TAVERLEY_TREE] := Self.ReadCheck('cb_bash_tav_tree');
  BASHFarmConfig.Enabled[EBASHFarmPatch.GNOME_TREE] := Self.ReadCheck('cb_bash_gnome_tree');
  BASHFarmConfig.Enabled[EBASHFarmPatch.GUILD_TREE] := Self.ReadCheck('cb_bash_guild_tree');
  BASHFarmConfig.Enabled[EBASHFarmPatch.GUILD_REDWOOD] := Self.ReadCheck('cb_bash_guild_redwood');
  BASHFarmConfig.Enabled[EBASHFarmPatch.GNOME_STRONGHOLD_FRUIT] := Self.ReadCheck('cb_bash_gnome_fruit');
  BASHFarmConfig.Enabled[EBASHFarmPatch.CATHERBY_FRUIT] := Self.ReadCheck('cb_bash_cath_fruit');
  BASHFarmConfig.Enabled[EBASHFarmPatch.GNOME_VILLAGE_FRUIT] := Self.ReadCheck('cb_bash_gnome_village_fruit');
  BASHFarmConfig.Enabled[EBASHFarmPatch.BRIMHAVEN_FRUIT] := Self.ReadCheck('cb_bash_brim_fruit');
  BASHFarmConfig.Enabled[EBASHFarmPatch.LLETYA_FRUIT] := Self.ReadCheck('cb_bash_lletya_fruit');
  BASHFarmConfig.Enabled[EBASHFarmPatch.GUILD_FRUIT] := Self.ReadCheck('cb_bash_guild_fruit');
  BASHFarmConfig.Enabled[EBASHFarmPatch.HARMONY_ISLAND_HERB] := False;

  {$IFDEF BASH_FARM_WITH_BIRDHOUSE}
  Self.DoPatches := Self.ReadCheck('cb_bash_enable_patches');
  Self.DoTrees := False;
  Self.DoBirdhouse := Self.ReadCheck('cb_bash_enable_birdhouse');
  Self.StartingLocationIdx := Self.ReadComboIdx('lcb_bash_start_loc');

  BASHFarmConfig.EnablePatches := Self.DoPatches;
  BASHFarmConfig.EnableTrees := False;
  BASHFarmConfig.EnableBirdhouse := Self.DoBirdhouse;
  BASHFarmConfig.StartingLocationIdx := Self.StartingLocationIdx;

  BASHBirdHouseConfig.LogTypeIdx := Self.ReadComboIdx('lcb_bash_bh_log');
  BASHBirdHouseConfig.SeedIdx := Self.ReadComboIdx('lcb_bash_bh_seed');
  BASHBirdHouseConfig.UseBestLog := Self.ReadCheck('cb_bash_bh_bestlog');
  BASHBirdHouseConfig.RunNow := Self.ReadCheck('cb_bash_bh_runnow');
  BASHBirdHouseConfig.Write();
  {$ENDIF}

  BASHFarmConfig.Write();

  {$IFDEF BASH_FARM_WITH_BIRDHOUSE}

  if not Self.DoPatches then
    Self.ClearPatchEnables();
  if not Self.DoTrees then
    Self.ClearTreeEnables();
  {$ENDIF}

  BASHFarmRunner.BuildFromConfig(BASHFarmConfig);

  {$IFDEF BASH_FARM_WITH_BIRDHOUSE}
  if Self.DoBirdhouse then
  begin
    BASHBirdHouseRunner.ApplyConfig(BASHBirdHouseConfig);
    BASHBirdHouseRunner.IsDisabled := False;
  end
  else
    BASHBirdHouseRunner.IsDisabled := True;
  {$ENDIF}
end;

procedure TBASHFarmGUI.StartScript({$H-}sender: TObject); override; {$H+}
begin
  Self.ApplySettings();
  BASHFarmRunner.Init();
  WriteLn('[BASHFarm] Loaded ', Length(BASHFarmRunner.Patches), ' patches from GUI');

  {$IFDEF BASH_FARM_WITH_BIRDHOUSE}
  if Self.DoBirdhouse then
  begin
    BASHBirdHouseRunner.Init();
    WriteLn('[BASHFarm] Birdhouse ready - log=', ToStr(BASHBirdHouseRunner.LogType),
      ' seed=', ToStr(BASHBirdHouseRunner.Seed));
  end
  else
    WriteLn('[BASHFarm] Birdhouse runs disabled');

  WriteLn('[BASHFarm] Activities - patches=', Self.DoPatches,
    ' trees=', Self.DoTrees, ' birdhouse=', Self.DoBirdhouse);
  {$ENDIF}

  try
    Self._WarmBuildCache();
  except
  end;
  Self.Form.SetOnClose(nil);
  Self.Form.Close();
end;

procedure TBASHFarmGUI.Run(); override;
var
  tab: TTabSheet;
begin
  BASHFarmConfig.Read();
  {$IFDEF BASH_FARM_WITH_BIRDHOUSE}
  BASHBirdHouseConfig.Read();
  Self.DoPatches := BASHFarmConfig.EnablePatches;
  Self.DoTrees := False;
  Self.DoBirdhouse := BASHFarmConfig.EnableBirdhouse;
  Self.StartingLocationIdx := BASHFarmConfig.StartingLocationIdx;
  Self.Setup('BASH Farm and Birdhouse', [BASH_GUI_W, BASH_GUI_H], False);
  Self.AddTab('BASH Farm BH');
  {$ELSE}
  Self.Setup('BASH Farm', [BASH_GUI_W, BASH_GUI_H], False);
  Self.AddTab('BASH Farm');
  {$ENDIF}
  tab := Self.Tabs[High(Self.Tabs)];
  Self.BuildShell(tab);
  {$IFDEF BASH_FARM_WITH_BIRDHOUSE}
  try
    Self.PageControl.SetShowTabs(False);
  except
  end;
  {$ENDIF}
  inherited;
end;
